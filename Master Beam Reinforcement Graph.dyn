    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# B01 — SELECTED TYPE GEOMETRY PREFLIGHT\r\n#\r\n# IN[0] = entire T04 output\r\n#\r\n# T04:\r\n# [0]  Type Name\r\n# [1]  Type ID\r\n# [2]  Beam Count\r\n# [3]  Beam IDs\r\n# [4]  TopQty\r\n# [5]  BottomQty\r\n# [6]  TopDia\r\n# [7]  BottomDia\r\n# [8]  StirrupDia\r\n# [9]  Cover\r\n# [10] EndSpacing\r\n# [11] MidSpacing\r\n# [12] ContinuousQty\r\n# [13] ExtraQty\r\n# [14] Support Extra Layer\r\n# [15] Midspan Extra Layer\r\n# [16] Support Section\r\n# [17] Midspan Section\r\n# [18] Beam Instances\r\n# [19] Ready\r\n# [20] Status\r\n#\r\n# OUT:\r\n# [0] Beam reports\r\n# [1] Input beam count\r\n# [2] Ready beams\r\n# [3] Ready count\r\n# [4] Ready beam IDs\r\n# [5] Failed reports\r\n# [6] Failed count\r\n# [7] Overall ready\r\n# [8] T04 config\r\n# [9] Status\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n    if value is None:\r\n        return []\r\n    if isinstance(value, list):\r\n        return value\r\n    try:\r\n        return list(value)\r\n    except:\r\n        return [value]\r\n\r\n\r\ndef id_value(element):\r\n    try:\r\n        return int(element.Id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element.Id.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\ndef internal_to_mm(value):\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef get_type_dimension_mm(beam_type, names):\r\n\r\n    for name in names:\r\n\r\n        try:\r\n            p = beam_type.LookupParameter(name)\r\n\r\n            if (\r\n                p is not None\r\n                and\r\n                p.StorageType == StorageType.Double\r\n            ):\r\n                return internal_to_mm(\r\n                    p.AsDouble()\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# READ T04\r\n# ============================================================\r\n\r\nt04 = IN[0]\r\n\r\ntry:\r\n\r\n    type_name = t04[0]\r\n    type_id = t04[1]\r\n\r\n    expected_beam_count = int(t04[2])\r\n\r\n    top_qty = int(t04[4])\r\n    bottom_qty = int(t04[5])\r\n\r\n    top_dia = float(t04[6])\r\n    bottom_dia = float(t04[7])\r\n\r\n    stirrup_dia = float(t04[8])\r\n    cover = float(t04[9])\r\n\r\n    end_spacing = float(t04[10])\r\n    mid_spacing = float(t04[11])\r\n\r\n    continuous_qty = int(t04[12])\r\n    extra_qty = int(t04[13])\r\n\r\n    support_extra_layer = t04[14]\r\n    midspan_extra_layer = t04[15]\r\n\r\n    beams_raw = as_list(\r\n        t04[18]\r\n    )\r\n\r\n    t04_ready = bool(\r\n        t04[19]\r\n    )\r\n\r\nexcept Exception as ex:\r\n\r\n    OUT = [\r\n        [],\r\n        0,\r\n        [],\r\n        0,\r\n        [],\r\n        [],\r\n        0,\r\n        False,\r\n        None,\r\n        \"INVALID T04 INPUT: {}\".format(str(ex))\r\n    ]\r\n\r\n    raise Exception(\r\n        \"Invalid T04 input: {}\".format(str(ex))\r\n    )\r\n\r\n\r\n# ============================================================\r\n# UNWRAP BEAMS\r\n# ============================================================\r\n\r\nbeams = []\r\n\r\nfor item in beams_raw:\r\n\r\n    try:\r\n        beam = UnwrapElement(item)\r\n    except:\r\n        beam = item\r\n\r\n    if beam is not None:\r\n        beams.append(beam)\r\n\r\n\r\n# ============================================================\r\n# PROCESS\r\n# ============================================================\r\n\r\nreports = []\r\n\r\nready_beams = []\r\nready_ids = []\r\n\r\nfailed_reports = []\r\n\r\n\r\nfor beam in beams:\r\n\r\n    errors = []\r\n    warnings = []\r\n\r\n    beam_id = id_value(\r\n        beam\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # LOCATION CURVE\r\n    # ========================================================\r\n\r\n    curve = None\r\n    length_mm = None\r\n\r\n\r\n    try:\r\n\r\n        location = beam.Location\r\n\r\n        if location is None:\r\n            errors.append(\r\n                \"Beam has no Location.\"\r\n            )\r\n\r\n        else:\r\n\r\n            curve = location.Curve\r\n\r\n            if curve is None:\r\n                errors.append(\r\n                    \"Beam has no LocationCurve.\"\r\n                )\r\n\r\n            else:\r\n\r\n                length_mm = internal_to_mm(\r\n                    curve.Length\r\n                )\r\n\r\n                if length_mm <= 0:\r\n                    errors.append(\r\n                        \"Beam length is invalid.\"\r\n                    )\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"LocationCurve error: {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # TYPE\r\n    # ========================================================\r\n\r\n    beam_type = None\r\n    beam_width = None\r\n    beam_depth = None\r\n\r\n\r\n    try:\r\n\r\n        beam_type = doc.GetElement(\r\n            beam.GetTypeId()\r\n        )\r\n\r\n    except:\r\n        beam_type = None\r\n\r\n\r\n    if beam_type is None:\r\n\r\n        errors.append(\r\n            \"Beam type not found.\"\r\n        )\r\n\r\n    else:\r\n\r\n        beam_width = get_type_dimension_mm(\r\n            beam_type,\r\n            [\r\n                \"b\",\r\n                \"Width\",\r\n                \"B\"\r\n            ]\r\n        )\r\n\r\n        beam_depth = get_type_dimension_mm(\r\n            beam_type,\r\n            [\r\n                \"h\",\r\n                \"Depth\",\r\n                \"H\"\r\n            ]\r\n        )\r\n\r\n\r\n        if beam_width is None or beam_width <= 0:\r\n\r\n            errors.append(\r\n                \"Beam width not found.\"\r\n            )\r\n\r\n\r\n        if beam_depth is None or beam_depth <= 0:\r\n\r\n            errors.append(\r\n                \"Beam depth not found.\"\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # VERIFY TYPE MATCH\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        current_type_id = id_value(\r\n            beam_type\r\n        )\r\n\r\n        if current_type_id != int(type_id):\r\n\r\n            errors.append(\r\n                \"Beam does not match selected type.\"\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # ========================================================\r\n    # CONFIG VALIDATION\r\n    # ========================================================\r\n\r\n    if top_qty < 2:\r\n        errors.append(\r\n            \"TopQty must be >= 2.\"\r\n        )\r\n\r\n    if bottom_qty < 2:\r\n        errors.append(\r\n            \"BottomQty must be >= 2.\"\r\n        )\r\n\r\n    if top_dia <= 0:\r\n        errors.append(\r\n            \"TopDia invalid.\"\r\n        )\r\n\r\n    if bottom_dia <= 0:\r\n        errors.append(\r\n            \"BottomDia invalid.\"\r\n        )\r\n\r\n    if stirrup_dia <= 0:\r\n        errors.append(\r\n            \"StirrupDia invalid.\"\r\n        )\r\n\r\n    if cover <= 0:\r\n        errors.append(\r\n            \"Cover invalid.\"\r\n        )\r\n\r\n    if end_spacing <= 0:\r\n        errors.append(\r\n            \"EndSpacing invalid.\"\r\n        )\r\n\r\n    if mid_spacing <= 0:\r\n        errors.append(\r\n            \"MidSpacing invalid.\"\r\n        )\r\n\r\n\r\n    if abs(top_dia - bottom_dia) > 0.5:\r\n\r\n        warnings.append(\r\n            \"TopDia and BottomDia differ.\"\r\n        )\r\n\r\n\r\n    ready = (\r\n        len(errors) == 0\r\n    )\r\n\r\n\r\n    status = (\r\n        \"READY\"\r\n        if ready\r\n        else \"FAILED\"\r\n    )\r\n\r\n\r\n    report = [\r\n\r\n        beam_id,                   # 0\r\n        ready,                     # 1\r\n        status,                    # 2\r\n\r\n        errors,                    # 3\r\n        warnings,                  # 4\r\n\r\n        [\r\n            length_mm,\r\n            beam_width,\r\n            beam_depth\r\n        ],                          # 5\r\n\r\n        [\r\n            top_qty,\r\n            bottom_qty,\r\n            top_dia,\r\n            bottom_dia\r\n        ],                          # 6\r\n\r\n        [\r\n            continuous_qty,\r\n            extra_qty,\r\n            support_extra_layer,\r\n            midspan_extra_layer\r\n        ],                          # 7\r\n\r\n        [\r\n            stirrup_dia,\r\n            cover,\r\n            end_spacing,\r\n            mid_spacing\r\n        ],                          # 8\r\n\r\n        beam                       # 9\r\n    ]\r\n\r\n\r\n    reports.append(\r\n        report\r\n    )\r\n\r\n\r\n    if ready:\r\n\r\n        ready_beams.append(\r\n            beam\r\n        )\r\n\r\n        ready_ids.append(\r\n            beam_id\r\n        )\r\n\r\n    else:\r\n\r\n        failed_reports.append(\r\n            report\r\n        )\r\n\r\n\r\n# ============================================================\r\n# FINAL\r\n# ============================================================\r\n\r\noverall_ready = (\r\n    t04_ready\r\n    and\r\n    len(beams) > 0\r\n    and\r\n    len(failed_reports) == 0\r\n)\r\n\r\n\r\nstatus = (\r\n    \"B01 PREFLIGHT COMPLETE\"\r\n    if overall_ready\r\n    else \"B01 PREFLIGHT FAILED\"\r\n)\r\n\r\n\r\nOUT = [\r\n\r\n    reports,                       # 0\r\n\r\n    len(beams),                    # 1\r\n\r\n    ready_beams,                   # 2\r\n\r\n    len(ready_beams),              # 3\r\n\r\n    ready_ids,                     # 4\r\n\r\n    failed_reports,                # 5\r\n\r\n    len(failed_reports),           # 6\r\n\r\n    overall_ready,                 # 7\r\n\r\n    [\r\n        type_name,\r\n        type_id,\r\n        top_qty,\r\n        bottom_qty,\r\n        top_dia,\r\n        bottom_dia,\r\n        stirrup_dia,\r\n        cover,\r\n        end_spacing,\r\n        mid_spacing,\r\n        continuous_qty,\r\n        extra_qty,\r\n        support_extra_layer,\r\n        midspan_extra_layer\r\n    ],                              # 8\r\n\r\n    status                         # 9\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b02f80c09fe94477bf5c1674bca2fc8d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "174a9509a1e04028b7e782c58cfc84f9",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "dd12ed5f22144759a88dab5a468adb40",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# B02 — SUPPORT / CONTINUITY PREFLIGHT\r\n#\r\n# IN[0] = Entire B01 output\r\n#\r\n# B01 beam report:\r\n# [0] Beam ID\r\n# [1] Ready\r\n# [2] Status\r\n# [3] Errors\r\n# [4] Warnings\r\n# [5] [Length, Width, Depth]\r\n# [6] [TopQty, BottomQty, TopDia, BottomDia]\r\n# [7] [ContinuousQty, ExtraQty,\r\n#      SupportExtraLayer, MidspanExtraLayer]\r\n# [8] [StirrupDia, Cover, EndSpacing, MidSpacing]\r\n# [9] Beam\r\n#\r\n#\r\n# OUT:\r\n# [0] Detailed reports\r\n# [1] Beams received\r\n# [2] Fully ready beams\r\n# [3] Ready count\r\n# [4] Ready IDs\r\n# [5] Failed reports\r\n# [6] Failed count\r\n# [7] Overall ready\r\n# [8] Status\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# SETTINGS\r\n# ============================================================\r\n\r\n# Maximum XY distance from beam endpoint to column bounding box.\r\nSUPPORT_TOLERANCE_MM = 600.0\r\n\r\n# Continuation beam endpoint tolerance.\r\nCONTINUITY_END_TOLERANCE_MM = 500.0\r\n\r\n# Maximum sideways offset of continuation beam.\r\nCONTINUITY_LATERAL_TOLERANCE_MM = 150.0\r\n\r\n# Parallel/alignment tolerance.\r\nCONTINUITY_ALIGNMENT = 0.98\r\n\r\n\r\n# ============================================================\r\n# BASIC HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n        return list(value)\r\n    except:\r\n        return [value]\r\n\r\n\r\ndef unwrap(element):\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef id_value(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return int(element.Id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element.Id.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\ndef internal_to_mm(value):\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef mm_to_internal(value):\r\n\r\n    return UnitUtils.ConvertToInternalUnits(\r\n        float(value),\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef xyz_to_mm(point):\r\n\r\n    if point is None:\r\n        return None\r\n\r\n    return [\r\n        internal_to_mm(point.X),\r\n        internal_to_mm(point.Y),\r\n        internal_to_mm(point.Z)\r\n    ]\r\n\r\n\r\ndef distance_mm(p1, p2):\r\n\r\n    return internal_to_mm(\r\n        p1.DistanceTo(p2)\r\n    )\r\n\r\n\r\ndef get_beam_curve(beam):\r\n\r\n    try:\r\n\r\n        location = beam.Location\r\n\r\n        if location is None:\r\n            return None\r\n\r\n        return location.Curve\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef unit_xy(vector):\r\n\r\n    try:\r\n\r\n        v = XYZ(\r\n            vector.X,\r\n            vector.Y,\r\n            0.0\r\n        )\r\n\r\n        if v.GetLength() <= 0.000001:\r\n            return None\r\n\r\n        return v.Normalize()\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# COLLECT COLUMNS\r\n# ============================================================\r\n\r\ncolumns = (\r\n    FilteredElementCollector(doc)\r\n    .OfCategory(BuiltInCategory.OST_StructuralColumns)\r\n    .WhereElementIsNotElementType()\r\n    .ToElements()\r\n)\r\n\r\n\r\n# ============================================================\r\n# COLLECT ALL BEAMS\r\n#\r\n# Used for continuity detection.\r\n# ============================================================\r\n\r\nall_framing = (\r\n    FilteredElementCollector(doc)\r\n    .OfCategory(BuiltInCategory.OST_StructuralFraming)\r\n    .WhereElementIsNotElementType()\r\n    .ToElements()\r\n)\r\n\r\n\r\nall_beams = []\r\n\r\n\r\nfor element in all_framing:\r\n\r\n    try:\r\n\r\n        if element.StructuralType == StructuralType.Beam:\r\n\r\n            all_beams.append(\r\n                element\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# POINT → BOUNDING BOX XY DISTANCE\r\n#\r\n# Returns zero when endpoint is inside the column bbox in plan.\r\n# ============================================================\r\n\r\ndef point_to_bbox_xy_distance_mm(point, bbox):\r\n\r\n    if point.X < bbox.Min.X:\r\n\r\n        dx = bbox.Min.X - point.X\r\n\r\n    elif point.X > bbox.Max.X:\r\n\r\n        dx = point.X - bbox.Max.X\r\n\r\n    else:\r\n\r\n        dx = 0.0\r\n\r\n\r\n    if point.Y < bbox.Min.Y:\r\n\r\n        dy = bbox.Min.Y - point.Y\r\n\r\n    elif point.Y > bbox.Max.Y:\r\n\r\n        dy = point.Y - bbox.Max.Y\r\n\r\n    else:\r\n\r\n        dy = 0.0\r\n\r\n\r\n    d = math.sqrt(\r\n        dx * dx\r\n        +\r\n        dy * dy\r\n    )\r\n\r\n\r\n    return internal_to_mm(\r\n        d\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COLUMN SUPPORT DETECTION\r\n#\r\n# New method:\r\n#\r\n# 1. Check every structural column.\r\n# 2. Measure beam-end XY distance to column bounding box.\r\n# 3. Pick nearest valid column.\r\n# 4. Project its bbox corners along beam axis.\r\n# 5. Derive near/far faces.\r\n#\r\n# This is much less sensitive than the old probe-line method.\r\n# ============================================================\r\n\r\ndef detect_column_support(\r\n    beam_end,\r\n    beam_direction,\r\n    is_start\r\n):\r\n\r\n    candidates = []\r\n\r\n\r\n    for column in columns:\r\n\r\n        try:\r\n\r\n            bbox = column.get_BoundingBox(\r\n                None\r\n            )\r\n\r\n            if bbox is None:\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # XY DISTANCE TO COLUMN\r\n            # =================================================\r\n\r\n            bbox_distance = (\r\n                point_to_bbox_xy_distance_mm(\r\n                    beam_end,\r\n                    bbox\r\n                )\r\n            )\r\n\r\n\r\n            if (\r\n                bbox_distance\r\n                > SUPPORT_TOLERANCE_MM\r\n            ):\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # COLUMN CENTER\r\n            # =================================================\r\n\r\n            center = XYZ(\r\n\r\n                (\r\n                    bbox.Min.X\r\n                    +\r\n                    bbox.Max.X\r\n                ) / 2.0,\r\n\r\n                (\r\n                    bbox.Min.Y\r\n                    +\r\n                    bbox.Max.Y\r\n                ) / 2.0,\r\n\r\n                beam_end.Z\r\n            )\r\n\r\n\r\n            center_distance = distance_mm(\r\n                beam_end,\r\n                center\r\n            )\r\n\r\n\r\n            candidates.append([\r\n                bbox_distance,\r\n                center_distance,\r\n                column,\r\n                bbox,\r\n                center\r\n            ])\r\n\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if len(candidates) == 0:\r\n\r\n        return None\r\n\r\n\r\n    # Prefer beam endpoint actually inside/intersecting bbox,\r\n    # then nearest column center.\r\n\r\n    candidates.sort(\r\n        key=lambda x: (\r\n            x[0],\r\n            x[1]\r\n        )\r\n    )\r\n\r\n\r\n    selected = candidates[0]\r\n\r\n    column = selected[2]\r\n    bbox = selected[3]\r\n    center = selected[4]\r\n\r\n    center_distance = selected[1]\r\n\r\n\r\n    # ========================================================\r\n    # PROJECT COLUMN BBOX CORNERS ONTO BEAM DIRECTION\r\n    # ========================================================\r\n\r\n    corners = [\r\n\r\n        XYZ(\r\n            bbox.Min.X,\r\n            bbox.Min.Y,\r\n            beam_end.Z\r\n        ),\r\n\r\n        XYZ(\r\n            bbox.Min.X,\r\n            bbox.Max.Y,\r\n            beam_end.Z\r\n        ),\r\n\r\n        XYZ(\r\n            bbox.Max.X,\r\n            bbox.Min.Y,\r\n            beam_end.Z\r\n        ),\r\n\r\n        XYZ(\r\n            bbox.Max.X,\r\n            bbox.Max.Y,\r\n            beam_end.Z\r\n        )\r\n    ]\r\n\r\n\r\n    projections = []\r\n\r\n\r\n    for corner in corners:\r\n\r\n        delta = corner.Subtract(\r\n            beam_end\r\n        )\r\n\r\n        projection = delta.DotProduct(\r\n            beam_direction\r\n        )\r\n\r\n        projections.append(\r\n            projection\r\n        )\r\n\r\n\r\n    minimum = min(\r\n        projections\r\n    )\r\n\r\n    maximum = max(\r\n        projections\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FACE ORDER\r\n    #\r\n    # START:\r\n    # beam runs toward +direction\r\n    # near face = positive/span side\r\n    # far face  = opposite side\r\n    #\r\n    # END:\r\n    # beam arrives from -direction\r\n    # near face = negative/span side\r\n    # far face  = positive/outside side\r\n    # ========================================================\r\n\r\n    if is_start:\r\n\r\n        near_offset = maximum\r\n        far_offset = minimum\r\n\r\n    else:\r\n\r\n        near_offset = minimum\r\n        far_offset = maximum\r\n\r\n\r\n    near_face = beam_end.Add(\r\n\r\n        beam_direction.Multiply(\r\n            near_offset\r\n        )\r\n    )\r\n\r\n\r\n    far_face = beam_end.Add(\r\n\r\n        beam_direction.Multiply(\r\n            far_offset\r\n        )\r\n    )\r\n\r\n\r\n    thickness_mm = abs(\r\n\r\n        internal_to_mm(\r\n            maximum - minimum\r\n        )\r\n    )\r\n\r\n\r\n    return [\r\n\r\n        column,             # 0\r\n        near_face,          # 1\r\n        far_face,           # 2\r\n        thickness_mm,       # 3\r\n        center_distance,    # 4\r\n        center              # 5\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# CONTINUATION BEAM DETECTION\r\n# ============================================================\r\n\r\ndef find_continuation_beams(\r\n    current_beam,\r\n    target_end,\r\n    current_direction\r\n):\r\n\r\n    current_id = id_value(\r\n        current_beam\r\n    )\r\n\r\n\r\n    current_dir_xy = unit_xy(\r\n        current_direction\r\n    )\r\n\r\n\r\n    if current_dir_xy is None:\r\n\r\n        return []\r\n\r\n\r\n    results = []\r\n\r\n\r\n    for candidate in all_beams:\r\n\r\n        candidate_id = id_value(\r\n            candidate\r\n        )\r\n\r\n\r\n        if candidate_id == current_id:\r\n\r\n            continue\r\n\r\n\r\n        curve = get_beam_curve(\r\n            candidate\r\n        )\r\n\r\n\r\n        if curve is None:\r\n\r\n            continue\r\n\r\n\r\n        try:\r\n\r\n            p0 = curve.GetEndPoint(\r\n                0\r\n            )\r\n\r\n            p1 = curve.GetEndPoint(\r\n                1\r\n            )\r\n\r\n        except:\r\n            continue\r\n\r\n\r\n        candidate_direction = (\r\n            p1.Subtract(\r\n                p0\r\n            )\r\n        )\r\n\r\n\r\n        candidate_dir_xy = unit_xy(\r\n            candidate_direction\r\n        )\r\n\r\n\r\n        if candidate_dir_xy is None:\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # DIRECTION ALIGNMENT\r\n        # ====================================================\r\n\r\n        alignment = abs(\r\n\r\n            current_dir_xy.DotProduct(\r\n                candidate_dir_xy\r\n            )\r\n        )\r\n\r\n\r\n        if alignment < CONTINUITY_ALIGNMENT:\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # ENDPOINT DISTANCE\r\n        # ====================================================\r\n\r\n        d0 = distance_mm(\r\n            target_end,\r\n            p0\r\n        )\r\n\r\n        d1 = distance_mm(\r\n            target_end,\r\n            p1\r\n        )\r\n\r\n\r\n        endpoint_distance = min(\r\n            d0,\r\n            d1\r\n        )\r\n\r\n\r\n        if (\r\n            endpoint_distance\r\n            >\r\n            CONTINUITY_END_TOLERANCE_MM\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        nearest = (\r\n            p0\r\n            if d0 <= d1\r\n            else p1\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # LATERAL OFFSET\r\n        # ====================================================\r\n\r\n        delta = nearest.Subtract(\r\n            target_end\r\n        )\r\n\r\n\r\n        axial_component = (\r\n            current_dir_xy.Multiply(\r\n\r\n                delta.DotProduct(\r\n                    current_dir_xy\r\n                )\r\n            )\r\n        )\r\n\r\n\r\n        lateral_component = (\r\n            delta.Subtract(\r\n                axial_component\r\n            )\r\n        )\r\n\r\n\r\n        lateral_mm = internal_to_mm(\r\n            lateral_component.GetLength()\r\n        )\r\n\r\n\r\n        if (\r\n            lateral_mm\r\n            >\r\n            CONTINUITY_LATERAL_TOLERANCE_MM\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        results.append(\r\n            candidate_id\r\n        )\r\n\r\n\r\n    return results\r\n\r\n\r\n# ============================================================\r\n# READ B01\r\n# ============================================================\r\n\r\nb01 = IN[0]\r\n\r\n\r\ntry:\r\n\r\n    b01_reports = as_list(\r\n        b01[0]\r\n    )\r\n\r\n\r\n    b01_ready = bool(\r\n        b01[7]\r\n    )\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    OUT = [\r\n\r\n        [],\r\n        0,\r\n        [],\r\n        0,\r\n        [],\r\n        [],\r\n        0,\r\n        False,\r\n\r\n        \"INVALID B01 INPUT: {}\".format(\r\n            str(ex)\r\n        )\r\n    ]\r\n\r\n    raise Exception(\r\n        \"Invalid B01 input.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PROCESS BEAMS\r\n# ============================================================\r\n\r\nreports = []\r\n\r\nready_beams = []\r\nready_ids = []\r\n\r\nfailed_reports = []\r\n\r\n\r\nfor b01_report in b01_reports:\r\n\r\n    errors = []\r\n\r\n\r\n    try:\r\n\r\n        beam_id = b01_report[0]\r\n\r\n        b01_beam_ready = bool(\r\n            b01_report[1]\r\n        )\r\n\r\n        beam = unwrap(\r\n            b01_report[9]\r\n        )\r\n\r\n\r\n    except Exception as ex:\r\n\r\n        failure = [\r\n\r\n            None,\r\n            False,\r\n            \"FAILED\",\r\n\r\n            [\r\n                \"Invalid B01 report: {}\".format(\r\n                    str(ex)\r\n                )\r\n            ],\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            False,\r\n            False,\r\n\r\n            [],\r\n            [],\r\n\r\n            None,\r\n\r\n            b01_report\r\n        ]\r\n\r\n\r\n        reports.append(\r\n            failure\r\n        )\r\n\r\n        failed_reports.append(\r\n            failure\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # B01 READY CHECK\r\n    # ========================================================\r\n\r\n    if not b01_beam_ready:\r\n\r\n        failure = [\r\n\r\n            beam_id,\r\n            False,\r\n            \"FAILED\",\r\n\r\n            [\r\n                \"Beam failed B01 preflight.\"\r\n            ],\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n\r\n            False,\r\n            False,\r\n\r\n            [],\r\n            [],\r\n\r\n            beam,\r\n\r\n            b01_report\r\n        ]\r\n\r\n\r\n        reports.append(\r\n            failure\r\n        )\r\n\r\n        failed_reports.append(\r\n            failure\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # BEAM GEOMETRY\r\n    # ========================================================\r\n\r\n    curve = get_beam_curve(\r\n        beam\r\n    )\r\n\r\n\r\n    if curve is None:\r\n\r\n        errors.append(\r\n            \"Beam LocationCurve not found.\"\r\n        )\r\n\r\n\r\n        p0 = None\r\n        p1 = None\r\n        direction = None\r\n\r\n\r\n    else:\r\n\r\n        try:\r\n\r\n            p0 = curve.GetEndPoint(\r\n                0\r\n            )\r\n\r\n            p1 = curve.GetEndPoint(\r\n                1\r\n            )\r\n\r\n\r\n            direction = (\r\n\r\n                p1.Subtract(\r\n                    p0\r\n                )\r\n                .Normalize()\r\n            )\r\n\r\n\r\n        except:\r\n\r\n            p0 = None\r\n            p1 = None\r\n            direction = None\r\n\r\n\r\n            errors.append(\r\n                \"Could not determine beam endpoints.\"\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # SUPPORTS\r\n    # ========================================================\r\n\r\n    start_support = None\r\n    end_support = None\r\n\r\n\r\n    if (\r\n        p0 is not None\r\n        and\r\n        direction is not None\r\n    ):\r\n\r\n        start_support = detect_column_support(\r\n\r\n            p0,\r\n            direction,\r\n            True\r\n        )\r\n\r\n\r\n    if (\r\n        p1 is not None\r\n        and\r\n        direction is not None\r\n    ):\r\n\r\n        end_support = detect_column_support(\r\n\r\n            p1,\r\n            direction,\r\n            False\r\n        )\r\n\r\n\r\n    if start_support is None:\r\n\r\n        errors.append(\r\n            \"Start column support not found.\"\r\n        )\r\n\r\n\r\n    if end_support is None:\r\n\r\n        errors.append(\r\n            \"End column support not found.\"\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # START DATA\r\n    # ========================================================\r\n\r\n    if start_support is not None:\r\n\r\n        start_column_id = id_value(\r\n            start_support[0]\r\n        )\r\n\r\n        start_near = xyz_to_mm(\r\n            start_support[1]\r\n        )\r\n\r\n        start_far = xyz_to_mm(\r\n            start_support[2]\r\n        )\r\n\r\n        start_thickness = (\r\n            start_support[3]\r\n        )\r\n\r\n        start_center_distance = (\r\n            start_support[4]\r\n        )\r\n\r\n\r\n    else:\r\n\r\n        start_column_id = None\r\n\r\n        start_near = None\r\n        start_far = None\r\n\r\n        start_thickness = None\r\n        start_center_distance = None\r\n\r\n\r\n    # ========================================================\r\n    # END DATA\r\n    # ========================================================\r\n\r\n    if end_support is not None:\r\n\r\n        end_column_id = id_value(\r\n            end_support[0]\r\n        )\r\n\r\n        end_near = xyz_to_mm(\r\n            end_support[1]\r\n        )\r\n\r\n        end_far = xyz_to_mm(\r\n            end_support[2]\r\n        )\r\n\r\n        end_thickness = (\r\n            end_support[3]\r\n        )\r\n\r\n        end_center_distance = (\r\n            end_support[4]\r\n        )\r\n\r\n\r\n    else:\r\n\r\n        end_column_id = None\r\n\r\n        end_near = None\r\n        end_far = None\r\n\r\n        end_thickness = None\r\n        end_center_distance = None\r\n\r\n\r\n    # ========================================================\r\n    # CONTINUITY\r\n    # ========================================================\r\n\r\n    if (\r\n        p0 is not None\r\n        and\r\n        direction is not None\r\n    ):\r\n\r\n        start_continuation_ids = (\r\n            find_continuation_beams(\r\n\r\n                beam,\r\n                p0,\r\n                direction\r\n            )\r\n        )\r\n\r\n    else:\r\n\r\n        start_continuation_ids = []\r\n\r\n\r\n    if (\r\n        p1 is not None\r\n        and\r\n        direction is not None\r\n    ):\r\n\r\n        end_continuation_ids = (\r\n            find_continuation_beams(\r\n\r\n                beam,\r\n                p1,\r\n                direction\r\n            )\r\n        )\r\n\r\n    else:\r\n\r\n        end_continuation_ids = []\r\n\r\n\r\n    start_continuous = (\r\n        len(start_continuation_ids) > 0\r\n    )\r\n\r\n\r\n    end_continuous = (\r\n        len(end_continuation_ids) > 0\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # RESULT\r\n    # ========================================================\r\n\r\n    ready = (\r\n        len(errors) == 0\r\n    )\r\n\r\n\r\n    status = (\r\n        \"READY\"\r\n        if ready\r\n        else \"FAILED\"\r\n    )\r\n\r\n\r\n    report = [\r\n\r\n        beam_id,                       # 0\r\n\r\n        ready,                         # 1\r\n        status,                        # 2\r\n\r\n        errors,                        # 3\r\n\r\n        start_column_id,               # 4\r\n        end_column_id,                 # 5\r\n\r\n        start_near,                    # 6\r\n        start_far,                     # 7\r\n\r\n        end_near,                      # 8\r\n        end_far,                       # 9\r\n\r\n        start_thickness,               # 10\r\n        end_thickness,                 # 11\r\n\r\n        start_center_distance,         # 12\r\n        end_center_distance,           # 13\r\n\r\n        start_continuous,              # 14\r\n        end_continuous,                # 15\r\n\r\n        start_continuation_ids,        # 16\r\n        end_continuation_ids,          # 17\r\n\r\n        beam,                          # 18\r\n\r\n        b01_report                     # 19\r\n    ]\r\n\r\n\r\n    reports.append(\r\n        report\r\n    )\r\n\r\n\r\n    if ready:\r\n\r\n        ready_beams.append(\r\n            beam\r\n        )\r\n\r\n        ready_ids.append(\r\n            beam_id\r\n        )\r\n\r\n\r\n    else:\r\n\r\n        failed_reports.append(\r\n            report\r\n        )\r\n\r\n\r\n# ============================================================\r\n# FINAL STATUS\r\n# ============================================================\r\n\r\noverall_ready = (\r\n\r\n    b01_ready\r\n\r\n    and\r\n\r\n    len(reports) > 0\r\n\r\n    and\r\n\r\n    len(failed_reports) == 0\r\n)\r\n\r\n\r\nif overall_ready:\r\n\r\n    final_status = (\r\n        \"B02 SUPPORT/CONTINUITY COMPLETE\"\r\n    )\r\n\r\nelse:\r\n\r\n    final_status = (\r\n        \"B02 SUPPORT/CONTINUITY FAILED\"\r\n    )\r\n\r\n\r\nOUT = [\r\n\r\n    reports,                       # 0\r\n\r\n    len(b01_reports),              # 1\r\n\r\n    ready_beams,                   # 2\r\n\r\n    len(ready_beams),              # 3\r\n\r\n    ready_ids,                     # 4\r\n\r\n    failed_reports,                # 5\r\n\r\n    len(failed_reports),           # 6\r\n\r\n    overall_ready,                 # 7\r\n\r\n    final_status                   # 8\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c79a1f964ab843c1989c2d4272e9e64c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
