    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# T04 — SCRIPT-BASED REBAR CONFIGURATION\r\n#\r\n# IN[0] = Entire T03 output\r\n#\r\n# T03:\r\n# [0] Type Name\r\n# [1] Type ID\r\n# [2] Beam Instances\r\n# [3] Beam Count\r\n# [4] Beam IDs\r\n# [5] Ready\r\n# [6] Status\r\n#\r\n# OUT:\r\n# [0] Type Name\r\n# [1] Type ID\r\n# [2] Beam Count\r\n# [3] Beam IDs\r\n# [4] TopQty\r\n# [5] BottomQty\r\n# [6] TopDia\r\n# [7] BottomDia\r\n# [8] StirrupDia\r\n# [9] Cover\r\n# [10] EndSpacing\r\n# [11] MidSpacing\r\n# [12] ContinuousQty\r\n# [13] ExtraQty\r\n# [14] Support Extra Layer\r\n# [15] Midspan Extra Layer\r\n# [16] Support Section\r\n# [17] Midspan Section\r\n# [18] Beam Instances\r\n# [19] Ready\r\n# [20] Status\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# REBAR CONFIGURATION TABLE\r\n#\r\n# Edit this table to control reinforcement.\r\n# No Revit project parameters are required.\r\n# ============================================================\r\n\r\nREBAR_CONFIG = {\r\n\r\n    \"300 x 600mm\": {\r\n        \"TopQty\": 4,\r\n        \"BottomQty\": 4,\r\n        \"TopDia\": 16,\r\n        \"BottomDia\": 16,\r\n        \"StirrupDia\": 10,\r\n        \"Cover\": 40,\r\n        \"EndSpacing\": 100,\r\n        \"MidSpacing\": 150\r\n    },\r\n\r\n    \"400 x 800mm\": {\r\n        \"TopQty\": 6,\r\n        \"BottomQty\": 4,\r\n        \"TopDia\": 20,\r\n        \"BottomDia\": 20,\r\n        \"StirrupDia\": 10,\r\n        \"Cover\": 40,\r\n        \"EndSpacing\": 100,\r\n        \"MidSpacing\": 150\r\n    }\r\n\r\n}\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\nt03 = IN[0]\r\n\r\n\r\ntry:\r\n\r\n    type_name = str(t03[0]).strip()\r\n\r\n    type_id = t03[1]\r\n\r\n    beams = list(t03[2])\r\n\r\n    beam_count = int(t03[3])\r\n\r\n    beam_ids = list(t03[4])\r\n\r\n    t03_ready = bool(t03[5])\r\n\r\nexcept:\r\n\r\n    OUT = [\r\n        None,\r\n        None,\r\n        0,\r\n        [],\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        [],\r\n        False,\r\n        \"INVALID T03 INPUT\"\r\n    ]\r\n\r\n    raise Exception(\"Invalid T03 input.\")\r\n\r\n\r\n# ============================================================\r\n# FIND CONFIGURATION\r\n# ============================================================\r\n\r\nconfig = None\r\n\r\n\r\nfor key in REBAR_CONFIG:\r\n\r\n    if str(key).strip().lower() == type_name.lower():\r\n\r\n        config = REBAR_CONFIG[key]\r\n\r\n        break\r\n\r\n\r\n# ============================================================\r\n# NO CONFIG\r\n# ============================================================\r\n\r\nif not t03_ready:\r\n\r\n    OUT = [\r\n        type_name,\r\n        type_id,\r\n        beam_count,\r\n        beam_ids,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        beams,\r\n        False,\r\n        \"T03 NOT READY\"\r\n    ]\r\n\r\n\r\nelif config is None:\r\n\r\n    OUT = [\r\n        type_name,\r\n        type_id,\r\n        beam_count,\r\n        beam_ids,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        None,\r\n        beams,\r\n        False,\r\n        \"NO REBAR CONFIGURATION FOR TYPE\"\r\n    ]\r\n\r\n\r\nelse:\r\n\r\n    # ========================================================\r\n    # READ CONFIG\r\n    # ========================================================\r\n\r\n    top_qty = int(\r\n        config[\"TopQty\"]\r\n    )\r\n\r\n    bottom_qty = int(\r\n        config[\"BottomQty\"]\r\n    )\r\n\r\n    top_dia = float(\r\n        config[\"TopDia\"]\r\n    )\r\n\r\n    bottom_dia = float(\r\n        config[\"BottomDia\"]\r\n    )\r\n\r\n    stirrup_dia = float(\r\n        config[\"StirrupDia\"]\r\n    )\r\n\r\n    cover = float(\r\n        config[\"Cover\"]\r\n    )\r\n\r\n    end_spacing = float(\r\n        config[\"EndSpacing\"]\r\n    )\r\n\r\n    mid_spacing = float(\r\n        config[\"MidSpacing\"]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # QUANTITY LOGIC\r\n    # ========================================================\r\n\r\n    continuous_qty = min(\r\n        top_qty,\r\n        bottom_qty\r\n    )\r\n\r\n    extra_qty = abs(\r\n        top_qty - bottom_qty\r\n    )\r\n\r\n\r\n    if top_qty > bottom_qty:\r\n\r\n        support_extra_layer = \"TOP\"\r\n        midspan_extra_layer = \"BOTTOM\"\r\n\r\n\r\n    elif bottom_qty > top_qty:\r\n\r\n        support_extra_layer = \"BOTTOM\"\r\n        midspan_extra_layer = \"TOP\"\r\n\r\n\r\n    else:\r\n\r\n        support_extra_layer = \"NONE\"\r\n        midspan_extra_layer = \"NONE\"\r\n\r\n\r\n    support_section = [\r\n        top_qty,\r\n        bottom_qty\r\n    ]\r\n\r\n    midspan_section = [\r\n        bottom_qty,\r\n        top_qty\r\n    ]\r\n\r\n\r\n    # ========================================================\r\n    # VALIDATION\r\n    # ========================================================\r\n\r\n    errors = []\r\n\r\n\r\n    if top_qty < 2:\r\n        errors.append(\r\n            \"TopQty must be at least 2.\"\r\n        )\r\n\r\n    if bottom_qty < 2:\r\n        errors.append(\r\n            \"BottomQty must be at least 2.\"\r\n        )\r\n\r\n    if top_dia <= 0:\r\n        errors.append(\r\n            \"TopDia must be greater than 0.\"\r\n        )\r\n\r\n    if bottom_dia <= 0:\r\n        errors.append(\r\n            \"BottomDia must be greater than 0.\"\r\n        )\r\n\r\n    if stirrup_dia <= 0:\r\n        errors.append(\r\n            \"StirrupDia must be greater than 0.\"\r\n        )\r\n\r\n    if cover <= 0:\r\n        errors.append(\r\n            \"Cover must be greater than 0.\"\r\n        )\r\n\r\n    if end_spacing <= 0:\r\n        errors.append(\r\n            \"EndSpacing must be greater than 0.\"\r\n        )\r\n\r\n    if mid_spacing <= 0:\r\n        errors.append(\r\n            \"MidSpacing must be greater than 0.\"\r\n        )\r\n\r\n\r\n    ready = (\r\n        len(errors) == 0\r\n        and\r\n        beam_count > 0\r\n    )\r\n\r\n\r\n    status = (\r\n        \"SCRIPT REBAR CONFIG READY\"\r\n        if ready\r\n        else \"SCRIPT REBAR CONFIG FAILED\"\r\n    )\r\n\r\n\r\n    OUT = [\r\n\r\n        type_name,                  # 0\r\n\r\n        type_id,                    # 1\r\n\r\n        beam_count,                 # 2\r\n\r\n        beam_ids,                   # 3\r\n\r\n        top_qty,                    # 4\r\n\r\n        bottom_qty,                 # 5\r\n\r\n        top_dia,                    # 6\r\n\r\n        bottom_dia,                 # 7\r\n\r\n        stirrup_dia,                # 8\r\n\r\n        cover,                      # 9\r\n\r\n        end_spacing,                # 10\r\n\r\n        mid_spacing,                # 11\r\n\r\n        continuous_qty,             # 12\r\n\r\n        extra_qty,                  # 13\r\n\r\n        support_extra_layer,        # 14\r\n\r\n        midspan_extra_layer,        # 15\r\n\r\n        support_section,            # 16\r\n\r\n        midspan_section,            # 17\r\n\r\n        beams,                      # 18\r\n\r\n        ready,                      # 19\r\n\r\n        status                      # 20\r\n    ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0ffe860400f54d8f8547fd2f0b1a1373",
      "NodeType": "PythonScriptNode",
      "Inputs": [
