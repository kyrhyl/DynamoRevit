    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# T03 — GET ALL BEAM INSTANCES OF SELECTED TYPE\r\n#\r\n# IN[0] = Entire T02 output\r\n#\r\n# OUT:\r\n# [0] Type Name\r\n# [1] Type ID\r\n# [2] Beam Instances\r\n# [3] Beam Count\r\n# [4] Beam IDs\r\n# [5] Ready\r\n# [6] Status\r\n# ============================================================\r\n\r\n\r\ndef id_value(element_id):\r\n\r\n    try:\r\n        return int(element_id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element_id.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\nt02 = IN[0]\r\n\r\n\r\ntry:\r\n\r\n    type_name = t02[0]\r\n    selected_type_id = int(t02[1])\r\n    selected_ready = bool(t02[4])\r\n\r\nexcept:\r\n\r\n    selected_ready = False\r\n    type_name = None\r\n    selected_type_id = None\r\n\r\n\r\nbeams = []\r\nbeam_ids = []\r\n\r\n\r\nif selected_ready:\r\n\r\n    all_framing = (\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(\r\n            BuiltInCategory.OST_StructuralFraming\r\n        )\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for element in all_framing:\r\n\r\n        try:\r\n\r\n            if (\r\n                element.StructuralType\r\n                != StructuralType.Beam\r\n            ):\r\n\r\n                continue\r\n\r\n\r\n            current_type_id = id_value(\r\n                element.GetTypeId()\r\n            )\r\n\r\n\r\n            if current_type_id != selected_type_id:\r\n                continue\r\n\r\n\r\n            beams.append(\r\n                element\r\n            )\r\n\r\n\r\n            beam_ids.append(\r\n                id_value(\r\n                    element.Id\r\n                )\r\n            )\r\n\r\n\r\n        except:\r\n            pass\r\n\r\n\r\nready = (\r\n    selected_ready\r\n    and\r\n    len(beams) > 0\r\n)\r\n\r\n\r\nif ready:\r\n\r\n    status = \"SELECTED BEAM INSTANCES READY\"\r\n\r\nelif not selected_ready:\r\n\r\n    status = \"NO VALID TYPE SELECTED\"\r\n\r\nelse:\r\n\r\n    status = \"NO BEAM INSTANCES FOUND\"\r\n\r\n\r\nOUT = [\r\n\r\n    type_name,              # 0\r\n\r\n    selected_type_id,       # 1\r\n\r\n    beams,                  # 2\r\n\r\n    len(beams),             # 3\r\n\r\n    beam_ids,               # 4\r\n\r\n    ready,                  # 5\r\n\r\n    status                  # 6\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "65c48025288543a69b99a28393e525e7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
