    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# B03 — SELECTED BEAM TYPE AUTO-REBAR GENERATOR\r\n#\r\n# IN[0] = ENTIRE B02 OUTPUT\r\n#\r\n# ------------------------------------------------------------\r\n# B02 PER-BEAM REPORT\r\n#\r\n# [0]  Beam ID\r\n# [1]  Ready\r\n# [2]  Status\r\n# [3]  Errors\r\n#\r\n# [4]  Start Column ID\r\n# [5]  End Column ID\r\n#\r\n# [6]  Start Near Face\r\n# [7]  Start Far Face\r\n#\r\n# [8]  End Near Face\r\n# [9]  End Far Face\r\n#\r\n# [10] Start Support Thickness\r\n# [11] End Support Thickness\r\n#\r\n# [12] Start Center Distance\r\n# [13] End Center Distance\r\n#\r\n# [14] Start Continuous\r\n# [15] End Continuous\r\n#\r\n# [16] Start Continuation IDs\r\n# [17] End Continuation IDs\r\n#\r\n# [18] Beam\r\n# [19] Original B01 Report\r\n#\r\n#\r\n# ------------------------------------------------------------\r\n# B01 PER-BEAM REPORT\r\n#\r\n# [0] Beam ID\r\n# [1] Ready\r\n# [2] Status\r\n# [3] Errors\r\n# [4] Warnings\r\n#\r\n# [5] [Length, Width, Depth]\r\n#\r\n# [6] [\r\n#       TopQty,\r\n#       BottomQty,\r\n#       TopDia,\r\n#       BottomDia\r\n#     ]\r\n#\r\n# [7] [\r\n#       ContinuousQty,\r\n#       ExtraQty,\r\n#       SupportExtraLayer,\r\n#       MidspanExtraLayer\r\n#     ]\r\n#\r\n# [8] [\r\n#       StirrupDia,\r\n#       Cover,\r\n#       EndSpacing,\r\n#       MidSpacing\r\n#     ]\r\n#\r\n# [9] Beam\r\n#\r\n#\r\n# ------------------------------------------------------------\r\n# REBAR QUANTITY RULE\r\n#\r\n# Example:\r\n#\r\n# SUPPORT:\r\n#\r\n# TopQty    = 6\r\n# BottomQty = 4\r\n#\r\n# ContinuousQty = 4\r\n# ExtraQty      = 2\r\n#\r\n# Support:\r\n# TOP    = 6\r\n# BOTTOM = 4\r\n#\r\n# Midspan:\r\n# TOP    = 4\r\n# BOTTOM = 6\r\n#\r\n#\r\n# If BottomQty > TopQty, the logic reverses automatically.\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n        return list(value)\r\n    except:\r\n        return [value]\r\n\r\n\r\ndef unwrap(element):\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef element_id_value(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return int(element.Id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element.Id.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# UNITS\r\n# ============================================================\r\n\r\ndef mm_to_internal(value):\r\n\r\n    return UnitUtils.ConvertToInternalUnits(\r\n        float(value),\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef internal_to_mm(value):\r\n\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef xyz_to_mm(point):\r\n\r\n    return [\r\n        internal_to_mm(point.X),\r\n        internal_to_mm(point.Y),\r\n        internal_to_mm(point.Z)\r\n    ]\r\n\r\n\r\ndef mm_to_xyz(point):\r\n\r\n    return XYZ(\r\n        mm_to_internal(point[0]),\r\n        mm_to_internal(point[1]),\r\n        mm_to_internal(point[2])\r\n    )\r\n\r\n\r\n# ============================================================\r\n# VECTOR / POINT HELPERS\r\n# ============================================================\r\n\r\ndef move_point(\r\n    point,\r\n    direction,\r\n    distance\r\n):\r\n\r\n    return [\r\n\r\n        point[0]\r\n        + direction[0] * distance,\r\n\r\n        point[1]\r\n        + direction[1] * distance,\r\n\r\n        point[2]\r\n        + direction[2] * distance\r\n    ]\r\n\r\n\r\ndef midpoint(\r\n    p1,\r\n    p2\r\n):\r\n\r\n    return [\r\n\r\n        (p1[0] + p2[0]) / 2.0,\r\n\r\n        (p1[1] + p2[1]) / 2.0,\r\n\r\n        (p1[2] + p2[2]) / 2.0\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# COMMENTS\r\n# ============================================================\r\n\r\ndef set_comments(\r\n    element,\r\n    text\r\n):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS\r\n        )\r\n\r\n        if (\r\n            p is not None\r\n            and\r\n            not p.IsReadOnly\r\n        ):\r\n\r\n            p.Set(\r\n                text\r\n            )\r\n\r\n            return\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        p = element.LookupParameter(\r\n            \"Comments\"\r\n        )\r\n\r\n        if (\r\n            p is not None\r\n            and\r\n            not p.IsReadOnly\r\n        ):\r\n\r\n            p.Set(\r\n                text\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# FIND REBAR TYPE BY DIAMETER\r\n# ============================================================\r\n\r\ndef get_bar_diameter(\r\n    bar_type\r\n):\r\n\r\n    try:\r\n        return bar_type.BarDiameter\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        p = bar_type.get_Parameter(\r\n            BuiltInParameter.REBAR_BAR_DIAMETER\r\n        )\r\n\r\n        if p is not None:\r\n            return p.AsDouble()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\ndef find_bar_type(\r\n    diameter_mm\r\n):\r\n\r\n    target = mm_to_internal(\r\n        diameter_mm\r\n    )\r\n\r\n    tolerance = mm_to_internal(\r\n        0.5\r\n    )\r\n\r\n\r\n    bar_types = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarBarType)\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for bar_type in bar_types:\r\n\r\n        diameter = get_bar_diameter(\r\n            bar_type\r\n        )\r\n\r\n        if diameter is None:\r\n            continue\r\n\r\n\r\n        if abs(\r\n            diameter - target\r\n        ) <= tolerance:\r\n\r\n            return bar_type\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# FIND 135 DEGREE HOOK\r\n# ============================================================\r\n\r\ndef find_135_hook():\r\n\r\n    target = math.radians(\r\n        135.0\r\n    )\r\n\r\n    tolerance = math.radians(\r\n        0.5\r\n    )\r\n\r\n\r\n    hook_types = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarHookType)\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for hook in hook_types:\r\n\r\n        try:\r\n\r\n            if abs(\r\n                hook.HookAngle - target\r\n            ) <= tolerance:\r\n\r\n                return hook\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\nhook_135 = find_135_hook()\r\n\r\n\r\n# ============================================================\r\n# DELETE EXISTING REBAR HOSTED BY BEAM\r\n#\r\n# IMPORTANT:\r\n# Only reinforcement hosted by the selected beam is removed.\r\n#\r\n# It does NOT clear unrelated project reinforcement.\r\n# ============================================================\r\n\r\ndef clear_hosted_rebar(\r\n    beam\r\n):\r\n\r\n    rebar_elements = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(Rebar)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    ids = []\r\n\r\n\r\n    for rebar in rebar_elements:\r\n\r\n        try:\r\n\r\n            if rebar.GetHostId() == beam.Id:\r\n\r\n                ids.append(\r\n                    rebar.Id\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    count = len(\r\n        ids\r\n    )\r\n\r\n\r\n    for rid in ids:\r\n\r\n        doc.Delete(\r\n            rid\r\n        )\r\n\r\n\r\n    return count\r\n\r\n\r\n# ============================================================\r\n# TRANSVERSE BAR POSITIONING\r\n#\r\n# Maximum support/midspan quantity defines available positions.\r\n#\r\n# Example:\r\n#\r\n# 6 / 4\r\n#\r\n# Six physical positions are generated.\r\n#\r\n# Four become continuous.\r\n# Two become extra.\r\n#\r\n# This prevents continuous and extra bars occupying\r\n# exactly the same transverse location.\r\n# ============================================================\r\n\r\ndef evenly_spaced_offsets(\r\n    quantity,\r\n    beam_width,\r\n    centerline_cover\r\n):\r\n\r\n    if quantity <= 0:\r\n\r\n        return []\r\n\r\n\r\n    usable_width = (\r\n\r\n        beam_width\r\n        - 2.0 * centerline_cover\r\n    )\r\n\r\n\r\n    if usable_width <= 0:\r\n\r\n        raise Exception(\r\n            \"No usable width remains for longitudinal reinforcement.\"\r\n        )\r\n\r\n\r\n    if quantity == 1:\r\n\r\n        return [\r\n            0.0\r\n        ]\r\n\r\n\r\n    spacing = (\r\n\r\n        usable_width\r\n        /\r\n        float(\r\n            quantity - 1\r\n        )\r\n    )\r\n\r\n\r\n    offsets = []\r\n\r\n\r\n    for i in range(\r\n        quantity\r\n    ):\r\n\r\n        offsets.append(\r\n\r\n            -usable_width / 2.0\r\n            + spacing * i\r\n        )\r\n\r\n\r\n    return offsets\r\n\r\n\r\ndef get_bar_offsets(\r\n    top_qty,\r\n    bottom_qty,\r\n    beam_width,\r\n    centerline_cover\r\n):\r\n\r\n    maximum_qty = max(\r\n        top_qty,\r\n        bottom_qty\r\n    )\r\n\r\n\r\n    continuous_qty = min(\r\n        top_qty,\r\n        bottom_qty\r\n    )\r\n\r\n\r\n    all_offsets = evenly_spaced_offsets(\r\n\r\n        maximum_qty,\r\n        beam_width,\r\n        centerline_cover\r\n    )\r\n\r\n\r\n    if maximum_qty == continuous_qty:\r\n\r\n        return (\r\n            list(all_offsets),\r\n            []\r\n        )\r\n\r\n\r\n    continuous_indices = []\r\n\r\n\r\n    # ========================================================\r\n    # ONE CONTINUOUS POSITION\r\n    # ========================================================\r\n\r\n    if continuous_qty == 1:\r\n\r\n        continuous_indices = [\r\n\r\n            int(\r\n                round(\r\n                    (\r\n                        maximum_qty - 1\r\n                    ) / 2.0\r\n                )\r\n            )\r\n        ]\r\n\r\n\r\n    # ========================================================\r\n    # DISTRIBUTE CONTINUOUS BARS ACROSS AVAILABLE POSITIONS\r\n    # ========================================================\r\n\r\n    else:\r\n\r\n        for i in range(\r\n            continuous_qty\r\n        ):\r\n\r\n            raw = (\r\n\r\n                float(i)\r\n                *\r\n                float(\r\n                    maximum_qty - 1\r\n                )\r\n                /\r\n                float(\r\n                    continuous_qty - 1\r\n                )\r\n            )\r\n\r\n\r\n            index = int(\r\n                round(raw)\r\n            )\r\n\r\n\r\n            if index not in continuous_indices:\r\n\r\n                continuous_indices.append(\r\n                    index\r\n                )\r\n\r\n\r\n    # ========================================================\r\n    # ROUNDING FALLBACK\r\n    # ========================================================\r\n\r\n    if len(\r\n        continuous_indices\r\n    ) < continuous_qty:\r\n\r\n        for i in range(\r\n            maximum_qty\r\n        ):\r\n\r\n            if i not in continuous_indices:\r\n\r\n                continuous_indices.append(\r\n                    i\r\n                )\r\n\r\n\r\n            if len(\r\n                continuous_indices\r\n            ) >= continuous_qty:\r\n\r\n                break\r\n\r\n\r\n    continuous_indices = sorted(\r\n        continuous_indices\r\n    )\r\n\r\n\r\n    continuous_offsets = []\r\n    extra_offsets = []\r\n\r\n\r\n    for i, offset in enumerate(\r\n        all_offsets\r\n    ):\r\n\r\n        if i in continuous_indices:\r\n\r\n            continuous_offsets.append(\r\n                offset\r\n            )\r\n\r\n        else:\r\n\r\n            extra_offsets.append(\r\n                offset\r\n            )\r\n\r\n\r\n    return (\r\n        continuous_offsets,\r\n        extra_offsets\r\n    )\r\n\r\n\r\n# ============================================================\r\n# STANDARD REBAR CREATION\r\n# ============================================================\r\n\r\ndef create_standard_rebar(\r\n    beam,\r\n    bar_type,\r\n    normal,\r\n    points\r\n):\r\n\r\n    curves = List[Curve]()\r\n\r\n\r\n    for i in range(\r\n        len(points) - 1\r\n    ):\r\n\r\n        p1 = mm_to_xyz(\r\n            points[i]\r\n        )\r\n\r\n        p2 = mm_to_xyz(\r\n            points[i + 1]\r\n        )\r\n\r\n\r\n        if p1.DistanceTo(p2) <= 0.000001:\r\n\r\n            continue\r\n\r\n\r\n        curves.Add(\r\n\r\n            Line.CreateBound(\r\n                p1,\r\n                p2\r\n            )\r\n        )\r\n\r\n\r\n    if curves.Count == 0:\r\n\r\n        raise Exception(\r\n            \"No valid longitudinal rebar curves.\"\r\n        )\r\n\r\n\r\n    rebar = Rebar.CreateFromCurves(\r\n\r\n        doc,\r\n\r\n        RebarStyle.Standard,\r\n\r\n        bar_type,\r\n\r\n        None,\r\n        None,\r\n\r\n        beam,\r\n\r\n        normal,\r\n\r\n        curves,\r\n\r\n        RebarHookOrientation.Left,\r\n        RebarHookOrientation.Right,\r\n\r\n        False,\r\n        True\r\n    )\r\n\r\n\r\n    if rebar is None:\r\n\r\n        raise Exception(\r\n            \"Revit failed to create longitudinal reinforcement.\"\r\n        )\r\n\r\n\r\n    return rebar\r\n\r\n\r\n# ============================================================\r\n# CONTINUOUS BAR GEOMETRY\r\n#\r\n# Exterior support:\r\n#\r\n# TOP    = vertical leg downward\r\n# BOTTOM = vertical leg upward\r\n#\r\n# Leg = 12db\r\n#\r\n# Continuous support:\r\n# no vertical hook.\r\n# ============================================================\r\n\r\ndef continuous_bar_points(\r\n    start_axis,\r\n    end_axis,\r\n    transverse_offset,\r\n    elevation,\r\n    local_y,\r\n    is_top,\r\n    start_hook,\r\n    end_hook,\r\n    hook_leg\r\n):\r\n\r\n    start = [\r\n\r\n        start_axis[0]\r\n        + local_y[0] * transverse_offset,\r\n\r\n        start_axis[1]\r\n        + local_y[1] * transverse_offset,\r\n\r\n        elevation\r\n    ]\r\n\r\n\r\n    end = [\r\n\r\n        end_axis[0]\r\n        + local_y[0] * transverse_offset,\r\n\r\n        end_axis[1]\r\n        + local_y[1] * transverse_offset,\r\n\r\n        elevation\r\n    ]\r\n\r\n\r\n    points = []\r\n\r\n\r\n    # ========================================================\r\n    # START HOOK\r\n    # ========================================================\r\n\r\n    if start_hook:\r\n\r\n        if is_top:\r\n\r\n            hook_point = [\r\n\r\n                start[0],\r\n                start[1],\r\n\r\n                start[2]\r\n                - hook_leg\r\n            ]\r\n\r\n        else:\r\n\r\n            hook_point = [\r\n\r\n                start[0],\r\n                start[1],\r\n\r\n                start[2]\r\n                + hook_leg\r\n            ]\r\n\r\n\r\n        points.append(\r\n            hook_point\r\n        )\r\n\r\n\r\n    points.append(\r\n        start\r\n    )\r\n\r\n\r\n    points.append(\r\n        end\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # END HOOK\r\n    # ========================================================\r\n\r\n    if end_hook:\r\n\r\n        if is_top:\r\n\r\n            hook_point = [\r\n\r\n                end[0],\r\n                end[1],\r\n\r\n                end[2]\r\n                - hook_leg\r\n            ]\r\n\r\n        else:\r\n\r\n            hook_point = [\r\n\r\n                end[0],\r\n                end[1],\r\n\r\n                end[2]\r\n                + hook_leg\r\n            ]\r\n\r\n\r\n        points.append(\r\n            hook_point\r\n        )\r\n\r\n\r\n    return points\r\n\r\n\r\n# ============================================================\r\n# SUPPORT EXTRA BAR\r\n#\r\n# START:\r\n#\r\n# support anchor → L/4\r\n#\r\n# END:\r\n#\r\n# 3L/4 → support anchor\r\n#\r\n# Exterior support gets 12db bend.\r\n# Continuous support terminates at support centerline.\r\n# ============================================================\r\n\r\ndef support_extra_points(\r\n    support_anchor,\r\n    cutoff,\r\n    transverse_offset,\r\n    elevation,\r\n    local_y,\r\n    is_top,\r\n    hook_required,\r\n    hook_leg,\r\n    is_start\r\n):\r\n\r\n    anchor = [\r\n\r\n        support_anchor[0]\r\n        + local_y[0] * transverse_offset,\r\n\r\n        support_anchor[1]\r\n        + local_y[1] * transverse_offset,\r\n\r\n        elevation\r\n    ]\r\n\r\n\r\n    cutoff_point = [\r\n\r\n        cutoff[0]\r\n        + local_y[0] * transverse_offset,\r\n\r\n        cutoff[1]\r\n        + local_y[1] * transverse_offset,\r\n\r\n        elevation\r\n    ]\r\n\r\n\r\n    if is_top:\r\n\r\n        hook_point = [\r\n\r\n            anchor[0],\r\n            anchor[1],\r\n\r\n            anchor[2]\r\n            - hook_leg\r\n        ]\r\n\r\n    else:\r\n\r\n        hook_point = [\r\n\r\n            anchor[0],\r\n            anchor[1],\r\n\r\n            anchor[2]\r\n            + hook_leg\r\n        ]\r\n\r\n\r\n    if is_start:\r\n\r\n        if hook_required:\r\n\r\n            return [\r\n                hook_point,\r\n                anchor,\r\n                cutoff_point\r\n            ]\r\n\r\n        else:\r\n\r\n            return [\r\n                anchor,\r\n                cutoff_point\r\n            ]\r\n\r\n\r\n    else:\r\n\r\n        if hook_required:\r\n\r\n            return [\r\n                cutoff_point,\r\n                anchor,\r\n                hook_point\r\n            ]\r\n\r\n        else:\r\n\r\n            return [\r\n                cutoff_point,\r\n                anchor\r\n            ]\r\n\r\n\r\n# ============================================================\r\n# MIDSPAN EXTRA BAR\r\n#\r\n# L/4 → 3L/4\r\n# ============================================================\r\n\r\ndef midspan_extra_points(\r\n    quarter,\r\n    three_quarter,\r\n    transverse_offset,\r\n    elevation,\r\n    local_y\r\n):\r\n\r\n    return [\r\n\r\n        [\r\n            quarter[0]\r\n            + local_y[0] * transverse_offset,\r\n\r\n            quarter[1]\r\n            + local_y[1] * transverse_offset,\r\n\r\n            elevation\r\n        ],\r\n\r\n        [\r\n            three_quarter[0]\r\n            + local_y[0] * transverse_offset,\r\n\r\n            three_quarter[1]\r\n            + local_y[1] * transverse_offset,\r\n\r\n            elevation\r\n        ]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# STIRRUP CURVES\r\n# ============================================================\r\n\r\ndef stirrup_curve_list(\r\n    points\r\n):\r\n\r\n    curves = List[Curve]()\r\n\r\n\r\n    for i in range(\r\n        len(points) - 1\r\n    ):\r\n\r\n        curves.Add(\r\n\r\n            Line.CreateBound(\r\n\r\n                mm_to_xyz(\r\n                    points[i]\r\n                ),\r\n\r\n                mm_to_xyz(\r\n                    points[i + 1]\r\n                )\r\n            )\r\n        )\r\n\r\n\r\n    return curves\r\n\r\n\r\n# ============================================================\r\n# CREATE STIRRUP ZONE\r\n# ============================================================\r\n\r\ndef create_stirrup_zone(\r\n    beam,\r\n    stirrup_type,\r\n    beam_direction_xyz,\r\n    beam_direction,\r\n    base_shape,\r\n    base_location,\r\n    zone_start,\r\n    zone_length,\r\n    spacing,\r\n    tag\r\n):\r\n\r\n    if zone_length <= 0:\r\n\r\n        return None\r\n\r\n\r\n    shift = (\r\n\r\n        zone_start\r\n        - base_location\r\n    )\r\n\r\n\r\n    moved_shape = []\r\n\r\n\r\n    for point in base_shape:\r\n\r\n        moved_shape.append([\r\n\r\n            point[0]\r\n            + beam_direction[0] * shift,\r\n\r\n            point[1]\r\n            + beam_direction[1] * shift,\r\n\r\n            point[2]\r\n            + beam_direction[2] * shift\r\n        ])\r\n\r\n\r\n    curves = stirrup_curve_list(\r\n        moved_shape\r\n    )\r\n\r\n\r\n    rebar = Rebar.CreateFromCurves(\r\n\r\n        doc,\r\n\r\n        RebarStyle.StirrupTie,\r\n\r\n        stirrup_type,\r\n\r\n        hook_135,\r\n        hook_135,\r\n\r\n        beam,\r\n\r\n        beam_direction_xyz,\r\n\r\n        curves,\r\n\r\n        RebarHookOrientation.Left,\r\n        RebarHookOrientation.Right,\r\n\r\n        True,\r\n        True\r\n    )\r\n\r\n\r\n    if rebar is None:\r\n\r\n        raise Exception(\r\n            \"Revit failed to create stirrup reinforcement.\"\r\n        )\r\n\r\n\r\n    accessor = (\r\n        rebar.GetShapeDrivenAccessor()\r\n    )\r\n\r\n\r\n    accessor.SetLayoutAsMaximumSpacing(\r\n\r\n        mm_to_internal(\r\n            spacing\r\n        ),\r\n\r\n        mm_to_internal(\r\n            zone_length\r\n        ),\r\n\r\n        True,\r\n        True,\r\n        True\r\n    )\r\n\r\n\r\n    set_comments(\r\n        rebar,\r\n        tag\r\n    )\r\n\r\n\r\n    return rebar\r\n\r\n\r\n# ============================================================\r\n# PROCESS ONE BEAM\r\n# ============================================================\r\n\r\ndef process_beam(\r\n    b02_report\r\n):\r\n\r\n    # ========================================================\r\n    # B02 DATA\r\n    # ========================================================\r\n\r\n    beam_id = b02_report[0]\r\n\r\n\r\n    beam = unwrap(\r\n        b02_report[18]\r\n    )\r\n\r\n\r\n    b01_report = b02_report[19]\r\n\r\n\r\n    # ========================================================\r\n    # CONFIG FROM B01\r\n    # ========================================================\r\n\r\n    length_mm = float(\r\n        b01_report[5][0]\r\n    )\r\n\r\n    beam_width = float(\r\n        b01_report[5][1]\r\n    )\r\n\r\n    beam_depth = float(\r\n        b01_report[5][2]\r\n    )\r\n\r\n\r\n    top_qty = int(\r\n        b01_report[6][0]\r\n    )\r\n\r\n    bottom_qty = int(\r\n        b01_report[6][1]\r\n    )\r\n\r\n    top_dia = float(\r\n        b01_report[6][2]\r\n    )\r\n\r\n    bottom_dia = float(\r\n        b01_report[6][3]\r\n    )\r\n\r\n\r\n    continuous_qty = int(\r\n        b01_report[7][0]\r\n    )\r\n\r\n    extra_qty = int(\r\n        b01_report[7][1]\r\n    )\r\n\r\n    support_extra_layer = str(\r\n        b01_report[7][2]\r\n    )\r\n\r\n    midspan_extra_layer = str(\r\n        b01_report[7][3]\r\n    )\r\n\r\n\r\n    stirrup_dia = float(\r\n        b01_report[8][0]\r\n    )\r\n\r\n    cover = float(\r\n        b01_report[8][1]\r\n    )\r\n\r\n    end_spacing = float(\r\n        b01_report[8][2]\r\n    )\r\n\r\n    mid_spacing = float(\r\n        b01_report[8][3]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # B02 SUPPORT INFORMATION\r\n    # ========================================================\r\n\r\n    start_near = b02_report[6]\r\n    start_far = b02_report[7]\r\n\r\n    end_near = b02_report[8]\r\n    end_far = b02_report[9]\r\n\r\n\r\n    start_continuous = bool(\r\n        b02_report[14]\r\n    )\r\n\r\n    end_continuous = bool(\r\n        b02_report[15]\r\n    )\r\n\r\n\r\n    start_hook_required = (\r\n        not start_continuous\r\n    )\r\n\r\n    end_hook_required = (\r\n        not end_continuous\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # VALIDATION\r\n    # ========================================================\r\n\r\n    if beam is None:\r\n\r\n        raise Exception(\r\n            \"Beam could not be resolved.\"\r\n        )\r\n\r\n\r\n    if start_near is None or start_far is None:\r\n\r\n        raise Exception(\r\n            \"Start support geometry is invalid.\"\r\n        )\r\n\r\n\r\n    if end_near is None or end_far is None:\r\n\r\n        raise Exception(\r\n            \"End support geometry is invalid.\"\r\n        )\r\n\r\n\r\n    if top_qty < 2:\r\n\r\n        raise Exception(\r\n            \"TopQty must be at least 2.\"\r\n        )\r\n\r\n\r\n    if bottom_qty < 2:\r\n\r\n        raise Exception(\r\n            \"BottomQty must be at least 2.\"\r\n        )\r\n\r\n\r\n    if abs(\r\n        top_dia - bottom_dia\r\n    ) > 0.5:\r\n\r\n        raise Exception(\r\n            \"Current B03 requires TopDia and BottomDia to match.\"\r\n        )\r\n\r\n\r\n    if hook_135 is None:\r\n\r\n        raise Exception(\r\n            \"No 135 degree RebarHookType found.\"\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # BAR TYPES\r\n    # ========================================================\r\n\r\n    main_dia = top_dia\r\n\r\n\r\n    main_type = find_bar_type(\r\n        main_dia\r\n    )\r\n\r\n\r\n    stirrup_type = find_bar_type(\r\n        stirrup_dia\r\n    )\r\n\r\n\r\n    if main_type is None:\r\n\r\n        raise Exception(\r\n\r\n            \"No RebarBarType found for {:.0f}mm.\"\r\n            .format(\r\n                main_dia\r\n            )\r\n        )\r\n\r\n\r\n    if stirrup_type is None:\r\n\r\n        raise Exception(\r\n\r\n            \"No RebarBarType found for {:.0f}mm stirrup.\"\r\n            .format(\r\n                stirrup_dia\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # BEAM GEOMETRY\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        curve = beam.Location.Curve\r\n\r\n    except:\r\n\r\n        curve = None\r\n\r\n\r\n    if curve is None:\r\n\r\n        raise Exception(\r\n            \"Beam has no LocationCurve.\"\r\n        )\r\n\r\n\r\n    start_xyz = curve.GetEndPoint(\r\n        0\r\n    )\r\n\r\n    end_xyz = curve.GetEndPoint(\r\n        1\r\n    )\r\n\r\n\r\n    beam_start = xyz_to_mm(\r\n        start_xyz\r\n    )\r\n\r\n\r\n    direction_xyz = (\r\n        end_xyz\r\n        .Subtract(\r\n            start_xyz\r\n        )\r\n        .Normalize()\r\n    )\r\n\r\n\r\n    local_x = [\r\n\r\n        direction_xyz.X,\r\n        direction_xyz.Y,\r\n        direction_xyz.Z\r\n    ]\r\n\r\n\r\n    global_z = XYZ(\r\n        0.0,\r\n        0.0,\r\n        1.0\r\n    )\r\n\r\n\r\n    local_y_xyz = (\r\n        global_z.CrossProduct(\r\n            direction_xyz\r\n        )\r\n    )\r\n\r\n\r\n    if local_y_xyz.GetLength() <= 0.000001:\r\n\r\n        raise Exception(\r\n            \"Could not determine beam transverse direction.\"\r\n        )\r\n\r\n\r\n    local_y_xyz = (\r\n        local_y_xyz.Normalize()\r\n    )\r\n\r\n\r\n    local_y = [\r\n\r\n        local_y_xyz.X,\r\n        local_y_xyz.Y,\r\n        local_y_xyz.Z\r\n    ]\r\n\r\n\r\n    # ========================================================\r\n    # COVER / BAR CENTERLINES\r\n    # ========================================================\r\n\r\n    longitudinal_center_cover = (\r\n\r\n        cover\r\n        + stirrup_dia\r\n        + main_dia / 2.0\r\n    )\r\n\r\n\r\n    stirrup_center_cover = (\r\n\r\n        cover\r\n        + stirrup_dia / 2.0\r\n    )\r\n\r\n\r\n    far_side_clearance = (\r\n\r\n        cover\r\n        + main_dia / 2.0\r\n    )\r\n\r\n\r\n    hook_leg = (\r\n\r\n        12.0\r\n        * main_dia\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # MAIN BAR ELEVATIONS\r\n    #\r\n    # Beam location is assumed at top reference,\r\n    # consistent with the previous working generator.\r\n    # ========================================================\r\n\r\n    top_z = (\r\n\r\n        beam_start[2]\r\n        - longitudinal_center_cover\r\n    )\r\n\r\n\r\n    bottom_z = (\r\n\r\n        beam_start[2]\r\n        - beam_depth\r\n        + longitudinal_center_cover\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # SUPPORT MAIN BAR AXES\r\n    # ========================================================\r\n\r\n    if start_hook_required:\r\n\r\n        start_main_axis = move_point(\r\n\r\n            start_far,\r\n\r\n            local_x,\r\n\r\n            far_side_clearance\r\n        )\r\n\r\n    else:\r\n\r\n        start_main_axis = list(\r\n            start_far\r\n        )\r\n\r\n\r\n    if end_hook_required:\r\n\r\n        end_main_axis = move_point(\r\n\r\n            end_far,\r\n\r\n            local_x,\r\n\r\n            -far_side_clearance\r\n        )\r\n\r\n    else:\r\n\r\n        end_main_axis = list(\r\n            end_far\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # COLUMN CENTERS\r\n    # ========================================================\r\n\r\n    start_column_center = midpoint(\r\n\r\n        start_near,\r\n        start_far\r\n    )\r\n\r\n\r\n    end_column_center = midpoint(\r\n\r\n        end_near,\r\n        end_far\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # SUPPORT EXTRA ANCHORS\r\n    # ========================================================\r\n\r\n    if start_continuous:\r\n\r\n        start_extra_anchor = (\r\n            start_column_center\r\n        )\r\n\r\n    else:\r\n\r\n        start_extra_anchor = (\r\n            start_main_axis\r\n        )\r\n\r\n\r\n    if end_continuous:\r\n\r\n        end_extra_anchor = (\r\n            end_column_center\r\n        )\r\n\r\n    else:\r\n\r\n        end_extra_anchor = (\r\n            end_main_axis\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # L/4 LOCATIONS\r\n    # ========================================================\r\n\r\n    quarter_point = move_point(\r\n\r\n        beam_start,\r\n\r\n        local_x,\r\n\r\n        length_mm / 4.0\r\n    )\r\n\r\n\r\n    three_quarter_point = move_point(\r\n\r\n        beam_start,\r\n\r\n        local_x,\r\n\r\n        length_mm * 0.75\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # BAR POSITIONS\r\n    # ========================================================\r\n\r\n    (\r\n        continuous_offsets,\r\n        extra_offsets\r\n    ) = get_bar_offsets(\r\n\r\n        top_qty,\r\n        bottom_qty,\r\n\r\n        beam_width,\r\n        longitudinal_center_cover\r\n    )\r\n\r\n\r\n    if len(\r\n        continuous_offsets\r\n    ) != continuous_qty:\r\n\r\n        raise Exception(\r\n            \"Continuous bar offset count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        extra_offsets\r\n    ) != extra_qty:\r\n\r\n        raise Exception(\r\n            \"Extra bar offset count mismatch.\"\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # VALIDATION COMPLETE\r\n    #\r\n    # Now it is safe to delete existing hosted rebar.\r\n    # ========================================================\r\n\r\n    deleted_count = clear_hosted_rebar(\r\n        beam\r\n    )\r\n\r\n\r\n    tag_prefix = (\r\n\r\n        \"AUTO_BEAM_REBAR:\"\r\n        + str(\r\n            beam_id\r\n        )\r\n        + \":\"\r\n    )\r\n\r\n\r\n    created_top_cont = []\r\n\r\n    created_bottom_cont = []\r\n\r\n    created_start_extra = []\r\n\r\n    created_end_extra = []\r\n\r\n    created_mid_extra = []\r\n\r\n    created_stirrups = []\r\n\r\n\r\n    # ========================================================\r\n    # CONTINUOUS TOP\r\n    # ========================================================\r\n\r\n    for offset in continuous_offsets:\r\n\r\n        points = continuous_bar_points(\r\n\r\n            start_main_axis,\r\n            end_main_axis,\r\n\r\n            offset,\r\n\r\n            top_z,\r\n\r\n            local_y,\r\n\r\n            True,\r\n\r\n            start_hook_required,\r\n            end_hook_required,\r\n\r\n            hook_leg\r\n        )\r\n\r\n\r\n        rebar = create_standard_rebar(\r\n\r\n            beam,\r\n            main_type,\r\n            local_y_xyz,\r\n            points\r\n        )\r\n\r\n\r\n        set_comments(\r\n\r\n            rebar,\r\n\r\n            tag_prefix\r\n            + \"TOP_CONT\"\r\n        )\r\n\r\n\r\n        created_top_cont.append(\r\n            rebar\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # CONTINUOUS BOTTOM\r\n    # ========================================================\r\n\r\n    for offset in continuous_offsets:\r\n\r\n        points = continuous_bar_points(\r\n\r\n            start_main_axis,\r\n            end_main_axis,\r\n\r\n            offset,\r\n\r\n            bottom_z,\r\n\r\n            local_y,\r\n\r\n            False,\r\n\r\n            start_hook_required,\r\n            end_hook_required,\r\n\r\n            hook_leg\r\n        )\r\n\r\n\r\n        rebar = create_standard_rebar(\r\n\r\n            beam,\r\n            main_type,\r\n            local_y_xyz,\r\n            points\r\n        )\r\n\r\n\r\n        set_comments(\r\n\r\n            rebar,\r\n\r\n            tag_prefix\r\n            + \"BOTTOM_CONT\"\r\n        )\r\n\r\n\r\n        created_bottom_cont.append(\r\n            rebar\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # SUPPORT EXTRAS\r\n    # ========================================================\r\n\r\n    if extra_qty > 0:\r\n\r\n        support_is_top = (\r\n\r\n            support_extra_layer.upper()\r\n            == \"TOP\"\r\n        )\r\n\r\n\r\n        support_z = (\r\n\r\n            top_z\r\n            if support_is_top\r\n            else bottom_z\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # START SUPPORT\r\n        # ====================================================\r\n\r\n        for offset in extra_offsets:\r\n\r\n            points = support_extra_points(\r\n\r\n                start_extra_anchor,\r\n\r\n                quarter_point,\r\n\r\n                offset,\r\n\r\n                support_z,\r\n\r\n                local_y,\r\n\r\n                support_is_top,\r\n\r\n                start_hook_required,\r\n\r\n                hook_leg,\r\n\r\n                True\r\n            )\r\n\r\n\r\n            rebar = create_standard_rebar(\r\n\r\n                beam,\r\n                main_type,\r\n                local_y_xyz,\r\n                points\r\n            )\r\n\r\n\r\n            set_comments(\r\n\r\n                rebar,\r\n\r\n                tag_prefix\r\n                + support_extra_layer\r\n                + \"_EXTRA_START\"\r\n            )\r\n\r\n\r\n            created_start_extra.append(\r\n                rebar\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # END SUPPORT\r\n        # ====================================================\r\n\r\n        for offset in extra_offsets:\r\n\r\n            points = support_extra_points(\r\n\r\n                end_extra_anchor,\r\n\r\n                three_quarter_point,\r\n\r\n                offset,\r\n\r\n                support_z,\r\n\r\n                local_y,\r\n\r\n                support_is_top,\r\n\r\n                end_hook_required,\r\n\r\n                hook_leg,\r\n\r\n                False\r\n            )\r\n\r\n\r\n            rebar = create_standard_rebar(\r\n\r\n                beam,\r\n                main_type,\r\n                local_y_xyz,\r\n                points\r\n            )\r\n\r\n\r\n            set_comments(\r\n\r\n                rebar,\r\n\r\n                tag_prefix\r\n                + support_extra_layer\r\n                + \"_EXTRA_END\"\r\n            )\r\n\r\n\r\n            created_end_extra.append(\r\n                rebar\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # MIDSPAN EXTRAS\r\n    # ========================================================\r\n\r\n    if extra_qty > 0:\r\n\r\n        midspan_is_top = (\r\n\r\n            midspan_extra_layer.upper()\r\n            == \"TOP\"\r\n        )\r\n\r\n\r\n        midspan_z = (\r\n\r\n            top_z\r\n            if midspan_is_top\r\n            else bottom_z\r\n        )\r\n\r\n\r\n        for offset in extra_offsets:\r\n\r\n            points = midspan_extra_points(\r\n\r\n                quarter_point,\r\n                three_quarter_point,\r\n\r\n                offset,\r\n\r\n                midspan_z,\r\n\r\n                local_y\r\n            )\r\n\r\n\r\n            rebar = create_standard_rebar(\r\n\r\n                beam,\r\n                main_type,\r\n                local_y_xyz,\r\n                points\r\n            )\r\n\r\n\r\n            set_comments(\r\n\r\n                rebar,\r\n\r\n                tag_prefix\r\n                + midspan_extra_layer\r\n                + \"_EXTRA_MID\"\r\n            )\r\n\r\n\r\n            created_mid_extra.append(\r\n                rebar\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # STIRRUP GEOMETRY\r\n    # ========================================================\r\n\r\n    end_clearance = (\r\n\r\n        cover\r\n        + stirrup_dia / 2.0\r\n    )\r\n\r\n\r\n    usable_length = (\r\n\r\n        length_mm\r\n        - 2.0 * end_clearance\r\n    )\r\n\r\n\r\n    if usable_length <= 0:\r\n\r\n        raise Exception(\r\n            \"Invalid stirrup usable length.\"\r\n        )\r\n\r\n\r\n    # End confinement zone = 2h\r\n    end_zone = (\r\n\r\n        2.0\r\n        * beam_depth\r\n    )\r\n\r\n\r\n    maximum_end_zone = (\r\n\r\n        usable_length / 2.0\r\n    )\r\n\r\n\r\n    left_zone_length = min(\r\n\r\n        end_zone,\r\n        maximum_end_zone\r\n    )\r\n\r\n\r\n    right_zone_length = min(\r\n\r\n        end_zone,\r\n        maximum_end_zone\r\n    )\r\n\r\n\r\n    middle_zone_length = (\r\n\r\n        usable_length\r\n        - left_zone_length\r\n        - right_zone_length\r\n    )\r\n\r\n\r\n    if middle_zone_length < 0:\r\n\r\n        middle_zone_length = 0.0\r\n\r\n\r\n    left_zone_start = (\r\n        end_clearance\r\n    )\r\n\r\n\r\n    middle_zone_start = (\r\n\r\n        left_zone_start\r\n        + left_zone_length\r\n    )\r\n\r\n\r\n    right_zone_start = (\r\n\r\n        middle_zone_start\r\n        + middle_zone_length\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FIRST STIRRUP AXIS\r\n    # ========================================================\r\n\r\n    first_stirrup_axis = move_point(\r\n\r\n        beam_start,\r\n\r\n        local_x,\r\n\r\n        end_clearance\r\n    )\r\n\r\n\r\n    half_stirrup_width = (\r\n\r\n        beam_width / 2.0\r\n        - stirrup_center_cover\r\n    )\r\n\r\n\r\n    left_side = move_point(\r\n\r\n        first_stirrup_axis,\r\n\r\n        local_y,\r\n\r\n        -half_stirrup_width\r\n    )\r\n\r\n\r\n    right_side = move_point(\r\n\r\n        first_stirrup_axis,\r\n\r\n        local_y,\r\n\r\n        half_stirrup_width\r\n    )\r\n\r\n\r\n    stirrup_top_z = (\r\n\r\n        beam_start[2]\r\n        - stirrup_center_cover\r\n    )\r\n\r\n\r\n    stirrup_bottom_z = (\r\n\r\n        beam_start[2]\r\n        - beam_depth\r\n        + stirrup_center_cover\r\n    )\r\n\r\n\r\n    p1 = [\r\n\r\n        left_side[0],\r\n        left_side[1],\r\n        stirrup_bottom_z\r\n    ]\r\n\r\n\r\n    p2 = [\r\n\r\n        right_side[0],\r\n        right_side[1],\r\n        stirrup_bottom_z\r\n    ]\r\n\r\n\r\n    p3 = [\r\n\r\n        right_side[0],\r\n        right_side[1],\r\n        stirrup_top_z\r\n    ]\r\n\r\n\r\n    p4 = [\r\n\r\n        left_side[0],\r\n        left_side[1],\r\n        stirrup_top_z\r\n    ]\r\n\r\n\r\n    base_stirrup_shape = [\r\n\r\n        p1,\r\n        p2,\r\n        p3,\r\n        p4,\r\n        p1\r\n    ]\r\n\r\n\r\n    # ========================================================\r\n    # LEFT STIRRUP ZONE\r\n    # ========================================================\r\n\r\n    left_set = create_stirrup_zone(\r\n\r\n        beam,\r\n        stirrup_type,\r\n\r\n        direction_xyz,\r\n        local_x,\r\n\r\n        base_stirrup_shape,\r\n\r\n        end_clearance,\r\n\r\n        left_zone_start,\r\n        left_zone_length,\r\n\r\n        end_spacing,\r\n\r\n        tag_prefix\r\n        + \"STIRRUP_LEFT\"\r\n    )\r\n\r\n\r\n    if left_set is not None:\r\n\r\n        created_stirrups.append(\r\n            left_set\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # MIDDLE STIRRUP ZONE\r\n    # ========================================================\r\n\r\n    if middle_zone_length > 0:\r\n\r\n        middle_set = create_stirrup_zone(\r\n\r\n            beam,\r\n            stirrup_type,\r\n\r\n            direction_xyz,\r\n            local_x,\r\n\r\n            base_stirrup_shape,\r\n\r\n            end_clearance,\r\n\r\n            middle_zone_start,\r\n            middle_zone_length,\r\n\r\n            mid_spacing,\r\n\r\n            tag_prefix\r\n            + \"STIRRUP_MID\"\r\n        )\r\n\r\n\r\n        if middle_set is not None:\r\n\r\n            created_stirrups.append(\r\n                middle_set\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # RIGHT STIRRUP ZONE\r\n    # ========================================================\r\n\r\n    right_set = create_stirrup_zone(\r\n\r\n        beam,\r\n        stirrup_type,\r\n\r\n        direction_xyz,\r\n        local_x,\r\n\r\n        base_stirrup_shape,\r\n\r\n        end_clearance,\r\n\r\n        right_zone_start,\r\n        right_zone_length,\r\n\r\n        end_spacing,\r\n\r\n        tag_prefix\r\n        + \"STIRRUP_RIGHT\"\r\n    )\r\n\r\n\r\n    if right_set is not None:\r\n\r\n        created_stirrups.append(\r\n            right_set\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # CREATION VALIDATION\r\n    # ========================================================\r\n\r\n    if len(\r\n        created_top_cont\r\n    ) != continuous_qty:\r\n\r\n        raise Exception(\r\n\r\n            \"Top continuous count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        created_bottom_cont\r\n    ) != continuous_qty:\r\n\r\n        raise Exception(\r\n\r\n            \"Bottom continuous count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        created_start_extra\r\n    ) != extra_qty:\r\n\r\n        raise Exception(\r\n\r\n            \"Start extra count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        created_end_extra\r\n    ) != extra_qty:\r\n\r\n        raise Exception(\r\n\r\n            \"End extra count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        created_mid_extra\r\n    ) != extra_qty:\r\n\r\n        raise Exception(\r\n\r\n            \"Midspan extra count mismatch.\"\r\n        )\r\n\r\n\r\n    if len(\r\n        created_stirrups\r\n    ) < 2:\r\n\r\n        raise Exception(\r\n\r\n            \"Stirrup zones were not created correctly.\"\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # RESULTING CROSS SECTIONS\r\n    # ========================================================\r\n\r\n    support_section = [\r\n\r\n        top_qty,\r\n        bottom_qty\r\n    ]\r\n\r\n\r\n    midspan_section = [\r\n\r\n        bottom_qty,\r\n        top_qty\r\n    ]\r\n\r\n\r\n    # ========================================================\r\n    # SUCCESS REPORT\r\n    # ========================================================\r\n\r\n    return [\r\n\r\n        beam_id,                       # 0\r\n\r\n        True,                          # 1\r\n\r\n        \"SUCCESS\",                     # 2\r\n\r\n        deleted_count,                 # 3\r\n\r\n        len(\r\n            created_top_cont\r\n        ),                              # 4\r\n\r\n        len(\r\n            created_bottom_cont\r\n        ),                              # 5\r\n\r\n        len(\r\n            created_start_extra\r\n        ),                              # 6\r\n\r\n        len(\r\n            created_end_extra\r\n        ),                              # 7\r\n\r\n        len(\r\n            created_mid_extra\r\n        ),                              # 8\r\n\r\n        len(\r\n            created_stirrups\r\n        ),                              # 9\r\n\r\n        start_continuous,              # 10\r\n        end_continuous,                # 11\r\n\r\n        start_hook_required,           # 12\r\n        end_hook_required,             # 13\r\n\r\n        main_dia,                      # 14\r\n\r\n        stirrup_dia,                   # 15\r\n\r\n        top_qty,                       # 16\r\n\r\n        bottom_qty,                    # 17\r\n\r\n        continuous_qty,                # 18\r\n\r\n        extra_qty,                     # 19\r\n\r\n        support_extra_layer,           # 20\r\n\r\n        midspan_extra_layer,           # 21\r\n\r\n        support_section,               # 22\r\n\r\n        midspan_section,               # 23\r\n\r\n        [\r\n            left_zone_length,\r\n            middle_zone_length,\r\n            right_zone_length\r\n        ],                              # 24\r\n\r\n        [\r\n            end_spacing,\r\n            mid_spacing,\r\n            end_spacing\r\n        ],                              # 25\r\n\r\n        continuous_offsets,            # 26\r\n\r\n        extra_offsets                  # 27\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# READ B02\r\n# ============================================================\r\n\r\nb02 = IN[0]\r\n\r\n\r\ntry:\r\n\r\n    b02_reports = as_list(\r\n        b02[0]\r\n    )\r\n\r\n    b02_ready = bool(\r\n        b02[7]\r\n    )\r\n\r\n    b02_error = None\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    b02_reports = []\r\n\r\n    b02_ready = False\r\n\r\n    b02_error = str(\r\n        ex\r\n    )\r\n\r\n\r\n# ============================================================\r\n# INVALID INPUT\r\n# ============================================================\r\n\r\nif b02_error is not None:\r\n\r\n    OUT = [\r\n\r\n        False,                         # 0\r\n\r\n        \"INVALID B02 INPUT\",           # 1\r\n\r\n        [],                            # 2\r\n\r\n        0,                             # 3\r\n\r\n        [],                            # 4\r\n\r\n        0,                             # 5\r\n\r\n        [\r\n            b02_error\r\n        ]                              # 6\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# B02 NOT READY\r\n# ============================================================\r\n\r\nelif not b02_ready:\r\n\r\n    OUT = [\r\n\r\n        False,                         # 0\r\n\r\n        \"B02 NOT READY\",               # 1\r\n\r\n        [],                            # 2\r\n\r\n        0,                             # 3\r\n\r\n        [],                            # 4\r\n\r\n        0,                             # 5\r\n\r\n        []                             # 6\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# RUN BATCH\r\n# ============================================================\r\n\r\nelse:\r\n\r\n    batch_reports = []\r\n\r\n    successful_ids = []\r\n\r\n    failed_reports = []\r\n\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    try:\r\n\r\n        for b02_report in b02_reports:\r\n\r\n            # =================================================\r\n            # B02 READY CHECK\r\n            # =================================================\r\n\r\n            try:\r\n\r\n                beam_ready = bool(\r\n                    b02_report[1]\r\n                )\r\n\r\n                beam_id = b02_report[0]\r\n\r\n\r\n            except Exception as ex:\r\n\r\n                failure = [\r\n\r\n                    None,\r\n\r\n                    False,\r\n\r\n                    \"INVALID B02 REPORT\",\r\n\r\n                    str(ex)\r\n                ]\r\n\r\n\r\n                batch_reports.append(\r\n                    failure\r\n                )\r\n\r\n                failed_reports.append(\r\n                    failure\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            if not beam_ready:\r\n\r\n                failure = [\r\n\r\n                    beam_id,\r\n\r\n                    False,\r\n\r\n                    \"SKIPPED - B02 FAILED\",\r\n\r\n                    b02_report[3]\r\n                ]\r\n\r\n\r\n                batch_reports.append(\r\n                    failure\r\n                )\r\n\r\n                failed_reports.append(\r\n                    failure\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # ONE BEAM = ONE SUBTRANSACTION\r\n            # =================================================\r\n\r\n            sub_transaction = SubTransaction(\r\n                doc\r\n            )\r\n\r\n\r\n            sub_transaction.Start()\r\n\r\n\r\n            try:\r\n\r\n                result = process_beam(\r\n                    b02_report\r\n                )\r\n\r\n\r\n                sub_transaction.Commit()\r\n\r\n\r\n                batch_reports.append(\r\n                    result\r\n                )\r\n\r\n\r\n                successful_ids.append(\r\n                    result[0]\r\n                )\r\n\r\n\r\n            except Exception as ex:\r\n\r\n                try:\r\n\r\n                    sub_transaction.RollBack()\r\n\r\n                except:\r\n                    pass\r\n\r\n\r\n                failure = [\r\n\r\n                    beam_id,\r\n\r\n                    False,\r\n\r\n                    \"FAILED\",\r\n\r\n                    str(ex)\r\n                ]\r\n\r\n\r\n                batch_reports.append(\r\n                    failure\r\n                )\r\n\r\n\r\n                failed_reports.append(\r\n                    failure\r\n                )\r\n\r\n\r\n    finally:\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n    # ========================================================\r\n    # FINAL\r\n    # ========================================================\r\n\r\n    batch_ok = (\r\n\r\n        len(\r\n            successful_ids\r\n        ) > 0\r\n\r\n        and\r\n\r\n        len(\r\n            failed_reports\r\n        ) == 0\r\n    )\r\n\r\n\r\n    OUT = [\r\n\r\n        batch_ok,                      # 0\r\n\r\n        (\r\n            \"BATCH AUTO-REBAR COMPLETE\"\r\n            if batch_ok\r\n            else\r\n            \"BATCH COMPLETED WITH ERRORS\"\r\n        ),                             # 1\r\n\r\n        batch_reports,                 # 2\r\n\r\n        len(\r\n            successful_ids\r\n        ),                             # 3\r\n\r\n        successful_ids,               # 4\r\n\r\n        len(\r\n            failed_reports\r\n        ),                             # 5\r\n\r\n        failed_reports                 # 6\r\n    ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3728d0a583e8459581ea16e58d0974ae",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "1dafbb307eec45a5a1e973c6f418b45b",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5ca912a1260542a89e75ddb49eb38603",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# J01 — USER REBAR INPUT JUNCTION\r\n#\r\n# IN[0] = Top Bars\r\n# IN[1] = Top Diameter\r\n# IN[2] = Bottom Bars\r\n# IN[3] = Bottom Diameter\r\n# IN[4] = Stirrup Diameter\r\n# IN[5] = End Spacing\r\n# IN[6] = Mid Spacing\r\n# IN[7] = Cover\r\n#\r\n# OUT:\r\n# [0] TopQty\r\n# [1] BottomQty\r\n# [2] TopDia\r\n# [3] BottomDia\r\n# [4] StirrupDia\r\n# [5] Cover\r\n# [6] EndSpacing\r\n# [7] MidSpacing\r\n# [8] ContinuousQty\r\n# [9] ExtraQty\r\n# [10] SupportExtraLayer\r\n# [11] MidspanExtraLayer\r\n# [12] SupportSection\r\n# [13] MidspanSection\r\n# [14] Ready\r\n# [15] Errors\r\n# [16] Status\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# CONVERSION HELPERS\r\n# ============================================================\r\n\r\ndef to_int(value):\r\n\r\n    try:\r\n        return int(\r\n            round(\r\n                float(value)\r\n            )\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef to_float(value):\r\n\r\n    try:\r\n        return float(value)\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# READ PLAYER INPUTS\r\n# ============================================================\r\n\r\ntop_qty = to_int(\r\n    IN[0]\r\n)\r\n\r\ntop_dia = to_float(\r\n    IN[1]\r\n)\r\n\r\nbottom_qty = to_int(\r\n    IN[2]\r\n)\r\n\r\nbottom_dia = to_float(\r\n    IN[3]\r\n)\r\n\r\nstirrup_dia = to_float(\r\n    IN[4]\r\n)\r\n\r\nend_spacing = to_float(\r\n    IN[5]\r\n)\r\n\r\nmid_spacing = to_float(\r\n    IN[6]\r\n)\r\n\r\ncover = to_float(\r\n    IN[7]\r\n)\r\n\r\n\r\n# ============================================================\r\n# VALIDATION\r\n# ============================================================\r\n\r\nerrors = []\r\n\r\n\r\nif top_qty is None:\r\n\r\n    errors.append(\r\n        \"Top Bars is invalid.\"\r\n    )\r\n\r\nelif top_qty < 2:\r\n\r\n    errors.append(\r\n        \"Top Bars must be at least 2.\"\r\n    )\r\n\r\n\r\nif bottom_qty is None:\r\n\r\n    errors.append(\r\n        \"Bottom Bars is invalid.\"\r\n    )\r\n\r\nelif bottom_qty < 2:\r\n\r\n    errors.append(\r\n        \"Bottom Bars must be at least 2.\"\r\n    )\r\n\r\n\r\nif top_dia is None or top_dia <= 0:\r\n\r\n    errors.append(\r\n        \"Top Diameter is invalid.\"\r\n    )\r\n\r\n\r\nif bottom_dia is None or bottom_dia <= 0:\r\n\r\n    errors.append(\r\n        \"Bottom Diameter is invalid.\"\r\n    )\r\n\r\n\r\nif stirrup_dia is None or stirrup_dia <= 0:\r\n\r\n    errors.append(\r\n        \"Stirrup Diameter is invalid.\"\r\n    )\r\n\r\n\r\nif cover is None or cover <= 0:\r\n\r\n    errors.append(\r\n        \"Cover is invalid.\"\r\n    )\r\n\r\n\r\nif end_spacing is None or end_spacing <= 0:\r\n\r\n    errors.append(\r\n        \"End Spacing is invalid.\"\r\n    )\r\n\r\n\r\nif mid_spacing is None or mid_spacing <= 0:\r\n\r\n    errors.append(\r\n        \"Mid Spacing is invalid.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# REBAR QUANTITY LOGIC\r\n# ============================================================\r\n\r\ncontinuous_qty = None\r\nextra_qty = None\r\n\r\nsupport_extra_layer = None\r\nmidspan_extra_layer = None\r\n\r\nsupport_section = None\r\nmidspan_section = None\r\n\r\n\r\nif (\r\n    top_qty is not None\r\n    and\r\n    bottom_qty is not None\r\n):\r\n\r\n    continuous_qty = min(\r\n        top_qty,\r\n        bottom_qty\r\n    )\r\n\r\n\r\n    extra_qty = abs(\r\n        top_qty - bottom_qty\r\n    )\r\n\r\n\r\n    if top_qty > bottom_qty:\r\n\r\n        support_extra_layer = \"TOP\"\r\n\r\n        midspan_extra_layer = \"BOTTOM\"\r\n\r\n\r\n    elif bottom_qty > top_qty:\r\n\r\n        support_extra_layer = \"BOTTOM\"\r\n\r\n        midspan_extra_layer = \"TOP\"\r\n\r\n\r\n    else:\r\n\r\n        support_extra_layer = \"NONE\"\r\n\r\n        midspan_extra_layer = \"NONE\"\r\n\r\n\r\n    support_section = [\r\n        top_qty,\r\n        bottom_qty\r\n    ]\r\n\r\n\r\n    midspan_section = [\r\n        bottom_qty,\r\n        top_qty\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# FINAL STATUS\r\n# ============================================================\r\n\r\nready = (\r\n    len(errors) == 0\r\n)\r\n\r\n\r\nif ready:\r\n\r\n    status = \"USER REBAR INPUT READY\"\r\n\r\nelse:\r\n\r\n    status = \"USER REBAR INPUT FAILED\"\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = [\r\n\r\n    top_qty,                    # 0\r\n\r\n    bottom_qty,                 # 1\r\n\r\n    top_dia,                    # 2\r\n\r\n    bottom_dia,                 # 3\r\n\r\n    stirrup_dia,                # 4\r\n\r\n    cover,                      # 5\r\n\r\n    end_spacing,                # 6\r\n\r\n    mid_spacing,                # 7\r\n\r\n    continuous_qty,             # 8\r\n\r\n    extra_qty,                  # 9\r\n\r\n    support_extra_layer,        # 10\r\n\r\n    midspan_extra_layer,        # 11\r\n\r\n    support_section,            # 12\r\n\r\n    midspan_section,            # 13\r\n\r\n    ready,                      # 14\r\n\r\n    errors,                     # 15\r\n\r\n    status                      # 16\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "040d1810e90649fe9848a6a9cf39d233",
