    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"System.Windows.Forms\")\r\nclr.AddReference(\"System.Drawing\")\r\n\r\nfrom System.Windows.Forms import (\r\n    Form,\r\n    Label,\r\n    ComboBox,\r\n    ComboBoxStyle,\r\n    Button,\r\n    DialogResult,\r\n    FormBorderStyle\r\n)\r\n\r\nfrom System.Drawing import (\r\n    Point,\r\n    Size,\r\n    Font,\r\n    FontStyle\r\n)\r\n\r\n\r\n# ============================================================\r\n# U01 — SELECT BEAM TYPE FROM T01\r\n#\r\n# IN[0] = Entire T01 output\r\n#\r\n# T01 format:\r\n#\r\n# [0] Type Names\r\n# [1] Type IDs\r\n# [2] Type Elements\r\n# [3] Instance Counts\r\n# [4] Number of Types\r\n#\r\n#\r\n# OUT:\r\n#\r\n# [0] Selected Type Name\r\n# [1] Selected Type ID\r\n# [2] Selected Type Element\r\n# [3] Instance Count\r\n# [4] Ready\r\n# [5] Status\r\n# ============================================================\r\n\r\n\r\n# ============================================================\r\n# READ T01\r\n# ============================================================\r\n\r\nt01 = IN[0]\r\n\r\n\r\ntry:\r\n\r\n    type_names = list(\r\n        t01[0]\r\n    )\r\n\r\n    type_ids = list(\r\n        t01[1]\r\n    )\r\n\r\n    type_elements = list(\r\n        t01[2]\r\n    )\r\n\r\n    instance_counts = list(\r\n        t01[3]\r\n    )\r\n\r\nexcept:\r\n\r\n    type_names = []\r\n    type_ids = []\r\n    type_elements = []\r\n    instance_counts = []\r\n\r\n\r\n# ============================================================\r\n# FORM\r\n# ============================================================\r\n\r\nclass InputForm(Form):\r\n\r\n    def __init__(\r\n        self,\r\n        type_names,\r\n        instance_counts\r\n    ):\r\n\r\n        self.Text = (\r\n            \"Beam Reinforcement Generator — Revit 2026\"\r\n        )\r\n\r\n        self.Size = Size(\r\n            520,\r\n            210\r\n        )\r\n\r\n        self.FormBorderStyle = (\r\n            FormBorderStyle.FixedDialog\r\n        )\r\n\r\n        self.MaximizeBox = False\r\n        self.MinimizeBox = False\r\n\r\n        self.StartPosition = 1\r\n\r\n        self.Font = Font(\r\n            \"Segoe UI\",\r\n            9\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # TITLE\r\n        # ====================================================\r\n\r\n        title = Label()\r\n\r\n        title.Text = (\r\n            \"SELECT STRUCTURAL BEAM TYPE\"\r\n        )\r\n\r\n        title.Font = Font(\r\n            \"Segoe UI\",\r\n            11,\r\n            FontStyle.Bold\r\n        )\r\n\r\n        title.Location = Point(\r\n            18,\r\n            18\r\n        )\r\n\r\n        title.Size = Size(\r\n            470,\r\n            25\r\n        )\r\n\r\n        self.Controls.Add(\r\n            title\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # LABEL\r\n        # ====================================================\r\n\r\n        label = Label()\r\n\r\n        label.Text = (\r\n            \"Beam type to update\"\r\n        )\r\n\r\n        label.Location = Point(\r\n            20,\r\n            65\r\n        )\r\n\r\n        label.Size = Size(\r\n            180,\r\n            23\r\n        )\r\n\r\n        self.Controls.Add(\r\n            label\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # COMBO\r\n        # ====================================================\r\n\r\n        self.combo = ComboBox()\r\n\r\n        self.combo.DropDownStyle = (\r\n            ComboBoxStyle.DropDownList\r\n        )\r\n\r\n        self.combo.Location = Point(\r\n            205,\r\n            62\r\n        )\r\n\r\n        self.combo.Size = Size(\r\n            285,\r\n            24\r\n        )\r\n\r\n\r\n        for i in range(\r\n            len(type_names)\r\n        ):\r\n\r\n            name = str(\r\n                type_names[i]\r\n            )\r\n\r\n\r\n            try:\r\n\r\n                count = int(\r\n                    instance_counts[i]\r\n                )\r\n\r\n            except:\r\n\r\n                count = 0\r\n\r\n\r\n            display = (\r\n                \"{} | {} beam(s)\"\r\n                .format(\r\n                    name,\r\n                    count\r\n                )\r\n            )\r\n\r\n\r\n            self.combo.Items.Add(\r\n                display\r\n            )\r\n\r\n\r\n        if len(type_names) > 0:\r\n\r\n            self.combo.SelectedIndex = 0\r\n\r\n\r\n        self.Controls.Add(\r\n            self.combo\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # SELECT BUTTON\r\n        # ====================================================\r\n\r\n        select_button = Button()\r\n\r\n        select_button.Text = (\r\n            \"Select\"\r\n        )\r\n\r\n        select_button.Location = Point(\r\n            315,\r\n            115\r\n        )\r\n\r\n        select_button.Size = Size(\r\n            85,\r\n            32\r\n        )\r\n\r\n        select_button.DialogResult = (\r\n            DialogResult.OK\r\n        )\r\n\r\n        self.Controls.Add(\r\n            select_button\r\n        )\r\n\r\n        self.AcceptButton = (\r\n            select_button\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # CANCEL BUTTON\r\n        # ====================================================\r\n\r\n        cancel_button = Button()\r\n\r\n        cancel_button.Text = (\r\n            \"Cancel\"\r\n        )\r\n\r\n        cancel_button.Location = Point(\r\n            405,\r\n            115\r\n        )\r\n\r\n        cancel_button.Size = Size(\r\n            85,\r\n            32\r\n        )\r\n\r\n        cancel_button.DialogResult = (\r\n            DialogResult.Cancel\r\n        )\r\n\r\n        self.Controls.Add(\r\n            cancel_button\r\n        )\r\n\r\n        self.CancelButton = (\r\n            cancel_button\r\n        )\r\n\r\n\r\n# ============================================================\r\n# RUN\r\n# ============================================================\r\n\r\nif len(type_names) == 0:\r\n\r\n    OUT = [\r\n\r\n        None,                           # 0\r\n        None,                           # 1\r\n        None,                           # 2\r\n        0,                              # 3\r\n\r\n        False,                          # 4\r\n\r\n        \"NO BEAM TYPES FROM T01\"       # 5\r\n    ]\r\n\r\n\r\nelse:\r\n\r\n    form = InputForm(\r\n        type_names,\r\n        instance_counts\r\n    )\r\n\r\n\r\n    result = (\r\n        form.ShowDialog()\r\n    )\r\n\r\n\r\n    if result != DialogResult.OK:\r\n\r\n        OUT = [\r\n\r\n            None,\r\n            None,\r\n            None,\r\n            0,\r\n\r\n            False,\r\n\r\n            \"USER CANCELLED\"\r\n        ]\r\n\r\n\r\n    else:\r\n\r\n        index = int(\r\n            form.combo.SelectedIndex\r\n        )\r\n\r\n\r\n        if (\r\n            index < 0\r\n            or\r\n            index >= len(type_names)\r\n        ):\r\n\r\n            OUT = [\r\n\r\n                None,\r\n                None,\r\n                None,\r\n                0,\r\n\r\n                False,\r\n\r\n                \"INVALID BEAM TYPE SELECTION\"\r\n            ]\r\n\r\n\r\n        else:\r\n\r\n            OUT = [\r\n\r\n                type_names[index],          # 0\r\n\r\n                type_ids[index],            # 1\r\n\r\n                type_elements[index],       # 2\r\n\r\n                instance_counts[index],     # 3\r\n\r\n                True,                       # 4\r\n\r\n                \"BEAM TYPE SELECTED\"        # 5\r\n            ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "aa7f16e028b64750a6860f97f1464659",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "698069ec05a8429db232d9b403c73c8f",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
