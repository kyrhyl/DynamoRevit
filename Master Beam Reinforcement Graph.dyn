{
  "Uuid": "858d8cf4-c8cd-43d4-b7fb-8aa6abab3ea6",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Master Beam Reinforcement Graph",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import StructuralType\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# T01 — USED STRUCTURAL BEAM TYPES\r\n#\r\n# Scans actual structural beam instances in the project\r\n# and returns unique beam types currently in use.\r\n#\r\n# OUT:\r\n# [0] Type Names\r\n# [1] Type IDs\r\n# [2] Type Elements\r\n# [3] Instance Counts\r\n# [4] Number of Types\r\n# ============================================================\r\n\r\n\r\ndef id_value(element_id):\r\n\r\n    try:\r\n        return int(element_id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element_id.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\ndef get_type_name(beam_type):\r\n\r\n    name = None\r\n\r\n    try:\r\n        p = beam_type.get_Parameter(\r\n            BuiltInParameter.SYMBOL_NAME_PARAM\r\n        )\r\n\r\n        if p is not None:\r\n            name = p.AsString()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    if not name:\r\n\r\n        try:\r\n            name = beam_type.Name\r\n        except:\r\n            pass\r\n\r\n\r\n    if not name:\r\n        name = \"Unnamed Type\"\r\n\r\n    return str(name)\r\n\r\n\r\nall_framing = (\r\n    FilteredElementCollector(doc)\r\n    .OfCategory(BuiltInCategory.OST_StructuralFraming)\r\n    .WhereElementIsNotElementType()\r\n    .ToElements()\r\n)\r\n\r\n\r\ntype_map = {}\r\n\r\n\r\nfor element in all_framing:\r\n\r\n    try:\r\n\r\n        if element.StructuralType != StructuralType.Beam:\r\n            continue\r\n\r\n\r\n        type_id = element.GetTypeId()\r\n\r\n        tid = id_value(\r\n            type_id\r\n        )\r\n\r\n\r\n        if tid is None:\r\n            continue\r\n\r\n\r\n        if tid not in type_map:\r\n\r\n            beam_type = doc.GetElement(\r\n                type_id\r\n            )\r\n\r\n            if beam_type is None:\r\n                continue\r\n\r\n\r\n            type_map[tid] = {\r\n                \"name\": get_type_name(beam_type),\r\n                \"type\": beam_type,\r\n                \"count\": 0\r\n            }\r\n\r\n\r\n        type_map[tid][\"count\"] += 1\r\n\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# SORT BY TYPE NAME\r\n# ============================================================\r\n\r\nitems = []\r\n\r\n\r\nfor tid in type_map:\r\n\r\n    data = type_map[tid]\r\n\r\n    items.append(\r\n        [\r\n            str(data[\"name\"]),\r\n            tid,\r\n            data[\"type\"],\r\n            data[\"count\"]\r\n        ]\r\n    )\r\n\r\n\r\nitems.sort(\r\n    key=lambda x: x[0].lower()\r\n)\r\n\r\n\r\ntype_names = []\r\ntype_ids = []\r\ntype_elements = []\r\ninstance_counts = []\r\n\r\n\r\nfor item in items:\r\n\r\n    type_names.append(\r\n        item[0]\r\n    )\r\n\r\n    type_ids.append(\r\n        item[1]\r\n    )\r\n\r\n    type_elements.append(\r\n        item[2]\r\n    )\r\n\r\n    instance_counts.append(\r\n        item[3]\r\n    )\r\n\r\n\r\nOUT = [\r\n    type_names,\r\n    type_ids,\r\n    type_elements,\r\n    instance_counts,\r\n    len(type_names)\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7bfe23d5827c44c09bb7dcf0a5326cf3",
      "NodeType": "PythonScriptNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "968f32b99bb84e7692f2a1433ae27b1f",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
