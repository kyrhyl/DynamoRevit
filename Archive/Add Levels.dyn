    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Import DocumentManager and TransactionManager\r\nimport clr\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# Import RevitAPI\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# Revit Document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Get the ForgeType from the Document object\r\nforgeTypeId = doc.GetUnits().GetFormatOptions(SpecTypeId.Length).GetUnitTypeId()\r\n\r\n# Temporary workaround for Forge SDK unit types that are missing in Revit 2023:\r\nif (forgeTypeId.Equals(UnitTypeId.FeetFractionalInches)) or (forgeTypeId.Equals(UnitTypeId.StationingFeet)):\r\n    forgeTypeId = UnitTypeId.Feet;\r\n\r\nif forgeTypeId.Equals(UnitTypeId.StationingSurveyFeet):\r\n    forgeTypeId = UnitTypeId.UsSurveyFeet;\r\n\r\nif forgeTypeId.Equals(UnitTypeId.FractionalInches):\r\n    forgeTypeId = UnitTypeId.Inches;\r\n\r\nif (forgeTypeId.Equals(UnitTypeId.MetersCentimeters)) or (forgeTypeId.Equals(UnitTypeId.StationingMeters)):\r\n    forgeTypeId = UnitTypeId.Meters;\r\n\r\n# Assign your output to the OUT variable\r\nOUT = forgeTypeId.TypeId",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "ab09c63fd25a4026a4c0bbd5ecffe505",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "cdd6168a6e3c4143b0f58f0386b197ee",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
