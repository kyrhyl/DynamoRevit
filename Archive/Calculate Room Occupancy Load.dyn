      "NodeType": "CodeBlockNode",
      "Code": "//declare a few variables to combine for output\nroomName;\narea;\noccupancyLoad;\n//build output\n//first line prefix + name + return line\nroomString + roomName + \"\\n\" +\n//second line prefix + area + return line\nareaString + area + \" \" + units+ \"\\n\" +\n//blank line\n\"\\n\"+\n//third line prefix + occupancy load\noccupancyString + occupancyLoad;",
