      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//declare a few variables to combine for output\ntotalLength;\ntravelTime;\nspeed;\nlengthUnits;\nspeedUnits;\n//build output\n//first line prefix + count + return line\nstring1 + totalLength + \" \" + lengthUnits + string2 + \"\\n\" +\nstring3 + travelTime + string4 + speed + \" \" + speedUnits;",
