    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Import DocumentManager and TransactionManager\r\nimport clr\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Import RevitAPI\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Set up inputs\r\nvalue = IN[0]\r\n\r\n# Execute definition\r\nprojectUnits = Document.GetUnits(doc).GetFormatOptions(SpecTypeId.Length).GetUnitTypeId()\r\nprojectDisplayUnits = LabelUtils.GetLabelForUnit(projectUnits)\r\n\r\nspeedUnits = Document.GetUnits(doc).GetFormatOptions(SpecTypeId.Speed).GetUnitTypeId()\r\nspeedDisplayUnits = LabelUtils.GetLabelForUnit(speedUnits)\r\n\r\n\r\n# Assign your output to the OUT variable\r\nOUT = projectDisplayUnits,speedDisplayUnits",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "044a4d2c8aaa420e86832be20347b499",
      "Inputs": [
        {
          "Id": "00b1575e1e2346cfa91c6b585e5593b4",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4f25bff3ff4b4c61b20cb329ea366da5",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
