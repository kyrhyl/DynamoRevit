      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//declare a few variables to combine for output\ncurveCount;\ntotalLength;\nunits;\n//build output\n//first line prefix + count + return line\noutputString1 + curveCount + \"\\n\" +\n//second line prefix + total length + space + units\noutputString2 + totalLength + \" \" + units;",
