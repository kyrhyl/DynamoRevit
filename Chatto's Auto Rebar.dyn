          "Id": "9c71a6344d084ff6885b44efd191dbb1",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "df47822a3ec14dbb817082d71fa63719",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "7d5f02a3a5544027bb015cbf334eddae",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "651788ab4db2462d88247f02cc8edf07",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector,\r\n    Element,\r\n    BuiltInParameter\r\n)\r\nfrom Autodesk.Revit.DB.Structure import RebarBarType\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\nbar_types = list(\r\n    FilteredElementCollector(doc)\r\n    .OfClass(RebarBarType)\r\n    .ToElements()\r\n)\r\n\r\ndef get_name(bar_type):\r\n    try:\r\n        return Element.Name.GetValue(bar_type)\r\n    except:\r\n        parameter = bar_type.get_Parameter(\r\n            BuiltInParameter.SYMBOL_NAME_PARAM\r\n        )\r\n        return parameter.AsString() if parameter else \"Unnamed\"\r\n\r\nbar_types.sort(key=get_name)\r\n\r\nnames = [get_name(bar_type) for bar_type in bar_types]\r\n\r\n# First output: elements used by the main script\r\n# Second output: readable names for the Watch node\r\nOUT = bar_types, names",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b11cb766bae54e04a8a621a126daacfc",
      "NodeType": "PythonScriptNode",
      "Inputs": [
