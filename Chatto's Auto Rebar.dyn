      "Inputs": [
        {
          "Id": "34791133d660427ba68fcb46e23bb001",
          "Name": "list",
          "Description": "List to fetch an item from.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a3bbebb9cc494801a4ed9ca0ab850428",
          "Name": "index",
          "Description": "Index of the item to be fetched.\n\nint",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "99961961c03642968696aab19b70cd63",
          "Name": "item",
          "Description": "Item in the list at the given index.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "DSCore.List.GetItemAtIndex@var[]..[],int",
      "Replication": "Auto",
      "Description": "Returns an item from the given list that's located at the specified index.\n\nList.GetItemAtIndex (list: var[]..[], index: int): var[]..[]"
    },
    {
      "ConcreteType": "CoreNodeModels.Watch, CoreNodeModels",
      "WatchWidth": 50.0,
      "WatchHeight": 166.0,
      "Id": "e64ce3c4fad7466996490acc91c2a709",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "7186174c1604467bb4070b4a06a9a381",
          "Name": "",
          "Description": "Node to show output from",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "6ffc51103036464ba7c49b21f9dba581",
          "Name": "",
          "Description": "Node output",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Visualizes a node's output"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Collections.Generic import List\r\n\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# DYNAMO INPUTS\r\n# ============================================================\r\n# IN[0] = Continuous structural column - Select Model Element\r\n# IN[1] = Connected beams - Select Model Elements\r\n# IN[2] = Stirrup/tie RebarBarType\r\n# IN[3] = Confinement spacing in millimetres\r\n# IN[4] = Middle-zone spacing in millimetres\r\n# IN[5] = Concrete cover in millimetres\r\n# IN[6] = Main-bar Python node OUT (execution-order trigger)\r\n\r\ncolumn = UnwrapElement(IN[0])\r\nraw_beams = UnwrapElement(IN[1])\r\ntie_type = UnwrapElement(IN[2])\r\n\r\n# This input deliberately creates a Dynamo dependency. Connect the OUT port\r\n# of the main-bar Python node to IN[6] of this tie node. Dynamo will then\r\n# finish the main-bar node before this script deletes and recreates the ties.\r\n# The value itself is not used for reinforcement geometry.\r\nmain_bar_completion = IN[6]\r\n\r\n\r\ntry:\r\n    confinement_spacing_mm = float(IN[3])\r\nexcept:\r\n    confinement_spacing_mm = 0.0\r\n\r\ntry:\r\n    middle_spacing_mm = float(IN[4])\r\nexcept:\r\n    middle_spacing_mm = 0.0\r\n\r\ntry:\r\n    cover_mm = float(IN[5])\r\nexcept:\r\n    cover_mm = -1.0\r\n\r\n\r\n# Fixed project rule:\r\n# confinement zone = Lclear / 4 at each end of every clear segment.\r\nCONFINEMENT_RATIO = 0.25\r\n\r\n\r\n# ============================================================\r\n# UNIT AND GENERAL HELPERS\r\n# ============================================================\r\n\r\ndef mm(value):\r\n    \"\"\"Convert millimetres to Revit internal units.\"\"\"\r\n    return UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef to_mm(value):\r\n    \"\"\"Convert Revit internal units to millimetres.\"\"\"\r\n    return UnitUtils.ConvertFromInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\n\r\ndef element_name(element):\r\n    \"\"\"Return a readable Revit element name.\"\"\"\r\n    try:\r\n        return Element.Name.GetValue(element)\r\n    except:\r\n        try:\r\n            return element.Name\r\n        except:\r\n            return \"Unnamed\"\r\n\r\n\r\ndef element_id_value(element):\r\n    \"\"\"Return an ElementId value in Revit 2026, with an older fallback.\"\"\"\r\n    try:\r\n        return int(element.Id.Value)\r\n    except:\r\n        try:\r\n            return int(element.Id.IntegerValue)\r\n        except:\r\n            return str(element.Id)\r\n\r\n\r\ndef make_element_list(value):\r\n    \"\"\"Normalize a Dynamo element input into a Python list.\"\"\"\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n        return list(value)\r\n    except:\r\n        return [value]\r\n\r\n\r\n# ============================================================\r\n# FIND A 135-DEGREE STIRRUP/TIE HOOK\r\n# ============================================================\r\n\r\ndef find_135_seismic_hook():\r\n    \"\"\"Find a loaded 135-degree Stirrup/Tie hook.\"\"\"\r\n    target_angle = math.radians(135.0)\r\n    angle_tolerance = math.radians(0.1)\r\n    candidates = []\r\n\r\n    hook_types = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarHookType)\r\n        .WhereElementIsElementType()\r\n        .ToElements()\r\n    )\r\n\r\n    for hook in hook_types:\r\n        try:\r\n            correct_angle = (\r\n                abs(hook.HookAngle - target_angle)\r\n                <= angle_tolerance\r\n            )\r\n            correct_style = (\r\n                hook.Style == RebarStyle.StirrupTie\r\n            )\r\n\r\n            if correct_angle and correct_style:\r\n                candidates.append(hook)\r\n        except:\r\n            pass\r\n\r\n    if not candidates:\r\n        return None\r\n\r\n    candidates.sort(\r\n        key=lambda hook: (\r\n            0 if \"seismic\" in element_name(hook).lower() else 1,\r\n            element_name(hook).lower()\r\n        )\r\n    )\r\n\r\n    return candidates[0]\r\n\r\n\r\n# ============================================================\r\n# BEAM-JOINT DETECTION HELPERS\r\n# ============================================================\r\n\r\ndef boxes_touch_in_xy(column_box, beam_box, tolerance):\r\n    \"\"\"Check whether a beam bounding box reaches the column in plan.\"\"\"\r\n    overlap_x = not (\r\n        beam_box.Max.X < column_box.Min.X - tolerance\r\n        or beam_box.Min.X > column_box.Max.X + tolerance\r\n    )\r\n\r\n    overlap_y = not (\r\n        beam_box.Max.Y < column_box.Min.Y - tolerance\r\n        or beam_box.Min.Y > column_box.Max.Y + tolerance\r\n    )\r\n\r\n    return overlap_x and overlap_y\r\n\r\n\r\ndef merge_joint_ranges(ranges, tolerance):\r\n    \"\"\"\r\n    Merge overlapping beam elevation ranges at each floor.\r\n\r\n    The merged range is used only as an exclusion zone. No ties are\r\n    created within it or directly on either joint face.\r\n    \"\"\"\r\n    if not ranges:\r\n        return []\r\n\r\n    ordered_ranges = sorted(\r\n        ranges,\r\n        key=lambda item: item[\"start\"]\r\n    )\r\n\r\n    merged = []\r\n\r\n    for current in ordered_ranges:\r\n        if not merged:\r\n            merged.append({\r\n                \"start\": current[\"start\"],\r\n                \"end\": current[\"end\"],\r\n                \"beam_ids\": list(current[\"beam_ids\"])\r\n            })\r\n            continue\r\n\r\n        previous = merged[-1]\r\n        ranges_overlap = (\r\n            current[\"start\"] <= previous[\"end\"] + tolerance\r\n        )\r\n\r\n        if ranges_overlap:\r\n            previous[\"start\"] = min(\r\n                previous[\"start\"],\r\n                current[\"start\"]\r\n            )\r\n            previous[\"end\"] = max(\r\n                previous[\"end\"],\r\n                current[\"end\"]\r\n            )\r\n            previous[\"beam_ids\"].extend(\r\n                current[\"beam_ids\"]\r\n            )\r\n        else:\r\n            merged.append({\r\n                \"start\": current[\"start\"],\r\n                \"end\": current[\"end\"],\r\n                \"beam_ids\": list(current[\"beam_ids\"])\r\n            })\r\n\r\n    return merged\r\n\r\n\r\n# ============================================================\r\n# TIE-ZONE HELPERS\r\n# ============================================================\r\n\r\ndef estimate_tie_quantity(\r\n    zone_length,\r\n    spacing,\r\n    include_first,\r\n    include_last\r\n):\r\n    \"\"\"Estimate the number of visible tie positions in one set.\"\"\"\r\n    if zone_length <= 0 or spacing <= 0:\r\n        return 0\r\n\r\n    quantity = int(math.ceil(zone_length / spacing)) + 1\r\n\r\n    if not include_first:\r\n        quantity -= 1\r\n\r\n    if not include_last:\r\n        quantity -= 1\r\n\r\n    return max(quantity, 0)\r\n\r\n\r\ndef add_zone(\r\n    zones,\r\n    name,\r\n    start_z,\r\n    end_z,\r\n    spacing,\r\n    include_first,\r\n    include_last,\r\n    zone_type\r\n):\r\n    \"\"\"Add one valid clear-column tie-distribution zone.\"\"\"\r\n    zone_length = end_z - start_z\r\n    tolerance = mm(1.0)\r\n\r\n    if zone_length <= tolerance:\r\n        return\r\n\r\n    estimated_quantity = estimate_tie_quantity(\r\n        zone_length,\r\n        spacing,\r\n        include_first,\r\n        include_last\r\n    )\r\n\r\n    if estimated_quantity <= 0:\r\n        return\r\n\r\n    zones.append({\r\n        \"name\": name,\r\n        \"type\": zone_type,\r\n        \"start\": start_z,\r\n        \"end\": end_z,\r\n        \"spacing\": spacing,\r\n        \"include_first\": include_first,\r\n        \"include_last\": include_last,\r\n        \"estimated_quantity\": estimated_quantity\r\n    })\r\n\r\n\r\ndef add_clear_segment_zones(\r\n    zones,\r\n    segment_number,\r\n    start_z,\r\n    end_z,\r\n    include_segment_start,\r\n    include_segment_end,\r\n    confinement_spacing,\r\n    middle_spacing\r\n):\r\n    \"\"\"\r\n    Divide one clear column segment into three zones:\r\n\r\n    bottom confinement = Lclear / 4\r\n    middle zone         = Lclear / 2\r\n    top confinement    = Lclear / 4\r\n\r\n    For a segment next to a beam joint, its joint-side endpoint is\r\n    excluded so no tie is placed directly on the joint face.\r\n    \"\"\"\r\n    clear_length = end_z - start_z\r\n\r\n    if clear_length <= mm(1.0):\r\n        return\r\n\r\n    confinement_length = clear_length * CONFINEMENT_RATIO\r\n    bottom_end = start_z + confinement_length\r\n    top_start = end_z - confinement_length\r\n\r\n    add_zone(\r\n        zones,\r\n        \"Segment {} - Bottom L/4 confinement\".format(\r\n            segment_number\r\n        ),\r\n        start_z,\r\n        bottom_end,\r\n        confinement_spacing,\r\n        include_segment_start,\r\n        True,\r\n        \"Confinement\"\r\n    )\r\n\r\n    add_zone(\r\n        zones,\r\n        \"Segment {} - Middle zone\".format(segment_number),\r\n        bottom_end,\r\n        top_start,\r\n        middle_spacing,\r\n        False,\r\n        False,\r\n        \"Middle\"\r\n    )\r\n\r\n    add_zone(\r\n        zones,\r\n        \"Segment {} - Top L/4 confinement\".format(\r\n            segment_number\r\n        ),\r\n        top_start,\r\n        end_z,\r\n        confinement_spacing,\r\n        True,\r\n        include_segment_end,\r\n        \"Confinement\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CREATE ONE SHAPE-DRIVEN TIE SET\r\n# ============================================================\r\n\r\ndef create_tie_set(\r\n    host_column,\r\n    tie_bar_type,\r\n    hook_type,\r\n    x1,\r\n    x2,\r\n    y1,\r\n    y2,\r\n    zone\r\n):\r\n    \"\"\"Create one rectangular shape-driven tie set.\"\"\"\r\n    z_start = zone[\"start\"]\r\n    z_end = zone[\"end\"]\r\n    distribution_length = z_end - z_start\r\n\r\n    p1 = XYZ(x1, y1, z_start)\r\n    p2 = XYZ(x2, y1, z_start)\r\n    p3 = XYZ(x2, y2, z_start)\r\n    p4 = XYZ(x1, y2, z_start)\r\n\r\n    # Confirmed working counterclockwise curve order.\r\n    curves = List[Curve]()\r\n    curves.Add(Line.CreateBound(p1, p2))\r\n    curves.Add(Line.CreateBound(p2, p3))\r\n    curves.Add(Line.CreateBound(p3, p4))\r\n    curves.Add(Line.CreateBound(p4, p1))\r\n\r\n    # Revit 2026 hook termination settings.\r\n    terminations = BarTerminationsData(doc)\r\n    terminations.HookTypeIdAtStart = hook_type.Id\r\n    terminations.HookTypeIdAtEnd = hook_type.Id\r\n\r\n    # Confirmed working hook orientation.\r\n    terminations.TerminationOrientationAtStart = (\r\n        RebarHookOrientation.Left\r\n    )\r\n    terminations.TerminationOrientationAtEnd = (\r\n        RebarHookOrientation.Left\r\n    )\r\n\r\n    new_tie = Rebar.CreateFromCurves(\r\n        doc,\r\n        RebarStyle.StirrupTie,\r\n        tie_bar_type,\r\n        host_column,\r\n        XYZ.BasisZ,\r\n        curves,\r\n        terminations,\r\n        True,\r\n        True\r\n    )\r\n\r\n    if new_tie is None:\r\n        raise Exception(\r\n            \"Revit could not create tie zone: {}\".format(\r\n                zone[\"name\"]\r\n            )\r\n        )\r\n\r\n    accessor = new_tie.GetShapeDrivenAccessor()\r\n    accessor.SetLayoutAsMaximumSpacing(\r\n        zone[\"spacing\"],\r\n        distribution_length,\r\n        True,\r\n        zone[\"include_first\"],\r\n        zone[\"include_last\"]\r\n    )\r\n\r\n    return new_tie\r\n\r\n\r\n# ============================================================\r\n# NORMALIZE BEAM INPUT\r\n# ============================================================\r\n\r\nbeams = make_element_list(raw_beams)\r\nbeams = [beam for beam in beams if beam is not None]\r\n\r\n\r\n# ============================================================\r\n# INPUT VALIDATION\r\n# ============================================================\r\n\r\nerror_message = None\r\n\r\nif column is None:\r\n    error_message = (\r\n        \"ERROR: Select one continuous structural column.\"\r\n    )\r\nelif tie_type is None:\r\n    error_message = (\r\n        \"ERROR: Select one stirrup RebarBarType.\"\r\n    )\r\nelif not isinstance(tie_type, RebarBarType):\r\n    error_message = (\r\n        \"ERROR: IN[2] must be a RebarBarType.\"\r\n    )\r\nelif not beams:\r\n    error_message = (\r\n        \"ERROR: Select all beams connected to the column using \"\r\n        \"Select Model Elements.\"\r\n    )\r\nelif confinement_spacing_mm <= 0:\r\n    error_message = (\r\n        \"ERROR: Confinement spacing must be greater than zero.\"\r\n    )\r\nelif middle_spacing_mm <= 0:\r\n    error_message = (\r\n        \"ERROR: Middle-zone spacing must be greater than zero.\"\r\n    )\r\nelif cover_mm < 0:\r\n    error_message = (\r\n        \"ERROR: Concrete cover cannot be negative.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# MAIN PROCESS\r\n# ============================================================\r\n\r\nif error_message is not None:\r\n    OUT = error_message\r\n\r\nelse:\r\n    seismic_hook = find_135_seismic_hook()\r\n\r\n    if seismic_hook is None:\r\n        OUT = [\r\n            \"ERROR: No compatible 135-degree hook was found.\",\r\n            \"Load or create a 135-degree Stirrup/Tie hook.\"\r\n        ]\r\n\r\n    else:\r\n        column_box = column.get_BoundingBox(None)\r\n\r\n        if column_box is None:\r\n            OUT = (\r\n                \"ERROR: Could not obtain the column bounding box.\"\r\n            )\r\n\r\n        else:\r\n            tie_diameter = tie_type.BarNominalDiameter\r\n            cover = mm(cover_mm)\r\n            confinement_spacing = mm(confinement_spacing_mm)\r\n            middle_spacing = mm(middle_spacing_mm)\r\n\r\n            # Tie centreline is cover plus half the tie diameter.\r\n            offset = cover + tie_diameter / 2.0\r\n\r\n            x1 = column_box.Min.X + offset\r\n            x2 = column_box.Max.X - offset\r\n            y1 = column_box.Min.Y + offset\r\n            y2 = column_box.Max.Y - offset\r\n\r\n            column_z_start = column_box.Min.Z + offset\r\n            column_z_end = column_box.Max.Z - offset\r\n\r\n            if x2 <= x1 or y2 <= y1:\r\n                OUT = (\r\n                    \"ERROR: Cover and tie diameter are too large \"\r\n                    \"for the column section.\"\r\n                )\r\n\r\n            elif column_z_end <= column_z_start:\r\n                OUT = (\r\n                    \"ERROR: Available tie distribution height \"\r\n                    \"is invalid.\"\r\n                )\r\n\r\n            else:\r\n                # -----------------------------------------------\r\n                # DETECT SELECTED BEAM-JOINT EXCLUSION RANGES\r\n                # -----------------------------------------------\r\n\r\n                beam_ranges = []\r\n                ignored_beams = []\r\n                xy_tolerance = mm(25.0)\r\n\r\n                for beam in beams:\r\n                    beam_box = beam.get_BoundingBox(None)\r\n\r\n                    if beam_box is None:\r\n                        ignored_beams.append(\r\n                            \"{} | ID {} | no bounding box\".format(\r\n                                element_name(beam),\r\n                                element_id_value(beam)\r\n                            )\r\n                        )\r\n                        continue\r\n\r\n                    touches_column = boxes_touch_in_xy(\r\n                        column_box,\r\n                        beam_box,\r\n                        xy_tolerance\r\n                    )\r\n\r\n                    overlaps_column_height = not (\r\n                        beam_box.Max.Z < column_z_start\r\n                        or beam_box.Min.Z > column_z_end\r\n                    )\r\n\r\n                    if not touches_column or not overlaps_column_height:\r\n                        ignored_beams.append(\r\n                            \"{} | ID {} | does not reach column\".format(\r\n                                element_name(beam),\r\n                                element_id_value(beam)\r\n                            )\r\n                        )\r\n                        continue\r\n\r\n                    joint_start = max(\r\n                        beam_box.Min.Z,\r\n                        column_z_start\r\n                    )\r\n                    joint_end = min(\r\n                        beam_box.Max.Z,\r\n                        column_z_end\r\n                    )\r\n\r\n                    if joint_end > joint_start:\r\n                        beam_ranges.append({\r\n                            \"start\": joint_start,\r\n                            \"end\": joint_end,\r\n                            \"beam_ids\": [element_id_value(beam)]\r\n                        })\r\n\r\n                joint_ranges = merge_joint_ranges(\r\n                    beam_ranges,\r\n                    mm(10.0)\r\n                )\r\n\r\n                if not joint_ranges:\r\n                    OUT = [\r\n                        \"ERROR: None of the selected beams were \"\r\n                        \"recognized as connected to the column.\",\r\n                        \"Check the selected column and beams.\",\r\n                        ignored_beams\r\n                    ]\r\n\r\n                else:\r\n                    # --------------------------------------------\r\n                    # BUILD CLEAR-COLUMN TIE ZONES ONLY\r\n                    # --------------------------------------------\r\n                    # The entire merged depth of every detected beam\r\n                    # joint is skipped. No joint tie set is created.\r\n                    # No tie is placed at the bottom or top joint face.\r\n\r\n                    zones = []\r\n                    cursor = column_z_start\r\n                    segment_number = 1\r\n\r\n                    for joint in joint_ranges:\r\n                        clear_end = joint[\"start\"]\r\n\r\n                        if clear_end > cursor + mm(1.0):\r\n                            include_segment_start = (\r\n                                abs(cursor - column_z_start)\r\n                                <= mm(1.0)\r\n                            )\r\n\r\n                            add_clear_segment_zones(\r\n                                zones,\r\n                                segment_number,\r\n                                cursor,\r\n                                clear_end,\r\n                                include_segment_start,\r\n                                False,\r\n                                confinement_spacing,\r\n                                middle_spacing\r\n                            )\r\n\r\n                            segment_number += 1\r\n\r\n                        # Jump to the top of the joint, leaving its\r\n                        # entire depth free of generated column ties.\r\n                        cursor = max(cursor, joint[\"end\"])\r\n\r\n                    # Create zones in the clear column portion above\r\n                    # the highest detected joint, if one exists.\r\n                    if column_z_end > cursor + mm(1.0):\r\n                        add_clear_segment_zones(\r\n                            zones,\r\n                            segment_number,\r\n                            cursor,\r\n                            column_z_end,\r\n                            False,\r\n                            True,\r\n                            confinement_spacing,\r\n                            middle_spacing\r\n                        )\r\n\r\n                    zones.sort(\r\n                        key=lambda zone: (\r\n                            zone[\"start\"],\r\n                            zone[\"end\"]\r\n                        )\r\n                    )\r\n\r\n                    if not zones:\r\n                        OUT = (\r\n                            \"ERROR: No valid clear-column tie zones \"\r\n                            \"were generated.\"\r\n                        )\r\n\r\n                    else:\r\n                        # ----------------------------------------\r\n                        # FIND EXISTING TIES ON SELECTED COLUMN\r\n                        # ----------------------------------------\r\n\r\n                        existing_ties = []\r\n\r\n                        all_rebars = (\r\n                            FilteredElementCollector(doc)\r\n                            .OfClass(Rebar)\r\n                            .WhereElementIsNotElementType()\r\n                            .ToElements()\r\n                        )\r\n\r\n                        for existing_rebar in all_rebars:\r\n                            try:\r\n                                same_host = (\r\n                                    existing_rebar.GetHostId()\r\n                                    == column.Id\r\n                                )\r\n                                is_tie = (\r\n                                    existing_rebar.Style\r\n                                    == RebarStyle.StirrupTie\r\n                                )\r\n\r\n                                if same_host and is_tie:\r\n                                    existing_ties.append(\r\n                                        existing_rebar\r\n                                    )\r\n                            except:\r\n                                pass\r\n\r\n                        deleted_count = len(existing_ties)\r\n                        created_sets = []\r\n                        joint_report = []\r\n                        zone_report = []\r\n\r\n                        for index, joint in enumerate(joint_ranges):\r\n                            joint_report.append(\r\n                                \"Excluded joint {} | {:.0f} to \"\r\n                                \"{:.0f} mm | Beam IDs: {}\".format(\r\n                                    index + 1,\r\n                                    to_mm(joint[\"start\"]),\r\n                                    to_mm(joint[\"end\"]),\r\n                                    joint[\"beam_ids\"]\r\n                                )\r\n                            )\r\n\r\n                        # ----------------------------------------\r\n                        # TRANSACTION\r\n                        # ----------------------------------------\r\n\r\n                        TransactionManager.Instance.EnsureInTransaction(\r\n                            doc\r\n                        )\r\n\r\n                        sub_transaction = SubTransaction(doc)\r\n                        sub_transaction.Start()\r\n\r\n                        try:\r\n                            # Delete only existing stirrup/tie rebars\r\n                            # hosted by the selected column. Main bars\r\n                            # are retained.\r\n                            for existing_tie in existing_ties:\r\n                                doc.Delete(existing_tie.Id)\r\n\r\n                            for zone in zones:\r\n                                new_tie = create_tie_set(\r\n                                    column,\r\n                                    tie_type,\r\n                                    seismic_hook,\r\n                                    x1,\r\n                                    x2,\r\n                                    y1,\r\n                                    y2,\r\n                                    zone\r\n                                )\r\n\r\n                                created_sets.append(new_tie)\r\n\r\n                                zone_report.append(\r\n                                    \"{} | {} | {:.0f} to {:.0f} mm | \"\r\n                                    \"length {:.0f} mm | maximum spacing \"\r\n                                    \"{:.0f} mm | estimated ties {}\".format(\r\n                                        zone[\"name\"],\r\n                                        zone[\"type\"],\r\n                                        to_mm(zone[\"start\"]),\r\n                                        to_mm(zone[\"end\"]),\r\n                                        to_mm(\r\n                                            zone[\"end\"] - zone[\"start\"]\r\n                                        ),\r\n                                        to_mm(zone[\"spacing\"]),\r\n                                        zone[\"estimated_quantity\"]\r\n                                    )\r\n                                )\r\n\r\n                            sub_transaction.Commit()\r\n                            TransactionManager.Instance.TransactionTaskDone()\r\n\r\n                            OUT = [\r\n                                \"SUCCESS: Clear-column tie zones created.\",\r\n                                \"Execution order: main bars completed before ties.\",\r\n                                \"Column ID: {}\".format(\r\n                                    element_id_value(column)\r\n                                ),\r\n                                \"Existing tie sets deleted: {}\".format(\r\n                                    deleted_count\r\n                                ),\r\n                                \"New tie sets created: {}\".format(\r\n                                    len(created_sets)\r\n                                ),\r\n                                \"Beam joints excluded: {}\".format(\r\n                                    len(joint_ranges)\r\n                                ),\r\n                                \"Beam-joint regions contain no generated ties.\",\r\n                                \"No generated tie is placed at a joint face.\",\r\n                                \"Confinement length rule: Lclear / 4\",\r\n                                \"Middle-zone length: Lclear / 2\",\r\n                                \"Confinement spacing: {:.0f} mm\".format(\r\n                                    confinement_spacing_mm\r\n                                ),\r\n                                \"Middle spacing: {:.0f} mm\".format(\r\n                                    middle_spacing_mm\r\n                                ),\r\n                                \"Hook type: {}\".format(\r\n                                    element_name(seismic_hook)\r\n                                ),\r\n                                \"Excluded beam-joint report:\",\r\n                                joint_report,\r\n                                \"Ignored beam selections:\",\r\n                                ignored_beams,\r\n                                \"Tie-zone report:\",\r\n                                zone_report,\r\n                                created_sets\r\n                            ]\r\n\r\n                        except Exception as error:\r\n                            sub_transaction.RollBack()\r\n                            TransactionManager.Instance.TransactionTaskDone()\r\n\r\n                            OUT = [\r\n                                \"ERROR: No tie changes were retained.\",\r\n                                str(error)\r\n                            ]",
