  "Nodes": [
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "be634cb3-59fb-4c49-b5d0-e18df02f1aff-000b3e61"
      ],
      "Id": "330f1cda21c54cbf96853db8f8010778",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "f739cb9d7fce44bf84a6dd3edaf3e3d0",
          "Name": "Element",
          "Description": "The selected elements.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select a model element from the document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Collections.Generic import List\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# INPUTS\r\ncolumn = UnwrapElement(IN[0])\r\nbar_type = UnwrapElement(IN[1])\r\nnumber_of_bars = int(IN[2])\r\n\r\ndef mm(value):\r\n    return UnitUtils.ConvertToInternalUnits(\r\n        value,\r\n        UnitTypeId.Millimeters\r\n    )\r\n\r\ndef intermediate_values(start, end, quantity):\r\n    \"\"\"Creates equally spaced coordinates excluding the corners.\"\"\"\r\n    values = []\r\n\r\n    if quantity <= 0:\r\n        return values\r\n\r\n    spacing = (end - start) / float(quantity + 1)\r\n\r\n    for i in range(1, quantity + 1):\r\n        values.append(start + spacing * i)\r\n\r\n    return values\r\n\r\ncover = mm(40)\r\n\r\nif column is None:\r\n    OUT = \"ERROR: Select one structural column.\"\r\n\r\nelif bar_type is None:\r\n    OUT = \"ERROR: Select one RebarBarType.\"\r\n\r\nelif not isinstance(bar_type, RebarBarType):\r\n    OUT = \"ERROR: IN[1] is not a valid RebarBarType.\"\r\n\r\nelif number_of_bars < 4:\r\n    OUT = \"ERROR: Minimum quantity is 4 bars.\"\r\n\r\nelif number_of_bars % 2 != 0:\r\n    OUT = \"ERROR: Use an even quantity: 4, 6, 8, 10, 12...\"\r\n\r\nelse:\r\n    box = column.get_BoundingBox(None)\r\n\r\n    if box is None:\r\n        OUT = \"ERROR: Could not obtain the column bounding box.\"\r\n\r\n    else:\r\n        bar_diameter = bar_type.BarNominalDiameter\r\n        offset = cover + bar_diameter / 2.0\r\n\r\n        x1 = box.Min.X + offset\r\n        x2 = box.Max.X - offset\r\n        y1 = box.Min.Y + offset\r\n        y2 = box.Max.Y - offset\r\n\r\n        z1 = box.Min.Z + offset\r\n        z2 = box.Max.Z - offset\r\n\r\n        usable_width = x2 - x1\r\n        usable_depth = y2 - y1\r\n\r\n        if usable_width <= 0 or usable_depth <= 0:\r\n            OUT = \"ERROR: Cover and bar diameter are too large for the column.\"\r\n\r\n        else:\r\n            # Four corner bars are always provided.\r\n            # Remaining bars are added symmetrically to opposite faces.\r\n            remaining_pairs = (number_of_bars - 4) // 2\r\n\r\n            if remaining_pairs == 0:\r\n                x_face_bars = 0\r\n                y_face_bars = 0\r\n\r\n            else:\r\n                # Allocate more bars to the longer faces.\r\n                x_face_bars = int(round(\r\n                    remaining_pairs *\r\n                    usable_width /\r\n                    (usable_width + usable_depth)\r\n                ))\r\n\r\n                # From 8 bars upward, place at least one\r\n                # intermediate bar on every face.\r\n                if remaining_pairs >= 2:\r\n                    x_face_bars = max(\r\n                        1,\r\n                        min(remaining_pairs - 1, x_face_bars)\r\n                    )\r\n\r\n                y_face_bars = remaining_pairs - x_face_bars\r\n\r\n            bar_locations = [\r\n                # Four corner bars\r\n                (x1, y1),\r\n                (x2, y1),\r\n                (x2, y2),\r\n                (x1, y2)\r\n            ]\r\n\r\n            # Intermediate bars on bottom and top faces\r\n            for x in intermediate_values(x1, x2, x_face_bars):\r\n                bar_locations.append((x, y1))\r\n                bar_locations.append((x, y2))\r\n\r\n            # Intermediate bars on left and right faces\r\n            for y in intermediate_values(y1, y2, y_face_bars):\r\n                bar_locations.append((x1, y))\r\n                bar_locations.append((x2, y))\r\n\r\n            # Find all existing rebars hosted by this column\r\n            existing_rebars = []\r\n\r\n            all_rebars = (\r\n                FilteredElementCollector(doc)\r\n                .OfClass(Rebar)\r\n                .WhereElementIsNotElementType()\r\n                .ToElements()\r\n            )\r\n\r\n            for existing_rebar in all_rebars:\r\n                try:\r\n                    if existing_rebar.GetHostId() == column.Id:\r\n                        existing_rebars.append(existing_rebar)\r\n                except:\r\n                    pass\r\n\r\n            deleted_count = len(existing_rebars)\r\n            created_bars = []\r\n\r\n            TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n            sub_transaction = SubTransaction(doc)\r\n            sub_transaction.Start()\r\n\r\n            try:\r\n                # Delete existing rebars in the selected column\r\n                for existing_rebar in existing_rebars:\r\n                    doc.Delete(existing_rebar.Id)\r\n\r\n                # Create the new main bars\r\n                for x, y in bar_locations:\r\n                    bar_line = Line.CreateBound(\r\n                        XYZ(x, y, z1),\r\n                        XYZ(x, y, z2)\r\n                    )\r\n\r\n                    curves = List[Curve]()\r\n                    curves.Add(bar_line)\r\n\r\n                    new_rebar = Rebar.CreateFromCurves(\r\n                        doc,\r\n                        RebarStyle.Standard,\r\n                        bar_type,\r\n                        None,\r\n                        None,\r\n                        column,\r\n                        XYZ.BasisX,\r\n                        curves,\r\n                        RebarHookOrientation.Left,\r\n                        RebarHookOrientation.Right,\r\n                        True,\r\n                        True\r\n                    )\r\n\r\n                    created_bars.append(new_rebar)\r\n\r\n                sub_transaction.Commit()\r\n                TransactionManager.Instance.TransactionTaskDone()\r\n\r\n                diameter_mm = UnitUtils.ConvertFromInternalUnits(\r\n                    bar_diameter,\r\n                    UnitTypeId.Millimeters\r\n                )\r\n\r\n                OUT = [\r\n                    \"SUCCESS: Main bars updated.\",\r\n                    \"Existing rebars deleted: {}\".format(deleted_count),\r\n                    \"Main bars created: {}\".format(len(created_bars)),\r\n                    \"Bar diameter: {:.0f} mm\".format(diameter_mm),\r\n                    \"Intermediate bars on top/bottom: {}\".format(\r\n                        x_face_bars\r\n                    ),\r\n                    \"Intermediate bars on left/right: {}\".format(\r\n                        y_face_bars\r\n                    ),\r\n                    created_bars\r\n                ]\r\n\r\n            except Exception as error:\r\n                sub_transaction.RollBack()\r\n                TransactionManager.Instance.TransactionTaskDone()\r\n\r\n                OUT = [\r\n                    \"ERROR: No changes were retained.\",\r\n                    str(error)\r\n                ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3a4281cec8e24b6db6513b2a97d2b58c",
      "NodeType": "PythonScriptNode",
      "Inputs": [
