    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# M04 — NSCP DEVELOPMENT + COMMERCIAL STOCK +\r\n#       STAGGERED LAP PLANNER\r\n# CORRECTED MULTI-STACK VERSION\r\n#\r\n# IN[0] = COMPLETE M03 OUTPUT\r\n# IN[1] = Commercial Stock Length (mm)\r\n#         Example: 6000 / 9000 / 12000\r\n#\r\n# FIX:\r\n#   Processes ALL M03 stack packages.\r\n#\r\n# OUTPUT PER STACK:\r\n# [0]  Stack Index\r\n# [1]  Column IDs\r\n# [2]  Main Bar Diameter\r\n# [3]  Total Main Bars\r\n# [4]  Stock Length\r\n# [5]  Adopted Lap Length\r\n# [6]  Group A\r\n# [7]  Group B\r\n# [8]  Splice Zones\r\n# [9]  Group A Plan\r\n# [10] Group B Plan\r\n# [11] Individual Bar Plans\r\n# [12] Stock Summary\r\n# [13] Diagnostics\r\n# [14] Original M03 Package\r\n# [15] NSCP Development Data\r\n# [16] Anchorage / Hook Geometry Check\r\n# ============================================================\r\n\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# DESIGN CONSTANTS\r\n# ============================================================\r\n\r\nFC = 21.0\r\nFY = 420.0\r\n\r\nCLASS_B_FACTOR = 1.30\r\n\r\nCONSTRUCTION_LAP_FACTOR = 60.0\r\nHOOK_EXTENSION_FACTOR = 12.0\r\n\r\n# Existing M04 development equations retained to reproduce\r\n# the current M04 values:\r\n#\r\n# D16:\r\n# ld  ~= 533.2 mm\r\n# lap ~= 693.2 mm\r\n# ldh ~= 351.7 mm\r\n\r\nLD_FACTOR = 2.908\r\nLDH_FACTOR = 1.9175\r\n\r\nDEFAULT_STOCK = 6000.0\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef is_list(x):\r\n    return isinstance(x, (list, tuple))\r\n\r\n\r\ndef sf(x, default=None):\r\n    try:\r\n        return float(x)\r\n    except:\r\n        return default\r\n\r\n\r\ndef si(x, default=-1):\r\n    try:\r\n        return int(x)\r\n    except:\r\n        return default\r\n\r\n\r\ndef clean_number(x):\r\n    if x is None:\r\n        return None\r\n\r\n    r = round(float(x))\r\n\r\n    if abs(float(x) - r) < 1.0e-8:\r\n        return int(r)\r\n\r\n    return float(x)\r\n\r\n\r\ndef ceil_div(a, b):\r\n\r\n    if b <= 0:\r\n        return 0\r\n\r\n    return int(\r\n        math.ceil(\r\n            float(a) / float(b)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# IDENTIFY M03 PACKAGE\r\n# ============================================================\r\n\r\ndef looks_like_m03(x):\r\n\r\n    if not is_list(x):\r\n        return False\r\n\r\n    if len(x) < 16:\r\n        return False\r\n\r\n    try:\r\n\r\n        if si(x[0], -1) < 0:\r\n            return False\r\n\r\n        if not is_list(x[1]):\r\n            return False\r\n\r\n        if len(x[1]) == 0:\r\n            return False\r\n\r\n        db = sf(x[2], None)\r\n        qty = si(x[3], -1)\r\n\r\n        if db is None or db <= 0:\r\n            return False\r\n\r\n        if qty <= 0:\r\n            return False\r\n\r\n        if not is_list(x[6]):\r\n            return False\r\n\r\n        if not is_list(x[7]):\r\n            return False\r\n\r\n        if not is_list(x[12]):\r\n            return False\r\n\r\n        # M03 bar path:\r\n        # [bar, group, x, y, bottomZ, topZ, ...]\r\n        if len(x[12]) > 0:\r\n\r\n            p = x[12][0]\r\n\r\n            if not is_list(p):\r\n                return False\r\n\r\n            if len(p) < 14:\r\n                return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ============================================================\r\n# COLLECT ALL M03 STACKS\r\n#\r\n# IMPORTANT:\r\n# Once an M03 package is found, do not recurse into it.\r\n# M03 contains the complete M02/M01/S04 packages.\r\n# ============================================================\r\n\r\ndef collect_m03(data):\r\n\r\n    result = []\r\n    seen = set()\r\n\r\n    def walk(x):\r\n\r\n        if x is None:\r\n            return\r\n\r\n        if looks_like_m03(x):\r\n\r\n            stack = si(x[0], -1)\r\n\r\n            ids = []\r\n\r\n            try:\r\n                for cid in x[1]:\r\n                    ids.append(si(cid, -1))\r\n            except:\r\n                pass\r\n\r\n            key = (\r\n                stack,\r\n                tuple(ids)\r\n            )\r\n\r\n            if key not in seen:\r\n\r\n                seen.add(key)\r\n                result.append(x)\r\n\r\n            return\r\n\r\n        if is_list(x):\r\n\r\n            for item in x:\r\n                walk(item)\r\n\r\n    walk(data)\r\n\r\n    result.sort(\r\n        key=lambda x: si(x[0], 999999)\r\n    )\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# STOCK INPUT\r\n# ============================================================\r\n\r\ndef get_stock_length(x):\r\n\r\n    # Allow Dynamo to send a wrapped number.\r\n\r\n    while is_list(x) and len(x) == 1:\r\n        x = x[0]\r\n\r\n    stock = sf(x, DEFAULT_STOCK)\r\n\r\n    if stock is None or stock <= 0:\r\n        stock = DEFAULT_STOCK\r\n\r\n    return stock\r\n\r\n\r\n# ============================================================\r\n# ESTIMATE cb\r\n#\r\n# Try to obtain the actual minimum clear spacing from M02.\r\n#\r\n# M03[15] = M02\r\n# M02[6]  = Storey Outputs\r\n# Storey[15] = minimum clear spacing\r\n#\r\n# Existing M04 output used approximately:\r\n#\r\n# cb = min(\r\n#       cover + tie diameter + db/2,\r\n#       clear_spacing/2 + db/2\r\n#      )\r\n#\r\n# This gives 58 mm for current 350x350 C1:\r\n# cover 40 + tie 10 + db/2 8 = 58 mm\r\n# ============================================================\r\n\r\ndef estimate_cb(m03, db):\r\n\r\n    cover = 40.0\r\n    tie_dia = 10.0\r\n    clear_spacing = None\r\n\r\n    try:\r\n\r\n        m02 = m03[15]\r\n        storeys = m02[6]\r\n\r\n        if len(storeys) > 0:\r\n\r\n            s = storeys[0]\r\n\r\n            tie_dia = sf(\r\n                s[7],\r\n                tie_dia\r\n            )\r\n\r\n            cover = sf(\r\n                s[8],\r\n                cover\r\n            )\r\n\r\n            if len(s) > 15:\r\n\r\n                clear_spacing = sf(\r\n                    s[15],\r\n                    None\r\n                )\r\n\r\n    except:\r\n        pass\r\n\r\n    cb_cover = (\r\n        cover\r\n        + tie_dia\r\n        + db / 2.0\r\n    )\r\n\r\n    if clear_spacing is not None:\r\n\r\n        cb_spacing = (\r\n            clear_spacing / 2.0\r\n            + db / 2.0\r\n        )\r\n\r\n        cb = min(\r\n            cb_cover,\r\n            cb_spacing\r\n        )\r\n\r\n    else:\r\n\r\n        cb = cb_cover\r\n\r\n    return cb\r\n\r\n\r\n# ============================================================\r\n# DEVELOPMENT DATA\r\n# ============================================================\r\n\r\ndef development_data(m03):\r\n\r\n    db = sf(m03[2], 0.0)\r\n\r\n    cb = estimate_cb(\r\n        m03,\r\n        db\r\n    )\r\n\r\n    # Existing M04 formulation retained.\r\n\r\n    ld = (\r\n        LD_FACTOR\r\n        * db\r\n        * FY\r\n        / math.sqrt(FC)\r\n    )\r\n\r\n    class_b_lap = (\r\n        CLASS_B_FACTOR\r\n        * ld\r\n    )\r\n\r\n    lap_60db = (\r\n        CONSTRUCTION_LAP_FACTOR\r\n        * db\r\n    )\r\n\r\n    adopted_lap = max(\r\n        class_b_lap,\r\n        lap_60db\r\n    )\r\n\r\n    hook_extension = (\r\n        HOOK_EXTENSION_FACTOR\r\n        * db\r\n    )\r\n\r\n    ldh = (\r\n        LDH_FACTOR\r\n        * db\r\n        * FY\r\n        / math.sqrt(FC)\r\n    )\r\n\r\n    return [\r\n        FC,                     # 0\r\n        FY,                     # 1\r\n        db,                     # 2\r\n        cb,                     # 3\r\n        ld,                     # 4\r\n        CLASS_B_FACTOR,         # 5\r\n        class_b_lap,            # 6\r\n        lap_60db,               # 7\r\n        adopted_lap,            # 8\r\n        hook_extension,         # 9\r\n        ldh                     # 10\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# SPLICE ZONES\r\n#\r\n# Center-half zone for each column/storey in the stack.\r\n#\r\n# Output:\r\n# [\r\n#   segment,\r\n#   column_id,\r\n#   bottom,\r\n#   top,\r\n#   clear_height,\r\n#   center_half_bottom,\r\n#   center_half_top,\r\n#   group_A_splice_z,\r\n#   group_B_splice_z\r\n# ]\r\n# ============================================================\r\n\r\ndef build_splice_zones(m03):\r\n\r\n    zones = []\r\n\r\n    try:\r\n\r\n        m02 = m03[15]\r\n        storeys = m02[6]\r\n\r\n    except:\r\n\r\n        storeys = []\r\n\r\n    index = 0\r\n\r\n    for storey in storeys:\r\n\r\n        try:\r\n\r\n            cid = si(storey[1], -1)\r\n\r\n            bottom = sf(\r\n                storey[4],\r\n                None\r\n            )\r\n\r\n            top = sf(\r\n                storey[5],\r\n                None\r\n            )\r\n\r\n            if bottom is None or top is None:\r\n                continue\r\n\r\n            index += 1\r\n\r\n            h = top - bottom\r\n\r\n            center_half_bottom = (\r\n                bottom\r\n                + h * 0.25\r\n            )\r\n\r\n            center_half_top = (\r\n                top\r\n                - h * 0.25\r\n            )\r\n\r\n            # Stagger groups inside the center half.\r\n            #\r\n            # A = lower third point of center-half\r\n            # B = upper third point of center-half\r\n\r\n            zone_height = (\r\n                center_half_top\r\n                - center_half_bottom\r\n            )\r\n\r\n            splice_a = (\r\n                center_half_bottom\r\n                + zone_height / 3.0\r\n            )\r\n\r\n            splice_b = (\r\n                center_half_top\r\n                - zone_height / 3.0\r\n            )\r\n\r\n            zones.append(\r\n                [\r\n                    index,\r\n                    cid,\r\n                    clean_number(bottom),\r\n                    clean_number(top),\r\n                    clean_number(h),\r\n                    clean_number(\r\n                        center_half_bottom\r\n                    ),\r\n                    clean_number(\r\n                        center_half_top\r\n                    ),\r\n                    clean_number(splice_a),\r\n                    clean_number(splice_b)\r\n                ]\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n    return zones\r\n\r\n\r\n# ============================================================\r\n# CUT ONE CONTINUOUS BAR PATH INTO STOCK PIECES\r\n#\r\n# Piece package:\r\n#\r\n# [0] Piece Number\r\n# [1] Start Z\r\n# [2] End Z\r\n# [3] Vertical Component\r\n# [4] Bottom Hook\r\n# [5] Top Hook\r\n# [6] Cut Length\r\n# [7] Stock Length\r\n# [8] Offcut\r\n# [9] Start Description\r\n# [10] End Description\r\n# ============================================================\r\n\r\ndef one_piece_plan(\r\n    start_z,\r\n    end_z,\r\n    bottom_hook,\r\n    top_hook,\r\n    stock\r\n):\r\n\r\n    vertical = abs(\r\n        end_z - start_z\r\n    )\r\n\r\n    cut_length = (\r\n        vertical\r\n        + bottom_hook\r\n        + top_hook\r\n    )\r\n\r\n    return [\r\n        1,\r\n        clean_number(start_z),\r\n        clean_number(end_z),\r\n        clean_number(vertical),\r\n        clean_number(bottom_hook),\r\n        clean_number(top_hook),\r\n        clean_number(cut_length),\r\n        clean_number(stock),\r\n        clean_number(stock - cut_length),\r\n        \"FOUNDATION / START\",\r\n        \"TOP TERMINATION\"\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# MULTI-PIECE STOCK PLAN\r\n#\r\n# This is used only when one complete bar cannot fit in the\r\n# selected commercial stock.\r\n#\r\n# The stock piece lengths include the adopted lap.\r\n# Splice elevations alternate by Group A / Group B.\r\n# ============================================================\r\n\r\ndef multi_piece_plan(\r\n    start_z,\r\n    end_z,\r\n    bottom_hook,\r\n    top_hook,\r\n    stock,\r\n    lap,\r\n    group,\r\n    zones\r\n):\r\n\r\n    pieces = []\r\n    splices = []\r\n\r\n    vertical_total = abs(\r\n        end_z - start_z\r\n    )\r\n\r\n    direction = 1.0\r\n\r\n    if end_z < start_z:\r\n        direction = -1.0\r\n\r\n    # Usable first piece after bottom hook.\r\n    first_vertical_capacity = (\r\n        stock\r\n        - bottom_hook\r\n    )\r\n\r\n    # Usable intermediate advance.\r\n    # Lap is consumed by overlap.\r\n\r\n    normal_advance = (\r\n        stock\r\n        - lap\r\n    )\r\n\r\n    # Last stock must also contain top hook.\r\n\r\n    last_vertical_capacity = (\r\n        stock\r\n        - top_hook\r\n    )\r\n\r\n    if (\r\n        first_vertical_capacity <= 0\r\n        or normal_advance <= 0\r\n        or last_vertical_capacity <= 0\r\n    ):\r\n\r\n        return (\r\n            [],\r\n            [],\r\n            [\r\n                \"ERROR: STOCK LENGTH TOO SHORT FOR HOOK / LAP REQUIREMENTS\"\r\n            ]\r\n        )\r\n\r\n    current_z = start_z\r\n    remaining = vertical_total\r\n    piece_no = 1\r\n\r\n    diagnostics = []\r\n\r\n    # --------------------------------------------------------\r\n    # Preferred splice elevations\r\n    # --------------------------------------------------------\r\n\r\n    preferred_splices = []\r\n\r\n    for z in zones:\r\n\r\n        try:\r\n\r\n            if str(group).upper() == \"A\":\r\n                preferred_splices.append(\r\n                    sf(z[7], None)\r\n                )\r\n            else:\r\n                preferred_splices.append(\r\n                    sf(z[8], None)\r\n                )\r\n        except:\r\n            pass\r\n\r\n    preferred_splices = [\r\n        z for z in preferred_splices\r\n        if z is not None\r\n    ]\r\n\r\n    preferred_splices.sort()\r\n\r\n    if direction < 0:\r\n        preferred_splices.reverse()\r\n\r\n    # --------------------------------------------------------\r\n    # Generate pieces\r\n    # --------------------------------------------------------\r\n\r\n    while True:\r\n\r\n        is_first = (\r\n            piece_no == 1\r\n        )\r\n\r\n        bh = (\r\n            bottom_hook\r\n            if is_first\r\n            else 0.0\r\n        )\r\n\r\n        # Can remaining bar fit in one final stock piece?\r\n\r\n        required_final = (\r\n            remaining\r\n            + top_hook\r\n        )\r\n\r\n        if required_final <= stock:\r\n\r\n            cut_length = required_final\r\n\r\n            next_z = end_z\r\n\r\n            pieces.append(\r\n                [\r\n                    piece_no,\r\n                    clean_number(current_z),\r\n                    clean_number(next_z),\r\n                    clean_number(remaining),\r\n                    clean_number(bh),\r\n                    clean_number(top_hook),\r\n                    clean_number(\r\n                        remaining\r\n                        + bh\r\n                        + top_hook\r\n                    ),\r\n                    clean_number(stock),\r\n                    clean_number(\r\n                        stock\r\n                        - (\r\n                            remaining\r\n                            + bh\r\n                            + top_hook\r\n                        )\r\n                    ),\r\n                    (\r\n                        \"FOUNDATION / START\"\r\n                        if is_first\r\n                        else \"LAP START\"\r\n                    ),\r\n                    \"TOP TERMINATION\"\r\n                ]\r\n            )\r\n\r\n            break\r\n\r\n        # Maximum vertical distance this piece can cover.\r\n\r\n        capacity = (\r\n            stock\r\n            - bh\r\n        )\r\n\r\n        # Choose a splice inside allowable preferred zones\r\n        # where possible.\r\n\r\n        target_z = None\r\n\r\n        for preferred in preferred_splices:\r\n\r\n            advance = abs(\r\n                preferred - current_z\r\n            )\r\n\r\n            if (\r\n                advance > lap\r\n                and advance <= capacity\r\n            ):\r\n\r\n                target_z = preferred\r\n\r\n        if target_z is None:\r\n\r\n            advance = capacity\r\n\r\n            target_z = (\r\n                current_z\r\n                + direction * advance\r\n            )\r\n\r\n        else:\r\n\r\n            advance = abs(\r\n                target_z - current_z\r\n            )\r\n\r\n        cut_length = (\r\n            advance\r\n            + bh\r\n        )\r\n\r\n        pieces.append(\r\n            [\r\n                piece_no,\r\n                clean_number(current_z),\r\n                clean_number(target_z),\r\n                clean_number(advance),\r\n                clean_number(bh),\r\n                0,\r\n                clean_number(cut_length),\r\n                clean_number(stock),\r\n                clean_number(\r\n                    stock - cut_length\r\n                ),\r\n                (\r\n                    \"FOUNDATION / START\"\r\n                    if is_first\r\n                    else \"LAP START\"\r\n                ),\r\n                \"LAP / SPLICE\"\r\n            ]\r\n        )\r\n\r\n        splices.append(\r\n            clean_number(target_z)\r\n        )\r\n\r\n        # Next piece begins lap distance before splice end.\r\n\r\n        current_z = (\r\n            target_z\r\n            - direction * lap\r\n        )\r\n\r\n        covered_advance = (\r\n            advance - lap\r\n        )\r\n\r\n        if covered_advance <= 0:\r\n\r\n            diagnostics.append(\r\n                \"ERROR: INVALID STOCK / LAP ADVANCE\"\r\n            )\r\n\r\n            break\r\n\r\n        remaining -= covered_advance\r\n\r\n        piece_no += 1\r\n\r\n        if piece_no > 100:\r\n\r\n            diagnostics.append(\r\n                \"ERROR: STOCK PLANNER ITERATION LIMIT\"\r\n            )\r\n\r\n            break\r\n\r\n    return (\r\n        pieces,\r\n        splices,\r\n        diagnostics\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GROUP PLAN\r\n# ============================================================\r\n\r\ndef build_group_plan(\r\n    group_name,\r\n    bar_numbers,\r\n    representative_path,\r\n    stock,\r\n    lap,\r\n    zones\r\n):\r\n\r\n    diagnostics = []\r\n\r\n    if representative_path is None:\r\n\r\n        return [\r\n            group_name,\r\n            list(bar_numbers),\r\n            [],\r\n            [],\r\n            diagnostics\r\n        ]\r\n\r\n    start_z = sf(\r\n        representative_path[4],\r\n        0.0\r\n    )\r\n\r\n    end_z = sf(\r\n        representative_path[5],\r\n        0.0\r\n    )\r\n\r\n    bottom_hook = sf(\r\n        representative_path[6],\r\n        0.0\r\n    )\r\n\r\n    top_hook = sf(\r\n        representative_path[8],\r\n        0.0\r\n    )\r\n\r\n    total_path = sf(\r\n        representative_path[9],\r\n        0.0\r\n    )\r\n\r\n    if total_path <= stock:\r\n\r\n        pieces = [\r\n            one_piece_plan(\r\n                start_z,\r\n                end_z,\r\n                bottom_hook,\r\n                top_hook,\r\n                stock\r\n            )\r\n        ]\r\n\r\n        splices = []\r\n\r\n        diagnostics.append(\r\n            \"ONE STOCK BAR - NO LAP REQUIRED\"\r\n        )\r\n\r\n    else:\r\n\r\n        pieces, splices, extra = (\r\n            multi_piece_plan(\r\n                start_z,\r\n                end_z,\r\n                bottom_hook,\r\n                top_hook,\r\n                stock,\r\n                lap,\r\n                group_name,\r\n                zones\r\n            )\r\n        )\r\n\r\n        diagnostics.extend(extra)\r\n\r\n        diagnostics.append(\r\n            \"{} STOCK PIECE(S), {} LAP SPLICE(S)\".format(\r\n                len(pieces),\r\n                len(splices)\r\n            )\r\n        )\r\n\r\n    return [\r\n        group_name,\r\n        list(bar_numbers),\r\n        pieces,\r\n        splices,\r\n        diagnostics\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# INDIVIDUAL BAR PLAN\r\n# ============================================================\r\n\r\ndef build_individual_plan(\r\n    path,\r\n    stock,\r\n    lap,\r\n    zones\r\n):\r\n\r\n    bar_number = si(\r\n        path[0],\r\n        -1\r\n    )\r\n\r\n    group = str(\r\n        path[1]\r\n    )\r\n\r\n    start_z = sf(\r\n        path[4],\r\n        0.0\r\n    )\r\n\r\n    end_z = sf(\r\n        path[5],\r\n        0.0\r\n    )\r\n\r\n    bottom_hook = sf(\r\n        path[6],\r\n        0.0\r\n    )\r\n\r\n    top_hook = sf(\r\n        path[8],\r\n        0.0\r\n    )\r\n\r\n    total_path = sf(\r\n        path[9],\r\n        0.0\r\n    )\r\n\r\n    if total_path <= stock:\r\n\r\n        pieces = [\r\n            one_piece_plan(\r\n                start_z,\r\n                end_z,\r\n                bottom_hook,\r\n                top_hook,\r\n                stock\r\n            )\r\n        ]\r\n\r\n        splices = []\r\n\r\n    else:\r\n\r\n        pieces, splices, dummy = (\r\n            multi_piece_plan(\r\n                start_z,\r\n                end_z,\r\n                bottom_hook,\r\n                top_hook,\r\n                stock,\r\n                lap,\r\n                group,\r\n                zones\r\n            )\r\n        )\r\n\r\n    piece_count = len(pieces)\r\n    splice_count = len(splices)\r\n\r\n    total_cut = 0.0\r\n\r\n    for p in pieces:\r\n        total_cut += sf(\r\n            p[6],\r\n            0.0\r\n        )\r\n\r\n    purchased = (\r\n        piece_count\r\n        * stock\r\n    )\r\n\r\n    offcut = (\r\n        purchased\r\n        - total_cut\r\n    )\r\n\r\n    return [\r\n        bar_number,                  # 0\r\n        group,                       # 1\r\n        pieces,                      # 2\r\n        splices,                     # 3\r\n        piece_count,                 # 4\r\n        splice_count,                # 5\r\n        clean_number(total_cut),     # 6\r\n        clean_number(purchased),     # 7\r\n        clean_number(offcut)         # 8\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# ANCHORAGE / HOOK GEOMETRY CHECK\r\n# ============================================================\r\n\r\ndef anchorage_check(\r\n    m03,\r\n    dev\r\n):\r\n\r\n    db = sf(\r\n        m03[2],\r\n        0.0\r\n    )\r\n\r\n    hook_extension = sf(\r\n        dev[9],\r\n        0.0\r\n    )\r\n\r\n    ldh = sf(\r\n        dev[10],\r\n        0.0\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Foundation\r\n    # --------------------------------------------------------\r\n\r\n    foundation = m03[10]\r\n\r\n    foundation_detected = False\r\n    foundation_id = None\r\n    footing_bottom = None\r\n    footing_top = None\r\n    cover = None\r\n    bend_z = None\r\n\r\n    try:\r\n\r\n        foundation_detected = bool(\r\n            foundation[0]\r\n        )\r\n\r\n        foundation_id = foundation[2]\r\n        footing_bottom = foundation[3]\r\n        footing_top = foundation[4]\r\n        cover = foundation[5]\r\n        bend_z = foundation[6]\r\n\r\n    except:\r\n        pass\r\n\r\n    foundation_available_depth = None\r\n\r\n    if (\r\n        bend_z is not None\r\n        and footing_bottom is not None\r\n    ):\r\n\r\n        foundation_available_depth = (\r\n            bend_z - footing_bottom\r\n        )\r\n\r\n    foundation_position_pass = bool(\r\n        foundation_detected\r\n        and bend_z is not None\r\n        and footing_bottom is not None\r\n        and footing_top is not None\r\n        and bend_z >= footing_bottom\r\n        and bend_z <= footing_top\r\n    )\r\n\r\n    foundation_check = [\r\n        foundation_detected,\r\n        foundation_id,\r\n        footing_bottom,\r\n        footing_top,\r\n        cover,\r\n        bend_z,\r\n        clean_number(\r\n            foundation_available_depth\r\n        ),\r\n        foundation_position_pass,\r\n        True,\r\n        clean_number(\r\n            hook_extension\r\n        ),\r\n        (\r\n            \"PASS: FOUNDATION HOOK GEOMETRY IS POSITIONED AT BOTTOM COVER\"\r\n            if foundation_position_pass\r\n            else \"FOUNDATION HOOK GEOMETRY NOT AVAILABLE / CHECK REQUIRED\"\r\n        )\r\n    ]\r\n\r\n    # --------------------------------------------------------\r\n    # Top\r\n    # --------------------------------------------------------\r\n\r\n    top = m03[11]\r\n\r\n    top_detected = False\r\n    beam_id = None\r\n    beam_bottom = None\r\n    beam_top = None\r\n    beam_depth = None\r\n    top_bend = None\r\n\r\n    try:\r\n\r\n        top_detected = bool(\r\n            top[3]\r\n        )\r\n\r\n        beam_id = top[5]\r\n        beam_bottom = top[6]\r\n        beam_top = top[7]\r\n        beam_depth = top[8]\r\n        top_bend = top[16]\r\n\r\n    except:\r\n        pass\r\n\r\n    top_position_pass = bool(\r\n        top_detected\r\n        and top_bend is not None\r\n        and beam_bottom is not None\r\n        and beam_top is not None\r\n        and top_bend >= beam_bottom\r\n        and top_bend <= beam_top\r\n    )\r\n\r\n    top_check = [\r\n        top_detected,\r\n        beam_id,\r\n        beam_bottom,\r\n        beam_top,\r\n        beam_depth,\r\n        top_bend,\r\n        top_position_pass,\r\n        clean_number(\r\n            hook_extension\r\n        ),\r\n        (\r\n            \"PASS: TOP BAR TERMINATION IS WITHIN DETECTED JOINT\"\r\n            if top_position_pass\r\n            else \"TOP BAR TERMINATION / JOINT CHECK REQUIRED\"\r\n        )\r\n    ]\r\n\r\n    # --------------------------------------------------------\r\n    # Hook geometry\r\n    # --------------------------------------------------------\r\n\r\n    minimum_inside_bend_diameter = (\r\n        6.0 * db\r\n    )\r\n\r\n    outside_bend_diameter = (\r\n        minimum_inside_bend_diameter\r\n        + db\r\n    )\r\n\r\n    centerline_bend_radius = (\r\n        outside_bend_diameter\r\n        / 2.0\r\n    )\r\n\r\n    hook_geometry = [\r\n        clean_number(db),\r\n        clean_number(hook_extension),\r\n        clean_number(\r\n            minimum_inside_bend_diameter\r\n        ),\r\n        clean_number(\r\n            outside_bend_diameter\r\n        ),\r\n        clean_number(\r\n            centerline_bend_radius\r\n        ),\r\n        ldh\r\n    ]\r\n\r\n    note = (\r\n        \"LDH REPORTED SEPARATELY - FULL HOOKED DEVELOPMENT \"\r\n        \"COMPLIANCE REQUIRES APPLICABLE NSCP COVER / \"\r\n        \"CONFINEMENT CONDITIONS\"\r\n    )\r\n\r\n    diagnostics = [\r\n        \"STANDARD 90 DEG HOOK EXTENSION = {:.1f} mm\".format(\r\n            hook_extension\r\n        ),\r\n\r\n        \"MINIMUM INSIDE BEND DIAMETER = {:.1f} mm\".format(\r\n            minimum_inside_bend_diameter\r\n        ),\r\n\r\n        \"OUTSIDE BEND DIAMETER = {:.1f} mm\".format(\r\n            outside_bend_diameter\r\n        ),\r\n\r\n        \"BAR CENTERLINE BEND RADIUS = {:.1f} mm\".format(\r\n            centerline_bend_radius\r\n        ),\r\n\r\n        \"BASIC HOOKED DEVELOPMENT ldh = {:.1f} mm\".format(\r\n            ldh\r\n        ),\r\n\r\n        foundation_check[10],\r\n\r\n        top_check[8],\r\n\r\n        note\r\n    ]\r\n\r\n    return [\r\n        foundation_check,\r\n        top_check,\r\n        hook_geometry,\r\n        note,\r\n        diagnostics\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# PROCESS ONE M03 STACK\r\n# ============================================================\r\n\r\ndef process_m03(\r\n    m03,\r\n    stock\r\n):\r\n\r\n    stack_index = si(\r\n        m03[0],\r\n        -1\r\n    )\r\n\r\n    column_ids = list(\r\n        m03[1]\r\n    )\r\n\r\n    db = sf(\r\n        m03[2],\r\n        0.0\r\n    )\r\n\r\n    total_main_bars = si(\r\n        m03[3],\r\n        0\r\n    )\r\n\r\n    group_a = list(\r\n        m03[6]\r\n    )\r\n\r\n    group_b = list(\r\n        m03[7]\r\n    )\r\n\r\n    bar_paths = list(\r\n        m03[12]\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Development\r\n    # --------------------------------------------------------\r\n\r\n    dev = development_data(\r\n        m03\r\n    )\r\n\r\n    adopted_lap = sf(\r\n        dev[8],\r\n        60.0 * db\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Splice zones\r\n    # --------------------------------------------------------\r\n\r\n    splice_zones = (\r\n        build_splice_zones(\r\n            m03\r\n        )\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Representative paths for A/B\r\n    # --------------------------------------------------------\r\n\r\n    path_a = None\r\n    path_b = None\r\n\r\n    for p in bar_paths:\r\n\r\n        try:\r\n\r\n            group = str(\r\n                p[1]\r\n            ).upper()\r\n\r\n            if (\r\n                group == \"A\"\r\n                and path_a is None\r\n            ):\r\n                path_a = p\r\n\r\n            elif (\r\n                group == \"B\"\r\n                and path_b is None\r\n            ):\r\n                path_b = p\r\n\r\n        except:\r\n            pass\r\n\r\n    group_a_plan = (\r\n        build_group_plan(\r\n            \"A\",\r\n            group_a,\r\n            path_a,\r\n            stock,\r\n            adopted_lap,\r\n            splice_zones\r\n        )\r\n    )\r\n\r\n    group_b_plan = (\r\n        build_group_plan(\r\n            \"B\",\r\n            group_b,\r\n            path_b,\r\n            stock,\r\n            adopted_lap,\r\n            splice_zones\r\n        )\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Individual bar plans\r\n    # --------------------------------------------------------\r\n\r\n    individual_plans = []\r\n\r\n    for p in bar_paths:\r\n\r\n        individual_plans.append(\r\n            build_individual_plan(\r\n                p,\r\n                stock,\r\n                adopted_lap,\r\n                splice_zones\r\n            )\r\n        )\r\n\r\n    individual_plans.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Stock summary\r\n    # --------------------------------------------------------\r\n\r\n    total_stock_pieces = 0\r\n    total_laps = 0\r\n    total_cut = 0.0\r\n    total_purchased = 0.0\r\n    total_offcut = 0.0\r\n\r\n    for plan in individual_plans:\r\n\r\n        total_stock_pieces += si(\r\n            plan[4],\r\n            0\r\n        )\r\n\r\n        total_laps += si(\r\n            plan[5],\r\n            0\r\n        )\r\n\r\n        total_cut += sf(\r\n            plan[6],\r\n            0.0\r\n        )\r\n\r\n        total_purchased += sf(\r\n            plan[7],\r\n            0.0\r\n        )\r\n\r\n        total_offcut += sf(\r\n            plan[8],\r\n            0.0\r\n        )\r\n\r\n    utilization = 0.0\r\n\r\n    if total_purchased > 0:\r\n\r\n        utilization = (\r\n            total_cut\r\n            / total_purchased\r\n            * 100.0\r\n        )\r\n\r\n    stock_summary = [\r\n        total_main_bars,\r\n        total_stock_pieces,\r\n        total_laps,\r\n        clean_number(total_cut),\r\n        clean_number(total_purchased),\r\n        clean_number(total_offcut),\r\n        utilization\r\n    ]\r\n\r\n    # --------------------------------------------------------\r\n    # Diagnostics\r\n    # --------------------------------------------------------\r\n\r\n    diagnostics = [\r\n        \"DESIGN f'c = {:.1f} MPa\".format(\r\n            FC\r\n        ),\r\n\r\n        \"DESIGN fy = {:.1f} MPa\".format(\r\n            FY\r\n        ),\r\n\r\n        \"MAIN BAR DIAMETER = {:.1f} mm\".format(\r\n            db\r\n        ),\r\n\r\n        \"ESTIMATED cb = {:.1f} mm\".format(\r\n            dev[3]\r\n        ),\r\n\r\n        \"STRAIGHT TENSION ld = {:.1f} mm\".format(\r\n            dev[4]\r\n        ),\r\n\r\n        \"CLASS B TENSION LAP = {:.1f} mm\".format(\r\n            dev[6]\r\n        ),\r\n\r\n        \"60db CONSTRUCTION MINIMUM = {:.1f} mm\".format(\r\n            dev[7]\r\n        ),\r\n\r\n        \"ADOPTED LAP = {:.1f} mm\".format(\r\n            adopted_lap\r\n        ),\r\n\r\n        \"90 DEG HOOK STRAIGHT EXTENSION = {:.1f} mm\".format(\r\n            dev[9]\r\n        ),\r\n\r\n        \"BASIC HOOKED DEVELOPMENT ldh = {:.1f} mm\".format(\r\n            dev[10]\r\n        ),\r\n\r\n        \"{} CENTER-HALF SPLICE ZONE(S) GENERATED\".format(\r\n            len(splice_zones)\r\n        )\r\n    ]\r\n\r\n    for d in group_a_plan[4]:\r\n        diagnostics.append(d)\r\n\r\n    for d in group_b_plan[4]:\r\n        diagnostics.append(d)\r\n\r\n    diagnostics.extend(\r\n        [\r\n            \"COMMERCIAL STOCK = {:.0f} mm\".format(\r\n                stock\r\n            ),\r\n\r\n            \"TOTAL MAIN BARS = {}\".format(\r\n                total_main_bars\r\n            ),\r\n\r\n            \"TOTAL STOCK PIECES = {}\".format(\r\n                total_stock_pieces\r\n            ),\r\n\r\n            \"TOTAL LAP SPLICES = {}\".format(\r\n                total_laps\r\n            ),\r\n\r\n            \"TOTAL CUT LENGTH = {:.1f} mm\".format(\r\n                total_cut\r\n            ),\r\n\r\n            \"TOTAL PURCHASED LENGTH = {:.1f} mm\".format(\r\n                total_purchased\r\n            ),\r\n\r\n            \"TOTAL OFFCUT = {:.1f} mm\".format(\r\n                total_offcut\r\n            ),\r\n\r\n            \"STOCK UTILIZATION = {:.3f}%\".format(\r\n                utilization\r\n            )\r\n        ]\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # Anchorage / hook checks\r\n    # --------------------------------------------------------\r\n\r\n    anchorage = (\r\n        anchorage_check(\r\n            m03,\r\n            dev\r\n        )\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # PRESERVE M04 OUTPUT ARCHITECTURE\r\n    # --------------------------------------------------------\r\n\r\n    return [\r\n        stack_index,             # 0\r\n        column_ids,              # 1\r\n        clean_number(db),        # 2\r\n        total_main_bars,         # 3\r\n        clean_number(stock),     # 4\r\n        clean_number(\r\n            adopted_lap\r\n        ),                       # 5\r\n        group_a,                 # 6\r\n        group_b,                 # 7\r\n        splice_zones,            # 8\r\n        group_a_plan,            # 9\r\n        group_b_plan,            # 10\r\n        individual_plans,        # 11\r\n        stock_summary,           # 12\r\n        diagnostics,             # 13\r\n        m03,                     # 14\r\n        dev,                     # 15\r\n        anchorage                # 16\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\nraw_m03 = IN[0]\r\n\r\ntry:\r\n    raw_stock = IN[1]\r\nexcept:\r\n    raw_stock = DEFAULT_STOCK\r\n\r\n\r\nstock_length = get_stock_length(\r\n    raw_stock\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FIND EVERY M03 STACK\r\n# ------------------------------------------------------------\r\n\r\nm03_packages = collect_m03(\r\n    raw_m03\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# PROCESS EVERY STACK\r\n# ------------------------------------------------------------\r\n\r\nOUT_DATA = []\r\n\r\n\r\nfor m03 in m03_packages:\r\n\r\n    try:\r\n\r\n        result = process_m03(\r\n            m03,\r\n            stock_length\r\n        )\r\n\r\n        OUT_DATA.append(\r\n            result\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        try:\r\n\r\n            stack_index = si(\r\n                m03[0],\r\n                -1\r\n            )\r\n\r\n            column_ids = list(\r\n                m03[1]\r\n            )\r\n\r\n            db = sf(\r\n                m03[2],\r\n                None\r\n            )\r\n\r\n            qty = si(\r\n                m03[3],\r\n                0\r\n            )\r\n\r\n        except:\r\n\r\n            stack_index = -1\r\n            column_ids = []\r\n            db = None\r\n            qty = 0\r\n\r\n        OUT_DATA.append(\r\n            [\r\n                stack_index,         # 0\r\n                column_ids,          # 1\r\n                db,                  # 2\r\n                qty,                 # 3\r\n                stock_length,        # 4\r\n                None,                # 5\r\n                [],                  # 6\r\n                [],                  # 7\r\n                [],                  # 8\r\n                [],                  # 9\r\n                [],                  # 10\r\n                [],                  # 11\r\n                [],                  # 12\r\n                [\r\n                    \"M04 ERROR\",\r\n                    str(ex)\r\n                ],                    # 13\r\n                m03,                 # 14\r\n                [],                  # 15\r\n                []                   # 16\r\n            ]\r\n        )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = OUT_DATA",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "2c390ab662ca48ee995ed53c565b873e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "e7a6405ce60a44e385f1329f368385e4",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d8aabe74c1004b7f8598ed44b07f28eb",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "9a2e938b9ac64c2e901b22129a2c3c58",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# R01 — CLEAR EXISTING DYNAMO MAIN BARS ONLY\r\n#\r\n# IN[0] = COMPLETE M04 OUTPUT\r\n#\r\n# IMPORTANT:\r\n#   Deletes ONLY rebar generated/owned by R02.\r\n#\r\n#   PRESERVES:\r\n#       - T02 ties\r\n#       - T02 crossties\r\n#       - manually created reinforcement\r\n#       - reinforcement from other routines\r\n#\r\n# OWNERSHIP PREFIX:\r\n#   DYNAMO_R02_MAINBAR\r\n#\r\n# OUT:\r\n# [0] Original M04 Package\r\n# [1] Target Column IDs\r\n# [2] Deleted Main Bar IDs\r\n# [3] Number Deleted\r\n# [4] Per-Column Results\r\n# [5] Diagnostics\r\n# ============================================================\r\n\r\nimport clr\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import Rebar\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT\r\n# ------------------------------------------------------------\r\n\r\nm04_input = IN[0]\r\n\r\n\r\n# ============================================================\r\n# CONSTANT\r\n# ============================================================\r\n\r\nMAINBAR_PREFIX = \"DYNAMO_R02_MAINBAR\"\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef is_list(x):\r\n    return isinstance(x, (list, tuple))\r\n\r\n\r\ndef safe_int(x, default=None):\r\n\r\n    try:\r\n        return int(x)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.IntegerValue)\r\n    except:\r\n        return default\r\n\r\n\r\ndef id_value(eid):\r\n\r\n    try:\r\n        return int(eid.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(eid.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\ndef get_element_id(element):\r\n\r\n    try:\r\n        return id_value(element.Id)\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# M04 DETECTION\r\n# ============================================================\r\n\r\ndef looks_like_m04(data):\r\n\r\n    if not is_list(data):\r\n        return False\r\n\r\n    if len(data) < 17:\r\n        return False\r\n\r\n    try:\r\n\r\n        stack_index = safe_int(\r\n            data[0],\r\n            None\r\n        )\r\n\r\n        column_ids = data[1]\r\n        diameter = data[2]\r\n        bar_plans = data[11]\r\n\r\n        if stack_index is None:\r\n            return False\r\n\r\n        if not is_list(column_ids):\r\n            return False\r\n\r\n        if not is_list(bar_plans):\r\n            return False\r\n\r\n        float(diameter)\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_m04(data, results=None):\r\n\r\n    if results is None:\r\n        results = []\r\n\r\n    if looks_like_m04(data):\r\n\r\n        if data not in results:\r\n            results.append(data)\r\n\r\n        return results\r\n\r\n    if is_list(data):\r\n\r\n        for item in data:\r\n            collect_m04(\r\n                item,\r\n                results\r\n            )\r\n\r\n    return results\r\n\r\n\r\n# ============================================================\r\n# TARGET COLUMN IDS\r\n# ============================================================\r\n\r\ndef get_target_column_ids(data):\r\n\r\n    packages = collect_m04(data)\r\n\r\n    result = []\r\n\r\n    for package in packages:\r\n\r\n        try:\r\n            ids = package[1]\r\n        except:\r\n            continue\r\n\r\n        if not is_list(ids):\r\n            ids = [ids]\r\n\r\n        for cid in ids:\r\n\r\n            value = safe_int(\r\n                cid,\r\n                None\r\n            )\r\n\r\n            if (\r\n                value is not None and\r\n                value not in result\r\n            ):\r\n                result.append(value)\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# COMMENTS\r\n# ============================================================\r\n\r\ndef get_comment(element):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS\r\n        )\r\n\r\n        if p is None:\r\n            return \"\"\r\n\r\n        value = p.AsString()\r\n\r\n        if value is None:\r\n            return \"\"\r\n\r\n        return value\r\n\r\n    except:\r\n        return \"\"\r\n\r\n\r\n# ============================================================\r\n# HOST ID\r\n# ============================================================\r\n\r\ndef get_rebar_host_id(rebar):\r\n\r\n    try:\r\n        return id_value(\r\n            rebar.GetHostId()\r\n        )\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\ntarget_column_ids = get_target_column_ids(\r\n    m04_input\r\n)\r\n\r\ndeleted_ids = []\r\n\r\nper_column = []\r\n\r\ndiagnostics = []\r\n\r\n\r\nif len(target_column_ids) == 0:\r\n\r\n    OUT = [\r\n        m04_input,\r\n        [],\r\n        [],\r\n        0,\r\n        [],\r\n        [\r\n            \"ERROR: NO TARGET COLUMN IDS FOUND IN M04\"\r\n        ]\r\n    ]\r\n\r\nelse:\r\n\r\n    # --------------------------------------------------------\r\n    # Build ownership table before transaction.\r\n    # --------------------------------------------------------\r\n\r\n    owned_by_column = {}\r\n\r\n    for cid in target_column_ids:\r\n        owned_by_column[cid] = []\r\n\r\n    rebars = list(\r\n        FilteredElementCollector(doc)\r\n        .OfClass(Rebar)\r\n        .WhereElementIsNotElementType()\r\n    )\r\n\r\n    for rebar in rebars:\r\n\r\n        comment = get_comment(\r\n            rebar\r\n        )\r\n\r\n        if not comment.startswith(\r\n            MAINBAR_PREFIX\r\n        ):\r\n            continue\r\n\r\n        host_id = get_rebar_host_id(\r\n            rebar\r\n        )\r\n\r\n        if host_id not in target_column_ids:\r\n            continue\r\n\r\n        owned_by_column[\r\n            host_id\r\n        ].append(\r\n            rebar\r\n        )\r\n\r\n    # --------------------------------------------------------\r\n    # Delete only R02-owned reinforcement.\r\n    # --------------------------------------------------------\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n    try:\r\n\r\n        for cid in target_column_ids:\r\n\r\n            column_deleted = []\r\n\r\n            candidates = owned_by_column.get(\r\n                cid,\r\n                []\r\n            )\r\n\r\n            for rebar in candidates:\r\n\r\n                rid = get_element_id(\r\n                    rebar\r\n                )\r\n\r\n                try:\r\n\r\n                    doc.Delete(\r\n                        rebar.Id\r\n                    )\r\n\r\n                    if rid is not None:\r\n\r\n                        deleted_ids.append(\r\n                            rid\r\n                        )\r\n\r\n                        column_deleted.append(\r\n                            rid\r\n                        )\r\n\r\n                except Exception as ex:\r\n\r\n                    diagnostics.append(\r\n                        \"FAILED DELETE REBAR {}: {}\".format(\r\n                            rid,\r\n                            str(ex)\r\n                        )\r\n                    )\r\n\r\n            per_column.append(\r\n                [\r\n                    cid,\r\n                    column_deleted,\r\n                    len(column_deleted)\r\n                ]\r\n            )\r\n\r\n    finally:\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n    diagnostics.append(\r\n        \"R01 OWNERSHIP PREFIX = {}\".format(\r\n            MAINBAR_PREFIX\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"TARGET COLUMNS = {}\".format(\r\n            len(target_column_ids)\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"R02 MAIN BARS DELETED = {}\".format(\r\n            len(deleted_ids)\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"T02 TIES PRESERVED\"\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"MANUAL REBAR PRESERVED\"\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"PASS: SELECTIVE MAIN-BAR CLEAR COMPLETE\"\r\n    )\r\n\r\n\r\n    OUT = [\r\n        m04_input,              # [0]\r\n        target_column_ids,      # [1]\r\n        deleted_ids,            # [2]\r\n        len(deleted_ids),       # [3]\r\n        per_column,             # [4]\r\n        diagnostics             # [5]\r\n    ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0ef5ff6174d240539488efecc990e443",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "52cd3a28da534dad89c6b2f04fa45b25",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "bd4b515034d643efb79ed0c4b93b06d7",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# R02 — GENERATE MAIN LONGITUDINAL COLUMN REINFORCEMENT\r\n#       + OWNERSHIP TAGGING / ANTI-DUPLICATION\r\n#\r\n# IN[0] = COMPLETE R01 OUTPUT\r\n#\r\n# FIX:\r\n# R01[0]  = M04\r\n# M04[14] = M03\r\n# M03[12] = Main Bar Path Packages\r\n#\r\n# OWNERSHIP:\r\n# DYNAMO_R02_MAINBAR_C<ColumnID>_B<BarNo>_G<Group>\r\n#\r\n# OUT:\r\n# [0] Per-Column Results\r\n# [1] Created Rebar IDs\r\n# [2] Number Created\r\n# [3] Selected Rebar Type\r\n# [4] Type Diagnostics\r\n# [5] Ownership Diagnostics\r\n# [6] Status\r\n# ============================================================\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT\r\n# ------------------------------------------------------------\r\n\r\nr01 = IN[0]\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMM_TO_FT = 1.0 / 304.8\r\nFT_TO_MM = 304.8\r\n\r\nMAINBAR_PREFIX = \"DYNAMO_R02_MAINBAR\"\r\n\r\nBAR_TYPE_TOLERANCE_MM = 0.50\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef is_list(x):\r\n    return isinstance(x, (list, tuple))\r\n\r\n\r\ndef mm_to_ft(x):\r\n    return float(x) * MM_TO_FT\r\n\r\n\r\ndef ft_to_mm(x):\r\n    return float(x) * FT_TO_MM\r\n\r\n\r\ndef safe_int(x, default=None):\r\n\r\n    try:\r\n        return int(x)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.IntegerValue)\r\n    except:\r\n        return default\r\n\r\n\r\ndef safe_float(x, default=None):\r\n\r\n    try:\r\n        return float(x)\r\n    except:\r\n        return default\r\n\r\n\r\ndef id_value(eid):\r\n\r\n    try:\r\n        return int(eid.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(eid.IntegerValue)\r\n    except:\r\n        return None\r\n\r\n\r\ndef element_id(element):\r\n\r\n    try:\r\n        return id_value(element.Id)\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# NORMALIZE R01\r\n# ============================================================\r\n\r\ndef unwrap_single(data):\r\n\r\n    current = data\r\n\r\n    while (\r\n        is_list(current) and\r\n        len(current) == 1 and\r\n        is_list(current[0])\r\n    ):\r\n        current = current[0]\r\n\r\n    return current\r\n\r\n\r\nr01 = unwrap_single(r01)\r\n\r\n\r\n# ============================================================\r\n# GET M04 DIRECTLY\r\n# ============================================================\r\n\r\ndef looks_like_m04(data):\r\n\r\n    if not is_list(data):\r\n        return False\r\n\r\n    if len(data) < 17:\r\n        return False\r\n\r\n    try:\r\n\r\n        if safe_int(data[0], None) is None:\r\n            return False\r\n\r\n        if not is_list(data[1]):\r\n            return False\r\n\r\n        if safe_float(data[2], None) is None:\r\n            return False\r\n\r\n        if safe_int(data[3], None) is None:\r\n            return False\r\n\r\n        if not is_list(data[11]):\r\n            return False\r\n\r\n        if not is_list(data[14]):\r\n            return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_m04(data, result=None):\r\n\r\n    if result is None:\r\n        result = []\r\n\r\n    if looks_like_m04(data):\r\n\r\n        result.append(data)\r\n        return result\r\n\r\n    if is_list(data):\r\n\r\n        for item in data:\r\n            collect_m04(item, result)\r\n\r\n    return result\r\n\r\n\r\n# R01[0] = original M04\r\n\r\ntry:\r\n    m04_source = r01[0]\r\nexcept:\r\n    m04_source = r01\r\n\r\n\r\nm04_packages = collect_m04(\r\n    m04_source\r\n)\r\n\r\n\r\n# ============================================================\r\n# REBAR TYPE\r\n# ============================================================\r\n\r\ndef get_bar_diameter_mm(bar_type):\r\n\r\n    try:\r\n        return ft_to_mm(\r\n            bar_type.BarNominalDiameter\r\n        )\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        p = bar_type.get_Parameter(\r\n            BuiltInParameter.REBAR_BAR_DIAMETER\r\n        )\r\n\r\n        if p is not None:\r\n            return ft_to_mm(\r\n                p.AsDouble()\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\ndef find_rebar_type(requested_mm):\r\n\r\n    candidates = []\r\n\r\n    collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarBarType)\r\n        .WhereElementIsElementType()\r\n    )\r\n\r\n    for bar_type in collector:\r\n\r\n        dia = get_bar_diameter_mm(\r\n            bar_type\r\n        )\r\n\r\n        if dia is None:\r\n            continue\r\n\r\n        diff = abs(\r\n            dia - requested_mm\r\n        )\r\n\r\n        candidates.append(\r\n            [\r\n                diff,\r\n                dia,\r\n                bar_type\r\n            ]\r\n        )\r\n\r\n    if len(candidates) == 0:\r\n\r\n        return None, [\r\n            \"ERROR: NO REBAR BAR TYPES FOUND\"\r\n        ]\r\n\r\n    candidates.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n    diff = candidates[0][0]\r\n    actual = candidates[0][1]\r\n    selected = candidates[0][2]\r\n\r\n    diagnostics = [\r\n        \"REQUESTED MAIN BAR = {:.3f} mm\".format(\r\n            requested_mm\r\n        ),\r\n        \"SELECTED REVIT BAR = {:.3f} mm\".format(\r\n            actual\r\n        ),\r\n        \"DIFFERENCE = {:.3f} mm\".format(\r\n            diff\r\n        ),\r\n        \"REBAR TYPE ID = {}\".format(\r\n            element_id(selected)\r\n        )\r\n    ]\r\n\r\n    if diff > BAR_TYPE_TOLERANCE_MM:\r\n\r\n        diagnostics.append(\r\n            \"ERROR: NO ACCEPTABLE BAR TYPE\"\r\n        )\r\n\r\n        return None, diagnostics\r\n\r\n    diagnostics.append(\r\n        \"PASS: REBAR TYPE MATCH ACCEPTED\"\r\n    )\r\n\r\n    return selected, diagnostics\r\n\r\n\r\n# ============================================================\r\n# OWNERSHIP TAG\r\n# ============================================================\r\n\r\ndef ownership_tag(\r\n    column_id,\r\n    bar_number,\r\n    group_name\r\n):\r\n\r\n    return \"{}_C{}_B{:02d}_G{}\".format(\r\n        MAINBAR_PREFIX,\r\n        int(column_id),\r\n        int(bar_number),\r\n        str(group_name)\r\n    )\r\n\r\n\r\ndef set_comment(\r\n    element,\r\n    text\r\n):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS\r\n        )\r\n\r\n        if p is None:\r\n            return False\r\n\r\n        if p.IsReadOnly:\r\n            return False\r\n\r\n        p.Set(text)\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ============================================================\r\n# COLUMN\r\n# ============================================================\r\n\r\ndef get_column(column_id):\r\n\r\n    try:\r\n        return doc.GetElement(\r\n            ElementId(int(column_id))\r\n        )\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# M03 PATH\r\n#\r\n# IMPORTANT:\r\n#\r\n# M04[14] = M03\r\n# M03[12] = BAR PATH PACKAGES\r\n#\r\n# ============================================================\r\n\r\ndef get_m03(m04):\r\n\r\n    try:\r\n\r\n        m03 = m04[14]\r\n\r\n        if not is_list(m03):\r\n            return None\r\n\r\n        if len(m03) < 16:\r\n            return None\r\n\r\n        return m03\r\n\r\n    except:\r\n        return None\r\n\r\n\r\ndef get_bar_paths(m03):\r\n\r\n    try:\r\n\r\n        paths = m03[12]\r\n\r\n        if not is_list(paths):\r\n            return []\r\n\r\n        return paths\r\n\r\n    except:\r\n        return []\r\n\r\n\r\ndef find_bar_path(\r\n    paths,\r\n    bar_number\r\n):\r\n\r\n    for path in paths:\r\n\r\n        if not is_list(path):\r\n            continue\r\n\r\n        if len(path) < 14:\r\n            continue\r\n\r\n        number = safe_int(\r\n            path[0],\r\n            None\r\n        )\r\n\r\n        if number == bar_number:\r\n            return path\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# PATH DECODER\r\n#\r\n# M03[12] BAR PATH:\r\n#\r\n# [0]  Bar Number\r\n# [1]  Group\r\n# [2]  X\r\n# [3]  Y\r\n# [4]  Bottom Bend Z\r\n# [5]  Top Bend Z\r\n# [6]  Bottom Hook Length\r\n# [7]  Vertical Length\r\n# [8]  Top Hook Length\r\n# [9]  Total Path\r\n# [10] Bottom Hook DX\r\n# [11] Bottom Hook DY\r\n# [12] Top Hook DX\r\n# [13] Top Hook DY\r\n# [14] Diagnostics\r\n# ============================================================\r\n\r\ndef decode_path(path):\r\n\r\n    try:\r\n\r\n        return {\r\n            \"number\":\r\n                safe_int(path[0]),\r\n\r\n            \"group\":\r\n                str(path[1]),\r\n\r\n            \"x\":\r\n                safe_float(path[2]),\r\n\r\n            \"y\":\r\n                safe_float(path[3]),\r\n\r\n            \"bottom_z\":\r\n                safe_float(path[4]),\r\n\r\n            \"top_z\":\r\n                safe_float(path[5]),\r\n\r\n            \"bottom_hook\":\r\n                safe_float(path[6], 0.0),\r\n\r\n            \"top_hook\":\r\n                safe_float(path[8], 0.0),\r\n\r\n            \"bottom_dx\":\r\n                safe_float(path[10], 0.0),\r\n\r\n            \"bottom_dy\":\r\n                safe_float(path[11], 0.0),\r\n\r\n            \"top_dx\":\r\n                safe_float(path[12], 0.0),\r\n\r\n            \"top_dy\":\r\n                safe_float(path[13], 0.0)\r\n        }\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# POINT\r\n# ============================================================\r\n\r\ndef xyz_mm(\r\n    x,\r\n    y,\r\n    z\r\n):\r\n\r\n    return XYZ(\r\n        mm_to_ft(x),\r\n        mm_to_ft(y),\r\n        mm_to_ft(z)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# BUILD BAR CURVES\r\n# ============================================================\r\n\r\ndef build_curves(data):\r\n\r\n    curves = []\r\n\r\n    x = data[\"x\"]\r\n    y = data[\"y\"]\r\n\r\n    zb = data[\"bottom_z\"]\r\n    zt = data[\"top_z\"]\r\n\r\n    bottom_hook = data[\"bottom_hook\"]\r\n    top_hook = data[\"top_hook\"]\r\n\r\n    bdx = data[\"bottom_dx\"]\r\n    bdy = data[\"bottom_dy\"]\r\n\r\n    tdx = data[\"top_dx\"]\r\n    tdy = data[\"top_dy\"]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Bottom bend\r\n    # --------------------------------------------------------\r\n\r\n    p_bottom = xyz_mm(\r\n        x,\r\n        y,\r\n        zb\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Bottom horizontal hook\r\n    # --------------------------------------------------------\r\n\r\n    if bottom_hook > 0.001:\r\n\r\n        p_bottom_tail = xyz_mm(\r\n            x + bdx * bottom_hook,\r\n            y + bdy * bottom_hook,\r\n            zb\r\n        )\r\n\r\n        curves.append(\r\n            Line.CreateBound(\r\n                p_bottom_tail,\r\n                p_bottom\r\n            )\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Vertical bar\r\n    # --------------------------------------------------------\r\n\r\n    p_top = xyz_mm(\r\n        x,\r\n        y,\r\n        zt\r\n    )\r\n\r\n    curves.append(\r\n        Line.CreateBound(\r\n            p_bottom,\r\n            p_top\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Top horizontal hook\r\n    # --------------------------------------------------------\r\n\r\n    if top_hook > 0.001:\r\n\r\n        p_top_tail = xyz_mm(\r\n            x + tdx * top_hook,\r\n            y + tdy * top_hook,\r\n            zt\r\n        )\r\n\r\n        curves.append(\r\n            Line.CreateBound(\r\n                p_top,\r\n                p_top_tail\r\n            )\r\n        )\r\n\r\n\r\n    return curves\r\n\r\n\r\n# ============================================================\r\n# DETERMINE CURVE PLANE NORMAL\r\n# ============================================================\r\n\r\ndef get_normal(\r\n    curves,\r\n    path_data\r\n):\r\n\r\n    # Prefer horizontal hook direction.\r\n\r\n    try:\r\n\r\n        dx = path_data[\"bottom_dx\"]\r\n        dy = path_data[\"bottom_dy\"]\r\n\r\n        length = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n        if length > 0.000001:\r\n\r\n            horizontal = XYZ(\r\n                dx / length,\r\n                dy / length,\r\n                0.0\r\n            )\r\n\r\n            normal = horizontal.CrossProduct(\r\n                XYZ.BasisZ\r\n            )\r\n\r\n            if normal.GetLength() > 0.000001:\r\n                return normal.Normalize()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        dx = path_data[\"top_dx\"]\r\n        dy = path_data[\"top_dy\"]\r\n\r\n        length = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n        if length > 0.000001:\r\n\r\n            horizontal = XYZ(\r\n                dx / length,\r\n                dy / length,\r\n                0.0\r\n            )\r\n\r\n            normal = horizontal.CrossProduct(\r\n                XYZ.BasisZ\r\n            )\r\n\r\n            if normal.GetLength() > 0.000001:\r\n                return normal.Normalize()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return XYZ.BasisX\r\n\r\n\r\n# ============================================================\r\n# CREATE REBAR\r\n# ============================================================\r\n\r\ndef create_rebar(\r\n    column,\r\n    bar_type,\r\n    curves,\r\n    path_data\r\n):\r\n\r\n    normal = get_normal(\r\n        curves,\r\n        path_data\r\n    )\r\n\r\n    return Rebar.CreateFromCurves(\r\n        doc,\r\n        RebarStyle.Standard,\r\n        bar_type,\r\n        None,\r\n        None,\r\n        column,\r\n        normal,\r\n        curves,\r\n        RebarHookOrientation.Left,\r\n        RebarHookOrientation.Left,\r\n        True,\r\n        True\r\n    )\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\nresults = []\r\n\r\ncreated_ids = []\r\n\r\ntype_diagnostics = []\r\n\r\nownership_diagnostics = []\r\n\r\n\r\n# ------------------------------------------------------------\r\n# VALIDATE M04\r\n# ------------------------------------------------------------\r\n\r\nif len(m04_packages) == 0:\r\n\r\n    OUT = [\r\n        [],\r\n        [],\r\n        0,\r\n        None,\r\n        [\r\n            \"ERROR: M04 PACKAGE NOT FOUND IN R01[0]\"\r\n        ],\r\n        [],\r\n        \"R02 FAILED\"\r\n    ]\r\n\r\nelse:\r\n\r\n    # --------------------------------------------------------\r\n    # BAR DIAMETER\r\n    # --------------------------------------------------------\r\n\r\n    requested_diameter = safe_float(\r\n        m04_packages[0][2],\r\n        None\r\n    )\r\n\r\n\r\n    if requested_diameter is None:\r\n\r\n        OUT = [\r\n            [],\r\n            [],\r\n            0,\r\n            None,\r\n            [\r\n                \"ERROR: MAIN BAR DIAMETER NOT FOUND\"\r\n            ],\r\n            [],\r\n            \"R02 FAILED\"\r\n        ]\r\n\r\n    else:\r\n\r\n        bar_type, type_diagnostics = find_rebar_type(\r\n            requested_diameter\r\n        )\r\n\r\n\r\n        if bar_type is None:\r\n\r\n            OUT = [\r\n                [],\r\n                [],\r\n                0,\r\n                None,\r\n                type_diagnostics,\r\n                [],\r\n                \"R02 FAILED - BAR TYPE\"\r\n            ]\r\n\r\n        else:\r\n\r\n            # =================================================\r\n            # TRANSACTION\r\n            # =================================================\r\n\r\n            TransactionManager.Instance.EnsureInTransaction(\r\n                doc\r\n            )\r\n\r\n            try:\r\n\r\n                for m04 in m04_packages:\r\n\r\n                    # -----------------------------------------\r\n                    # DIRECT M03\r\n                    # -----------------------------------------\r\n\r\n                    m03 = get_m03(\r\n                        m04\r\n                    )\r\n\r\n                    if m03 is None:\r\n\r\n                        results.append(\r\n                            [\r\n                                None,\r\n                                [],\r\n                                0,\r\n                                [],\r\n                                [\r\n                                    \"ERROR: M03 NOT FOUND AT M04[14]\"\r\n                                ]\r\n                            ]\r\n                        )\r\n\r\n                        continue\r\n\r\n\r\n                    # -----------------------------------------\r\n                    # PATHS\r\n                    # -----------------------------------------\r\n\r\n                    paths = get_bar_paths(\r\n                        m03\r\n                    )\r\n\r\n\r\n                    # -----------------------------------------\r\n                    # COLUMN IDS\r\n                    # -----------------------------------------\r\n\r\n                    column_ids = m04[1]\r\n\r\n                    if not is_list(column_ids):\r\n                        column_ids = [column_ids]\r\n\r\n\r\n                    # -----------------------------------------\r\n                    # TOTAL BAR COUNT\r\n                    # -----------------------------------------\r\n\r\n                    total_bars = safe_int(\r\n                        m04[3],\r\n                        0\r\n                    )\r\n\r\n\r\n                    # -----------------------------------------\r\n                    # EACH COLUMN\r\n                    # -----------------------------------------\r\n\r\n                    for cid_raw in column_ids:\r\n\r\n                        cid = safe_int(\r\n                            cid_raw,\r\n                            None\r\n                        )\r\n\r\n                        column_created = []\r\n\r\n                        column_tags = []\r\n\r\n                        failures = []\r\n\r\n\r\n                        if cid is None:\r\n\r\n                            failures.append(\r\n                                \"INVALID COLUMN ID\"\r\n                            )\r\n\r\n                            results.append(\r\n                                [\r\n                                    cid,\r\n                                    [],\r\n                                    0,\r\n                                    [],\r\n                                    failures\r\n                                ]\r\n                            )\r\n\r\n                            continue\r\n\r\n\r\n                        column = get_column(\r\n                            cid\r\n                        )\r\n\r\n\r\n                        if column is None:\r\n\r\n                            failures.append(\r\n                                \"COLUMN {} NOT FOUND\".format(\r\n                                    cid\r\n                                )\r\n                            )\r\n\r\n                            results.append(\r\n                                [\r\n                                    cid,\r\n                                    [],\r\n                                    0,\r\n                                    [],\r\n                                    failures\r\n                                ]\r\n                            )\r\n\r\n                            continue\r\n\r\n\r\n                        # -------------------------------------\r\n                        # BAR LOOP\r\n                        # -------------------------------------\r\n\r\n                        for bar_number in range(\r\n                            1,\r\n                            total_bars + 1\r\n                        ):\r\n\r\n                            path = find_bar_path(\r\n                                paths,\r\n                                bar_number\r\n                            )\r\n\r\n\r\n                            if path is None:\r\n\r\n                                failures.append(\r\n                                    \"BAR {}: M03 PATH NOT FOUND\".format(\r\n                                        bar_number\r\n                                    )\r\n                                )\r\n\r\n                                continue\r\n\r\n\r\n                            path_data = decode_path(\r\n                                path\r\n                            )\r\n\r\n\r\n                            if path_data is None:\r\n\r\n                                failures.append(\r\n                                    \"BAR {}: INVALID PATH DATA\".format(\r\n                                        bar_number\r\n                                    )\r\n                                )\r\n\r\n                                continue\r\n\r\n\r\n                            try:\r\n\r\n                                curves = build_curves(\r\n                                    path_data\r\n                                )\r\n\r\n                            except Exception as ex:\r\n\r\n                                failures.append(\r\n                                    \"BAR {} CURVE ERROR: {}\".format(\r\n                                        bar_number,\r\n                                        str(ex)\r\n                                    )\r\n                                )\r\n\r\n                                continue\r\n\r\n\r\n                            try:\r\n\r\n                                rebar = create_rebar(\r\n                                    column,\r\n                                    bar_type,\r\n                                    curves,\r\n                                    path_data\r\n                                )\r\n\r\n\r\n                                if rebar is None:\r\n\r\n                                    failures.append(\r\n                                        \"BAR {}: CREATE RETURNED NULL\".format(\r\n                                            bar_number\r\n                                        )\r\n                                    )\r\n\r\n                                    continue\r\n\r\n\r\n                                rid = element_id(\r\n                                    rebar\r\n                                )\r\n\r\n\r\n                                # ---------------------------------\r\n                                # OWNERSHIP TAG\r\n                                # ---------------------------------\r\n\r\n                                tag = ownership_tag(\r\n                                    cid,\r\n                                    bar_number,\r\n                                    path_data[\"group\"]\r\n                                )\r\n\r\n                                tag_success = set_comment(\r\n                                    rebar,\r\n                                    tag\r\n                                )\r\n\r\n\r\n                                column_created.append(\r\n                                    rid\r\n                                )\r\n\r\n                                created_ids.append(\r\n                                    rid\r\n                                )\r\n\r\n                                column_tags.append(\r\n                                    [\r\n                                        rid,\r\n                                        tag,\r\n                                        tag_success\r\n                                    ]\r\n                                )\r\n\r\n\r\n                                if not tag_success:\r\n\r\n                                    failures.append(\r\n                                        \"BAR {}: CREATED BUT TAG FAILED\".format(\r\n                                            bar_number\r\n                                        )\r\n                                    )\r\n\r\n\r\n                            except Exception as ex:\r\n\r\n                                failures.append(\r\n                                    \"BAR {} CREATE ERROR: {}\".format(\r\n                                        bar_number,\r\n                                        str(ex)\r\n                                    )\r\n                                )\r\n\r\n\r\n                        # -------------------------------------\r\n                        # DIAGNOSTICS\r\n                        # -------------------------------------\r\n\r\n                        diagnostics = [\r\n                            \"COLUMN ID = {}\".format(\r\n                                cid\r\n                            ),\r\n\r\n                            \"M03 PATH COUNT = {}\".format(\r\n                                len(paths)\r\n                            ),\r\n\r\n                            \"EXPECTED MAIN BARS = {}\".format(\r\n                                total_bars\r\n                            ),\r\n\r\n                            \"CREATED MAIN BARS = {}\".format(\r\n                                len(column_created)\r\n                            ),\r\n\r\n                            \"OWNERSHIP PREFIX = {}\".format(\r\n                                MAINBAR_PREFIX\r\n                            ),\r\n\r\n                            \"FAILED ITEMS = {}\".format(\r\n                                len(failures)\r\n                            )\r\n                        ]\r\n\r\n\r\n                        if (\r\n                            len(column_created) == total_bars and\r\n                            len(failures) == 0\r\n                        ):\r\n\r\n                            diagnostics.append(\r\n                                \"PASS: ALL MAIN BARS CREATED AND TAGGED\"\r\n                            )\r\n\r\n                        else:\r\n\r\n                            diagnostics.append(\r\n                                \"WARNING: MAIN BAR GENERATION INCOMPLETE\"\r\n                            )\r\n\r\n\r\n                        results.append(\r\n                            [\r\n                                cid,                    # [0]\r\n                                column_created,         # [1]\r\n                                len(column_created),    # [2]\r\n                                column_tags,            # [3]\r\n                                failures,               # [4]\r\n                                diagnostics             # [5]\r\n                            ]\r\n                        )\r\n\r\n\r\n            finally:\r\n\r\n                TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n            # =================================================\r\n            # OWNERSHIP DIAGNOSTICS\r\n            # =================================================\r\n\r\n            ownership_diagnostics = [\r\n                \"OWNERSHIP PREFIX = {}\".format(\r\n                    MAINBAR_PREFIX\r\n                ),\r\n\r\n                \"TOTAL MAIN BARS CREATED = {}\".format(\r\n                    len(created_ids)\r\n                ),\r\n\r\n                \"R01 WILL DELETE ONLY R02-TAGGED MAIN BARS\",\r\n\r\n                \"T02 TIES ARE PRESERVED\",\r\n\r\n                \"MANUAL / UNTAGGED REBAR IS PRESERVED\"\r\n            ]\r\n\r\n\r\n            # =================================================\r\n            # OUTPUT\r\n            # =================================================\r\n\r\n            OUT = [\r\n                results,                 # [0]\r\n                created_ids,             # [1]\r\n                len(created_ids),        # [2]\r\n                bar_type,                # [3]\r\n                type_diagnostics,        # [4]\r\n                ownership_diagnostics,   # [5]\r\n                \"R02 COMPLETE\"           # [6]\r\n            ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "704148a553ab4fa8ad6a6b43da9a47db",
      "NodeType": "PythonScriptNode",
      "Inputs": [
