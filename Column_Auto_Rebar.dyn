  "Nodes": [
    {
      "ConcreteType": "DSRevitNodesUI.StructuralColumnTypes, DSRevitNodesUI",
      "SelectedIndex": 2,
      "SelectedString": "C1",
      "Id": "6ed6e0d97f0b4659a5d8735fa346dec2",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "da04f6f03ed24c9598a758f63231344f",
          "Name": "Column Types",
          "Description": "The selected Column Types",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select a structural column type in the active document"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S01 — READ SELECTED STRUCTURAL COLUMN TYPE\r\n#\r\n# IN[0] = Structural Column Type\r\n#\r\n# Finds all placed Structural Column instances that use\r\n# the selected type.\r\n#\r\n# OUT:\r\n# [0] Selected Column Type\r\n# [1] Column Instances\r\n# [2] Element IDs\r\n# [3] Instance Count\r\n# [4] Type Name\r\n# ============================================================\r\n\r\nimport clr\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    FilteredElementCollector,\r\n    BuiltInCategory,\r\n    FamilyInstance,\r\n    ElementId\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# DYNAMO / REVIT NODES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# DOCUMENT\r\n# ------------------------------------------------------------\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT\r\n# ------------------------------------------------------------\r\n\r\ninput_type = IN[0]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNWRAP INPUT\r\n# ------------------------------------------------------------\r\n\r\ntry:\r\n    selected_type = UnwrapElement(input_type)\r\nexcept:\r\n    selected_type = input_type\r\n\r\n\r\n# ------------------------------------------------------------\r\n# VALIDATION\r\n# ------------------------------------------------------------\r\n\r\nif selected_type is None:\r\n\r\n    OUT = [\r\n        None,\r\n        [],\r\n        [],\r\n        0,\r\n        \"No column type selected\"\r\n    ]\r\n\r\nelse:\r\n\r\n    # --------------------------------------------------------\r\n    # SELECTED TYPE ID\r\n    # --------------------------------------------------------\r\n\r\n    selected_type_id = selected_type.Id\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # GET TYPE NAME\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n        type_name = selected_type.Name\r\n\r\n    except:\r\n\r\n        try:\r\n            type_name = selected_type.get_Parameter(\r\n                BuiltInParameter.SYMBOL_NAME_PARAM\r\n            ).AsString()\r\n\r\n        except:\r\n            type_name = \"Unknown\"\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLLECT STRUCTURAL COLUMNS\r\n    # --------------------------------------------------------\r\n\r\n    all_columns = (\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(BuiltInCategory.OST_StructuralColumns)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FILTER BY SELECTED TYPE\r\n    # --------------------------------------------------------\r\n\r\n    matching_columns = []\r\n\r\n    for column in all_columns:\r\n\r\n        try:\r\n\r\n            if column.GetTypeId() == selected_type_id:\r\n                matching_columns.append(column)\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ELEMENT IDS\r\n    # --------------------------------------------------------\r\n\r\n    element_ids = []\r\n\r\n    for column in matching_columns:\r\n\r\n        try:\r\n            element_ids.append(column.Id.Value)\r\n\r\n        except:\r\n\r\n            try:\r\n                element_ids.append(column.Id.IntegerValue)\r\n\r\n            except:\r\n                element_ids.append(str(column.Id))\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # OUTPUT\r\n    # --------------------------------------------------------\r\n\r\n    OUT = [\r\n        selected_type,\r\n        matching_columns,\r\n        element_ids,\r\n        len(matching_columns),\r\n        type_name\r\n    ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cf539cc67574478ca4fc90fc5ee65f94",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "7f0c76777b2849d0a087c859d965b07a",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
