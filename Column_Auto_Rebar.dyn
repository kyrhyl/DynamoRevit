    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# M01 — COLUMN STACK BUILDER\r\n# VERSION 2\r\n#\r\n# PURPOSE:\r\n# Groups vertically related Structural Column instances into\r\n# continuous column stacks for longitudinal reinforcement.\r\n#\r\n# Unlike V1, columns DO NOT need identical insertion points.\r\n#\r\n# Stack matching uses:\r\n#   1. Plan footprint overlap\r\n#   2. Relative center proximity\r\n#   3. Vertical sequencing\r\n#\r\n# This allows:\r\n#   - different column sizes between storeys\r\n#   - small offsets\r\n#   - different insertion/justification conditions\r\n#\r\n#\r\n# IN[0] = S03 Support Packages\r\n# IN[1] = S04 Column Zone Packages\r\n#\r\n#\r\n# OUT = Column Stack Packages\r\n#\r\n#\r\n# STACK PACKAGE\r\n# ------------------------------------------------------------\r\n# [0]  Stack Index\r\n# [1]  Column Elements\r\n# [2]  Column IDs\r\n# [3]  Stack Bottom mm\r\n# [4]  Stack Top mm\r\n# [5]  Stack Height mm\r\n# [6]  Average Center X mm\r\n# [7]  Average Center Y mm\r\n# [8]  Column Count\r\n# [9]  Storey Packages\r\n# [10] Foundation Package\r\n# [11] Diagnostics\r\n#\r\n#\r\n# STOREY PACKAGE\r\n# ------------------------------------------------------------\r\n# [0] Column Element\r\n# [1] Column ID\r\n# [2] Bottom mm\r\n# [3] Top mm\r\n# [4] Width mm\r\n# [5] Depth mm\r\n# [6] Center X mm\r\n# [7] Center Y mm\r\n# [8] Rotation degrees\r\n# [9] S03 Package\r\n# [10] S04 Package\r\n#\r\n# ============================================================\r\n\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# ============================================================\r\n# REVIT / DYNAMO\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMM_PER_FOOT = 304.8\r\n\r\n\r\n# ------------------------------------------------------------\r\n# STACK MATCHING SETTINGS\r\n# ------------------------------------------------------------\r\n\r\n# Additional allowance around each column footprint.\r\nPLAN_MARGIN_MM = 50.0\r\n\r\n\r\n# Maximum acceptable horizontal offset expressed relative\r\n# to the smaller column dimension.\r\n#\r\n# Example:\r\n# 400 mm column:\r\n#\r\n# 0.50 x 400 = 200 mm allowable center offset\r\n#\r\nCENTER_OFFSET_FACTOR = 0.50\r\n\r\n\r\n# Minimum absolute center tolerance.\r\nMIN_CENTER_TOLERANCE_MM = 100.0\r\n\r\n\r\n# Maximum vertical gap between one column top and the next\r\n# column bottom that can still represent the next storey.\r\n#\r\n# This is intentionally generous because Revit columns may\r\n# terminate at different beam/slab references.\r\n#\r\nMAX_VERTICAL_GAP_MM = 1500.0\r\n\r\n\r\n# Maximum vertical overlap tolerated between consecutive\r\n# Revit column instances.\r\n#\r\nMAX_VERTICAL_OVERLAP_MM = 1500.0\r\n\r\n\r\n# ============================================================\r\n# UTILITY FUNCTIONS\r\n# ============================================================\r\n\r\ndef unwrap(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef id_value(element):\r\n\r\n    element = unwrap(element)\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return int(element.Id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element.Id.IntegerValue)\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\ndef feet_to_mm(value):\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    try:\r\n        return float(value) * MM_PER_FOOT\r\n    except:\r\n        return None\r\n\r\n\r\ndef radians_to_degrees(value):\r\n\r\n    try:\r\n        return math.degrees(value)\r\n    except:\r\n        return 0.0\r\n\r\n\r\n# ============================================================\r\n# PACKAGE DETECTION\r\n# ============================================================\r\n\r\ndef is_column_package(data):\r\n\r\n    if not isinstance(data, (list, tuple)):\r\n        return False\r\n\r\n    if len(data) < 2:\r\n        return False\r\n\r\n    try:\r\n\r\n        element = unwrap(data[0])\r\n\r\n        if element is None:\r\n            return False\r\n\r\n        if not hasattr(element, \"Id\"):\r\n            return False\r\n\r\n        eid = id_value(element)\r\n\r\n        try:\r\n            package_id = int(data[1])\r\n        except:\r\n            return False\r\n\r\n        return eid == package_id\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_packages(data):\r\n\r\n    result = []\r\n\r\n    if data is None:\r\n        return result\r\n\r\n\r\n    if is_column_package(data):\r\n\r\n        result.append(data)\r\n\r\n        return result\r\n\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n\r\n            result.extend(\r\n                collect_packages(item)\r\n            )\r\n\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# PARAMETER READER\r\n# ============================================================\r\n\r\ndef read_double_parameter(element, names):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n\r\n    for name in names:\r\n\r\n        try:\r\n\r\n            p = element.LookupParameter(name)\r\n\r\n            if p is None:\r\n                continue\r\n\r\n\r\n            if p.StorageType == StorageType.Double:\r\n\r\n                return feet_to_mm(\r\n                    p.AsDouble()\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# COLUMN GEOMETRY\r\n# ============================================================\r\n\r\ndef get_column_geometry(column):\r\n\r\n    column = unwrap(column)\r\n\r\n    if column is None:\r\n        return None\r\n\r\n\r\n    cx = None\r\n    cy = None\r\n\r\n    bottom = None\r\n    top = None\r\n\r\n    width = None\r\n    depth = None\r\n\r\n    rotation = 0.0\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # LOCATION POINT\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        loc = column.Location\r\n\r\n\r\n        if isinstance(loc, LocationPoint):\r\n\r\n            point = loc.Point\r\n\r\n            cx = feet_to_mm(point.X)\r\n            cy = feet_to_mm(point.Y)\r\n\r\n            rotation = radians_to_degrees(\r\n                loc.Rotation\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOUNDING BOX\r\n    # --------------------------------------------------------\r\n\r\n    bbox = None\r\n\r\n    try:\r\n        bbox = column.get_BoundingBox(None)\r\n    except:\r\n        bbox = None\r\n\r\n\r\n    if bbox is not None:\r\n\r\n        try:\r\n\r\n            bottom = feet_to_mm(\r\n                bbox.Min.Z\r\n            )\r\n\r\n            top = feet_to_mm(\r\n                bbox.Max.Z\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLUMN TYPE\r\n    # --------------------------------------------------------\r\n\r\n    column_type = None\r\n\r\n    try:\r\n\r\n        column_type = doc.GetElement(\r\n            column.GetTypeId()\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # WIDTH\r\n    # --------------------------------------------------------\r\n\r\n    if column_type is not None:\r\n\r\n        width = read_double_parameter(\r\n            column_type,\r\n            [\r\n                \"b\",\r\n                \"B\",\r\n                \"Width\",\r\n                \"WIDTH\",\r\n                \"Width 1\"\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DEPTH\r\n    # --------------------------------------------------------\r\n\r\n    if column_type is not None:\r\n\r\n        depth = read_double_parameter(\r\n            column_type,\r\n            [\r\n                \"h\",\r\n                \"H\",\r\n                \"Depth\",\r\n                \"DEPTH\",\r\n                \"Height\",\r\n                \"Depth 1\"\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FALLBACK CENTER\r\n    # --------------------------------------------------------\r\n\r\n    if bbox is not None:\r\n\r\n        if cx is None:\r\n\r\n            try:\r\n\r\n                cx = feet_to_mm(\r\n                    (\r\n                        bbox.Min.X +\r\n                        bbox.Max.X\r\n                    ) / 2.0\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        if cy is None:\r\n\r\n            try:\r\n\r\n                cy = feet_to_mm(\r\n                    (\r\n                        bbox.Min.Y +\r\n                        bbox.Max.Y\r\n                    ) / 2.0\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FALLBACK WIDTH / DEPTH\r\n    # --------------------------------------------------------\r\n\r\n    if bbox is not None:\r\n\r\n        if width is None:\r\n\r\n            try:\r\n\r\n                width = feet_to_mm(\r\n                    bbox.Max.X -\r\n                    bbox.Min.X\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        if depth is None:\r\n\r\n            try:\r\n\r\n                depth = feet_to_mm(\r\n                    bbox.Max.Y -\r\n                    bbox.Min.Y\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n    if (\r\n        cx is None or\r\n        cy is None or\r\n        bottom is None or\r\n        top is None\r\n    ):\r\n\r\n        return None\r\n\r\n\r\n    return {\r\n\r\n        \"cx\": cx,\r\n        \"cy\": cy,\r\n\r\n        \"bottom\": bottom,\r\n        \"top\": top,\r\n\r\n        \"width\": width,\r\n        \"depth\": depth,\r\n\r\n        \"rotation\": rotation,\r\n\r\n        \"bbox\": bbox\r\n    }\r\n\r\n\r\n# ============================================================\r\n# PLAN DISTANCE\r\n# ============================================================\r\n\r\ndef plan_distance(record_a, record_b):\r\n\r\n    dx = (\r\n        record_a[\"cx\"] -\r\n        record_b[\"cx\"]\r\n    )\r\n\r\n    dy = (\r\n        record_a[\"cy\"] -\r\n        record_b[\"cy\"]\r\n    )\r\n\r\n\r\n    return math.sqrt(\r\n        dx * dx +\r\n        dy * dy\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COLUMN PLAN RECTANGLE\r\n# ============================================================\r\n\r\ndef get_plan_rectangle(record):\r\n\r\n    \"\"\"\r\n    Creates a conservative axis-aligned plan footprint.\r\n\r\n    The actual column may be rotated.\r\n\r\n    Bounding box is preferred because it already encloses\r\n    rotated geometry.\r\n    \"\"\"\r\n\r\n    bbox = record.get(\"bbox\")\r\n\r\n\r\n    if bbox is not None:\r\n\r\n        try:\r\n\r\n            return [\r\n\r\n                feet_to_mm(bbox.Min.X),\r\n                feet_to_mm(bbox.Max.X),\r\n\r\n                feet_to_mm(bbox.Min.Y),\r\n                feet_to_mm(bbox.Max.Y)\r\n            ]\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    width = record.get(\"width\")\r\n    depth = record.get(\"depth\")\r\n\r\n\r\n    if width is None:\r\n        width = 0.0\r\n\r\n    if depth is None:\r\n        depth = 0.0\r\n\r\n\r\n    return [\r\n\r\n        record[\"cx\"] - width / 2.0,\r\n        record[\"cx\"] + width / 2.0,\r\n\r\n        record[\"cy\"] - depth / 2.0,\r\n        record[\"cy\"] + depth / 2.0\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# PLAN OVERLAP\r\n# ============================================================\r\n\r\ndef plan_overlap(record_a, record_b):\r\n\r\n    rect_a = get_plan_rectangle(record_a)\r\n    rect_b = get_plan_rectangle(record_b)\r\n\r\n\r\n    ax1 = rect_a[0] - PLAN_MARGIN_MM\r\n    ax2 = rect_a[1] + PLAN_MARGIN_MM\r\n\r\n    ay1 = rect_a[2] - PLAN_MARGIN_MM\r\n    ay2 = rect_a[3] + PLAN_MARGIN_MM\r\n\r\n\r\n    bx1 = rect_b[0] - PLAN_MARGIN_MM\r\n    bx2 = rect_b[1] + PLAN_MARGIN_MM\r\n\r\n    by1 = rect_b[2] - PLAN_MARGIN_MM\r\n    by2 = rect_b[3] + PLAN_MARGIN_MM\r\n\r\n\r\n    overlap_x = (\r\n        ax1 <= bx2 and\r\n        ax2 >= bx1\r\n    )\r\n\r\n    overlap_y = (\r\n        ay1 <= by2 and\r\n        ay2 >= by1\r\n    )\r\n\r\n\r\n    return (\r\n        overlap_x and\r\n        overlap_y\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CENTER OFFSET CHECK\r\n# ============================================================\r\n\r\ndef center_offset_allowed(record_a, record_b):\r\n\r\n    distance = plan_distance(\r\n        record_a,\r\n        record_b\r\n    )\r\n\r\n\r\n    dimensions = []\r\n\r\n\r\n    for record in [record_a, record_b]:\r\n\r\n        width = record.get(\"width\")\r\n        depth = record.get(\"depth\")\r\n\r\n\r\n        if width is not None and width > 0:\r\n            dimensions.append(width)\r\n\r\n        if depth is not None and depth > 0:\r\n            dimensions.append(depth)\r\n\r\n\r\n    if len(dimensions) > 0:\r\n\r\n        reference_dimension = min(\r\n            dimensions\r\n        )\r\n\r\n        allowed = max(\r\n            MIN_CENTER_TOLERANCE_MM,\r\n            reference_dimension *\r\n            CENTER_OFFSET_FACTOR\r\n        )\r\n\r\n    else:\r\n\r\n        allowed = MIN_CENTER_TOLERANCE_MM\r\n\r\n\r\n    return (\r\n        distance <= allowed,\r\n        distance,\r\n        allowed\r\n    )\r\n\r\n\r\n# ============================================================\r\n# VERTICAL RELATION\r\n# ============================================================\r\n\r\ndef vertical_relation(lower, upper):\r\n\r\n    gap = (\r\n        upper[\"bottom\"] -\r\n        lower[\"top\"]\r\n    )\r\n\r\n\r\n    valid = (\r\n\r\n        gap <= MAX_VERTICAL_GAP_MM\r\n\r\n        and\r\n\r\n        gap >= -MAX_VERTICAL_OVERLAP_MM\r\n\r\n        and\r\n\r\n        upper[\"bottom\"] >\r\n        lower[\"bottom\"]\r\n\r\n    )\r\n\r\n\r\n    return (\r\n        valid,\r\n        gap\r\n    )\r\n\r\n\r\n# ============================================================\r\n# STACK MATCH TEST\r\n# ============================================================\r\n\r\ndef can_follow(lower, upper):\r\n\r\n    # Must actually be above lower column.\r\n    vertical_ok, vertical_gap = (\r\n        vertical_relation(\r\n            lower,\r\n            upper\r\n        )\r\n    )\r\n\r\n\r\n    if not vertical_ok:\r\n\r\n        return (\r\n            False,\r\n            None\r\n        )\r\n\r\n\r\n    footprint_ok = plan_overlap(\r\n        lower,\r\n        upper\r\n    )\r\n\r\n\r\n    (\r\n        center_ok,\r\n        center_distance,\r\n        center_allowed\r\n\r\n    ) = center_offset_allowed(\r\n        lower,\r\n        upper\r\n    )\r\n\r\n\r\n    # Require footprint overlap.\r\n    #\r\n    # Center offset is retained as a diagnostic and\r\n    # secondary safeguard.\r\n    valid = (\r\n        footprint_ok and\r\n        center_ok\r\n    )\r\n\r\n\r\n    score = (\r\n        abs(vertical_gap) +\r\n        center_distance\r\n    )\r\n\r\n\r\n    diagnostic = {\r\n\r\n        \"valid\": valid,\r\n\r\n        \"vertical_gap\": vertical_gap,\r\n\r\n        \"footprint_overlap\":\r\n            footprint_ok,\r\n\r\n        \"center_distance\":\r\n            center_distance,\r\n\r\n        \"center_allowed\":\r\n            center_allowed,\r\n\r\n        \"score\":\r\n            score\r\n    }\r\n\r\n\r\n    return (\r\n        valid,\r\n        diagnostic\r\n    )\r\n\r\n\r\n# ============================================================\r\n# FOUNDATION PACKAGE\r\n# ============================================================\r\n\r\ndef get_foundation_package(s03_package):\r\n\r\n    if s03_package is None:\r\n        return []\r\n\r\n\r\n    try:\r\n\r\n        foundations = s03_package[6]\r\n\r\n\r\n        if foundations is None:\r\n            return []\r\n\r\n\r\n        if isinstance(\r\n            foundations,\r\n            (list, tuple)\r\n        ):\r\n\r\n            return foundations\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return []\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\ns03_input = IN[0]\r\ns04_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# COLLECT PACKAGES\r\n# ============================================================\r\n\r\ns03_packages = collect_packages(\r\n    s03_input\r\n)\r\n\r\ns04_packages = collect_packages(\r\n    s04_input\r\n)\r\n\r\n\r\n# ============================================================\r\n# INDEX PACKAGES BY COLUMN ID\r\n# ============================================================\r\n\r\ns03_by_id = {}\r\n\r\nfor package in s03_packages:\r\n\r\n    try:\r\n\r\n        column = unwrap(\r\n            package[0]\r\n        )\r\n\r\n        cid = id_value(\r\n            column\r\n        )\r\n\r\n\r\n        if cid is not None:\r\n\r\n            s03_by_id[cid] = package\r\n\r\n    except:\r\n        pass\r\n\r\n\r\ns04_by_id = {}\r\n\r\nfor package in s04_packages:\r\n\r\n    try:\r\n\r\n        column = unwrap(\r\n            package[0]\r\n        )\r\n\r\n        cid = id_value(\r\n            column\r\n        )\r\n\r\n\r\n        if cid is not None:\r\n\r\n            s04_by_id[cid] = package\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# BUILD COLUMN RECORDS\r\n# ============================================================\r\n\r\nall_ids = set(\r\n    list(s03_by_id.keys()) +\r\n    list(s04_by_id.keys())\r\n)\r\n\r\n\r\nrecords = []\r\n\r\n\r\nfor cid in all_ids:\r\n\r\n    s03 = s03_by_id.get(cid)\r\n    s04 = s04_by_id.get(cid)\r\n\r\n\r\n    column = None\r\n\r\n\r\n    if s03 is not None:\r\n\r\n        try:\r\n            column = unwrap(\r\n                s03[0]\r\n            )\r\n        except:\r\n            pass\r\n\r\n\r\n    if column is None and s04 is not None:\r\n\r\n        try:\r\n            column = unwrap(\r\n                s04[0]\r\n            )\r\n        except:\r\n            pass\r\n\r\n\r\n    if column is None:\r\n        continue\r\n\r\n\r\n    geometry = get_column_geometry(\r\n        column\r\n    )\r\n\r\n\r\n    if geometry is None:\r\n        continue\r\n\r\n\r\n    record = {\r\n\r\n        \"column\":\r\n            column,\r\n\r\n        \"id\":\r\n            cid,\r\n\r\n        \"cx\":\r\n            geometry[\"cx\"],\r\n\r\n        \"cy\":\r\n            geometry[\"cy\"],\r\n\r\n        \"bottom\":\r\n            geometry[\"bottom\"],\r\n\r\n        \"top\":\r\n            geometry[\"top\"],\r\n\r\n        \"width\":\r\n            geometry[\"width\"],\r\n\r\n        \"depth\":\r\n            geometry[\"depth\"],\r\n\r\n        \"rotation\":\r\n            geometry[\"rotation\"],\r\n\r\n        \"bbox\":\r\n            geometry[\"bbox\"],\r\n\r\n        \"s03\":\r\n            s03,\r\n\r\n        \"s04\":\r\n            s04\r\n    }\r\n\r\n\r\n    records.append(\r\n        record\r\n    )\r\n\r\n\r\n# ============================================================\r\n# SORT LOWEST TO HIGHEST\r\n# ============================================================\r\n\r\nrecords.sort(\r\n\r\n    key=lambda r: (\r\n\r\n        r[\"bottom\"],\r\n        r[\"cx\"],\r\n        r[\"cy\"]\r\n    )\r\n)\r\n\r\n\r\n# ============================================================\r\n# BUILD STACKS\r\n# ============================================================\r\n\r\nstacks = []\r\n\r\n\r\nfor record in records:\r\n\r\n    candidates = []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TEST AGAINST TOP COLUMN OF EACH EXISTING STACK\r\n    # --------------------------------------------------------\r\n\r\n    for stack_index, stack in enumerate(stacks):\r\n\r\n        if len(stack) == 0:\r\n            continue\r\n\r\n\r\n        top_record = stack[-1]\r\n\r\n\r\n        valid, diagnostic = can_follow(\r\n            top_record,\r\n            record\r\n        )\r\n\r\n\r\n        if valid:\r\n\r\n            candidates.append(\r\n                (\r\n                    diagnostic[\"score\"],\r\n                    stack_index,\r\n                    diagnostic\r\n                )\r\n            )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ASSIGN TO BEST STACK\r\n    # --------------------------------------------------------\r\n\r\n    if len(candidates) > 0:\r\n\r\n        candidates.sort(\r\n            key=lambda x: x[0]\r\n        )\r\n\r\n\r\n        best = candidates[0]\r\n\r\n        best_stack_index = best[1]\r\n\r\n\r\n        stacks[\r\n            best_stack_index\r\n        ].append(\r\n            record\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # OTHERWISE START NEW STACK\r\n    # --------------------------------------------------------\r\n\r\n    else:\r\n\r\n        stacks.append(\r\n            [record]\r\n        )\r\n\r\n\r\n# ============================================================\r\n# SORT EACH STACK\r\n# ============================================================\r\n\r\nfor stack in stacks:\r\n\r\n    stack.sort(\r\n        key=lambda r:\r\n            r[\"bottom\"]\r\n    )\r\n\r\n\r\n# ============================================================\r\n# BUILD OUTPUT\r\n# ============================================================\r\n\r\noutput = []\r\n\r\n\r\nfor stack_index, stack in enumerate(stacks):\r\n\r\n    if len(stack) == 0:\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STACK EXTENTS\r\n    # --------------------------------------------------------\r\n\r\n    stack_bottom = min(\r\n        r[\"bottom\"]\r\n        for r in stack\r\n    )\r\n\r\n\r\n    stack_top = max(\r\n        r[\"top\"]\r\n        for r in stack\r\n    )\r\n\r\n\r\n    stack_height = (\r\n        stack_top -\r\n        stack_bottom\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # AVERAGE CENTER\r\n    # --------------------------------------------------------\r\n\r\n    average_x = sum(\r\n        r[\"cx\"]\r\n        for r in stack\r\n    ) / float(len(stack))\r\n\r\n\r\n    average_y = sum(\r\n        r[\"cy\"]\r\n        for r in stack\r\n    ) / float(len(stack))\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLUMN LISTS\r\n    # --------------------------------------------------------\r\n\r\n    columns = [\r\n        r[\"column\"]\r\n        for r in stack\r\n    ]\r\n\r\n\r\n    column_ids = [\r\n        r[\"id\"]\r\n        for r in stack\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STOREY PACKAGES\r\n    # --------------------------------------------------------\r\n\r\n    storey_packages = []\r\n\r\n\r\n    for r in stack:\r\n\r\n        storey_packages.append(\r\n\r\n            [\r\n\r\n                r[\"column\"],       # [0]\r\n\r\n                r[\"id\"],           # [1]\r\n\r\n                r[\"bottom\"],       # [2]\r\n\r\n                r[\"top\"],          # [3]\r\n\r\n                r[\"width\"],        # [4]\r\n\r\n                r[\"depth\"],        # [5]\r\n\r\n                r[\"cx\"],           # [6]\r\n\r\n                r[\"cy\"],           # [7]\r\n\r\n                r[\"rotation\"],     # [8]\r\n\r\n                r[\"s03\"],          # [9]\r\n\r\n                r[\"s04\"]           # [10]\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FOUNDATION\r\n    # --------------------------------------------------------\r\n\r\n    foundation_package = []\r\n\r\n\r\n    # Foundation should normally belong to lowest column.\r\n    lowest = stack[0]\r\n\r\n\r\n    foundation_package = (\r\n        get_foundation_package(\r\n            lowest[\"s03\"]\r\n        )\r\n    )\r\n\r\n\r\n    # Fallback: search entire stack.\r\n    if len(foundation_package) == 0:\r\n\r\n        for r in stack:\r\n\r\n            candidate = (\r\n                get_foundation_package(\r\n                    r[\"s03\"]\r\n                )\r\n            )\r\n\r\n\r\n            if len(candidate) > 0:\r\n\r\n                foundation_package = (\r\n                    candidate\r\n                )\r\n\r\n                break\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STACK DIAGNOSTICS\r\n    # --------------------------------------------------------\r\n\r\n    relationship_diagnostics = []\r\n\r\n\r\n    if len(stack) > 1:\r\n\r\n        for i in range(\r\n            len(stack) - 1\r\n        ):\r\n\r\n            lower = stack[i]\r\n            upper = stack[i + 1]\r\n\r\n\r\n            valid, data = can_follow(\r\n                lower,\r\n                upper\r\n            )\r\n\r\n\r\n            if data is not None:\r\n\r\n                relationship_diagnostics.append(\r\n\r\n                    [\r\n                        lower[\"id\"],\r\n                        upper[\"id\"],\r\n\r\n                        \"CONNECTED\"\r\n                        if valid\r\n                        else \"NOT CONNECTED\",\r\n\r\n                        \"Vertical Gap mm\",\r\n                        round(\r\n                            data[\r\n                                \"vertical_gap\"\r\n                            ],\r\n                            2\r\n                        ),\r\n\r\n                        \"Center Offset mm\",\r\n                        round(\r\n                            data[\r\n                                \"center_distance\"\r\n                            ],\r\n                            2\r\n                        ),\r\n\r\n                        \"Allowed Offset mm\",\r\n                        round(\r\n                            data[\r\n                                \"center_allowed\"\r\n                            ],\r\n                            2\r\n                        ),\r\n\r\n                        \"Plan Overlap\",\r\n                        data[\r\n                            \"footprint_overlap\"\r\n                        ]\r\n                    ]\r\n                )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FOUNDATION STATUS\r\n    # --------------------------------------------------------\r\n\r\n    if len(foundation_package) > 0:\r\n\r\n        foundation_status = (\r\n            \"FOUNDATION DETECTED\"\r\n        )\r\n\r\n    else:\r\n\r\n        foundation_status = (\r\n            \"NO FOUNDATION DETECTED\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DIAGNOSTIC\r\n    # --------------------------------------------------------\r\n\r\n    diagnostic = [\r\n\r\n        \"STACK {}\".format(\r\n            stack_index + 1\r\n        ),\r\n\r\n        \"COLUMN COUNT = {}\".format(\r\n            len(stack)\r\n        ),\r\n\r\n        \"COLUMN IDS = {}\".format(\r\n            column_ids\r\n        ),\r\n\r\n        foundation_status,\r\n\r\n        relationship_diagnostics\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FINAL STACK PACKAGE\r\n    # --------------------------------------------------------\r\n\r\n    stack_package = [\r\n\r\n        stack_index + 1,          # [0]\r\n\r\n        columns,                  # [1]\r\n\r\n        column_ids,               # [2]\r\n\r\n        stack_bottom,             # [3]\r\n\r\n        stack_top,                # [4]\r\n\r\n        stack_height,             # [5]\r\n\r\n        average_x,                # [6]\r\n\r\n        average_y,                # [7]\r\n\r\n        len(stack),               # [8]\r\n\r\n        storey_packages,          # [9]\r\n\r\n        foundation_package,       # [10]\r\n\r\n        diagnostic                # [11]\r\n    ]\r\n\r\n\r\n    output.append(\r\n        stack_package\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "473bd3e53acf4bd584094f03e75ed624",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "86b2796a161946eb90ddd5ac437afe89",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "3afd262938b747019974169f041c0b06",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4c6334c6489d40e0acadaf4e17d78048",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
