      "Outputs": [
        {
          "Id": "7b2e10e7963d4803bb179b65611c40e0",
          "Name": "",
          "Description": "Int64",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Produces integer values",
      "InputValue": 16
    },
    {
      "ConcreteType": "CoreNodeModels.Input.IntegerSlider, CoreNodeModels",
      "NumberType": "Integer",
      "MaximumValue": 16,
      "MinimumValue": 4,
      "StepValue": 2,
      "Id": "821e5dca88d3454796e76d0d3f9652ac",
      "NodeType": "NumberInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "659a7bccaf58419f949141cd1e97d678",
          "Name": "",
          "Description": "Int64",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Produces integer values",
      "InputValue": 8
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# M03 — COMPLETE MAIN BAR ANCHORAGE / PATH PLANNER\r\n# CORRECTED MULTI-STACK VERSION\r\n#\r\n# IN[0] = COMPLETE M02 OUTPUT\r\n#\r\n# FIX:\r\n#   - Processes ALL M02 stack packages\r\n#   - Does NOT collapse input to first stack\r\n#   - Preserves existing M03 output architecture\r\n#\r\n# RULES:\r\n#   FOUNDATION:\r\n#       Bottom bend centerline =\r\n#       footing bottom + cover + db/2\r\n#\r\n#       Bottom 90-degree hook =\r\n#       12db, directed outward from column center\r\n#\r\n#   TOP JOINT:\r\n#       Top bend centerline =\r\n#       beam / column top - cover - db/2\r\n#\r\n#       Top 90-degree hook =\r\n#       12db, directed toward column core\r\n#\r\n# M03 OUTPUT PER STACK:\r\n#\r\n# [0]  Stack Index\r\n# [1]  Column IDs\r\n# [2]  Main Bar Diameter\r\n# [3]  Total Main Bars\r\n# [4]  Lap Length = 60db\r\n# [5]  Hook Extension = 12db\r\n# [6]  Group A\r\n# [7]  Group B\r\n# [8]  Stack Bottom\r\n# [9]  Stack Top\r\n# [10] Foundation Data\r\n# [11] Top Termination Data\r\n# [12] Bar Path Packages\r\n# [13] Maximum Preliminary Bar Path\r\n# [14] Diagnostics\r\n# [15] Original M02 Package\r\n#\r\n# BAR PATH:\r\n#\r\n# [0]  Bar Number\r\n# [1]  Group\r\n# [2]  Global X mm\r\n# [3]  Global Y mm\r\n# [4]  Bottom Bend Z mm\r\n# [5]  Top Bend Z mm\r\n# [6]  Bottom Hook Extension mm\r\n# [7]  Vertical Length mm\r\n# [8]  Top Hook Extension mm\r\n# [9]  Total Path Length mm\r\n# [10] Bottom DX\r\n# [11] Bottom DY\r\n# [12] Top DX\r\n# [13] Top DY\r\n# [14] Diagnostics\r\n# ============================================================\r\n\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# ------------------------------------------------------------\r\n# CONSTANTS\r\n# ------------------------------------------------------------\r\n\r\nFT_TO_MM = 304.8\r\n\r\nHOOK_FACTOR = 12.0\r\n\r\n\r\n# ------------------------------------------------------------\r\n# HELPERS\r\n# ------------------------------------------------------------\r\n\r\ndef is_list(value):\r\n\r\n    return isinstance(\r\n        value,\r\n        (list, tuple)\r\n    )\r\n\r\n\r\ndef safe_float(\r\n    value,\r\n    default=None\r\n):\r\n\r\n    try:\r\n        return float(value)\r\n    except:\r\n        return default\r\n\r\n\r\ndef safe_int(\r\n    value,\r\n    default=-1\r\n):\r\n\r\n    try:\r\n        return int(value)\r\n    except:\r\n        return default\r\n\r\n\r\n# ------------------------------------------------------------\r\n# IDENTIFY M02 PACKAGE\r\n#\r\n# Existing M02:\r\n#\r\n# [0] Stack Index\r\n# [1] Column IDs\r\n# [2] Main Bar Diameter\r\n# [3] Total Main Bars\r\n# [4] Bar Area\r\n# [5] Total Steel Area\r\n# [6] Storey Outputs\r\n# [7] Group A\r\n# [8] Group B\r\n# [9] Lap Length\r\n# [10] Diagnostics\r\n# [11] Original M01\r\n# ------------------------------------------------------------\r\n\r\ndef looks_like_m02(value):\r\n\r\n    if not is_list(value):\r\n        return False\r\n\r\n    if len(value) < 12:\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        stack_index = safe_int(\r\n            value[0],\r\n            -1\r\n        )\r\n\r\n        if stack_index < 0:\r\n            return False\r\n\r\n\r\n        if not is_list(\r\n            value[1]\r\n        ):\r\n            return False\r\n\r\n\r\n        if len(value[1]) == 0:\r\n            return False\r\n\r\n\r\n        db = safe_float(\r\n            value[2],\r\n            None\r\n        )\r\n\r\n        bars = safe_int(\r\n            value[3],\r\n            -1\r\n        )\r\n\r\n\r\n        if db is None or db <= 0:\r\n            return False\r\n\r\n\r\n        if bars <= 0:\r\n            return False\r\n\r\n\r\n        if not is_list(\r\n            value[6]\r\n        ):\r\n            return False\r\n\r\n\r\n        if not is_list(\r\n            value[7]\r\n        ):\r\n            return False\r\n\r\n\r\n        if not is_list(\r\n            value[8]\r\n        ):\r\n            return False\r\n\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ------------------------------------------------------------\r\n# COLLECT ALL M02 PACKAGES\r\n#\r\n# THIS IS THE MAIN CORRECTION.\r\n#\r\n# The previous M03 effectively processed only the first\r\n# M02 package. This recursively finds ALL top-level M02\r\n# packages while preventing duplicate collection.\r\n# ------------------------------------------------------------\r\n\r\ndef collect_m02_packages(data):\r\n\r\n    found = []\r\n\r\n    seen = set()\r\n\r\n\r\n    def walk(value):\r\n\r\n        if value is None:\r\n            return\r\n\r\n\r\n        if looks_like_m02(\r\n            value\r\n        ):\r\n\r\n            stack_index = safe_int(\r\n                value[0],\r\n                -1\r\n            )\r\n\r\n\r\n            ids = []\r\n\r\n            try:\r\n\r\n                for cid in value[1]:\r\n\r\n                    ids.append(\r\n                        safe_int(\r\n                            cid,\r\n                            -1\r\n                        )\r\n                    )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n            key = (\r\n                stack_index,\r\n                tuple(ids)\r\n            )\r\n\r\n\r\n            if key not in seen:\r\n\r\n                seen.add(\r\n                    key\r\n                )\r\n\r\n                found.append(\r\n                    value\r\n                )\r\n\r\n            # IMPORTANT:\r\n            # Do not recurse inside an identified M02 package.\r\n            # M01/S04 data nested inside it may resemble other\r\n            # package structures.\r\n\r\n            return\r\n\r\n\r\n        if is_list(\r\n            value\r\n        ):\r\n\r\n            for item in value:\r\n\r\n                walk(\r\n                    item\r\n                )\r\n\r\n\r\n    walk(\r\n        data\r\n    )\r\n\r\n\r\n    found.sort(\r\n        key=lambda package:\r\n        safe_int(\r\n            package[0],\r\n            999999\r\n        )\r\n    )\r\n\r\n\r\n    return found\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FIND COLUMN IN M01 COLUMN PACKAGE\r\n#\r\n# M01:\r\n# [9] Column Packages\r\n#\r\n# Column Package:\r\n# [0] Column\r\n# [1] ID\r\n# [2] Bottom\r\n# [3] Top\r\n# [4] Width\r\n# [5] Depth\r\n# [6] Center X\r\n# [7] Center Y\r\n# [8] Rotation\r\n# [9] S03\r\n# [10] S04\r\n# ------------------------------------------------------------\r\n\r\ndef find_m01_column_package(\r\n    m02,\r\n    column_id\r\n):\r\n\r\n    try:\r\n\r\n        m01 = m02[11]\r\n\r\n        column_packages = m01[9]\r\n\r\n\r\n        for package in column_packages:\r\n\r\n            if not is_list(\r\n                package\r\n            ):\r\n                continue\r\n\r\n\r\n            if len(package) < 11:\r\n                continue\r\n\r\n\r\n            cid = safe_int(\r\n                package[1],\r\n                -1\r\n            )\r\n\r\n\r\n            if cid == column_id:\r\n\r\n                return package\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FIND M02 STOREY PACKAGE\r\n#\r\n# M02[6]:\r\n#\r\n# [0] Column\r\n# [1] ID\r\n# [2] Width\r\n# [3] Depth\r\n# [4] Bottom Z\r\n# [5] Top Z\r\n# [6] Rotation\r\n# [7] Tie Dia\r\n# [8] Cover\r\n# ...\r\n# [14] Bar Layout\r\n# ------------------------------------------------------------\r\n\r\ndef find_storey_package(\r\n    m02,\r\n    column_id\r\n):\r\n\r\n    try:\r\n\r\n        storeys = m02[6]\r\n\r\n\r\n        for storey in storeys:\r\n\r\n            if not is_list(\r\n                storey\r\n            ):\r\n                continue\r\n\r\n\r\n            if len(storey) < 15:\r\n                continue\r\n\r\n\r\n            cid = safe_int(\r\n                storey[1],\r\n                -1\r\n            )\r\n\r\n\r\n            if cid == column_id:\r\n\r\n                return storey\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET S03 FROM M01 COLUMN PACKAGE\r\n# ------------------------------------------------------------\r\n\r\ndef get_s03(\r\n    column_package\r\n):\r\n\r\n    try:\r\n\r\n        s03 = column_package[9]\r\n\r\n\r\n        if (\r\n            is_list(s03)\r\n            and len(s03) >= 8\r\n        ):\r\n\r\n            return s03\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FOUNDATION DATA\r\n#\r\n# S03:\r\n# [4] Foundation Top\r\n# [6] Foundation Package\r\n#\r\n# Current foundation package:\r\n#\r\n# [\r\n#   [\r\n#       footing_bottom,\r\n#       footing_top,\r\n#       footing_id,\r\n#       footing_name\r\n#   ]\r\n# ]\r\n# ------------------------------------------------------------\r\n\r\ndef get_foundation_data(\r\n    s03,\r\n    cover,\r\n    db\r\n):\r\n\r\n    detected = False\r\n\r\n    footing_name = None\r\n    footing_id = None\r\n\r\n    footing_bottom = None\r\n    footing_top = None\r\n\r\n    bend_z = None\r\n\r\n\r\n    if s03 is not None:\r\n\r\n        try:\r\n\r\n            foundations = s03[6]\r\n\r\n\r\n            if (\r\n                is_list(foundations)\r\n                and len(foundations) > 0\r\n            ):\r\n\r\n                foundation = foundations[0]\r\n\r\n\r\n                if (\r\n                    is_list(foundation)\r\n                    and len(foundation) >= 4\r\n                ):\r\n\r\n                    footing_bottom = safe_float(\r\n                        foundation[0],\r\n                        None\r\n                    )\r\n\r\n\r\n                    footing_top = safe_float(\r\n                        foundation[1],\r\n                        None\r\n                    )\r\n\r\n\r\n                    footing_id = safe_int(\r\n                        foundation[2],\r\n                        -1\r\n                    )\r\n\r\n\r\n                    footing_name = str(\r\n                        foundation[3]\r\n                    )\r\n\r\n\r\n                    if (\r\n                        footing_bottom is not None\r\n                        and footing_top is not None\r\n                    ):\r\n\r\n                        detected = True\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if detected:\r\n\r\n        bend_z = (\r\n            footing_bottom\r\n            + cover\r\n            + db / 2.0\r\n        )\r\n\r\n\r\n        status = (\r\n            \"FOUNDATION ANCHORAGE GEOMETRY AVAILABLE\"\r\n        )\r\n\r\n    else:\r\n\r\n        status = (\r\n            \"NO FOUNDATION DETECTED\"\r\n        )\r\n\r\n\r\n    return [\r\n        detected,            # 0\r\n        footing_name,        # 1\r\n        footing_id,          # 2\r\n        footing_bottom,      # 3\r\n        footing_top,         # 4\r\n        cover,               # 5\r\n        bend_z,              # 6\r\n        HOOK_FACTOR * db,    # 7\r\n        status               # 8\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# TOP BEAM / JOINT\r\n#\r\n# S03[5] Beam Package:\r\n#\r\n# [\r\n#   [beam_bottom, beam_top, beam_id, beam],\r\n#   ...\r\n# ]\r\n#\r\n# We select the beam/joint whose top is closest to the\r\n# stack top.\r\n# ------------------------------------------------------------\r\n\r\ndef get_top_termination(\r\n    s03,\r\n    column,\r\n    column_id,\r\n    stack_top,\r\n    cover,\r\n    db\r\n):\r\n\r\n    top_detected = False\r\n\r\n    selected_beam = None\r\n    selected_id = None\r\n\r\n    beam_bottom = None\r\n    beam_top = None\r\n\r\n    beam_depth = None\r\n\r\n    best_difference = None\r\n\r\n\r\n    if s03 is not None:\r\n\r\n        try:\r\n\r\n            beams = s03[5]\r\n\r\n\r\n            if is_list(\r\n                beams\r\n            ):\r\n\r\n                for beam_data in beams:\r\n\r\n                    if not is_list(\r\n                        beam_data\r\n                    ):\r\n                        continue\r\n\r\n\r\n                    if len(beam_data) < 4:\r\n                        continue\r\n\r\n\r\n                    bz0 = safe_float(\r\n                        beam_data[0],\r\n                        None\r\n                    )\r\n\r\n\r\n                    bz1 = safe_float(\r\n                        beam_data[1],\r\n                        None\r\n                    )\r\n\r\n\r\n                    bid = safe_int(\r\n                        beam_data[2],\r\n                        -1\r\n                    )\r\n\r\n\r\n                    beam = beam_data[3]\r\n\r\n\r\n                    if (\r\n                        bz0 is None\r\n                        or bz1 is None\r\n                    ):\r\n                        continue\r\n\r\n\r\n                    difference = abs(\r\n                        bz1 - stack_top\r\n                    )\r\n\r\n\r\n                    if (\r\n                        best_difference is None\r\n                        or difference\r\n                        < best_difference\r\n                    ):\r\n\r\n                        best_difference = difference\r\n\r\n                        selected_beam = beam\r\n                        selected_id = bid\r\n\r\n                        beam_bottom = bz0\r\n                        beam_top = bz1\r\n\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Consider a beam a top joint when it terminates at\r\n    # approximately the column/stack top.\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        beam_top is not None\r\n        and stack_top is not None\r\n    ):\r\n\r\n        if abs(\r\n            beam_top - stack_top\r\n        ) <= 5.0:\r\n\r\n            top_detected = True\r\n\r\n\r\n    if top_detected:\r\n\r\n        beam_depth = (\r\n            beam_top\r\n            - beam_bottom\r\n        )\r\n\r\n\r\n        bend_z = (\r\n            beam_top\r\n            - cover\r\n            - db / 2.0\r\n        )\r\n\r\n\r\n        status = (\r\n            \"TOP BEAM / JOINT DETECTED\"\r\n        )\r\n\r\n\r\n        hook_status = (\r\n            \"TOP TERMINATION WITH 90 DEG HOOK \"\r\n            \"PLANNED AT COVER LINE\"\r\n        )\r\n\r\n    else:\r\n\r\n        # No beam exactly at top.\r\n        # Terminate at column top cover line.\r\n\r\n        bend_z = (\r\n            stack_top\r\n            - cover\r\n            - db / 2.0\r\n        )\r\n\r\n\r\n        status = (\r\n            \"NO TOP BEAM AT STACK TOP\"\r\n        )\r\n\r\n\r\n        hook_status = (\r\n            \"TOP TERMINATION AT COLUMN COVER LINE\"\r\n        )\r\n\r\n\r\n    return [\r\n        column,                 # 0\r\n        column_id,              # 1\r\n        stack_top,              # 2\r\n        top_detected,           # 3\r\n        selected_beam,          # 4\r\n        selected_id,            # 5\r\n        beam_bottom,            # 6\r\n        beam_top,               # 7\r\n        beam_depth,             # 8\r\n        (\r\n            (\r\n                stack_top - bend_z\r\n            )\r\n            if (\r\n                stack_top is not None\r\n                and bend_z is not None\r\n            )\r\n            else None\r\n        ),                      # 9\r\n        bend_z,                 # 10\r\n        status,                 # 11\r\n        True,                   # 12\r\n        HOOK_FACTOR * db,       # 13\r\n        hook_status,            # 14\r\n        cover,                  # 15\r\n        bend_z                  # 16\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# NORMALIZE VECTOR\r\n# ------------------------------------------------------------\r\n\r\ndef normalize_vector(\r\n    dx,\r\n    dy\r\n):\r\n\r\n    length = math.sqrt(\r\n        dx * dx\r\n        + dy * dy\r\n    )\r\n\r\n\r\n    if length <= 1.0e-9:\r\n\r\n        return (\r\n            0.0,\r\n            0.0\r\n        )\r\n\r\n\r\n    return (\r\n        dx / length,\r\n        dy / length\r\n    )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# PROCESS ONE M02 STACK\r\n# ------------------------------------------------------------\r\n\r\ndef process_m02(\r\n    m02\r\n):\r\n\r\n    stack_index = safe_int(\r\n        m02[0],\r\n        -1\r\n    )\r\n\r\n\r\n    column_ids = [\r\n        safe_int(\r\n            cid,\r\n            -1\r\n        )\r\n        for cid in m02[1]\r\n    ]\r\n\r\n\r\n    db = safe_float(\r\n        m02[2],\r\n        0.0\r\n    )\r\n\r\n\r\n    total_main_bars = safe_int(\r\n        m02[3],\r\n        0\r\n    )\r\n\r\n\r\n    group_a = list(\r\n        m02[7]\r\n    )\r\n\r\n\r\n    group_b = list(\r\n        m02[8]\r\n    )\r\n\r\n\r\n    lap_length = safe_float(\r\n        m02[9],\r\n        60.0 * db\r\n    )\r\n\r\n\r\n    hook_extension = (\r\n        HOOK_FACTOR\r\n        * db\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Stack limits from M01\r\n    # --------------------------------------------------------\r\n\r\n    m01 = m02[11]\r\n\r\n\r\n    stack_bottom = safe_float(\r\n        m01[3],\r\n        None\r\n    )\r\n\r\n\r\n    stack_top = safe_float(\r\n        m01[4],\r\n        None\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # M03 currently creates one continuous preliminary path\r\n    # for each longitudinal bar through the complete stack.\r\n    #\r\n    # Use the lowest storey for bottom anchorage and highest\r\n    # storey for top termination.\r\n    # --------------------------------------------------------\r\n\r\n    storeys = []\r\n\r\n\r\n    try:\r\n\r\n        storeys = list(\r\n            m02[6]\r\n        )\r\n\r\n    except:\r\n        storeys = []\r\n\r\n\r\n    if len(storeys) == 0:\r\n\r\n        return None\r\n\r\n\r\n    storeys.sort(\r\n        key=lambda s:\r\n        safe_float(\r\n            s[4],\r\n            1.0e99\r\n        )\r\n    )\r\n\r\n\r\n    bottom_storey = storeys[0]\r\n\r\n    top_storey = storeys[-1]\r\n\r\n\r\n    bottom_column_id = safe_int(\r\n        bottom_storey[1],\r\n        -1\r\n    )\r\n\r\n\r\n    top_column_id = safe_int(\r\n        top_storey[1],\r\n        -1\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Cover\r\n    # --------------------------------------------------------\r\n\r\n    cover = safe_float(\r\n        bottom_storey[8],\r\n        40.0\r\n    )\r\n\r\n\r\n    top_cover = safe_float(\r\n        top_storey[8],\r\n        cover\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Bottom / top M01 column packages\r\n    # --------------------------------------------------------\r\n\r\n    bottom_column_package = (\r\n        find_m01_column_package(\r\n            m02,\r\n            bottom_column_id\r\n        )\r\n    )\r\n\r\n\r\n    top_column_package = (\r\n        find_m01_column_package(\r\n            m02,\r\n            top_column_id\r\n        )\r\n    )\r\n\r\n\r\n    bottom_s03 = get_s03(\r\n        bottom_column_package\r\n    )\r\n\r\n\r\n    top_s03 = get_s03(\r\n        top_column_package\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Foundation\r\n    # --------------------------------------------------------\r\n\r\n    foundation_data = (\r\n        get_foundation_data(\r\n            bottom_s03,\r\n            cover,\r\n            db\r\n        )\r\n    )\r\n\r\n\r\n    foundation_detected = (\r\n        foundation_data[0]\r\n    )\r\n\r\n\r\n    foundation_bend_z = (\r\n        foundation_data[6]\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # If no footing exists, use bottom cover line.\r\n    # --------------------------------------------------------\r\n\r\n    if foundation_bend_z is None:\r\n\r\n        foundation_bend_z = (\r\n            stack_bottom\r\n            + cover\r\n            + db / 2.0\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Top termination\r\n    # --------------------------------------------------------\r\n\r\n    top_column = top_storey[0]\r\n\r\n\r\n    top_termination = (\r\n        get_top_termination(\r\n            top_s03,\r\n            top_column,\r\n            top_column_id,\r\n            stack_top,\r\n            top_cover,\r\n            db\r\n        )\r\n    )\r\n\r\n\r\n    top_bend_z = safe_float(\r\n        top_termination[16],\r\n        None\r\n    )\r\n\r\n\r\n    if top_bend_z is None:\r\n\r\n        top_bend_z = (\r\n            stack_top\r\n            - top_cover\r\n            - db / 2.0\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Column center\r\n    # --------------------------------------------------------\r\n\r\n    center_x = None\r\n    center_y = None\r\n\r\n\r\n    try:\r\n\r\n        center_x = safe_float(\r\n            m01[6],\r\n            None\r\n        )\r\n\r\n\r\n        center_y = safe_float(\r\n            m01[7],\r\n            None\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Bar layout\r\n    #\r\n    # For the preliminary continuous stack path, use the\r\n    # bottom-storey bar coordinates. For a single-storey\r\n    # column this is exactly the existing behavior.\r\n    # --------------------------------------------------------\r\n\r\n    bar_layout = []\r\n\r\n\r\n    try:\r\n\r\n        bar_layout = bottom_storey[14]\r\n\r\n    except:\r\n        bar_layout = []\r\n\r\n\r\n    bar_paths = []\r\n\r\n    maximum_path = 0.0\r\n\r\n\r\n    for bar in bar_layout:\r\n\r\n        if not is_list(\r\n            bar\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        if len(bar) < 9:\r\n\r\n            continue\r\n\r\n\r\n        bar_number = safe_int(\r\n            bar[0],\r\n            -1\r\n        )\r\n\r\n\r\n        group = str(\r\n            bar[1]\r\n        )\r\n\r\n\r\n        global_x = safe_float(\r\n            bar[4],\r\n            None\r\n        )\r\n\r\n\r\n        global_y = safe_float(\r\n            bar[5],\r\n            None\r\n        )\r\n\r\n\r\n        if (\r\n            global_x is None\r\n            or global_y is None\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # RADIAL VECTOR\r\n        #\r\n        # Bar -> outside:\r\n        #     bar - center\r\n        #\r\n        # Bottom hook = outward\r\n        # Top hook    = inward\r\n        # ----------------------------------------------------\r\n\r\n        if (\r\n            center_x is not None\r\n            and center_y is not None\r\n        ):\r\n\r\n            radial_x = (\r\n                global_x\r\n                - center_x\r\n            )\r\n\r\n\r\n            radial_y = (\r\n                global_y\r\n                - center_y\r\n            )\r\n\r\n\r\n            outward_dx, outward_dy = (\r\n                normalize_vector(\r\n                    radial_x,\r\n                    radial_y\r\n                )\r\n            )\r\n\r\n        else:\r\n\r\n            outward_dx = 0.0\r\n            outward_dy = 0.0\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Fallback for pathological center bar\r\n        # ----------------------------------------------------\r\n\r\n        if (\r\n            abs(outward_dx) < 1.0e-9\r\n            and abs(outward_dy) < 1.0e-9\r\n        ):\r\n\r\n            face = str(\r\n                bar[8]\r\n            ).upper()\r\n\r\n\r\n            if face == \"TOP\":\r\n\r\n                outward_dx = 0.0\r\n                outward_dy = 1.0\r\n\r\n            elif face == \"RIGHT\":\r\n\r\n                outward_dx = 1.0\r\n                outward_dy = 0.0\r\n\r\n            elif face == \"BOTTOM\":\r\n\r\n                outward_dx = 0.0\r\n                outward_dy = -1.0\r\n\r\n            elif face == \"LEFT\":\r\n\r\n                outward_dx = -1.0\r\n                outward_dy = 0.0\r\n\r\n\r\n        # Bottom = outward\r\n        bottom_dx = outward_dx\r\n        bottom_dy = outward_dy\r\n\r\n\r\n        # Top = toward column core\r\n        top_dx = -outward_dx\r\n        top_dy = -outward_dy\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Vertical length\r\n        # ----------------------------------------------------\r\n\r\n        vertical_length = abs(\r\n            top_bend_z\r\n            - foundation_bend_z\r\n        )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # Both hooks currently 12db\r\n        # ----------------------------------------------------\r\n\r\n        bottom_hook = (\r\n            hook_extension\r\n        )\r\n\r\n\r\n        top_hook = (\r\n            hook_extension\r\n        )\r\n\r\n\r\n        total_path = (\r\n            bottom_hook\r\n            + vertical_length\r\n            + top_hook\r\n        )\r\n\r\n\r\n        if total_path > maximum_path:\r\n\r\n            maximum_path = (\r\n                total_path\r\n            )\r\n\r\n\r\n        path_diagnostics = []\r\n\r\n\r\n        if foundation_detected:\r\n\r\n            path_diagnostics.append(\r\n                \"BOTTOM FOUNDATION HOOK = 12db\"\r\n            )\r\n\r\n        else:\r\n\r\n            path_diagnostics.append(\r\n                \"NO FOUNDATION - BOTTOM HOOK AT COLUMN COVER LINE\"\r\n            )\r\n\r\n\r\n        if top_termination[3]:\r\n\r\n            path_diagnostics.append(\r\n                \"TOP JOINT DETECTED\"\r\n            )\r\n\r\n        else:\r\n\r\n            path_diagnostics.append(\r\n                \"NO TOP BEAM AT STACK TOP\"\r\n            )\r\n\r\n\r\n        path_diagnostics.append(\r\n            \"TOP HOOK = 12db AT COVER LINE - \"\r\n            \"DIRECTION TOWARD COLUMN CORE\"\r\n        )\r\n\r\n\r\n        bar_paths.append(\r\n            [\r\n                bar_number,             # 0\r\n                group,                  # 1\r\n                global_x,               # 2\r\n                global_y,               # 3\r\n                foundation_bend_z,      # 4\r\n                top_bend_z,             # 5\r\n                bottom_hook,            # 6\r\n                vertical_length,        # 7\r\n                top_hook,               # 8\r\n                total_path,             # 9\r\n                bottom_dx,              # 10\r\n                bottom_dy,              # 11\r\n                top_dx,                 # 12\r\n                top_dy,                 # 13\r\n                path_diagnostics        # 14\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DIAGNOSTICS\r\n    # --------------------------------------------------------\r\n\r\n    diagnostics = [\r\n        \"MAIN BAR DIAMETER = {:.1f} mm\".format(\r\n            db\r\n        ),\r\n\r\n        \"TOTAL MAIN BARS = {}\".format(\r\n            total_main_bars\r\n        ),\r\n\r\n        \"ADOPTED LAP = 60db = {:.1f} mm\".format(\r\n            lap_length\r\n        ),\r\n\r\n        \"90 DEG HOOK EXTENSION = 12db = {:.1f} mm\".format(\r\n            hook_extension\r\n        ),\r\n\r\n        \"STACK BOTTOM = {:.1f} mm\".format(\r\n            stack_bottom\r\n        ),\r\n\r\n        \"STACK TOP = {:.1f} mm\".format(\r\n            stack_top\r\n        )\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FOUNDATION DIAGNOSTICS\r\n    # --------------------------------------------------------\r\n\r\n    if foundation_detected:\r\n\r\n        diagnostics.append(\r\n            \"FOUNDATION DETECTED\"\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"FOUNDATION ID = {}\".format(\r\n                foundation_data[2]\r\n            )\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"FOUNDATION Z = {:.1f} TO {:.1f} mm\".format(\r\n                foundation_data[3],\r\n                foundation_data[4]\r\n            )\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"FOUNDATION COVER = {:.1f} mm\".format(\r\n                cover\r\n            )\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"FOUNDATION BEND Z = {:.1f} mm\".format(\r\n                foundation_bend_z\r\n            )\r\n        )\r\n\r\n    else:\r\n\r\n        diagnostics.append(\r\n            \"NO FOUNDATION DETECTED\"\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"BOTTOM BEND Z = {:.1f} mm\".format(\r\n                foundation_bend_z\r\n            )\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TOP DIAGNOSTICS\r\n    # --------------------------------------------------------\r\n\r\n    if top_termination[3]:\r\n\r\n        diagnostics.append(\r\n            \"TOP BEAM / JOINT DETECTED\"\r\n        )\r\n\r\n\r\n        diagnostics.append(\r\n            \"TOP BEAM ID = {}\".format(\r\n                top_termination[5]\r\n            )\r\n        )\r\n\r\n\r\n        if (\r\n            top_termination[6] is not None\r\n            and top_termination[7] is not None\r\n        ):\r\n\r\n            diagnostics.append(\r\n                \"TOP BEAM Z = {:.1f} TO {:.1f} mm\".format(\r\n                    top_termination[6],\r\n                    top_termination[7]\r\n                )\r\n            )\r\n\r\n\r\n        if top_termination[8] is not None:\r\n\r\n            diagnostics.append(\r\n                \"TOP BEAM DEPTH = {:.1f} mm\".format(\r\n                    top_termination[8]\r\n                )\r\n            )\r\n\r\n    else:\r\n\r\n        diagnostics.append(\r\n            \"NO TOP BEAM / JOINT AT STACK TOP\"\r\n        )\r\n\r\n\r\n    diagnostics.append(\r\n        \"TOP CONCRETE COVER = {:.1f} mm\".format(\r\n            top_cover\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"CORRECTED TOP BAR BEND Z = {:.1f} mm\".format(\r\n            top_bend_z\r\n        )\r\n    )\r\n\r\n\r\n    if (\r\n        center_x is not None\r\n        and center_y is not None\r\n    ):\r\n\r\n        diagnostics.append(\r\n            \"COLUMN CENTER XY = ({:.3f}, {:.3f}) mm\".format(\r\n                center_x,\r\n                center_y\r\n            )\r\n        )\r\n\r\n\r\n    diagnostics.append(\r\n        \"GROUP A = {}\".format(\r\n            group_a\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"GROUP B = {}\".format(\r\n            group_b\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"TOP BAR BEND CENTERLINE = {:.1f} mm\".format(\r\n            top_bend_z\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"TOP BAR CENTERLINE IS {:.1f} mm BELOW CONCRETE TOP\".format(\r\n            stack_top - top_bend_z\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"TOP HOOK DIRECTIONS REVERSED TOWARD COLUMN CORE\"\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"M03 BAR PATH COUNT = {}\".format(\r\n            len(bar_paths)\r\n        )\r\n    )\r\n\r\n\r\n    diagnostics.append(\r\n        \"MAXIMUM PRELIMINARY BAR PATH = {:.1f} mm\".format(\r\n            maximum_path\r\n        )\r\n    )\r\n\r\n\r\n    if len(bar_paths) == total_main_bars:\r\n\r\n        diagnostics.append(\r\n            \"PASS: ALL MAIN BAR PATHS GENERATED\"\r\n        )\r\n\r\n    else:\r\n\r\n        diagnostics.append(\r\n            \"WARNING: EXPECTED {} BAR PATHS, GENERATED {}\".format(\r\n                total_main_bars,\r\n                len(bar_paths)\r\n            )\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PRESERVE ORIGINAL M03 ARCHITECTURE\r\n    # --------------------------------------------------------\r\n\r\n    return [\r\n        stack_index,             # 0\r\n        column_ids,              # 1\r\n        db,                      # 2\r\n        total_main_bars,         # 3\r\n        lap_length,              # 4\r\n        hook_extension,          # 5\r\n        group_a,                 # 6\r\n        group_b,                 # 7\r\n        stack_bottom,            # 8\r\n        stack_top,               # 9\r\n        foundation_data,         # 10\r\n        top_termination,         # 11\r\n        bar_paths,               # 12\r\n        maximum_path,            # 13\r\n        diagnostics,             # 14\r\n        m02                      # 15\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\nraw_input = IN[0]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# COLLECT EVERY M02 STACK\r\n# ------------------------------------------------------------\r\n\r\nm02_packages = collect_m02_packages(\r\n    raw_input\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# PROCESS EVERY STACK\r\n# ------------------------------------------------------------\r\n\r\noutput = []\r\n\r\n\r\nfor m02 in m02_packages:\r\n\r\n    try:\r\n\r\n        result = process_m02(\r\n            m02\r\n        )\r\n\r\n\r\n        if result is not None:\r\n\r\n            output.append(\r\n                result\r\n            )\r\n\r\n    except Exception as ex:\r\n\r\n        # Keep the remaining stacks running if one stack fails.\r\n\r\n        try:\r\n\r\n            stack_index = safe_int(\r\n                m02[0],\r\n                -1\r\n            )\r\n\r\n            column_ids = m02[1]\r\n\r\n        except:\r\n\r\n            stack_index = -1\r\n            column_ids = []\r\n\r\n\r\n        output.append(\r\n            [\r\n                stack_index,                 # 0\r\n                column_ids,                  # 1\r\n                None,                        # 2\r\n                0,                           # 3\r\n                None,                        # 4\r\n                None,                        # 5\r\n                [],                          # 6\r\n                [],                          # 7\r\n                None,                        # 8\r\n                None,                        # 9\r\n                [],                          # 10\r\n                [],                          # 11\r\n                [],                          # 12\r\n                0.0,                         # 13\r\n                [\r\n                    \"M03 ERROR\",\r\n                    str(ex)\r\n                ],                            # 14\r\n                m02                          # 15\r\n            ]\r\n        )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# OUTPUT\r\n# ------------------------------------------------------------\r\n\r\nOUT = output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
