    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# T02 — GENERATE ACTUAL COLUMN TIES / CROSSTIES\r\n# CORRECTED — NATIVE REVIT HOST / UNWRAP FIX\r\n#\r\n# IN[0] = COMPLETE T01 OUTPUT\r\n#\r\n# Creates:\r\n#   1. Perimeter rectangular ties\r\n#   2. X-direction crossties\r\n#   3. Y-direction crossties\r\n#\r\n# Anti-duplication:\r\n#   Deletes ONLY previous T02-generated reinforcement.\r\n#   R02 main bars are preserved.\r\n#   Manual / untagged reinforcement is preserved.\r\n#\r\n# Ownership:\r\n#   DYNAMO_T02_TIE_C<ColumnID>_...\r\n#\r\n# Legacy cleanup:\r\n#   DYNAMO_T02_COLUMN_TIE_C<ColumnID>_...\r\n#\r\n# OUT:\r\n# [0] Per-column results\r\n# [1] Target Column IDs\r\n# [2] Deleted T02 Rebar IDs\r\n# [3] Number Deleted\r\n# [4] Number Created\r\n# [5] Rebar Type Diagnostics\r\n# [6] Ownership Diagnostics\r\n# [7] Status\r\n# ============================================================\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT / DYNAMO\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# CONSTANTS\r\n# ------------------------------------------------------------\r\n\r\nMM_TO_FT = 1.0 / 304.8\r\nFT_TO_MM = 304.8\r\n\r\nNEW_PREFIX = \"DYNAMO_T02_TIE\"\r\nOLD_PREFIX = \"DYNAMO_T02_COLUMN_TIE\"\r\n\r\nTYPE_TOLERANCE_MM = 0.75\r\nGEOM_TOL_MM = 1.0\r\n\r\n\r\n# ------------------------------------------------------------\r\n# BASIC HELPERS\r\n# ------------------------------------------------------------\r\n\r\ndef is_sequence(obj):\r\n\r\n    return isinstance(\r\n        obj,\r\n        (list, tuple)\r\n    )\r\n\r\n\r\ndef safe_float(value, default=0.0):\r\n\r\n    try:\r\n        return float(value)\r\n    except:\r\n        return default\r\n\r\n\r\ndef safe_int(value, default=0):\r\n\r\n    try:\r\n        return int(value)\r\n    except:\r\n        return default\r\n\r\n\r\ndef mm_to_ft(value):\r\n\r\n    return float(value) * MM_TO_FT\r\n\r\n\r\ndef ft_to_mm(value):\r\n\r\n    return float(value) * FT_TO_MM\r\n\r\n\r\ndef id_value(eid):\r\n\r\n    if eid is None:\r\n        return -1\r\n\r\n    try:\r\n        return int(eid.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(eid.IntegerValue)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(str(eid))\r\n    except:\r\n        return -1\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNWRAP DYNAMO LIST WRAPPERS\r\n# ------------------------------------------------------------\r\n\r\ndef unwrap_single(value):\r\n\r\n    current = value\r\n\r\n    for i in range(12):\r\n\r\n        if (\r\n            is_sequence(current)\r\n            and len(current) == 1\r\n            and is_sequence(current[0])\r\n        ):\r\n\r\n            current = current[0]\r\n\r\n        else:\r\n            break\r\n\r\n    return current\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNWRAP DYNAMO ELEMENT\r\n# ------------------------------------------------------------\r\n\r\ndef native_element(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    # Already native Revit element\r\n    try:\r\n\r\n        if isinstance(\r\n            element,\r\n            Autodesk.Revit.DB.Element\r\n        ):\r\n            return element\r\n\r\n    except:\r\n        pass\r\n\r\n    # Dynamo UnwrapElement\r\n    try:\r\n\r\n        unwrapped = UnwrapElement(\r\n            element\r\n        )\r\n\r\n        if unwrapped is not None:\r\n            return unwrapped\r\n\r\n    except:\r\n        pass\r\n\r\n    # InternalElement\r\n    try:\r\n\r\n        internal = element.InternalElement\r\n\r\n        if internal is not None:\r\n            return internal\r\n\r\n    except:\r\n        pass\r\n\r\n    # InternalElementId\r\n    try:\r\n\r\n        internal_id = element.InternalElementId\r\n\r\n        if internal_id is not None:\r\n\r\n            found = doc.GetElement(\r\n                internal_id\r\n            )\r\n\r\n            if found is not None:\r\n                return found\r\n\r\n    except:\r\n        pass\r\n\r\n    # Dynamo element Id\r\n    try:\r\n\r\n        dyn_id = element.Id\r\n\r\n        try:\r\n            eid = ElementId(\r\n                int(dyn_id)\r\n            )\r\n\r\n            found = doc.GetElement(\r\n                eid\r\n            )\r\n\r\n            if found is not None:\r\n                return found\r\n\r\n        except:\r\n            pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# IDENTIFY T01 PACKAGE\r\n# ------------------------------------------------------------\r\n\r\ndef is_t01_package(item):\r\n\r\n    if not is_sequence(item):\r\n        return False\r\n\r\n    if len(item) < 20:\r\n        return False\r\n\r\n    try:\r\n\r\n        cid = safe_int(\r\n            item[1],\r\n            -1\r\n        )\r\n\r\n        tie_dia = safe_float(\r\n            item[2],\r\n            -1.0\r\n        )\r\n\r\n        segment_plans = item[13]\r\n        all_ties = item[14]\r\n\r\n        if cid < 0:\r\n            return False\r\n\r\n        if tie_dia <= 0:\r\n            return False\r\n\r\n        if not is_sequence(\r\n            segment_plans\r\n        ):\r\n            return False\r\n\r\n        if not is_sequence(\r\n            all_ties\r\n        ):\r\n            return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_t01_packages(data):\r\n\r\n    data = unwrap_single(\r\n        data\r\n    )\r\n\r\n    if is_t01_package(\r\n        data\r\n    ):\r\n        return [data]\r\n\r\n    result = []\r\n\r\n    if is_sequence(\r\n        data\r\n    ):\r\n\r\n        for item in data:\r\n\r\n            item = unwrap_single(\r\n                item\r\n            )\r\n\r\n            if is_t01_package(\r\n                item\r\n            ):\r\n\r\n                result.append(\r\n                    item\r\n                )\r\n\r\n    return result\r\n\r\n\r\n# ------------------------------------------------------------\r\n# COMMENTS\r\n# ------------------------------------------------------------\r\n\r\ndef get_comments(element):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS\r\n        )\r\n\r\n        if p:\r\n\r\n            value = p.AsString()\r\n\r\n            if value:\r\n                return value\r\n\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        p = element.LookupParameter(\r\n            \"Comments\"\r\n        )\r\n\r\n        if p:\r\n\r\n            value = p.AsString()\r\n\r\n            if value:\r\n                return value\r\n\r\n    except:\r\n        pass\r\n\r\n    return \"\"\r\n\r\n\r\ndef set_comments(element, text):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            BuiltInParameter.ALL_MODEL_INSTANCE_COMMENTS\r\n        )\r\n\r\n        if p and not p.IsReadOnly:\r\n\r\n            p.Set(\r\n                text\r\n            )\r\n\r\n            return True\r\n\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        p = element.LookupParameter(\r\n            \"Comments\"\r\n        )\r\n\r\n        if p and not p.IsReadOnly:\r\n\r\n            p.Set(\r\n                text\r\n            )\r\n\r\n            return True\r\n\r\n    except:\r\n        pass\r\n\r\n    return False\r\n\r\n\r\n# ------------------------------------------------------------\r\n# BAR DIAMETER\r\n# ------------------------------------------------------------\r\n\r\ndef get_bar_diameter_mm(bar_type):\r\n\r\n    candidates = []\r\n\r\n    try:\r\n\r\n        candidates.append(\r\n            ft_to_mm(\r\n                bar_type.BarNominalDiameter\r\n            )\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        candidates.append(\r\n            ft_to_mm(\r\n                bar_type.BarModelDiameter\r\n            )\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        p = bar_type.get_Parameter(\r\n            BuiltInParameter.REBAR_BAR_DIAMETER\r\n        )\r\n\r\n        if p:\r\n\r\n            candidates.append(\r\n                ft_to_mm(\r\n                    p.AsDouble()\r\n                )\r\n            )\r\n\r\n    except:\r\n        pass\r\n\r\n    for value in candidates:\r\n\r\n        if value > 0:\r\n            return value\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FIND REBAR TYPE\r\n# ------------------------------------------------------------\r\n\r\ndef find_rebar_type(\r\n    requested_mm\r\n):\r\n\r\n    candidates = []\r\n\r\n    collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarBarType)\r\n    )\r\n\r\n    for bar_type in collector:\r\n\r\n        diameter = get_bar_diameter_mm(\r\n            bar_type\r\n        )\r\n\r\n        if diameter is None:\r\n            continue\r\n\r\n        difference = abs(\r\n            diameter\r\n            - requested_mm\r\n        )\r\n\r\n        candidates.append(\r\n            (\r\n                difference,\r\n                diameter,\r\n                bar_type\r\n            )\r\n        )\r\n\r\n    candidates.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n    if not candidates:\r\n\r\n        return None, [\r\n            \"REQUESTED = {:.3f} mm\".format(\r\n                requested_mm\r\n            ),\r\n            \"FAIL: NO REBAR TYPES FOUND\"\r\n        ]\r\n\r\n    difference = candidates[0][0]\r\n    diameter = candidates[0][1]\r\n    bar_type = candidates[0][2]\r\n\r\n    diagnostics = [\r\n        \"REQUESTED NOMINAL = {:.3f} mm\".format(\r\n            requested_mm\r\n        ),\r\n        \"SELECTED REVIT BAR = {:.3f} mm\".format(\r\n            diameter\r\n        ),\r\n        \"DIFFERENCE = {:.3f} mm\".format(\r\n            difference\r\n        ),\r\n        \"REBAR TYPE ID = {}\".format(\r\n            id_value(\r\n                bar_type.Id\r\n            )\r\n        ),\r\n        \"TOLERANCE = {:.3f} mm\".format(\r\n            TYPE_TOLERANCE_MM\r\n        )\r\n    ]\r\n\r\n    if difference > TYPE_TOLERANCE_MM:\r\n\r\n        diagnostics.append(\r\n            \"FAIL: REBAR TYPE OUTSIDE TOLERANCE\"\r\n        )\r\n\r\n        return None, diagnostics\r\n\r\n    diagnostics.append(\r\n        \"PASS: REBAR TYPE MATCH ACCEPTED\"\r\n    )\r\n\r\n    return bar_type, diagnostics\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET NATIVE COLUMN\r\n# ------------------------------------------------------------\r\n\r\ndef get_native_column(\r\n    t01\r\n):\r\n\r\n    source = t01[0]\r\n\r\n    column = native_element(\r\n        source\r\n    )\r\n\r\n    if column is not None:\r\n\r\n        return column\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FALLBACK USING COLUMN ID\r\n    # --------------------------------------------------------\r\n\r\n    cid = safe_int(\r\n        t01[1],\r\n        -1\r\n    )\r\n\r\n    if cid >= 0:\r\n\r\n        try:\r\n\r\n            column = doc.GetElement(\r\n                ElementId(\r\n                    cid\r\n                )\r\n            )\r\n\r\n            if column is not None:\r\n                return column\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# COLUMN FRAME\r\n# ------------------------------------------------------------\r\n\r\ndef get_column_frame(\r\n    column,\r\n    t01\r\n):\r\n\r\n    origin = None\r\n    angle = None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # LOCATION POINT\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        loc = column.Location\r\n\r\n        if isinstance(\r\n            loc,\r\n            LocationPoint\r\n        ):\r\n\r\n            p = loc.Point\r\n\r\n            origin = XYZ(\r\n                p.X,\r\n                p.Y,\r\n                0.0\r\n            )\r\n\r\n            try:\r\n\r\n                angle = float(\r\n                    loc.Rotation\r\n                )\r\n\r\n            except:\r\n                angle = None\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # M02 FALLBACK\r\n    # --------------------------------------------------------\r\n\r\n    if origin is None:\r\n\r\n        try:\r\n\r\n            m02 = t01[19]\r\n\r\n            storeys = m02[6]\r\n\r\n            cid = safe_int(\r\n                t01[1]\r\n            )\r\n\r\n            target = None\r\n\r\n            for storey in storeys:\r\n\r\n                if (\r\n                    is_sequence(storey)\r\n                    and len(storey) > 14\r\n                    and safe_int(\r\n                        storey[1],\r\n                        -1\r\n                    ) == cid\r\n                ):\r\n\r\n                    target = storey\r\n\r\n                    break\r\n\r\n\r\n            if (\r\n                target is None\r\n                and len(storeys) > 0\r\n            ):\r\n\r\n                target = storeys[0]\r\n\r\n\r\n            if target is not None:\r\n\r\n                layout = target[14]\r\n\r\n                global_x = []\r\n                global_y = []\r\n\r\n                for bar in layout:\r\n\r\n                    if len(bar) > 5:\r\n\r\n                        global_x.append(\r\n                            safe_float(\r\n                                bar[4]\r\n                            )\r\n                        )\r\n\r\n                        global_y.append(\r\n                            safe_float(\r\n                                bar[5]\r\n                            )\r\n                        )\r\n\r\n\r\n                if global_x and global_y:\r\n\r\n                    cx = (\r\n                        min(global_x)\r\n                        + max(global_x)\r\n                    ) / 2.0\r\n\r\n                    cy = (\r\n                        min(global_y)\r\n                        + max(global_y)\r\n                    ) / 2.0\r\n\r\n\r\n                    origin = XYZ(\r\n                        mm_to_ft(\r\n                            cx\r\n                        ),\r\n                        mm_to_ft(\r\n                            cy\r\n                        ),\r\n                        0.0\r\n                    )\r\n\r\n\r\n                try:\r\n\r\n                    rotation_deg = safe_float(\r\n                        target[6]\r\n                    )\r\n\r\n                    angle = math.radians(\r\n                        rotation_deg\r\n                    )\r\n\r\n                except:\r\n                    pass\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOUNDING BOX FALLBACK\r\n    # --------------------------------------------------------\r\n\r\n    if origin is None:\r\n\r\n        try:\r\n\r\n            bb = column.get_BoundingBox(\r\n                None\r\n            )\r\n\r\n            if bb is not None:\r\n\r\n                origin = XYZ(\r\n                    (\r\n                        bb.Min.X\r\n                        + bb.Max.X\r\n                    ) / 2.0,\r\n\r\n                    (\r\n                        bb.Min.Y\r\n                        + bb.Max.Y\r\n                    ) / 2.0,\r\n\r\n                    0.0\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if origin is None:\r\n        return None\r\n\r\n\r\n    if angle is None:\r\n        angle = 0.0\r\n\r\n\r\n    local_x = XYZ(\r\n        math.cos(angle),\r\n        math.sin(angle),\r\n        0.0\r\n    )\r\n\r\n\r\n    local_y = XYZ(\r\n        -math.sin(angle),\r\n        math.cos(angle),\r\n        0.0\r\n    )\r\n\r\n\r\n    return [\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        angle\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# LOCAL → GLOBAL\r\n# ------------------------------------------------------------\r\n\r\ndef local_point(\r\n    origin,\r\n    local_x,\r\n    local_y,\r\n    x_mm,\r\n    y_mm,\r\n    z_mm\r\n):\r\n\r\n    x = mm_to_ft(\r\n        x_mm\r\n    )\r\n\r\n    y = mm_to_ft(\r\n        y_mm\r\n    )\r\n\r\n    z = mm_to_ft(\r\n        z_mm\r\n    )\r\n\r\n\r\n    return XYZ(\r\n        origin.X\r\n        + local_x.X * x\r\n        + local_y.X * y,\r\n\r\n        origin.Y\r\n        + local_x.Y * x\r\n        + local_y.Y * y,\r\n\r\n        z\r\n    )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# MAIN BAR LAYOUT\r\n# ------------------------------------------------------------\r\n\r\ndef get_main_bar_layout(\r\n    t01\r\n):\r\n\r\n    try:\r\n\r\n        cid = safe_int(\r\n            t01[1]\r\n        )\r\n\r\n        m02 = t01[19]\r\n\r\n        storeys = m02[6]\r\n\r\n        for storey in storeys:\r\n\r\n            if (\r\n                is_sequence(storey)\r\n                and len(storey) > 14\r\n                and safe_int(\r\n                    storey[1],\r\n                    -1\r\n                ) == cid\r\n            ):\r\n\r\n                return storey[14]\r\n\r\n\r\n        if storeys:\r\n\r\n            return storeys[0][14]\r\n\r\n    except:\r\n        pass\r\n\r\n    return []\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNIQUE VALUES\r\n# ------------------------------------------------------------\r\n\r\ndef unique_sorted(\r\n    values,\r\n    tolerance=1.0\r\n):\r\n\r\n    result = []\r\n\r\n    for value in sorted(\r\n        values\r\n    ):\r\n\r\n        if not result:\r\n\r\n            result.append(\r\n                value\r\n            )\r\n\r\n        elif abs(\r\n            value\r\n            - result[-1]\r\n        ) > tolerance:\r\n\r\n            result.append(\r\n                value\r\n            )\r\n\r\n    return result\r\n\r\n\r\n# ------------------------------------------------------------\r\n# CROSSTIE OFFSETS\r\n# ------------------------------------------------------------\r\n\r\ndef get_crosstie_offsets(\r\n    layout,\r\n    hx,\r\n    hy\r\n):\r\n\r\n    xs = []\r\n    ys = []\r\n\r\n    for bar in layout:\r\n\r\n        try:\r\n\r\n            xs.append(\r\n                safe_float(\r\n                    bar[2]\r\n                )\r\n            )\r\n\r\n            ys.append(\r\n                safe_float(\r\n                    bar[3]\r\n                )\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    xs = unique_sorted(\r\n        xs\r\n    )\r\n\r\n    ys = unique_sorted(\r\n        ys\r\n    )\r\n\r\n\r\n    interior_x = []\r\n\r\n    interior_y = []\r\n\r\n\r\n    for x in xs:\r\n\r\n        if (\r\n            abs(x)\r\n            < hx - GEOM_TOL_MM\r\n        ):\r\n\r\n            interior_x.append(\r\n                x\r\n            )\r\n\r\n\r\n    for y in ys:\r\n\r\n        if (\r\n            abs(y)\r\n            < hy - GEOM_TOL_MM\r\n        ):\r\n\r\n            interior_y.append(\r\n                y\r\n            )\r\n\r\n\r\n    return [\r\n        interior_x,\r\n        interior_y\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# PERIMETER TIE\r\n# ------------------------------------------------------------\r\n\r\ndef perimeter_curves(\r\n    origin,\r\n    local_x,\r\n    local_y,\r\n    hx,\r\n    hy,\r\n    z\r\n):\r\n\r\n    p1 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        -hx,\r\n        -hy,\r\n        z\r\n    )\r\n\r\n    p2 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        hx,\r\n        -hy,\r\n        z\r\n    )\r\n\r\n    p3 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        hx,\r\n        hy,\r\n        z\r\n    )\r\n\r\n    p4 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        -hx,\r\n        hy,\r\n        z\r\n    )\r\n\r\n\r\n    return [\r\n        Line.CreateBound(\r\n            p1,\r\n            p2\r\n        ),\r\n\r\n        Line.CreateBound(\r\n            p2,\r\n            p3\r\n        ),\r\n\r\n        Line.CreateBound(\r\n            p3,\r\n            p4\r\n        ),\r\n\r\n        Line.CreateBound(\r\n            p4,\r\n            p1\r\n        )\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# X CROSSTIE\r\n# ------------------------------------------------------------\r\n\r\ndef x_crosstie_curves(\r\n    origin,\r\n    local_x,\r\n    local_y,\r\n    hx,\r\n    y,\r\n    z\r\n):\r\n\r\n    p1 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        -hx,\r\n        y,\r\n        z\r\n    )\r\n\r\n    p2 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        hx,\r\n        y,\r\n        z\r\n    )\r\n\r\n\r\n    return [\r\n        Line.CreateBound(\r\n            p1,\r\n            p2\r\n        )\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# Y CROSSTIE\r\n# ------------------------------------------------------------\r\n\r\ndef y_crosstie_curves(\r\n    origin,\r\n    local_x,\r\n    local_y,\r\n    x,\r\n    hy,\r\n    z\r\n):\r\n\r\n    p1 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        x,\r\n        -hy,\r\n        z\r\n    )\r\n\r\n    p2 = local_point(\r\n        origin,\r\n        local_x,\r\n        local_y,\r\n        x,\r\n        hy,\r\n        z\r\n    )\r\n\r\n\r\n    return [\r\n        Line.CreateBound(\r\n            p1,\r\n            p2\r\n        )\r\n    ]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# CREATE REBAR\r\n# ------------------------------------------------------------\r\n\r\ndef create_rebar(\r\n    host,\r\n    bar_type,\r\n    curves\r\n):\r\n\r\n    # Host MUST be native Autodesk.Revit.DB.Element\r\n\r\n    native_host = native_element(\r\n        host\r\n    )\r\n\r\n    if native_host is None:\r\n\r\n        native_host = host\r\n\r\n\r\n    return Rebar.CreateFromCurves(\r\n        doc,\r\n        RebarStyle.StirrupTie,\r\n        bar_type,\r\n        None,\r\n        None,\r\n        native_host,\r\n        XYZ.BasisZ,\r\n        curves,\r\n        RebarHookOrientation.Left,\r\n        RebarHookOrientation.Left,\r\n        True,\r\n        True\r\n    )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT\r\n# ------------------------------------------------------------\r\n\r\nraw_input = IN[0]\r\n\r\n\r\nt01_packages = collect_t01_packages(\r\n    raw_input\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# VALIDATE INPUT\r\n# ------------------------------------------------------------\r\n\r\nif not t01_packages:\r\n\r\n    OUT = [\r\n        [],\r\n        [],\r\n        [],\r\n        0,\r\n        0,\r\n        [],\r\n        [],\r\n        \"ERROR: NO T01 PACKAGES FOUND\"\r\n    ]\r\n\r\n\r\nelse:\r\n\r\n    # --------------------------------------------------------\r\n    # TARGET IDS\r\n    # --------------------------------------------------------\r\n\r\n    target_ids = []\r\n\r\n    valid_packages = []\r\n\r\n    input_diagnostics = []\r\n\r\n\r\n    for pkg in t01_packages:\r\n\r\n        cid = safe_int(\r\n            pkg[1],\r\n            -1\r\n        )\r\n\r\n        column = get_native_column(\r\n            pkg\r\n        )\r\n\r\n\r\n        if column is None:\r\n\r\n            input_diagnostics.append(\r\n                [\r\n                    cid,\r\n                    \"FAIL: NATIVE REVIT COLUMN NOT FOUND\"\r\n                ]\r\n            )\r\n\r\n            continue\r\n\r\n\r\n        valid_packages.append(\r\n            pkg\r\n        )\r\n\r\n\r\n        if cid not in target_ids:\r\n\r\n            target_ids.append(\r\n                cid\r\n            )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # REQUIRED TYPES\r\n    # --------------------------------------------------------\r\n\r\n    type_cache = {}\r\n\r\n    type_diagnostics = []\r\n\r\n    requested_diameters = []\r\n\r\n\r\n    for pkg in valid_packages:\r\n\r\n        diameter = round(\r\n            safe_float(\r\n                pkg[2]\r\n            ),\r\n            3\r\n        )\r\n\r\n        if diameter not in requested_diameters:\r\n\r\n            requested_diameters.append(\r\n                diameter\r\n            )\r\n\r\n\r\n    for requested in requested_diameters:\r\n\r\n        bar_type, diag = find_rebar_type(\r\n            requested\r\n        )\r\n\r\n\r\n        type_cache[\r\n            requested\r\n        ] = bar_type\r\n\r\n\r\n        type_diagnostics.append(\r\n            [\r\n                requested,\r\n                diag\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ABORT BEFORE DELETE IF TYPE MISSING\r\n    # --------------------------------------------------------\r\n\r\n    missing_types = []\r\n\r\n    for diameter in requested_diameters:\r\n\r\n        if type_cache.get(\r\n            diameter\r\n        ) is None:\r\n\r\n            missing_types.append(\r\n                diameter\r\n            )\r\n\r\n\r\n    if missing_types:\r\n\r\n        OUT = [\r\n            input_diagnostics,\r\n            target_ids,\r\n            [],\r\n            0,\r\n            0,\r\n            type_diagnostics,\r\n            [\r\n                \"NO T02 REBAR DELETED\",\r\n                \"R02 MAIN BARS PRESERVED\",\r\n                \"MANUAL REBAR PRESERVED\"\r\n            ],\r\n            \"ERROR: REQUIRED TIE BAR TYPE NOT FOUND\"\r\n        ]\r\n\r\n\r\n    else:\r\n\r\n        # ----------------------------------------------------\r\n        # TRANSACTION\r\n        # ----------------------------------------------------\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(\r\n            doc\r\n        )\r\n\r\n\r\n        deleted_ids = []\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # DELETE OLD T02 ONLY\r\n        # ----------------------------------------------------\r\n\r\n        existing_rebars = (\r\n            FilteredElementCollector(doc)\r\n            .OfClass(Rebar)\r\n            .WhereElementIsNotElementType()\r\n            .ToElements()\r\n        )\r\n\r\n\r\n        for rebar in existing_rebars:\r\n\r\n            try:\r\n\r\n                host_id = id_value(\r\n                    rebar.GetHostId()\r\n                )\r\n\r\n\r\n                if host_id not in target_ids:\r\n                    continue\r\n\r\n\r\n                comments = get_comments(\r\n                    rebar\r\n                )\r\n\r\n\r\n                if not (\r\n                    comments.startswith(\r\n                        NEW_PREFIX\r\n                    )\r\n                    or\r\n                    comments.startswith(\r\n                        OLD_PREFIX\r\n                    )\r\n                ):\r\n\r\n                    continue\r\n\r\n\r\n                rid = id_value(\r\n                    rebar.Id\r\n                )\r\n\r\n\r\n                doc.Delete(\r\n                    rebar.Id\r\n                )\r\n\r\n\r\n                deleted_ids.append(\r\n                    rid\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # CREATE\r\n        # ----------------------------------------------------\r\n\r\n        results = []\r\n\r\n        total_created = 0\r\n\r\n        total_perimeter = 0\r\n        total_x = 0\r\n        total_y = 0\r\n\r\n        tag_success = 0\r\n        tag_failed = 0\r\n\r\n\r\n        for t01 in valid_packages:\r\n\r\n            column_id = safe_int(\r\n                t01[1]\r\n            )\r\n\r\n\r\n            column = get_native_column(\r\n                t01\r\n            )\r\n\r\n\r\n            requested_tie_dia = safe_float(\r\n                t01[2]\r\n            )\r\n\r\n\r\n            cover = safe_float(\r\n                t01[3]\r\n            )\r\n\r\n\r\n            main_db = safe_float(\r\n                t01[4]\r\n            )\r\n\r\n\r\n            total_main_bars = safe_int(\r\n                t01[5]\r\n            )\r\n\r\n\r\n            width = safe_float(\r\n                t01[6]\r\n            )\r\n\r\n\r\n            depth = safe_float(\r\n                t01[7]\r\n            )\r\n\r\n\r\n            conf_spacing = safe_float(\r\n                t01[11]\r\n            )\r\n\r\n\r\n            regular_spacing = safe_float(\r\n                t01[12]\r\n            )\r\n\r\n\r\n            tie_elevations = t01[14]\r\n\r\n\r\n            diagnostics = [\r\n                \"COLUMN ID = {}\".format(\r\n                    column_id\r\n                ),\r\n                \"NATIVE HOST TYPE = {}\".format(\r\n                    column.GetType().FullName\r\n                ),\r\n                \"SIZE = {:.0f} x {:.0f} mm\".format(\r\n                    width,\r\n                    depth\r\n                ),\r\n                \"MAIN = {}-D{:.0f}\".format(\r\n                    total_main_bars,\r\n                    main_db\r\n                ),\r\n                \"REQUESTED TIE = {:.1f} mm\".format(\r\n                    requested_tie_dia\r\n                ),\r\n                \"COVER = {:.1f} mm\".format(\r\n                    cover\r\n                ),\r\n                \"CONF SPACING = {:.1f} mm\".format(\r\n                    conf_spacing\r\n                ),\r\n                \"REGULAR SPACING = {:.1f} mm\".format(\r\n                    regular_spacing\r\n                )\r\n            ]\r\n\r\n\r\n            # ------------------------------------------------\r\n            # TYPE\r\n            # ------------------------------------------------\r\n\r\n            type_key = round(\r\n                requested_tie_dia,\r\n                3\r\n            )\r\n\r\n\r\n            bar_type = type_cache[\r\n                type_key\r\n            ]\r\n\r\n\r\n            actual_tie_dia = get_bar_diameter_mm(\r\n                bar_type\r\n            )\r\n\r\n\r\n            diagnostics.append(\r\n                \"REVIT ACTUAL TIE DIA = {:.3f} mm\".format(\r\n                    actual_tie_dia\r\n                )\r\n            )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # FRAME\r\n            # ------------------------------------------------\r\n\r\n            frame = get_column_frame(\r\n                column,\r\n                t01\r\n            )\r\n\r\n\r\n            if frame is None:\r\n\r\n                diagnostics.append(\r\n                    \"FAIL: COLUMN FRAME NOT FOUND\"\r\n                )\r\n\r\n\r\n                results.append(\r\n                    [\r\n                        column_id,\r\n                        [],\r\n                        0,\r\n                        0,\r\n                        0,\r\n                        0,\r\n                        [\r\n                            \"COLUMN FRAME NOT FOUND\"\r\n                        ],\r\n                        diagnostics\r\n                    ]\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            origin = frame[0]\r\n            local_x = frame[1]\r\n            local_y = frame[2]\r\n\r\n\r\n            # ------------------------------------------------\r\n            # TIE CENTERLINE\r\n            # ------------------------------------------------\r\n\r\n            offset = (\r\n                cover\r\n                + actual_tie_dia / 2.0\r\n            )\r\n\r\n\r\n            hx = (\r\n                width / 2.0\r\n                - offset\r\n            )\r\n\r\n\r\n            hy = (\r\n                depth / 2.0\r\n                - offset\r\n            )\r\n\r\n\r\n            if hx <= 0 or hy <= 0:\r\n\r\n                diagnostics.append(\r\n                    \"FAIL: INVALID TIE CENTERLINE\"\r\n                )\r\n\r\n\r\n                results.append(\r\n                    [\r\n                        column_id,\r\n                        [],\r\n                        0,\r\n                        0,\r\n                        0,\r\n                        0,\r\n                        [\r\n                            \"INVALID TIE CENTERLINE\"\r\n                        ],\r\n                        diagnostics\r\n                    ]\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # CROSSTIE LOCATIONS\r\n            # ------------------------------------------------\r\n\r\n            layout = get_main_bar_layout(\r\n                t01\r\n            )\r\n\r\n\r\n            cross = get_crosstie_offsets(\r\n                layout,\r\n                hx,\r\n                hy\r\n            )\r\n\r\n\r\n            interior_x = cross[0]\r\n            interior_y = cross[1]\r\n\r\n\r\n            if total_main_bars >= 8:\r\n\r\n                if not interior_x:\r\n\r\n                    interior_x = [\r\n                        0.0\r\n                    ]\r\n\r\n\r\n                if not interior_y:\r\n\r\n                    interior_y = [\r\n                        0.0\r\n                    ]\r\n\r\n\r\n            # ------------------------------------------------\r\n            # ELEVATIONS\r\n            # ------------------------------------------------\r\n\r\n            elevations = []\r\n\r\n\r\n            for z in tie_elevations:\r\n\r\n                try:\r\n\r\n                    elevations.append(\r\n                        float(z)\r\n                    )\r\n\r\n                except:\r\n                    pass\r\n\r\n\r\n            elevations = unique_sorted(\r\n                elevations,\r\n                0.5\r\n            )\r\n\r\n\r\n            created_ids = []\r\n\r\n            failures = []\r\n\r\n            perimeter_count = 0\r\n            x_count = 0\r\n            y_count = 0\r\n\r\n\r\n            # ------------------------------------------------\r\n            # GENERATE EACH ELEVATION\r\n            # ------------------------------------------------\r\n\r\n            for i, z in enumerate(\r\n                elevations\r\n            ):\r\n\r\n                z_index = i + 1\r\n\r\n\r\n                # --------------------------------------------\r\n                # PERIMETER\r\n                # --------------------------------------------\r\n\r\n                try:\r\n\r\n                    curves = perimeter_curves(\r\n                        origin,\r\n                        local_x,\r\n                        local_y,\r\n                        hx,\r\n                        hy,\r\n                        z\r\n                    )\r\n\r\n\r\n                    rebar = create_rebar(\r\n                        column,\r\n                        bar_type,\r\n                        curves\r\n                    )\r\n\r\n\r\n                    tag = (\r\n                        \"{}_C{}_Z{:03d}_PERIMETER\"\r\n                    ).format(\r\n                        NEW_PREFIX,\r\n                        column_id,\r\n                        z_index\r\n                    )\r\n\r\n\r\n                    if set_comments(\r\n                        rebar,\r\n                        tag\r\n                    ):\r\n\r\n                        tag_success += 1\r\n\r\n                    else:\r\n\r\n                        tag_failed += 1\r\n\r\n\r\n                    rid = id_value(\r\n                        rebar.Id\r\n                    )\r\n\r\n\r\n                    created_ids.append(\r\n                        rid\r\n                    )\r\n\r\n\r\n                    perimeter_count += 1\r\n                    total_perimeter += 1\r\n                    total_created += 1\r\n\r\n\r\n                except Exception as ex:\r\n\r\n                    failures.append(\r\n                        \"PERIMETER Z {:.1f}: {}\".format(\r\n                            z,\r\n                            str(ex)\r\n                        )\r\n                    )\r\n\r\n\r\n                # --------------------------------------------\r\n                # X CROSSTIES\r\n                # --------------------------------------------\r\n\r\n                for j, y_offset in enumerate(\r\n                    interior_y\r\n                ):\r\n\r\n                    try:\r\n\r\n                        curves = x_crosstie_curves(\r\n                            origin,\r\n                            local_x,\r\n                            local_y,\r\n                            hx,\r\n                            y_offset,\r\n                            z\r\n                        )\r\n\r\n\r\n                        rebar = create_rebar(\r\n                            column,\r\n                            bar_type,\r\n                            curves\r\n                        )\r\n\r\n\r\n                        tag = (\r\n                            \"{}_C{}_Z{:03d}_X{:02d}\"\r\n                        ).format(\r\n                            NEW_PREFIX,\r\n                            column_id,\r\n                            z_index,\r\n                            j + 1\r\n                        )\r\n\r\n\r\n                        if set_comments(\r\n                            rebar,\r\n                            tag\r\n                        ):\r\n\r\n                            tag_success += 1\r\n\r\n                        else:\r\n\r\n                            tag_failed += 1\r\n\r\n\r\n                        rid = id_value(\r\n                            rebar.Id\r\n                        )\r\n\r\n\r\n                        created_ids.append(\r\n                            rid\r\n                        )\r\n\r\n\r\n                        x_count += 1\r\n                        total_x += 1\r\n                        total_created += 1\r\n\r\n\r\n                    except Exception as ex:\r\n\r\n                        failures.append(\r\n                            \"X CROSSTIE Z {:.1f}: {}\".format(\r\n                                z,\r\n                                str(ex)\r\n                            )\r\n                        )\r\n\r\n\r\n                # --------------------------------------------\r\n                # Y CROSSTIES\r\n                # --------------------------------------------\r\n\r\n                for j, x_offset in enumerate(\r\n                    interior_x\r\n                ):\r\n\r\n                    try:\r\n\r\n                        curves = y_crosstie_curves(\r\n                            origin,\r\n                            local_x,\r\n                            local_y,\r\n                            x_offset,\r\n                            hy,\r\n                            z\r\n                        )\r\n\r\n\r\n                        rebar = create_rebar(\r\n                            column,\r\n                            bar_type,\r\n                            curves\r\n                        )\r\n\r\n\r\n                        tag = (\r\n                            \"{}_C{}_Z{:03d}_Y{:02d}\"\r\n                        ).format(\r\n                            NEW_PREFIX,\r\n                            column_id,\r\n                            z_index,\r\n                            j + 1\r\n                        )\r\n\r\n\r\n                        if set_comments(\r\n                            rebar,\r\n                            tag\r\n                        ):\r\n\r\n                            tag_success += 1\r\n\r\n                        else:\r\n\r\n                            tag_failed += 1\r\n\r\n\r\n                        rid = id_value(\r\n                            rebar.Id\r\n                        )\r\n\r\n\r\n                        created_ids.append(\r\n                            rid\r\n                        )\r\n\r\n\r\n                        y_count += 1\r\n                        total_y += 1\r\n                        total_created += 1\r\n\r\n\r\n                    except Exception as ex:\r\n\r\n                        failures.append(\r\n                            \"Y CROSSTIE Z {:.1f}: {}\".format(\r\n                                z,\r\n                                str(ex)\r\n                            )\r\n                        )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # COLUMN SUMMARY\r\n            # ------------------------------------------------\r\n\r\n            diagnostics.extend(\r\n                [\r\n                    \"TIE ELEVATIONS = {}\".format(\r\n                        len(elevations)\r\n                    ),\r\n                    \"PERIMETER CREATED = {}\".format(\r\n                        perimeter_count\r\n                    ),\r\n                    \"X CROSSTIES CREATED = {}\".format(\r\n                        x_count\r\n                    ),\r\n                    \"Y CROSSTIES CREATED = {}\".format(\r\n                        y_count\r\n                    ),\r\n                    \"TOTAL CREATED = {}\".format(\r\n                        len(created_ids)\r\n                    ),\r\n                    \"FAILED ITEMS = {}\".format(\r\n                        len(failures)\r\n                    )\r\n                ]\r\n            )\r\n\r\n\r\n            if (\r\n                created_ids\r\n                and not failures\r\n            ):\r\n\r\n                diagnostics.append(\r\n                    \"PASS: ALL T02 REINFORCEMENT CREATED\"\r\n                )\r\n\r\n\r\n            elif created_ids:\r\n\r\n                diagnostics.append(\r\n                    \"WARNING: PARTIAL T02 CREATION\"\r\n                )\r\n\r\n\r\n            else:\r\n\r\n                diagnostics.append(\r\n                    \"FAIL: NO T02 REINFORCEMENT CREATED\"\r\n                )\r\n\r\n\r\n            results.append(\r\n                [\r\n                    column_id,\r\n                    created_ids,\r\n                    len(elevations),\r\n                    perimeter_count,\r\n                    x_count,\r\n                    y_count,\r\n                    failures,\r\n                    diagnostics\r\n                ]\r\n            )\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # FINISH TRANSACTION\r\n        # ----------------------------------------------------\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OWNERSHIP SUMMARY\r\n        # ----------------------------------------------------\r\n\r\n        ownership = [\r\n            \"OWNERSHIP PREFIX = {}\".format(\r\n                NEW_PREFIX\r\n            ),\r\n            \"LEGACY PREFIX = {}\".format(\r\n                OLD_PREFIX\r\n            ),\r\n            \"TARGET COLUMNS = {}\".format(\r\n                len(target_ids)\r\n            ),\r\n            \"OLD T02 REBAR DELETED = {}\".format(\r\n                len(deleted_ids)\r\n            ),\r\n            \"NEW T02 REBAR CREATED = {}\".format(\r\n                total_created\r\n            ),\r\n            \"PERIMETER TIES = {}\".format(\r\n                total_perimeter\r\n            ),\r\n            \"X CROSSTIES = {}\".format(\r\n                total_x\r\n            ),\r\n            \"Y CROSSTIES = {}\".format(\r\n                total_y\r\n            ),\r\n            \"TAG SUCCESS = {}\".format(\r\n                tag_success\r\n            ),\r\n            \"TAG FAILED = {}\".format(\r\n                tag_failed\r\n            ),\r\n            \"R02 MAIN BARS PRESERVED\",\r\n            \"MANUAL / UNTAGGED REBAR PRESERVED\"\r\n        ]\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # OUTPUT\r\n        # ----------------------------------------------------\r\n\r\n        OUT = [\r\n            results,\r\n            target_ids,\r\n            deleted_ids,\r\n            len(deleted_ids),\r\n            total_created,\r\n            type_diagnostics,\r\n            ownership,\r\n            \"T02 COMPLETE\"\r\n        ]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "cf9f7247bd3145b5a9cb7c3944eb4c7b",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "ba05fc7c39b54334bec90cad6f30a377",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3c65e027c5894247ae7329b7f13cc8b4",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# T01 — NSCP COLUMN TIE LAYOUT PLANNER\r\n#\r\n# IN[0] = COMPLETE S04 PACKAGE\r\n# IN[1] = COMPLETE M02 PACKAGE\r\n#\r\n# PURPOSE:\r\n#   1. Read clear column segments from S04\r\n#   2. Read actual longitudinal-bar layout from M02\r\n#   3. Match M02 storey data to each S04 column\r\n#   4. Calculate confinement spacing limits\r\n#   5. Calculate regular-zone spacing limits\r\n#   6. Round construction spacing DOWN to nearest 10 mm\r\n#   7. Generate final tie elevations\r\n#\r\n# IMPORTANT:\r\n#   T01 DOES NOT CREATE REVIT REBAR.\r\n#\r\n# CONSTRUCTION ROUNDING:\r\n#\r\n#   87.5 mm -> 80 mm\r\n#   96.0 mm -> 90 mm\r\n#   100 mm  -> 100 mm\r\n#   125 mm  -> 120 mm\r\n#   150 mm  -> 150 mm\r\n#\r\n# ============================================================\r\n\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\ns04_input = IN[0]\r\nm02_input = IN[1]\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nTOL = 0.1\r\nDUPLICATE_TOL = 0.5\r\n\r\nSO_MIN = 100.0\r\nSO_MAX = 150.0\r\n\r\nABSOLUTE_REGULAR_MAX = 150.0\r\n\r\n# Construction spacing increment\r\nCONSTRUCTION_INCREMENT = 10.0\r\n\r\n\r\n# ============================================================\r\n# BASIC HELPERS\r\n# ============================================================\r\n\r\ndef is_list(x):\r\n    return isinstance(x, (list, tuple))\r\n\r\n\r\ndef safe_float(x, default=None):\r\n\r\n    try:\r\n        return float(x)\r\n    except:\r\n        return default\r\n\r\n\r\ndef safe_int(x, default=None):\r\n\r\n    try:\r\n        return int(x)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(x.IntegerValue)\r\n    except:\r\n        return default\r\n\r\n\r\ndef unique_sorted(values, tolerance=DUPLICATE_TOL):\r\n\r\n    clean = []\r\n\r\n    for value in values:\r\n\r\n        z = safe_float(\r\n            value,\r\n            None\r\n        )\r\n\r\n        if z is None:\r\n            continue\r\n\r\n        duplicate = False\r\n\r\n        for existing in clean:\r\n\r\n            if abs(\r\n                existing - z\r\n            ) <= tolerance:\r\n\r\n                duplicate = True\r\n                break\r\n\r\n        if not duplicate:\r\n            clean.append(z)\r\n\r\n    clean.sort()\r\n\r\n    return clean\r\n\r\n\r\n# ============================================================\r\n# CONSTRUCTION ROUNDING\r\n# ============================================================\r\n#\r\n# Always round DOWN.\r\n#\r\n# Example:\r\n#\r\n# 87.5 -> 80\r\n# 96.0 -> 90\r\n# 100  -> 100\r\n#\r\n# This prevents construction rounding from exceeding the\r\n# calculated maximum allowable spacing.\r\n#\r\n# ============================================================\r\n\r\ndef round_down_construction(value):\r\n\r\n    value = safe_float(\r\n        value,\r\n        None\r\n    )\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    if value <= 0:\r\n        return value\r\n\r\n    rounded = (\r\n        math.floor(\r\n            value /\r\n            CONSTRUCTION_INCREMENT\r\n        ) *\r\n        CONSTRUCTION_INCREMENT\r\n    )\r\n\r\n    if rounded <= 0:\r\n        return value\r\n\r\n    return rounded\r\n\r\n\r\n# ============================================================\r\n# S04 DETECTION\r\n# ============================================================\r\n\r\ndef looks_like_s04(data):\r\n\r\n    if not is_list(data):\r\n        return False\r\n\r\n    if len(data) < 12:\r\n        return False\r\n\r\n    try:\r\n\r\n        column_id = safe_int(\r\n            data[1],\r\n            None\r\n        )\r\n\r\n        if column_id is None:\r\n            return False\r\n\r\n        if not is_list(data[2]):\r\n            return False\r\n\r\n        if not is_list(data[3]):\r\n            return False\r\n\r\n        if not is_list(data[4]):\r\n            return False\r\n\r\n        if safe_float(\r\n            data[5],\r\n            None\r\n        ) is None:\r\n            return False\r\n\r\n        if safe_float(\r\n            data[6],\r\n            None\r\n        ) is None:\r\n            return False\r\n\r\n        if safe_float(\r\n            data[8],\r\n            None\r\n        ) is None:\r\n            return False\r\n\r\n        if safe_float(\r\n            data[10],\r\n            None\r\n        ) is None:\r\n            return False\r\n\r\n        if safe_float(\r\n            data[11],\r\n            None\r\n        ) is None:\r\n            return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_s04_packages(\r\n    data,\r\n    results=None\r\n):\r\n\r\n    if results is None:\r\n        results = []\r\n\r\n    if looks_like_s04(data):\r\n\r\n        cid = safe_int(\r\n            data[1],\r\n            None\r\n        )\r\n\r\n        duplicate = False\r\n\r\n        for existing in results:\r\n\r\n            existing_id = safe_int(\r\n                existing[1],\r\n                None\r\n            )\r\n\r\n            if existing_id == cid:\r\n\r\n                duplicate = True\r\n                break\r\n\r\n        if not duplicate:\r\n            results.append(data)\r\n\r\n        return results\r\n\r\n    if is_list(data):\r\n\r\n        for item in data:\r\n\r\n            collect_s04_packages(\r\n                item,\r\n                results\r\n            )\r\n\r\n    return results\r\n\r\n\r\n# ============================================================\r\n# M02 DETECTION\r\n# ============================================================\r\n\r\ndef looks_like_m02(data):\r\n\r\n    if not is_list(data):\r\n        return False\r\n\r\n    if len(data) < 12:\r\n        return False\r\n\r\n    try:\r\n\r\n        stack_index = safe_int(\r\n            data[0],\r\n            None\r\n        )\r\n\r\n        main_db = safe_float(\r\n            data[2],\r\n            None\r\n        )\r\n\r\n        total_bars = safe_int(\r\n            data[3],\r\n            None\r\n        )\r\n\r\n        storeys = data[6]\r\n\r\n        if stack_index is None:\r\n            return False\r\n\r\n        if main_db is None:\r\n            return False\r\n\r\n        if total_bars is None:\r\n            return False\r\n\r\n        if not is_list(storeys):\r\n            return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_m02_packages(\r\n    data,\r\n    results=None\r\n):\r\n\r\n    if results is None:\r\n        results = []\r\n\r\n    if looks_like_m02(data):\r\n\r\n        stack_index = safe_int(\r\n            data[0],\r\n            None\r\n        )\r\n\r\n        duplicate = False\r\n\r\n        for existing in results:\r\n\r\n            existing_index = safe_int(\r\n                existing[0],\r\n                None\r\n            )\r\n\r\n            if existing_index == stack_index:\r\n\r\n                duplicate = True\r\n                break\r\n\r\n        if not duplicate:\r\n            results.append(data)\r\n\r\n        return results\r\n\r\n    if is_list(data):\r\n\r\n        for item in data:\r\n\r\n            collect_m02_packages(\r\n                item,\r\n                results\r\n            )\r\n\r\n    return results\r\n\r\n\r\n# ============================================================\r\n# FIND M02 STOREY FOR COLUMN\r\n# ============================================================\r\n\r\ndef find_m02_storey_for_column(\r\n    m02_packages,\r\n    column_id\r\n):\r\n\r\n    for m02 in m02_packages:\r\n\r\n        try:\r\n            storeys = m02[6]\r\n        except:\r\n            continue\r\n\r\n        if not is_list(storeys):\r\n            continue\r\n\r\n        for storey in storeys:\r\n\r\n            if not is_list(storey):\r\n                continue\r\n\r\n            if len(storey) < 15:\r\n                continue\r\n\r\n            sid = safe_int(\r\n                storey[1],\r\n                None\r\n            )\r\n\r\n            if sid == column_id:\r\n\r\n                return (\r\n                    m02,\r\n                    storey\r\n                )\r\n\r\n    return (\r\n        None,\r\n        None\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CLEAR SEGMENT PARSER\r\n# ============================================================\r\n\r\ndef extract_segment_bounds(segment):\r\n\r\n    if not is_list(segment):\r\n        return None\r\n\r\n    if len(segment) < 2:\r\n        return None\r\n\r\n    z1 = safe_float(\r\n        segment[0],\r\n        None\r\n    )\r\n\r\n    z2 = safe_float(\r\n        segment[1],\r\n        None\r\n    )\r\n\r\n    if (\r\n        z1 is None or\r\n        z2 is None\r\n    ):\r\n        return None\r\n\r\n    bottom = min(\r\n        z1,\r\n        z2\r\n    )\r\n\r\n    top = max(\r\n        z1,\r\n        z2\r\n    )\r\n\r\n    if (\r\n        top -\r\n        bottom\r\n    ) <= TOL:\r\n        return None\r\n\r\n    return (\r\n        bottom,\r\n        top\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CONFINEMENT LENGTH\r\n# ============================================================\r\n\r\ndef get_lc(\r\n    confinement_data,\r\n    segment_index,\r\n    clear_height,\r\n    column_max_dimension\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # First use S04 Final Lc if available.\r\n    #\r\n    # Try both zero-based and one-based segment indexing.\r\n    # --------------------------------------------------------\r\n\r\n    if is_list(\r\n        confinement_data\r\n    ):\r\n\r\n        for target_index in [\r\n            segment_index - 1,\r\n            segment_index\r\n        ]:\r\n\r\n            for item in confinement_data:\r\n\r\n                if not is_list(item):\r\n                    continue\r\n\r\n                if len(item) < 8:\r\n                    continue\r\n\r\n                idx = safe_int(\r\n                    item[0],\r\n                    None\r\n                )\r\n\r\n                if idx != target_index:\r\n                    continue\r\n\r\n                lc = safe_float(\r\n                    item[7],\r\n                    None\r\n                )\r\n\r\n                if (\r\n                    lc is not None and\r\n                    lc > 0\r\n                ):\r\n                    return lc\r\n\r\n    # --------------------------------------------------------\r\n    # Fallback:\r\n    #\r\n    # lo = max(\r\n    #     column dimension,\r\n    #     clear height / 6,\r\n    #     450 mm\r\n    # )\r\n    #\r\n    # Adopted construction rule:\r\n    #\r\n    # Lc = max(\r\n    #     clear height / 4,\r\n    #     lo\r\n    # )\r\n    # --------------------------------------------------------\r\n\r\n    l_quarter = (\r\n        clear_height /\r\n        4.0\r\n    )\r\n\r\n    l_sixth = (\r\n        clear_height /\r\n        6.0\r\n    )\r\n\r\n    lo = max(\r\n        column_max_dimension,\r\n        l_sixth,\r\n        450.0\r\n    )\r\n\r\n    return max(\r\n        l_quarter,\r\n        lo\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GET MAIN BAR XY COORDINATES\r\n# ============================================================\r\n\r\ndef get_bar_xy(layout):\r\n\r\n    points = []\r\n\r\n    if not is_list(layout):\r\n        return points\r\n\r\n    for bar in layout:\r\n\r\n        if not is_list(bar):\r\n            continue\r\n\r\n        if len(bar) < 6:\r\n            continue\r\n\r\n        x = safe_float(\r\n            bar[4],\r\n            None\r\n        )\r\n\r\n        y = safe_float(\r\n            bar[5],\r\n            None\r\n        )\r\n\r\n        if (\r\n            x is None or\r\n            y is None\r\n        ):\r\n            continue\r\n\r\n        points.append(\r\n            [\r\n                x,\r\n                y\r\n            ]\r\n        )\r\n\r\n    return points\r\n\r\n\r\n# ============================================================\r\n# CALCULATE hx\r\n# ============================================================\r\n#\r\n# Uses maximum adjacent longitudinal-bar center spacing\r\n# along the rectangular column perimeter.\r\n#\r\n# ============================================================\r\n\r\ndef calculate_hx(layout):\r\n\r\n    points = get_bar_xy(\r\n        layout\r\n    )\r\n\r\n    if len(points) < 2:\r\n        return None\r\n\r\n    xs = [\r\n        p[0]\r\n        for p in points\r\n    ]\r\n\r\n    ys = [\r\n        p[1]\r\n        for p in points\r\n    ]\r\n\r\n    min_x = min(xs)\r\n    max_x = max(xs)\r\n\r\n    min_y = min(ys)\r\n    max_y = max(ys)\r\n\r\n    coordinate_tolerance = 1.0\r\n\r\n    face_1 = []\r\n    face_2 = []\r\n    face_3 = []\r\n    face_4 = []\r\n\r\n    for x, y in points:\r\n\r\n        if abs(\r\n            y -\r\n            min_y\r\n        ) <= coordinate_tolerance:\r\n\r\n            face_1.append(x)\r\n\r\n        if abs(\r\n            y -\r\n            max_y\r\n        ) <= coordinate_tolerance:\r\n\r\n            face_2.append(x)\r\n\r\n        if abs(\r\n            x -\r\n            min_x\r\n        ) <= coordinate_tolerance:\r\n\r\n            face_3.append(y)\r\n\r\n        if abs(\r\n            x -\r\n            max_x\r\n        ) <= coordinate_tolerance:\r\n\r\n            face_4.append(y)\r\n\r\n    spacings = []\r\n\r\n    def add_face_spacings(values):\r\n\r\n        values = sorted(\r\n            list(\r\n                set(values)\r\n            )\r\n        )\r\n\r\n        if len(values) < 2:\r\n            return\r\n\r\n        for i in range(\r\n            len(values) - 1\r\n        ):\r\n\r\n            spacing = abs(\r\n                values[i + 1] -\r\n                values[i]\r\n            )\r\n\r\n            if spacing > TOL:\r\n\r\n                spacings.append(\r\n                    spacing\r\n                )\r\n\r\n    add_face_spacings(\r\n        face_1\r\n    )\r\n\r\n    add_face_spacings(\r\n        face_2\r\n    )\r\n\r\n    add_face_spacings(\r\n        face_3\r\n    )\r\n\r\n    add_face_spacings(\r\n        face_4\r\n    )\r\n\r\n    if len(spacings) == 0:\r\n        return None\r\n\r\n    return max(\r\n        spacings\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COLUMN DIMENSIONS\r\n# ============================================================\r\n\r\ndef get_column_dimensions(\r\n    storey,\r\n    fallback_dimension\r\n):\r\n\r\n    width = None\r\n    depth = None\r\n\r\n    if (\r\n        storey is not None and\r\n        len(storey) > 3\r\n    ):\r\n\r\n        width = safe_float(\r\n            storey[2],\r\n            None\r\n        )\r\n\r\n        depth = safe_float(\r\n            storey[3],\r\n            None\r\n        )\r\n\r\n    if (\r\n        width is None or\r\n        width <= 0\r\n    ):\r\n\r\n        width = (\r\n            fallback_dimension\r\n        )\r\n\r\n    if (\r\n        depth is None or\r\n        depth <= 0\r\n    ):\r\n\r\n        depth = (\r\n            fallback_dimension\r\n        )\r\n\r\n    return (\r\n        width,\r\n        depth\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CALCULATE so\r\n# ============================================================\r\n\r\ndef calculate_so(hx):\r\n\r\n    if hx is None:\r\n\r\n        return (\r\n            SO_MAX,\r\n            None\r\n        )\r\n\r\n    raw_so = (\r\n        100.0 +\r\n        (\r\n            350.0 -\r\n            hx\r\n        ) /\r\n        3.0\r\n    )\r\n\r\n    final_so = max(\r\n        SO_MIN,\r\n        min(\r\n            SO_MAX,\r\n            raw_so\r\n        )\r\n    )\r\n\r\n    return (\r\n        final_so,\r\n        raw_so\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CALCULATE SPACING LIMITS\r\n# ============================================================\r\n\r\ndef calculate_spacing_limits(\r\n    requested_conf,\r\n    requested_regular,\r\n    width,\r\n    depth,\r\n    main_db,\r\n    hx\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # Minimum column dimension\r\n    # --------------------------------------------------------\r\n\r\n    bmin = min(\r\n        width,\r\n        depth\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # bmin / 4\r\n    # --------------------------------------------------------\r\n\r\n    limit_b4 = (\r\n        bmin /\r\n        4.0\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # 6db\r\n    # --------------------------------------------------------\r\n\r\n    limit_6db = (\r\n        6.0 *\r\n        main_db\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # so\r\n    # --------------------------------------------------------\r\n\r\n    so, raw_so = (\r\n        calculate_so(\r\n            hx\r\n        )\r\n    )\r\n\r\n    # ========================================================\r\n    # CONFINEMENT SPACING\r\n    # ========================================================\r\n\r\n    confinement_candidates = [\r\n        requested_conf,\r\n        limit_b4,\r\n        limit_6db,\r\n        so\r\n    ]\r\n\r\n    confinement_candidates = [\r\n        value\r\n        for value in confinement_candidates\r\n        if (\r\n            value is not None and\r\n            value > 0\r\n        )\r\n    ]\r\n\r\n    conf_exact = min(\r\n        confinement_candidates\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # ROUND DOWN TO NEAREST 10 mm\r\n    # --------------------------------------------------------\r\n\r\n    conf_final = (\r\n        round_down_construction(\r\n            conf_exact\r\n        )\r\n    )\r\n\r\n    # ========================================================\r\n    # REGULAR SPACING\r\n    # ========================================================\r\n\r\n    regular_candidates = [\r\n        requested_regular,\r\n        limit_6db,\r\n        ABSOLUTE_REGULAR_MAX\r\n    ]\r\n\r\n    regular_candidates = [\r\n        value\r\n        for value in regular_candidates\r\n        if (\r\n            value is not None and\r\n            value > 0\r\n        )\r\n    ]\r\n\r\n    regular_exact = min(\r\n        regular_candidates\r\n    )\r\n\r\n    # --------------------------------------------------------\r\n    # ROUND DOWN TO NEAREST 10 mm\r\n    # --------------------------------------------------------\r\n\r\n    regular_final = (\r\n        round_down_construction(\r\n            regular_exact\r\n        )\r\n    )\r\n\r\n    return [\r\n        bmin,                 # [0]\r\n        limit_b4,             # [1]\r\n        limit_6db,            # [2]\r\n        hx,                   # [3]\r\n        raw_so,               # [4]\r\n        so,                   # [5]\r\n\r\n        requested_conf,       # [6]\r\n        conf_exact,           # [7]\r\n        conf_final,           # [8]\r\n\r\n        requested_regular,    # [9]\r\n        regular_exact,        # [10]\r\n        regular_final,        # [11]\r\n\r\n        CONSTRUCTION_INCREMENT # [12]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# DISTRIBUTE TIES IN A ZONE\r\n# ============================================================\r\n\r\ndef distribute_zone(\r\n    start_z,\r\n    end_z,\r\n    maximum_spacing\r\n):\r\n\r\n    if (\r\n        start_z is None or\r\n        end_z is None\r\n    ):\r\n        return []\r\n\r\n    start_z = float(\r\n        start_z\r\n    )\r\n\r\n    end_z = float(\r\n        end_z\r\n    )\r\n\r\n    if end_z < start_z:\r\n\r\n        temp = start_z\r\n        start_z = end_z\r\n        end_z = temp\r\n\r\n    length = (\r\n        end_z -\r\n        start_z\r\n    )\r\n\r\n    if length <= TOL:\r\n\r\n        return [\r\n            start_z\r\n        ]\r\n\r\n    if (\r\n        maximum_spacing is None or\r\n        maximum_spacing <= 0\r\n    ):\r\n\r\n        return [\r\n            start_z,\r\n            end_z\r\n        ]\r\n\r\n    # --------------------------------------------------------\r\n    # Number of spaces required so actual spacing never\r\n    # exceeds the adopted maximum.\r\n    # --------------------------------------------------------\r\n\r\n    intervals = int(\r\n        math.ceil(\r\n            length /\r\n            maximum_spacing\r\n        )\r\n    )\r\n\r\n    if intervals < 1:\r\n        intervals = 1\r\n\r\n    actual_spacing = (\r\n        length /\r\n        float(intervals)\r\n    )\r\n\r\n    elevations = []\r\n\r\n    for i in range(\r\n        intervals + 1\r\n    ):\r\n\r\n        z = (\r\n            start_z +\r\n            actual_spacing *\r\n            i\r\n        )\r\n\r\n        elevations.append(\r\n            z\r\n        )\r\n\r\n    return elevations\r\n\r\n\r\n# ============================================================\r\n# MAXIMUM ACTUAL ADJACENT SPACING\r\n# ============================================================\r\n\r\ndef maximum_adjacent_spacing(\r\n    values\r\n):\r\n\r\n    values = unique_sorted(\r\n        values\r\n    )\r\n\r\n    if len(values) < 2:\r\n        return 0.0\r\n\r\n    maximum = 0.0\r\n\r\n    for i in range(\r\n        len(values) - 1\r\n    ):\r\n\r\n        spacing = (\r\n            values[i + 1] -\r\n            values[i]\r\n        )\r\n\r\n        if spacing > maximum:\r\n\r\n            maximum = spacing\r\n\r\n    return maximum\r\n\r\n\r\n# ============================================================\r\n# BUILD SEGMENT PLAN\r\n# ============================================================\r\n\r\ndef build_segment_plan(\r\n    segment_index,\r\n    bottom,\r\n    top,\r\n    lc,\r\n    conf_spacing,\r\n    regular_spacing\r\n):\r\n\r\n    diagnostics = []\r\n\r\n    height = (\r\n        top -\r\n        bottom\r\n    )\r\n\r\n    # ========================================================\r\n    # WHOLE SEGMENT CONFINED\r\n    # ========================================================\r\n\r\n    if (\r\n        2.0 *\r\n        lc >=\r\n        height -\r\n        TOL\r\n    ):\r\n\r\n        lower_start = bottom\r\n        lower_end = top\r\n\r\n        regular_start = None\r\n        regular_end = None\r\n\r\n        upper_start = top\r\n        upper_end = top\r\n\r\n        lower_ties = (\r\n            distribute_zone(\r\n                bottom,\r\n                top,\r\n                conf_spacing\r\n            )\r\n        )\r\n\r\n        regular_ties = []\r\n        upper_ties = []\r\n\r\n        all_ties = (\r\n            unique_sorted(\r\n                lower_ties\r\n            )\r\n        )\r\n\r\n        diagnostics.append(\r\n            \"WHOLE CLEAR SEGMENT REQUIRES \"\r\n            \"CONFINEMENT SPACING\"\r\n        )\r\n\r\n    # ========================================================\r\n    # LOWER + REGULAR + UPPER\r\n    # ========================================================\r\n\r\n    else:\r\n\r\n        lower_start = (\r\n            bottom\r\n        )\r\n\r\n        lower_end = (\r\n            bottom +\r\n            lc\r\n        )\r\n\r\n        upper_start = (\r\n            top -\r\n            lc\r\n        )\r\n\r\n        upper_end = (\r\n            top\r\n        )\r\n\r\n        regular_start = (\r\n            lower_end\r\n        )\r\n\r\n        regular_end = (\r\n            upper_start\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # LOWER CONFINEMENT\r\n        # ----------------------------------------------------\r\n\r\n        lower_ties = (\r\n            distribute_zone(\r\n                lower_start,\r\n                lower_end,\r\n                conf_spacing\r\n            )\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # REGULAR REGION\r\n        # ----------------------------------------------------\r\n\r\n        regular_ties = (\r\n            distribute_zone(\r\n                regular_start,\r\n                regular_end,\r\n                regular_spacing\r\n            )\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # UPPER CONFINEMENT\r\n        # ----------------------------------------------------\r\n\r\n        upper_ties = (\r\n            distribute_zone(\r\n                upper_start,\r\n                upper_end,\r\n                conf_spacing\r\n            )\r\n        )\r\n\r\n        # ----------------------------------------------------\r\n        # Remove duplicate boundary elevations.\r\n        # ----------------------------------------------------\r\n\r\n        all_ties = (\r\n            unique_sorted(\r\n                lower_ties +\r\n                regular_ties +\r\n                upper_ties\r\n            )\r\n        )\r\n\r\n        diagnostics.append(\r\n            \"LOWER / REGULAR / UPPER \"\r\n            \"TIE REGIONS GENERATED\"\r\n        )\r\n\r\n    # ========================================================\r\n    # ACTUAL SPACING CHECK\r\n    # ========================================================\r\n\r\n    actual_max = (\r\n        maximum_adjacent_spacing(\r\n            all_ties\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"SEGMENT TIES = {}\".format(\r\n            len(all_ties)\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"MAX ACTUAL ADJACENT SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            actual_max\r\n        )\r\n    )\r\n\r\n    return [\r\n        segment_index,       # [0]\r\n        bottom,              # [1]\r\n        top,                 # [2]\r\n        height,              # [3]\r\n        lc,                  # [4]\r\n\r\n        lower_start,         # [5]\r\n        lower_end,           # [6]\r\n\r\n        upper_start,         # [7]\r\n        upper_end,           # [8]\r\n\r\n        regular_start,       # [9]\r\n        regular_end,         # [10]\r\n\r\n        lower_ties,          # [11]\r\n        regular_ties,        # [12]\r\n        upper_ties,          # [13]\r\n\r\n        all_ties,            # [14]\r\n\r\n        diagnostics          # [15]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# BUILD COLUMN PLAN\r\n# ============================================================\r\n\r\ndef build_column_plan(\r\n    s04,\r\n    m02_packages\r\n):\r\n\r\n    diagnostics = []\r\n\r\n    # ========================================================\r\n    # S04 DATA\r\n    # ========================================================\r\n\r\n    column = s04[0]\r\n\r\n    column_id = safe_int(\r\n        s04[1],\r\n        None\r\n    )\r\n\r\n    clear_segments = s04[2]\r\n\r\n    confinement_zones = s04[3]\r\n    normal_zones = s04[4]\r\n\r\n    requested_conf = safe_float(\r\n        s04[5],\r\n        100.0\r\n    )\r\n\r\n    requested_regular = safe_float(\r\n        s04[6],\r\n        150.0\r\n    )\r\n\r\n    beam_joints = s04[7]\r\n\r\n    column_max_dimension = safe_float(\r\n        s04[8],\r\n        0.0\r\n    )\r\n\r\n    confinement_data = s04[9]\r\n\r\n    tie_diameter = safe_float(\r\n        s04[10],\r\n        0.0\r\n    )\r\n\r\n    cover = safe_float(\r\n        s04[11],\r\n        40.0\r\n    )\r\n\r\n    # ========================================================\r\n    # MATCH M02\r\n    # ========================================================\r\n\r\n    m02, storey = (\r\n        find_m02_storey_for_column(\r\n            m02_packages,\r\n            column_id\r\n        )\r\n    )\r\n\r\n    if (\r\n        m02 is None or\r\n        storey is None\r\n    ):\r\n\r\n        return [\r\n            column,\r\n            column_id,\r\n            tie_diameter,\r\n            cover,\r\n\r\n            None,\r\n            None,\r\n\r\n            None,\r\n            None,\r\n            None,\r\n\r\n            requested_conf,\r\n            requested_regular,\r\n\r\n            None,\r\n            None,\r\n\r\n            [],\r\n            [],\r\n\r\n            beam_joints,\r\n\r\n            [],\r\n\r\n            [\r\n                \"ERROR: MATCHING M02 STOREY NOT FOUND\",\r\n                \"COLUMN ID = {}\".format(\r\n                    column_id\r\n                )\r\n            ],\r\n\r\n            s04,\r\n            None\r\n        ]\r\n\r\n    # ========================================================\r\n    # MAIN BAR DATA\r\n    # ========================================================\r\n\r\n    main_db = safe_float(\r\n        m02[2],\r\n        None\r\n    )\r\n\r\n    total_main_bars = safe_int(\r\n        m02[3],\r\n        None\r\n    )\r\n\r\n    layout = storey[14]\r\n\r\n    # ========================================================\r\n    # COLUMN DIMENSIONS\r\n    # ========================================================\r\n\r\n    width, depth = (\r\n        get_column_dimensions(\r\n            storey,\r\n            column_max_dimension\r\n        )\r\n    )\r\n\r\n    # ========================================================\r\n    # hx\r\n    # ========================================================\r\n\r\n    hx = calculate_hx(\r\n        layout\r\n    )\r\n\r\n    # ========================================================\r\n    # SPACING CALCULATION\r\n    # ========================================================\r\n\r\n    spacing_data = (\r\n        calculate_spacing_limits(\r\n            requested_conf,\r\n            requested_regular,\r\n            width,\r\n            depth,\r\n            main_db,\r\n            hx\r\n        )\r\n    )\r\n\r\n    bmin = spacing_data[0]\r\n    b4 = spacing_data[1]\r\n    six_db = spacing_data[2]\r\n\r\n    raw_so = spacing_data[4]\r\n    so = spacing_data[5]\r\n\r\n    conf_exact = spacing_data[7]\r\n    conf_final = spacing_data[8]\r\n\r\n    regular_exact = spacing_data[10]\r\n    regular_final = spacing_data[11]\r\n\r\n    # ========================================================\r\n    # BUILD CLEAR SEGMENT PLANS\r\n    # ========================================================\r\n\r\n    segment_plans = []\r\n\r\n    all_ties = []\r\n\r\n    valid_segments = 0\r\n\r\n    for i, segment in enumerate(\r\n        clear_segments\r\n    ):\r\n\r\n        bounds = (\r\n            extract_segment_bounds(\r\n                segment\r\n            )\r\n        )\r\n\r\n        if bounds is None:\r\n\r\n            diagnostics.append(\r\n                \"WARNING: SEGMENT {} \"\r\n                \"COULD NOT BE PARSED\".format(\r\n                    i + 1\r\n                )\r\n            )\r\n\r\n            continue\r\n\r\n        bottom = bounds[0]\r\n        top = bounds[1]\r\n\r\n        clear_height = (\r\n            top -\r\n            bottom\r\n        )\r\n\r\n        lc = (\r\n            get_lc(\r\n                confinement_data,\r\n                i + 1,\r\n                clear_height,\r\n                column_max_dimension\r\n            )\r\n        )\r\n\r\n        plan = (\r\n            build_segment_plan(\r\n                i + 1,\r\n                bottom,\r\n                top,\r\n                lc,\r\n                conf_final,\r\n                regular_final\r\n            )\r\n        )\r\n\r\n        segment_plans.append(\r\n            plan\r\n        )\r\n\r\n        all_ties.extend(\r\n            plan[14]\r\n        )\r\n\r\n        valid_segments += 1\r\n\r\n    all_ties = (\r\n        unique_sorted(\r\n            all_ties\r\n        )\r\n    )\r\n\r\n    # ========================================================\r\n    # DIAGNOSTICS\r\n    # ========================================================\r\n\r\n    diagnostics.append(\r\n        \"COLUMN ID = {}\".format(\r\n            column_id\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"COLUMN SIZE = \"\r\n        \"{:.1f} x {:.1f} mm\".format(\r\n            width,\r\n            depth\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"MAIN BAR DIAMETER = \"\r\n        \"{:.1f} mm\".format(\r\n            main_db\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"TOTAL MAIN BARS = {}\".format(\r\n            total_main_bars\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"TIE DIAMETER = \"\r\n        \"{:.1f} mm\".format(\r\n            tie_diameter\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"CONCRETE COVER = \"\r\n        \"{:.1f} mm\".format(\r\n            cover\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"bmin/4 LIMIT = \"\r\n        \"{:.1f} mm\".format(\r\n            b4\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"6db LIMIT = \"\r\n        \"{:.1f} mm\".format(\r\n            six_db\r\n        )\r\n    )\r\n\r\n    if hx is not None:\r\n\r\n        diagnostics.append(\r\n            \"CALCULATED hx = \"\r\n            \"{:.1f} mm\".format(\r\n                hx\r\n            )\r\n        )\r\n\r\n    else:\r\n\r\n        diagnostics.append(\r\n            \"WARNING: hx COULD NOT BE CALCULATED\"\r\n        )\r\n\r\n    if raw_so is not None:\r\n\r\n        diagnostics.append(\r\n            \"RAW so = \"\r\n            \"{:.1f} mm\".format(\r\n                raw_so\r\n            )\r\n        )\r\n\r\n    diagnostics.append(\r\n        \"ADOPTED so = \"\r\n        \"{:.1f} mm\".format(\r\n            so\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"USER CONFINEMENT SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            requested_conf\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"MAXIMUM CALCULATED \"\r\n        \"CONFINEMENT SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            conf_exact\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"FINAL CONSTRUCTION \"\r\n        \"CONFINEMENT SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            conf_final\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"USER REGULAR SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            requested_regular\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"MAXIMUM CALCULATED \"\r\n        \"REGULAR SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            regular_exact\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"FINAL CONSTRUCTION \"\r\n        \"REGULAR SPACING = \"\r\n        \"{:.1f} mm\".format(\r\n            regular_final\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"CONSTRUCTION ROUNDING = \"\r\n        \"DOWN TO NEAREST \"\r\n        \"{:.0f} mm\".format(\r\n            CONSTRUCTION_INCREMENT\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"VALID CLEAR SEGMENTS = {}\".format(\r\n            valid_segments\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"TOTAL UNIQUE TIE ELEVATIONS = {}\".format(\r\n            len(all_ties)\r\n        )\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"PASS: MAIN-BAR-DEPENDENT \"\r\n        \"SPACING CHECK COMPLETED\"\r\n    )\r\n\r\n    diagnostics.append(\r\n        \"PASS: CONSTRUCTION SPACING \"\r\n        \"ROUNDED DOWN TO 10 mm MULTIPLES\"\r\n    )\r\n\r\n    # ========================================================\r\n    # OUTPUT\r\n    # ========================================================\r\n\r\n    return [\r\n        column,                 # [0]\r\n        column_id,              # [1]\r\n\r\n        tie_diameter,           # [2]\r\n        cover,                  # [3]\r\n\r\n        main_db,                # [4]\r\n        total_main_bars,        # [5]\r\n\r\n        width,                  # [6]\r\n        depth,                  # [7]\r\n        bmin,                   # [8]\r\n\r\n        requested_conf,         # [9]\r\n        requested_regular,      # [10]\r\n\r\n        conf_final,             # [11]\r\n        regular_final,          # [12]\r\n\r\n        segment_plans,          # [13]\r\n        all_ties,               # [14]\r\n\r\n        beam_joints,            # [15]\r\n\r\n        spacing_data,           # [16]\r\n        diagnostics,            # [17]\r\n\r\n        s04,                    # [18]\r\n        m02                     # [19]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# MAIN\r\n# ============================================================\r\n\r\ns04_packages = (\r\n    collect_s04_packages(\r\n        s04_input\r\n    )\r\n)\r\n\r\nm02_packages = (\r\n    collect_m02_packages(\r\n        m02_input\r\n    )\r\n)\r\n\r\n\r\n# ============================================================\r\n# VALIDATE S04\r\n# ============================================================\r\n\r\nif len(s04_packages) == 0:\r\n\r\n    OUT = [\r\n        [\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            [],\r\n            [],\r\n            [],\r\n            [],\r\n            [\r\n                \"ERROR: VALID S04 PACKAGE NOT FOUND\"\r\n            ],\r\n            s04_input,\r\n            m02_input\r\n        ]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# VALIDATE M02\r\n# ============================================================\r\n\r\nelif len(m02_packages) == 0:\r\n\r\n    OUT = [\r\n        [\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            None,\r\n            [],\r\n            [],\r\n            [],\r\n            [],\r\n            [\r\n                \"ERROR: VALID M02 PACKAGE NOT FOUND\"\r\n            ],\r\n            s04_input,\r\n            m02_input\r\n        ]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# BUILD ALL COLUMN PLANS\r\n# ============================================================\r\n\r\nelse:\r\n\r\n    results = []\r\n\r\n    for s04 in s04_packages:\r\n\r\n        try:\r\n\r\n            result = (\r\n                build_column_plan(\r\n                    s04,\r\n                    m02_packages\r\n                )\r\n            )\r\n\r\n            results.append(\r\n                result\r\n            )\r\n\r\n        except Exception as ex:\r\n\r\n            column_id = None\r\n\r\n            try:\r\n                column_id = s04[1]\r\n            except:\r\n                pass\r\n\r\n            results.append(\r\n                [\r\n                    None,\r\n                    column_id,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    None,\r\n                    [],\r\n                    [],\r\n                    [],\r\n                    [],\r\n                    [\r\n                        \"ERROR BUILDING T01 PLAN\",\r\n                        str(ex)\r\n                    ],\r\n                    s04,\r\n                    None\r\n                ]\r\n            )\r\n\r\n    OUT = results",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "0738c29a15154010b2ad9bdd3c59291b",
