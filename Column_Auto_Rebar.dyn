    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S02 — READ COLUMN GEOMETRY\r\n#\r\n# IN[0] = S01 OUT[1]\r\n#\r\n# Accepts nested Dynamo lists.\r\n#\r\n# OUT:\r\n# [0]  Columns\r\n# [1]  Width mm\r\n# [2]  Depth mm\r\n# [3]  Height mm\r\n# [4]  Base Elevation mm\r\n# [5]  Top Elevation mm\r\n# [6]  Rotation degrees\r\n# [7]  Center XYZ\r\n# [8]  Local X Direction\r\n# [9]  Local Y Direction\r\n# [10] Diagnostic\r\n# ============================================================\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    XYZ,\r\n    LocationPoint,\r\n    UnitUtils,\r\n    UnitTypeId\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT NODES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ============================================================\r\n# FUNCTIONS\r\n# ============================================================\r\n\r\n\r\n# ------------------------------------------------------------\r\n# RECURSIVELY FLATTEN INPUT\r\n# ------------------------------------------------------------\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n    if isinstance(data, (list, tuple)):\r\n\r\n        for item in data:\r\n            result.extend(flatten(item))\r\n\r\n    else:\r\n\r\n        if data is not None:\r\n            result.append(data)\r\n\r\n    return result\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNWRAP ELEMENT\r\n# ------------------------------------------------------------\r\n\r\ndef unwrap(item):\r\n\r\n    try:\r\n        return UnwrapElement(item)\r\n\r\n    except:\r\n        return item\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FEET TO MILLIMETRES\r\n# ------------------------------------------------------------\r\n\r\ndef ft_to_mm(value):\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    try:\r\n\r\n        return UnitUtils.ConvertFromInternalUnits(\r\n            value,\r\n            UnitTypeId.Millimeters\r\n        )\r\n\r\n    except:\r\n\r\n        return value * 304.8\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET PARAMETER\r\n# ------------------------------------------------------------\r\n\r\ndef get_parameter(element, names):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    for name in names:\r\n\r\n        try:\r\n\r\n            parameter = element.LookupParameter(name)\r\n\r\n            if parameter is not None:\r\n\r\n                if parameter.HasValue:\r\n\r\n                    return parameter.AsDouble()\r\n\r\n        except:\r\n            pass\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET COLUMN DIMENSIONS\r\n# ------------------------------------------------------------\r\n\r\ndef get_dimensions(column):\r\n\r\n    width = None\r\n    depth = None\r\n\r\n    try:\r\n\r\n        type_id = column.GetTypeId()\r\n\r\n        column_type = doc.GetElement(type_id)\r\n\r\n    except:\r\n\r\n        column_type = None\r\n\r\n\r\n    if column_type is None:\r\n        return None, None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # WIDTH\r\n    # --------------------------------------------------------\r\n\r\n    width_names = [\r\n        \"b\",\r\n        \"B\",\r\n        \"Width\",\r\n        \"WIDTH\",\r\n        \"Width 1\"\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DEPTH\r\n    # --------------------------------------------------------\r\n\r\n    depth_names = [\r\n        \"h\",\r\n        \"H\",\r\n        \"Depth\",\r\n        \"DEPTH\",\r\n        \"Height\",\r\n        \"Depth 1\"\r\n    ]\r\n\r\n\r\n    width = get_parameter(\r\n        column_type,\r\n        width_names\r\n    )\r\n\r\n    depth = get_parameter(\r\n        column_type,\r\n        depth_names\r\n    )\r\n\r\n\r\n    return width, depth\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET COLUMN VERTICAL GEOMETRY\r\n# ------------------------------------------------------------\r\n\r\ndef get_vertical_geometry(column):\r\n\r\n    try:\r\n\r\n        bbox = column.get_BoundingBox(None)\r\n\r\n    except:\r\n\r\n        return None, None, None, None\r\n\r\n\r\n    if bbox is None:\r\n\r\n        return None, None, None, None\r\n\r\n\r\n    z_min = bbox.Min.Z\r\n    z_max = bbox.Max.Z\r\n\r\n    height = z_max - z_min\r\n\r\n\r\n    center = XYZ(\r\n        (bbox.Min.X + bbox.Max.X) / 2.0,\r\n        (bbox.Min.Y + bbox.Max.Y) / 2.0,\r\n        (bbox.Min.Z + bbox.Max.Z) / 2.0\r\n    )\r\n\r\n\r\n    return (\r\n        z_min,\r\n        z_max,\r\n        height,\r\n        center\r\n    )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET COLUMN ORIENTATION\r\n# ------------------------------------------------------------\r\n\r\ndef get_orientation(column):\r\n\r\n    rotation = 0.0\r\n    insertion_point = None\r\n\r\n\r\n    try:\r\n\r\n        location = column.Location\r\n\r\n        if isinstance(location, LocationPoint):\r\n\r\n            insertion_point = location.Point\r\n\r\n            rotation = location.Rotation\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # LOCAL X DIRECTION\r\n    # --------------------------------------------------------\r\n\r\n    local_x = XYZ(\r\n        math.cos(rotation),\r\n        math.sin(rotation),\r\n        0.0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # LOCAL Y DIRECTION\r\n    # --------------------------------------------------------\r\n\r\n    local_y = XYZ(\r\n        -math.sin(rotation),\r\n        math.cos(rotation),\r\n        0.0\r\n    )\r\n\r\n\r\n    return (\r\n        rotation,\r\n        insertion_point,\r\n        local_x,\r\n        local_y\r\n    )\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\nraw_input = IN[0]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# FLATTEN INPUT COMPLETELY\r\n# ------------------------------------------------------------\r\n\r\nflat_input = flatten(raw_input)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# UNWRAP\r\n# ------------------------------------------------------------\r\n\r\ncolumns = []\r\n\r\n\r\nfor item in flat_input:\r\n\r\n    element = unwrap(item)\r\n\r\n    if element is None:\r\n        continue\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ONLY ACCEPT ACTUAL REVIT ELEMENTS\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        element.Id\r\n\r\n        columns.append(element)\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# OUTPUT LISTS\r\n# ============================================================\r\n\r\nwidths = []\r\n\r\ndepths = []\r\n\r\nheights = []\r\n\r\nbase_elevations = []\r\n\r\ntop_elevations = []\r\n\r\nrotations = []\r\n\r\ncenters = []\r\n\r\nlocal_x_directions = []\r\n\r\nlocal_y_directions = []\r\n\r\ndiagnostics = []\r\n\r\n\r\n# ============================================================\r\n# PROCESS EACH COLUMN\r\n# ============================================================\r\n\r\nfor column in columns:\r\n\r\n    messages = []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLUMN DIMENSIONS\r\n    # --------------------------------------------------------\r\n\r\n    width, depth = get_dimensions(column)\r\n\r\n\r\n    if width is not None:\r\n\r\n        width_mm = ft_to_mm(width)\r\n\r\n    else:\r\n\r\n        width_mm = None\r\n\r\n        messages.append(\r\n            \"Width parameter not found\"\r\n        )\r\n\r\n\r\n    if depth is not None:\r\n\r\n        depth_mm = ft_to_mm(depth)\r\n\r\n    else:\r\n\r\n        depth_mm = None\r\n\r\n        messages.append(\r\n            \"Depth parameter not found\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # VERTICAL GEOMETRY\r\n    # --------------------------------------------------------\r\n\r\n    (\r\n        z_min,\r\n        z_max,\r\n        height,\r\n        bbox_center\r\n\r\n    ) = get_vertical_geometry(column)\r\n\r\n\r\n    if z_min is not None:\r\n\r\n        base_mm = ft_to_mm(z_min)\r\n\r\n        top_mm = ft_to_mm(z_max)\r\n\r\n        height_mm = ft_to_mm(height)\r\n\r\n    else:\r\n\r\n        base_mm = None\r\n\r\n        top_mm = None\r\n\r\n        height_mm = None\r\n\r\n        messages.append(\r\n            \"Bounding box unavailable\"\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ORIENTATION\r\n    # --------------------------------------------------------\r\n\r\n    (\r\n        rotation,\r\n        insertion_point,\r\n        local_x,\r\n        local_y\r\n\r\n    ) = get_orientation(column)\r\n\r\n\r\n    rotation_degrees = math.degrees(\r\n        rotation\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLUMN CENTER\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        insertion_point is not None\r\n        and\r\n        bbox_center is not None\r\n    ):\r\n\r\n        center = XYZ(\r\n            insertion_point.X,\r\n            insertion_point.Y,\r\n            bbox_center.Z\r\n        )\r\n\r\n    elif bbox_center is not None:\r\n\r\n        center = bbox_center\r\n\r\n    else:\r\n\r\n        center = None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DIAGNOSTIC\r\n    # --------------------------------------------------------\r\n\r\n    if len(messages) == 0:\r\n\r\n        messages.append(\"OK\")\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STORE RESULTS\r\n    # --------------------------------------------------------\r\n\r\n    widths.append(\r\n        width_mm\r\n    )\r\n\r\n    depths.append(\r\n        depth_mm\r\n    )\r\n\r\n    heights.append(\r\n        height_mm\r\n    )\r\n\r\n    base_elevations.append(\r\n        base_mm\r\n    )\r\n\r\n    top_elevations.append(\r\n        top_mm\r\n    )\r\n\r\n    rotations.append(\r\n        rotation_degrees\r\n    )\r\n\r\n    centers.append(\r\n        center\r\n    )\r\n\r\n    local_x_directions.append(\r\n        local_x\r\n    )\r\n\r\n    local_y_directions.append(\r\n        local_y\r\n    )\r\n\r\n    diagnostics.append(\r\n        \" | \".join(messages)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = [\r\n\r\n    columns,                 # 0\r\n\r\n    widths,                  # 1\r\n\r\n    depths,                  # 2\r\n\r\n    heights,                 # 3\r\n\r\n    base_elevations,         # 4\r\n\r\n    top_elevations,          # 5\r\n\r\n    rotations,               # 6\r\n\r\n    centers,                 # 7\r\n\r\n    local_x_directions,      # 8\r\n\r\n    local_y_directions,      # 9\r\n\r\n    diagnostics              # 10\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b9c153363f424b6291971d7026da14b0",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "206269b3c3c9456e87fdfbb2d5b08193",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a6d8e5a1602f4e60ad17f36802d633be",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S03 — COLUMN SUPPORT DETECTOR\r\n#\r\n# IN[0] = Columns from S02\r\n#\r\n# PURPOSE\r\n# ------------------------------------------------------------\r\n# Detect all structural framing and foundations associated\r\n# with each selected structural column.\r\n#\r\n# Detection:\r\n#   Beam       = LocationCurve crossing column footprint\r\n#   Foundation = Column center inside foundation footprint\r\n#\r\n# IMPORTANT:\r\n# S03 DOES NOT calculate confinement zones.\r\n#\r\n# It only detects and packages support information.\r\n#\r\n#\r\n# OUTPUT\r\n# ------------------------------------------------------------\r\n#\r\n# OUT = [\r\n#\r\n#   [                         # COLUMN 0 PACKAGE\r\n#       Column,               # [0]\r\n#       Column ID,            # [1]\r\n#       Column Bottom mm,     # [2]\r\n#       Column Top mm,        # [3]\r\n#       Foundation Top mm,    # [4]\r\n#\r\n#       [                     # [5] BEAM JOINT DATA\r\n#           [\r\n#               Beam Bottom mm,\r\n#               Beam Top mm,\r\n#               Beam ID,\r\n#               Beam Element\r\n#           ],\r\n#           ...\r\n#       ],\r\n#\r\n#       [                     # [6] FOUNDATION DATA\r\n#           [\r\n#               Foundation Bottom mm,\r\n#               Foundation Top mm,\r\n#               Foundation ID,\r\n#               Foundation Element\r\n#           ],\r\n#           ...\r\n#       ],\r\n#\r\n#       Diagnostic            # [7]\r\n#   ],\r\n#\r\n#   ...\r\n# ]\r\n#\r\n# S03 OUT → S04 IN[0]\r\n#\r\n# ============================================================\r\n\r\n\r\nimport clr\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    XYZ,\r\n    BuiltInCategory,\r\n    FilteredElementCollector,\r\n    LocationCurve,\r\n    UnitUtils,\r\n    UnitTypeId\r\n)\r\n\r\n\r\n# ============================================================\r\n# REVIT NODES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(\r\n    Revit.Elements\r\n)\r\n\r\n\r\n# ============================================================\r\n# SETTINGS\r\n# ============================================================\r\n\r\n# Extra plan allowance around the column for beam detection.\r\n\r\nBEAM_PLAN_TOLERANCE_MM = 100.0\r\n\r\n\r\n# Vertical allowance for joined/cut geometry.\r\n\r\nVERTICAL_TOLERANCE_MM = 100.0\r\n\r\n\r\n# Foundation plan allowance.\r\n\r\nFOUNDATION_PLAN_TOLERANCE_MM = 100.0\r\n\r\n\r\n# ============================================================\r\n# UNIT CONVERSION\r\n# ============================================================\r\n\r\ndef mm_to_ft(value):\r\n\r\n    try:\r\n\r\n        return UnitUtils.ConvertToInternalUnits(\r\n            float(value),\r\n            UnitTypeId.Millimeters\r\n        )\r\n\r\n    except:\r\n\r\n        return float(value) / 304.8\r\n\r\n\r\ndef ft_to_mm(value):\r\n\r\n    try:\r\n\r\n        return UnitUtils.ConvertFromInternalUnits(\r\n            float(value),\r\n            UnitTypeId.Millimeters\r\n        )\r\n\r\n    except:\r\n\r\n        return float(value) * 304.8\r\n\r\n\r\nBEAM_PLAN_TOL = mm_to_ft(\r\n    BEAM_PLAN_TOLERANCE_MM\r\n)\r\n\r\nVERTICAL_TOL = mm_to_ft(\r\n    VERTICAL_TOLERANCE_MM\r\n)\r\n\r\nFOUNDATION_PLAN_TOL = mm_to_ft(\r\n    FOUNDATION_PLAN_TOLERANCE_MM\r\n)\r\n\r\n\r\n# ============================================================\r\n# GENERAL FUNCTIONS\r\n# ============================================================\r\n\r\ndef flatten(data):\r\n\r\n    result = []\r\n\r\n\r\n    if isinstance(\r\n        data,\r\n        (list, tuple)\r\n    ):\r\n\r\n        for item in data:\r\n\r\n            result.extend(\r\n                flatten(item)\r\n            )\r\n\r\n\r\n    elif data is not None:\r\n\r\n        result.append(\r\n            data\r\n        )\r\n\r\n\r\n    return result\r\n\r\n\r\ndef unwrap(item):\r\n\r\n    try:\r\n\r\n        return UnwrapElement(\r\n            item\r\n        )\r\n\r\n    except:\r\n\r\n        return item\r\n\r\n\r\ndef get_id(element):\r\n\r\n    if element is None:\r\n\r\n        return None\r\n\r\n\r\n    try:\r\n\r\n        return int(\r\n            element.Id.Value\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        return int(\r\n            element.Id.IntegerValue\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# BOUNDING BOX\r\n# ============================================================\r\n\r\ndef get_bbox(element):\r\n\r\n    try:\r\n\r\n        return element.get_BoundingBox(\r\n            None\r\n        )\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# BBOX CENTER\r\n# ============================================================\r\n\r\ndef bbox_center(bbox):\r\n\r\n    return XYZ(\r\n\r\n        (\r\n            bbox.Min.X\r\n            +\r\n            bbox.Max.X\r\n        ) / 2.0,\r\n\r\n        (\r\n            bbox.Min.Y\r\n            +\r\n            bbox.Max.Y\r\n        ) / 2.0,\r\n\r\n        (\r\n            bbox.Min.Z\r\n            +\r\n            bbox.Max.Z\r\n        ) / 2.0\r\n    )\r\n\r\n\r\n# ============================================================\r\n# POINT INSIDE RECTANGLE\r\n# ============================================================\r\n\r\ndef point_inside_rect(\r\n    x,\r\n    y,\r\n    xmin,\r\n    xmax,\r\n    ymin,\r\n    ymax\r\n):\r\n\r\n    return (\r\n\r\n        x >= xmin\r\n        and\r\n        x <= xmax\r\n\r\n        and\r\n\r\n        y >= ymin\r\n        and\r\n        y <= ymax\r\n    )\r\n\r\n\r\n# ============================================================\r\n# LINE SEGMENT INTERSECTION\r\n# ============================================================\r\n\r\ndef orientation(\r\n    ax,\r\n    ay,\r\n    bx,\r\n    by,\r\n    cx,\r\n    cy\r\n):\r\n\r\n    value = (\r\n\r\n        (by - ay)\r\n        *\r\n        (cx - bx)\r\n\r\n        -\r\n\r\n        (bx - ax)\r\n        *\r\n        (cy - by)\r\n    )\r\n\r\n\r\n    if abs(value) < 1e-9:\r\n\r\n        return 0\r\n\r\n\r\n    if value > 0:\r\n\r\n        return 1\r\n\r\n\r\n    return 2\r\n\r\n\r\ndef on_segment(\r\n    ax,\r\n    ay,\r\n    bx,\r\n    by,\r\n    cx,\r\n    cy\r\n):\r\n\r\n    return (\r\n\r\n        bx <= max(ax, cx)\r\n        and\r\n        bx >= min(ax, cx)\r\n\r\n        and\r\n\r\n        by <= max(ay, cy)\r\n        and\r\n        by >= min(ay, cy)\r\n    )\r\n\r\n\r\ndef segments_intersect(\r\n    p1x,\r\n    p1y,\r\n    p2x,\r\n    p2y,\r\n    q1x,\r\n    q1y,\r\n    q2x,\r\n    q2y\r\n):\r\n\r\n    o1 = orientation(\r\n        p1x,\r\n        p1y,\r\n        p2x,\r\n        p2y,\r\n        q1x,\r\n        q1y\r\n    )\r\n\r\n\r\n    o2 = orientation(\r\n        p1x,\r\n        p1y,\r\n        p2x,\r\n        p2y,\r\n        q2x,\r\n        q2y\r\n    )\r\n\r\n\r\n    o3 = orientation(\r\n        q1x,\r\n        q1y,\r\n        q2x,\r\n        q2y,\r\n        p1x,\r\n        p1y\r\n    )\r\n\r\n\r\n    o4 = orientation(\r\n        q1x,\r\n        q1y,\r\n        q2x,\r\n        q2y,\r\n        p2x,\r\n        p2y\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # GENERAL CASE\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n        o1 != o2\r\n        and\r\n        o3 != o4\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # COLLINEAR CASES\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n\r\n        o1 == 0\r\n        and\r\n        on_segment(\r\n            p1x,\r\n            p1y,\r\n            q1x,\r\n            q1y,\r\n            p2x,\r\n            p2y\r\n        )\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    if (\r\n\r\n        o2 == 0\r\n        and\r\n        on_segment(\r\n            p1x,\r\n            p1y,\r\n            q2x,\r\n            q2y,\r\n            p2x,\r\n            p2y\r\n        )\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    if (\r\n\r\n        o3 == 0\r\n        and\r\n        on_segment(\r\n            q1x,\r\n            q1y,\r\n            p1x,\r\n            p1y,\r\n            q2x,\r\n            q2y\r\n        )\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    if (\r\n\r\n        o4 == 0\r\n        and\r\n        on_segment(\r\n            q1x,\r\n            q1y,\r\n            p2x,\r\n            p2y,\r\n            q2x,\r\n            q2y\r\n        )\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    return False\r\n\r\n\r\n# ============================================================\r\n# SEGMENT / RECTANGLE\r\n# ============================================================\r\n\r\ndef segment_intersects_rect(\r\n    p1,\r\n    p2,\r\n    xmin,\r\n    xmax,\r\n    ymin,\r\n    ymax\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # ENDPOINT INSIDE RECTANGLE\r\n    # --------------------------------------------------------\r\n\r\n    if point_inside_rect(\r\n\r\n        p1.X,\r\n        p1.Y,\r\n\r\n        xmin,\r\n        xmax,\r\n\r\n        ymin,\r\n        ymax\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    if point_inside_rect(\r\n\r\n        p2.X,\r\n        p2.Y,\r\n\r\n        xmin,\r\n        xmax,\r\n\r\n        ymin,\r\n        ymax\r\n\r\n    ):\r\n\r\n        return True\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # RECTANGLE EDGES\r\n    # --------------------------------------------------------\r\n\r\n    edges = [\r\n\r\n        (\r\n            xmin,\r\n            ymin,\r\n            xmax,\r\n            ymin\r\n        ),\r\n\r\n        (\r\n            xmax,\r\n            ymin,\r\n            xmax,\r\n            ymax\r\n        ),\r\n\r\n        (\r\n            xmax,\r\n            ymax,\r\n            xmin,\r\n            ymax\r\n        ),\r\n\r\n        (\r\n            xmin,\r\n            ymax,\r\n            xmin,\r\n            ymin\r\n        )\r\n    ]\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TEST AGAINST EACH EDGE\r\n    # --------------------------------------------------------\r\n\r\n    for edge in edges:\r\n\r\n        if segments_intersect(\r\n\r\n            p1.X,\r\n            p1.Y,\r\n\r\n            p2.X,\r\n            p2.Y,\r\n\r\n            edge[0],\r\n            edge[1],\r\n\r\n            edge[2],\r\n            edge[3]\r\n\r\n        ):\r\n\r\n            return True\r\n\r\n\r\n    return False\r\n\r\n\r\n# ============================================================\r\n# VERTICAL OVERLAP\r\n# ============================================================\r\n\r\ndef vertical_overlap(\r\n    bbox_a,\r\n    bbox_b\r\n):\r\n\r\n    if bbox_a is None:\r\n\r\n        return False\r\n\r\n\r\n    if bbox_b is None:\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # A ABOVE B\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n\r\n        bbox_a.Min.Z\r\n        >\r\n        bbox_b.Max.Z\r\n        +\r\n        VERTICAL_TOL\r\n\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # A BELOW B\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n\r\n        bbox_a.Max.Z\r\n        <\r\n        bbox_b.Min.Z\r\n        -\r\n        VERTICAL_TOL\r\n\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    return True\r\n\r\n\r\n# ============================================================\r\n# BEAM / COLUMN DETECTION\r\n# ============================================================\r\n\r\ndef beam_hits_column(\r\n    beam,\r\n    beam_bbox,\r\n    column_bbox\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # VERTICAL CHECK\r\n    # --------------------------------------------------------\r\n\r\n    if not vertical_overlap(\r\n\r\n        beam_bbox,\r\n        column_bbox\r\n\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BEAM LOCATION CURVE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        location = beam.Location\r\n\r\n    except:\r\n\r\n        return False\r\n\r\n\r\n    if not isinstance(\r\n        location,\r\n        LocationCurve\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        curve = location.Curve\r\n\r\n        p1 = curve.GetEndPoint(\r\n            0\r\n        )\r\n\r\n        p2 = curve.GetEndPoint(\r\n            1\r\n        )\r\n\r\n    except:\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # EXPANDED COLUMN FOOTPRINT\r\n    # --------------------------------------------------------\r\n\r\n    xmin = (\r\n\r\n        column_bbox.Min.X\r\n        -\r\n        BEAM_PLAN_TOL\r\n    )\r\n\r\n\r\n    xmax = (\r\n\r\n        column_bbox.Max.X\r\n        +\r\n        BEAM_PLAN_TOL\r\n    )\r\n\r\n\r\n    ymin = (\r\n\r\n        column_bbox.Min.Y\r\n        -\r\n        BEAM_PLAN_TOL\r\n    )\r\n\r\n\r\n    ymax = (\r\n\r\n        column_bbox.Max.Y\r\n        +\r\n        BEAM_PLAN_TOL\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PLAN CHECK\r\n    # --------------------------------------------------------\r\n\r\n    return segment_intersects_rect(\r\n\r\n        p1,\r\n        p2,\r\n\r\n        xmin,\r\n        xmax,\r\n\r\n        ymin,\r\n        ymax\r\n    )\r\n\r\n\r\n# ============================================================\r\n# FOUNDATION / COLUMN DETECTION\r\n# ============================================================\r\n\r\ndef foundation_hits_column(\r\n    foundation_bbox,\r\n    column_bbox,\r\n    center\r\n):\r\n\r\n    if foundation_bbox is None:\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PLAN CHECK\r\n    # --------------------------------------------------------\r\n\r\n    inside = (\r\n\r\n        center.X\r\n        >=\r\n        foundation_bbox.Min.X\r\n        -\r\n        FOUNDATION_PLAN_TOL\r\n\r\n        and\r\n\r\n        center.X\r\n        <=\r\n        foundation_bbox.Max.X\r\n        +\r\n        FOUNDATION_PLAN_TOL\r\n\r\n        and\r\n\r\n        center.Y\r\n        >=\r\n        foundation_bbox.Min.Y\r\n        -\r\n        FOUNDATION_PLAN_TOL\r\n\r\n        and\r\n\r\n        center.Y\r\n        <=\r\n        foundation_bbox.Max.Y\r\n        +\r\n        FOUNDATION_PLAN_TOL\r\n    )\r\n\r\n\r\n    if not inside:\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FOUNDATION MUST BE ASSOCIATED WITH LOWER COLUMN END\r\n    #\r\n    # Foundation top can equal or slightly overlap the\r\n    # column bottom.\r\n    # --------------------------------------------------------\r\n\r\n    column_bottom = (\r\n        column_bbox.Min.Z\r\n    )\r\n\r\n\r\n    foundation_top = (\r\n        foundation_bbox.Max.Z\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Foundation completely above column bottom = reject.\r\n    #\r\n    # This prevents floor/slab-like foundation elements at\r\n    # higher elevations from being mistaken for the footing.\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n\r\n        foundation_bbox.Min.Z\r\n        >\r\n        column_bottom\r\n        +\r\n        VERTICAL_TOL\r\n\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # Foundation too far below the column = reject.\r\n    # --------------------------------------------------------\r\n\r\n    if (\r\n\r\n        foundation_top\r\n        <\r\n        column_bottom\r\n        -\r\n        VERTICAL_TOL\r\n\r\n    ):\r\n\r\n        return False\r\n\r\n\r\n    return True\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\nraw_columns = flatten(\r\n    IN[0]\r\n)\r\n\r\n\r\ncolumns = []\r\n\r\n\r\nfor item in raw_columns:\r\n\r\n    element = unwrap(\r\n        item\r\n    )\r\n\r\n\r\n    if element is None:\r\n\r\n        continue\r\n\r\n\r\n    try:\r\n\r\n        element.Id\r\n\r\n        columns.append(\r\n            element\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n# ============================================================\r\n# COLLECT STRUCTURAL FRAMING\r\n# ============================================================\r\n\r\nbeams = list(\r\n\r\n    FilteredElementCollector(doc)\r\n\r\n    .OfCategory(\r\n        BuiltInCategory.OST_StructuralFraming\r\n    )\r\n\r\n    .WhereElementIsNotElementType()\r\n\r\n    .ToElements()\r\n)\r\n\r\n\r\n# ============================================================\r\n# COLLECT FOUNDATIONS\r\n# ============================================================\r\n\r\nfoundations = list(\r\n\r\n    FilteredElementCollector(doc)\r\n\r\n    .OfCategory(\r\n        BuiltInCategory.OST_StructuralFoundation\r\n    )\r\n\r\n    .WhereElementIsNotElementType()\r\n\r\n    .ToElements()\r\n)\r\n\r\n\r\n# ============================================================\r\n# CACHE BEAM BOUNDING BOXES\r\n# ============================================================\r\n\r\nbeam_bboxes = {}\r\n\r\n\r\nfor beam in beams:\r\n\r\n    eid = get_id(\r\n        beam\r\n    )\r\n\r\n\r\n    if eid is not None:\r\n\r\n        beam_bboxes[eid] = (\r\n            get_bbox(\r\n                beam\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# CACHE FOUNDATION BOUNDING BOXES\r\n# ============================================================\r\n\r\nfoundation_bboxes = {}\r\n\r\n\r\nfor foundation in foundations:\r\n\r\n    eid = get_id(\r\n        foundation\r\n    )\r\n\r\n\r\n    if eid is not None:\r\n\r\n        foundation_bboxes[eid] = (\r\n            get_bbox(\r\n                foundation\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# RESULT\r\n# ============================================================\r\n\r\nsupport_packages = []\r\n\r\n\r\n# ============================================================\r\n# PROCESS EACH COLUMN\r\n# ============================================================\r\n\r\nfor column in columns:\r\n\r\n    column_id = get_id(\r\n        column\r\n    )\r\n\r\n\r\n    column_bbox = get_bbox(\r\n        column\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # INVALID COLUMN\r\n    # ========================================================\r\n\r\n    if column_bbox is None:\r\n\r\n        support_packages.append(\r\n\r\n            [\r\n                column,\r\n                column_id,\r\n                None,\r\n                None,\r\n                None,\r\n                [],\r\n                [],\r\n                \"Column {} | ERROR: no bounding box\".format(\r\n                    column_id\r\n                )\r\n            ]\r\n        )\r\n\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # COLUMN DATA\r\n    # ========================================================\r\n\r\n    column_bottom_mm = ft_to_mm(\r\n        column_bbox.Min.Z\r\n    )\r\n\r\n\r\n    column_top_mm = ft_to_mm(\r\n        column_bbox.Max.Z\r\n    )\r\n\r\n\r\n    center = bbox_center(\r\n        column_bbox\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # DETECT BEAMS\r\n    # ========================================================\r\n\r\n    beam_package = []\r\n\r\n\r\n    for beam in beams:\r\n\r\n        beam_id = get_id(\r\n            beam\r\n        )\r\n\r\n\r\n        if beam_id is None:\r\n\r\n            continue\r\n\r\n\r\n        beam_bbox = beam_bboxes.get(\r\n            beam_id\r\n        )\r\n\r\n\r\n        if beam_bbox is None:\r\n\r\n            continue\r\n\r\n\r\n        try:\r\n\r\n            hit = beam_hits_column(\r\n\r\n                beam,\r\n                beam_bbox,\r\n                column_bbox\r\n            )\r\n\r\n        except:\r\n\r\n            hit = False\r\n\r\n\r\n        if not hit:\r\n\r\n            continue\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # BEAM ELEVATIONS\r\n        # ----------------------------------------------------\r\n\r\n        beam_bottom_mm = ft_to_mm(\r\n            beam_bbox.Min.Z\r\n        )\r\n\r\n\r\n        beam_top_mm = ft_to_mm(\r\n            beam_bbox.Max.Z\r\n        )\r\n\r\n\r\n        beam_package.append(\r\n\r\n            [\r\n                beam_bottom_mm,    # 0\r\n                beam_top_mm,       # 1\r\n                beam_id,           # 2\r\n                beam               # 3\r\n            ]\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # SORT BEAMS BY BOTTOM ELEVATION\r\n    # ========================================================\r\n\r\n    beam_package.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # DETECT FOUNDATIONS\r\n    # ========================================================\r\n\r\n    foundation_package = []\r\n\r\n\r\n    for foundation in foundations:\r\n\r\n        foundation_id = get_id(\r\n            foundation\r\n        )\r\n\r\n\r\n        if foundation_id is None:\r\n\r\n            continue\r\n\r\n\r\n        foundation_bbox = (\r\n            foundation_bboxes.get(\r\n                foundation_id\r\n            )\r\n        )\r\n\r\n\r\n        if foundation_bbox is None:\r\n\r\n            continue\r\n\r\n\r\n        try:\r\n\r\n            hit = foundation_hits_column(\r\n\r\n                foundation_bbox,\r\n\r\n                column_bbox,\r\n\r\n                center\r\n            )\r\n\r\n        except:\r\n\r\n            hit = False\r\n\r\n\r\n        if not hit:\r\n\r\n            continue\r\n\r\n\r\n        foundation_bottom_mm = (\r\n            ft_to_mm(\r\n                foundation_bbox.Min.Z\r\n            )\r\n        )\r\n\r\n\r\n        foundation_top_mm = (\r\n            ft_to_mm(\r\n                foundation_bbox.Max.Z\r\n            )\r\n        )\r\n\r\n\r\n        foundation_package.append(\r\n\r\n            [\r\n                foundation_bottom_mm,   # 0\r\n                foundation_top_mm,      # 1\r\n                foundation_id,          # 2\r\n                foundation              # 3\r\n            ]\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # SORT FOUNDATIONS\r\n    # ========================================================\r\n\r\n    foundation_package.sort(\r\n        key=lambda x: x[1]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # DETERMINE PRIMARY FOUNDATION TOP\r\n    # ========================================================\r\n\r\n    foundation_top = None\r\n\r\n\r\n    if len(\r\n        foundation_package\r\n    ) > 0:\r\n\r\n        # ----------------------------------------------------\r\n        # Choose foundation whose TOP is closest to the\r\n        # column bottom.\r\n        # ----------------------------------------------------\r\n\r\n        closest_foundation = min(\r\n\r\n            foundation_package,\r\n\r\n            key=lambda x:\r\n            abs(\r\n                x[1]\r\n                -\r\n                column_bottom_mm\r\n            )\r\n        )\r\n\r\n\r\n        foundation_top = (\r\n            closest_foundation[1]\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # DIAGNOSTIC\r\n    # ========================================================\r\n\r\n    diagnostic = (\r\n\r\n        \"Column {} | \"\r\n        \"Z={:.0f} to {:.0f} mm | \"\r\n        \"Beams={} | \"\r\n        \"Foundations={} | \"\r\n        \"FoundationTop={}\"\r\n    ).format(\r\n\r\n        column_id,\r\n\r\n        column_bottom_mm,\r\n\r\n        column_top_mm,\r\n\r\n        len(\r\n            beam_package\r\n        ),\r\n\r\n        len(\r\n            foundation_package\r\n        ),\r\n\r\n        (\r\n            \"{:.0f}\".format(\r\n                foundation_top\r\n            )\r\n\r\n            if\r\n            foundation_top is not None\r\n\r\n            else\r\n            \"NONE\"\r\n        )\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # ONE PACKAGE FOR THIS COLUMN\r\n    # ========================================================\r\n\r\n    support_package = [\r\n\r\n        column,                 # 0\r\n\r\n        column_id,              # 1\r\n\r\n        column_bottom_mm,       # 2\r\n\r\n        column_top_mm,          # 3\r\n\r\n        foundation_top,         # 4\r\n\r\n        beam_package,           # 5\r\n\r\n        foundation_package,     # 6\r\n\r\n        diagnostic              # 7\r\n    ]\r\n\r\n\r\n    support_packages.append(\r\n        support_package\r\n    )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = support_packages",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "8810f060d978476493a37552bf07273d",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "04c5d82c529f45da966efd97076538fe",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "fd6e9de4d2fd4f3e9043219eacd89e39",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S04 — COLUMN CONFINEMENT ZONE + REBAR SETTINGS\r\n#\r\n# IN[0] = S03 Support Package\r\n# IN[1] = Tie Diameter (mm)\r\n# IN[2] = Confinement Spacing (mm)\r\n# IN[3] = Regular Spacing (mm)\r\n# IN[4] = Concrete Cover (mm)\r\n#\r\n# CONFINEMENT RULE:\r\n#\r\n# Code-style minimum:\r\n#\r\n# Lo = MAX(\r\n#       Column Max Dimension,\r\n#       Clear Height / 6,\r\n#       450 mm\r\n#      )\r\n#\r\n# Construction rule:\r\n#\r\n# L/4 = Clear Height / 4\r\n#\r\n# FINAL CONFINEMENT LENGTH:\r\n#\r\n# Lc = MAX(L/4, Lo)\r\n#\r\n# Therefore:\r\n#\r\n# Lc = MAX(\r\n#       Clear Height / 4,\r\n#       Column Max Dimension,\r\n#       Clear Height / 6,\r\n#       450 mm\r\n#      )\r\n#\r\n#\r\n# OUTPUT PACKAGE:\r\n#\r\n# [\r\n#     Column,                  # [0]\r\n#     Column ID,               # [1]\r\n#     Clear Segments,          # [2]\r\n#     Confinement Zones,       # [3]\r\n#     Normal Zones,            # [4]\r\n#     Confinement Spacing,     # [5]\r\n#     Regular Spacing,         # [6]\r\n#     Beam Joints,             # [7]\r\n#     Column Max Dimension,    # [8]\r\n#     Confinement Data,        # [9]\r\n#     Tie Diameter,            # [10]\r\n#     Concrete Cover           # [11]\r\n# ]\r\n#\r\n# ============================================================\r\n\r\n\r\nimport clr\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import (\r\n    UnitUtils,\r\n    UnitTypeId\r\n)\r\n\r\n\r\n# ============================================================\r\n# REVIT NODES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(\r\n    Revit.Elements\r\n)\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMINIMUM_LO_MM = 450.0\r\n\r\nTOLERANCE_MM = 5.0\r\n\r\n\r\n# ============================================================\r\n# BASIC HELPERS\r\n# ============================================================\r\n\r\ndef is_list(value):\r\n\r\n    return isinstance(\r\n        value,\r\n        (list, tuple)\r\n    )\r\n\r\n\r\ndef unwrap(value):\r\n\r\n    try:\r\n\r\n        return UnwrapElement(\r\n            value\r\n        )\r\n\r\n    except:\r\n\r\n        return value\r\n\r\n\r\ndef to_float(value):\r\n\r\n    try:\r\n\r\n        if value is None:\r\n\r\n            return None\r\n\r\n        return float(value)\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\ndef ft_to_mm(value):\r\n\r\n    try:\r\n\r\n        return UnitUtils.ConvertFromInternalUnits(\r\n            float(value),\r\n            UnitTypeId.Millimeters\r\n        )\r\n\r\n    except:\r\n\r\n        return float(value) * 304.8\r\n\r\n\r\n# ============================================================\r\n# SAFE INPUT READER\r\n# ============================================================\r\n\r\ndef get_input(index):\r\n\r\n    try:\r\n\r\n        if len(IN) > index:\r\n\r\n            return IN[index]\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# READ USER SETTINGS\r\n# ============================================================\r\n\r\ndata = get_input(0)\r\n\r\ntie_diameter_mm = to_float(\r\n    get_input(1)\r\n)\r\n\r\nconfinement_spacing_mm = to_float(\r\n    get_input(2)\r\n)\r\n\r\nregular_spacing_mm = to_float(\r\n    get_input(3)\r\n)\r\n\r\ncover_mm = to_float(\r\n    get_input(4)\r\n)\r\n\r\n\r\n# ============================================================\r\n# INPUT VALIDATION\r\n# ============================================================\r\n\r\ninput_errors = []\r\n\r\n\r\nif tie_diameter_mm is None:\r\n\r\n    input_errors.append(\r\n        \"Tie Diameter is missing or invalid.\"\r\n    )\r\n\r\nelif tie_diameter_mm <= 0:\r\n\r\n    input_errors.append(\r\n        \"Tie Diameter must be greater than 0.\"\r\n    )\r\n\r\n\r\nif confinement_spacing_mm is None:\r\n\r\n    input_errors.append(\r\n        \"Confinement Spacing is missing or invalid.\"\r\n    )\r\n\r\nelif confinement_spacing_mm <= 0:\r\n\r\n    input_errors.append(\r\n        \"Confinement Spacing must be greater than 0.\"\r\n    )\r\n\r\n\r\nif regular_spacing_mm is None:\r\n\r\n    input_errors.append(\r\n        \"Regular Spacing is missing or invalid.\"\r\n    )\r\n\r\nelif regular_spacing_mm <= 0:\r\n\r\n    input_errors.append(\r\n        \"Regular Spacing must be greater than 0.\"\r\n    )\r\n\r\n\r\nif cover_mm is None:\r\n\r\n    input_errors.append(\r\n        \"Concrete Cover is missing or invalid.\"\r\n    )\r\n\r\nelif cover_mm < 0:\r\n\r\n    input_errors.append(\r\n        \"Concrete Cover cannot be negative.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PARAMETER READER\r\n# ============================================================\r\n\r\ndef get_parameter_double(\r\n    element,\r\n    names\r\n):\r\n\r\n    if element is None:\r\n\r\n        return None\r\n\r\n\r\n    for name in names:\r\n\r\n        try:\r\n\r\n            parameter = element.LookupParameter(\r\n                name\r\n            )\r\n\r\n\r\n            if parameter is None:\r\n\r\n                continue\r\n\r\n\r\n            if not parameter.HasValue:\r\n\r\n                continue\r\n\r\n\r\n            value = parameter.AsDouble()\r\n\r\n\r\n            if (\r\n                value is not None\r\n                and\r\n                value > 0\r\n            ):\r\n\r\n                return value\r\n\r\n        except:\r\n\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# COLUMN DIMENSIONS\r\n# ============================================================\r\n\r\ndef get_column_dimensions_mm(\r\n    column\r\n):\r\n\r\n    column = unwrap(\r\n        column\r\n    )\r\n\r\n\r\n    if column is None:\r\n\r\n        return (\r\n            None,\r\n            None,\r\n            None\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # GET COLUMN TYPE\r\n    # ========================================================\r\n\r\n    column_type = None\r\n\r\n\r\n    try:\r\n\r\n        column_type = doc.GetElement(\r\n            column.GetTypeId()\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n    # ========================================================\r\n    # WIDTH\r\n    # ========================================================\r\n\r\n    width_ft = get_parameter_double(\r\n\r\n        column_type,\r\n\r\n        [\r\n            \"b\",\r\n            \"B\",\r\n            \"Width\",\r\n            \"WIDTH\",\r\n            \"Width 1\"\r\n        ]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # DEPTH\r\n    # ========================================================\r\n\r\n    depth_ft = get_parameter_double(\r\n\r\n        column_type,\r\n\r\n        [\r\n            \"h\",\r\n            \"H\",\r\n            \"Depth\",\r\n            \"DEPTH\",\r\n            \"Height\",\r\n            \"Depth 1\"\r\n        ]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # TYPE PARAMETERS FOUND\r\n    # ========================================================\r\n\r\n    if (\r\n        width_ft is not None\r\n        and\r\n        depth_ft is not None\r\n    ):\r\n\r\n        width_mm = ft_to_mm(\r\n            width_ft\r\n        )\r\n\r\n\r\n        depth_mm = ft_to_mm(\r\n            depth_ft\r\n        )\r\n\r\n\r\n        max_dimension_mm = max(\r\n            width_mm,\r\n            depth_mm\r\n        )\r\n\r\n\r\n        return (\r\n            width_mm,\r\n            depth_mm,\r\n            max_dimension_mm\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # BOUNDING BOX FALLBACK\r\n    # ========================================================\r\n\r\n    bbox = None\r\n\r\n\r\n    try:\r\n\r\n        bbox = column.get_BoundingBox(\r\n            None\r\n        )\r\n\r\n    except:\r\n\r\n        pass\r\n\r\n\r\n    if bbox is None:\r\n\r\n        return (\r\n            None,\r\n            None,\r\n            None\r\n        )\r\n\r\n\r\n    width_mm = ft_to_mm(\r\n        bbox.Max.X\r\n        -\r\n        bbox.Min.X\r\n    )\r\n\r\n\r\n    depth_mm = ft_to_mm(\r\n        bbox.Max.Y\r\n        -\r\n        bbox.Min.Y\r\n    )\r\n\r\n\r\n    max_dimension_mm = max(\r\n        width_mm,\r\n        depth_mm\r\n    )\r\n\r\n\r\n    return (\r\n        width_mm,\r\n        depth_mm,\r\n        max_dimension_mm\r\n    )\r\n\r\n\r\n# ============================================================\r\n# BEAM JOINT DETECTION FROM S03 PACKAGE\r\n# ============================================================\r\n\r\ndef get_beam_joints(\r\n    beam_package,\r\n    column_start,\r\n    column_top\r\n):\r\n\r\n    raw = []\r\n\r\n\r\n    if not is_list(\r\n        beam_package\r\n    ):\r\n\r\n        return []\r\n\r\n\r\n    for beam_data in beam_package:\r\n\r\n        if not is_list(\r\n            beam_data\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        if len(beam_data) < 2:\r\n\r\n            continue\r\n\r\n\r\n        bottom = to_float(\r\n            beam_data[0]\r\n        )\r\n\r\n\r\n        top = to_float(\r\n            beam_data[1]\r\n        )\r\n\r\n\r\n        if (\r\n            bottom is None\r\n            or\r\n            top is None\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        beam_id = None\r\n\r\n\r\n        if len(beam_data) >= 3:\r\n\r\n            beam_id = beam_data[2]\r\n\r\n\r\n        # ====================================================\r\n        # CORRECT ORDER\r\n        # ====================================================\r\n\r\n        if top < bottom:\r\n\r\n            temp = bottom\r\n\r\n            bottom = top\r\n\r\n            top = temp\r\n\r\n\r\n        # ====================================================\r\n        # IGNORE JOINTS OUTSIDE COLUMN\r\n        # ====================================================\r\n\r\n        if (\r\n            top\r\n            <\r\n            column_start\r\n            -\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        if (\r\n            bottom\r\n            >\r\n            column_top\r\n            +\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # CLAMP TO COLUMN\r\n        # ====================================================\r\n\r\n        bottom = max(\r\n            bottom,\r\n            column_start\r\n        )\r\n\r\n\r\n        top = min(\r\n            top,\r\n            column_top\r\n        )\r\n\r\n\r\n        raw.append(\r\n            [\r\n                bottom,\r\n                top,\r\n                beam_id\r\n            ]\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # SORT BY ELEVATION\r\n    # ========================================================\r\n\r\n    raw.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # MERGE OVERLAPPING BEAMS INTO ONE JOINT\r\n    # ========================================================\r\n\r\n    joints = []\r\n\r\n\r\n    for item in raw:\r\n\r\n        bottom = item[0]\r\n\r\n        top = item[1]\r\n\r\n        beam_id = item[2]\r\n\r\n\r\n        # ====================================================\r\n        # FIRST JOINT\r\n        # ====================================================\r\n\r\n        if len(joints) == 0:\r\n\r\n            ids = []\r\n\r\n\r\n            if beam_id is not None:\r\n\r\n                ids.append(\r\n                    beam_id\r\n                )\r\n\r\n\r\n            joints.append(\r\n                [\r\n                    bottom,\r\n                    top,\r\n                    ids\r\n                ]\r\n            )\r\n\r\n\r\n            continue\r\n\r\n\r\n        last = joints[-1]\r\n\r\n\r\n        # ====================================================\r\n        # OVERLAPPING JOINT\r\n        # ====================================================\r\n\r\n        if (\r\n            bottom\r\n            <=\r\n            last[1]\r\n            +\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            last[0] = min(\r\n                last[0],\r\n                bottom\r\n            )\r\n\r\n\r\n            last[1] = max(\r\n                last[1],\r\n                top\r\n            )\r\n\r\n\r\n            if (\r\n                beam_id is not None\r\n                and\r\n                beam_id not in last[2]\r\n            ):\r\n\r\n                last[2].append(\r\n                    beam_id\r\n                )\r\n\r\n\r\n        # ====================================================\r\n        # NEW JOINT\r\n        # ====================================================\r\n\r\n        else:\r\n\r\n            ids = []\r\n\r\n\r\n            if beam_id is not None:\r\n\r\n                ids.append(\r\n                    beam_id\r\n                )\r\n\r\n\r\n            joints.append(\r\n                [\r\n                    bottom,\r\n                    top,\r\n                    ids\r\n                ]\r\n            )\r\n\r\n\r\n    return joints\r\n\r\n\r\n# ============================================================\r\n# CLEAR COLUMN SEGMENTS\r\n#\r\n# Beam depth itself is excluded.\r\n# ============================================================\r\n\r\ndef get_clear_segments(\r\n    column_start,\r\n    column_top,\r\n    beam_joints\r\n):\r\n\r\n    clear_segments = []\r\n\r\n    current = column_start\r\n\r\n\r\n    for joint in beam_joints:\r\n\r\n        beam_bottom = joint[0]\r\n\r\n        beam_top = joint[1]\r\n\r\n\r\n        # ====================================================\r\n        # JOINT BELOW CURRENT POSITION\r\n        # ====================================================\r\n\r\n        if (\r\n            beam_top\r\n            <=\r\n            current\r\n            +\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # COLUMN BELOW JOINT\r\n        # ====================================================\r\n\r\n        if (\r\n            beam_bottom\r\n            >\r\n            current\r\n            +\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            clear_segments.append(\r\n                [\r\n                    current,\r\n                    beam_bottom\r\n                ]\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # SKIP BEAM DEPTH\r\n        # ====================================================\r\n\r\n        if beam_top > current:\r\n\r\n            current = beam_top\r\n\r\n\r\n    # ========================================================\r\n    # FINAL CLEAR SEGMENT\r\n    # ========================================================\r\n\r\n    if (\r\n        column_top\r\n        >\r\n        current\r\n        +\r\n        TOLERANCE_MM\r\n    ):\r\n\r\n        clear_segments.append(\r\n            [\r\n                current,\r\n                column_top\r\n            ]\r\n        )\r\n\r\n\r\n    return clear_segments\r\n\r\n\r\n# ============================================================\r\n# CONFINEMENT LENGTH\r\n#\r\n# Lo = max(h, L/6, 450)\r\n#\r\n# Construction confinement:\r\n#\r\n# Lc = max(L/4, Lo)\r\n# ============================================================\r\n\r\ndef calculate_confinement_length(\r\n    clear_height_mm,\r\n    max_column_dimension_mm\r\n):\r\n\r\n    # ========================================================\r\n    # L / 4\r\n    # ========================================================\r\n\r\n    quarter_height = (\r\n        clear_height_mm\r\n        /\r\n        4.0\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # L / 6\r\n    # ========================================================\r\n\r\n    sixth_height = (\r\n        clear_height_mm\r\n        /\r\n        6.0\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # CODE-STYLE Lo\r\n    # ========================================================\r\n\r\n    lo = max(\r\n        max_column_dimension_mm,\r\n        sixth_height,\r\n        MINIMUM_LO_MM\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # FINAL CONSTRUCTION CONFINEMENT LENGTH\r\n    # ========================================================\r\n\r\n    confinement_length = max(\r\n        quarter_height,\r\n        lo\r\n    )\r\n\r\n\r\n    return (\r\n        confinement_length,\r\n        quarter_height,\r\n        lo,\r\n        max_column_dimension_mm,\r\n        sixth_height,\r\n        MINIMUM_LO_MM\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CREATE REINFORCEMENT ZONES\r\n# ============================================================\r\n\r\ndef get_rebar_zones(\r\n    clear_segments,\r\n    max_column_dimension_mm\r\n):\r\n\r\n    confinement_zones = []\r\n\r\n    normal_zones = []\r\n\r\n    confinement_data = []\r\n\r\n\r\n    for segment_index in range(\r\n        len(clear_segments)\r\n    ):\r\n\r\n        segment = clear_segments[\r\n            segment_index\r\n        ]\r\n\r\n\r\n        start = segment[0]\r\n\r\n        end = segment[1]\r\n\r\n\r\n        clear_height = (\r\n            end\r\n            -\r\n            start\r\n        )\r\n\r\n\r\n        if clear_height <= TOLERANCE_MM:\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # CALCULATE CONFINEMENT LENGTH\r\n        # ====================================================\r\n\r\n        (\r\n            confinement_length,\r\n            quarter_height,\r\n            lo,\r\n            column_dimension,\r\n            sixth_height,\r\n            minimum_lo\r\n\r\n        ) = calculate_confinement_length(\r\n\r\n            clear_height,\r\n\r\n            max_column_dimension_mm\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # STORE CALCULATION\r\n        #\r\n        # [\r\n        #   Segment Index,\r\n        #   Clear Height,\r\n        #   L/4,\r\n        #   Column Max Dimension,\r\n        #   L/6,\r\n        #   450,\r\n        #   Lo,\r\n        #   Final Lc\r\n        # ]\r\n        # ====================================================\r\n\r\n        confinement_data.append(\r\n            [\r\n                segment_index,          # 0\r\n\r\n                clear_height,           # 1\r\n\r\n                quarter_height,         # 2\r\n\r\n                column_dimension,       # 3\r\n\r\n                sixth_height,           # 4\r\n\r\n                minimum_lo,             # 5\r\n\r\n                lo,                     # 6\r\n\r\n                confinement_length      # 7\r\n            ]\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # SHORT SEGMENT\r\n        #\r\n        # If confinement zones overlap:\r\n        #\r\n        # entire segment = confinement.\r\n        # ====================================================\r\n\r\n        if (\r\n            2.0\r\n            *\r\n            confinement_length\r\n\r\n            >=\r\n\r\n            clear_height\r\n            -\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            confinement_zones.append(\r\n                [\r\n                    start,\r\n                    end,\r\n                    segment_index,\r\n                    confinement_length\r\n                ]\r\n            )\r\n\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # LOWER CONFINEMENT\r\n        # ====================================================\r\n\r\n        lower_end = (\r\n            start\r\n            +\r\n            confinement_length\r\n        )\r\n\r\n\r\n        confinement_zones.append(\r\n            [\r\n                start,\r\n                lower_end,\r\n                segment_index,\r\n                confinement_length\r\n            ]\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # REGULAR MIDDLE ZONE\r\n        # ====================================================\r\n\r\n        middle_start = lower_end\r\n\r\n\r\n        middle_end = (\r\n            end\r\n            -\r\n            confinement_length\r\n        )\r\n\r\n\r\n        if (\r\n            middle_end\r\n            >\r\n            middle_start\r\n            +\r\n            TOLERANCE_MM\r\n        ):\r\n\r\n            normal_zones.append(\r\n                [\r\n                    middle_start,\r\n                    middle_end,\r\n                    segment_index,\r\n                    confinement_length\r\n                ]\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # UPPER CONFINEMENT\r\n        # ====================================================\r\n\r\n        upper_start = (\r\n            end\r\n            -\r\n            confinement_length\r\n        )\r\n\r\n\r\n        confinement_zones.append(\r\n            [\r\n                upper_start,\r\n                end,\r\n                segment_index,\r\n                confinement_length\r\n            ]\r\n        )\r\n\r\n\r\n    return (\r\n        confinement_zones,\r\n        normal_zones,\r\n        confinement_data\r\n    )\r\n\r\n\r\n# ============================================================\r\n# NORMALIZE S03 INPUT\r\n# ============================================================\r\n\r\nif data is None:\r\n\r\n    packages = []\r\n\r\n\r\nelif is_list(\r\n    data\r\n):\r\n\r\n    packages = list(\r\n        data\r\n    )\r\n\r\n\r\nelse:\r\n\r\n    packages = [\r\n        data\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# RESULT\r\n# ============================================================\r\n\r\nresult = []\r\n\r\n\r\n# ============================================================\r\n# ONLY PROCESS IF INPUT SETTINGS ARE VALID\r\n# ============================================================\r\n\r\nif len(input_errors) == 0:\r\n\r\n    for package in packages:\r\n\r\n        # ====================================================\r\n        # VALIDATE S03 PACKAGE\r\n        # ====================================================\r\n\r\n        if not is_list(\r\n            package\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        if len(package) < 6:\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # READ S03 DATA\r\n        # ====================================================\r\n\r\n        column = package[0]\r\n\r\n        column_id = package[1]\r\n\r\n\r\n        column_bottom = to_float(\r\n            package[2]\r\n        )\r\n\r\n\r\n        column_top = to_float(\r\n            package[3]\r\n        )\r\n\r\n\r\n        foundation_top = to_float(\r\n            package[4]\r\n        )\r\n\r\n\r\n        beam_package = package[5]\r\n\r\n\r\n        # ====================================================\r\n        # COLUMN HEIGHT VALIDATION\r\n        # ====================================================\r\n\r\n        if (\r\n            column_bottom is None\r\n            or\r\n            column_top is None\r\n        ):\r\n\r\n            continue\r\n\r\n\r\n        if column_top < column_bottom:\r\n\r\n            temp = column_bottom\r\n\r\n            column_bottom = column_top\r\n\r\n            column_top = temp\r\n\r\n\r\n        # ====================================================\r\n        # COLUMN DIMENSIONS\r\n        # ====================================================\r\n\r\n        (\r\n            width_mm,\r\n            depth_mm,\r\n            max_dimension_mm\r\n\r\n        ) = get_column_dimensions_mm(\r\n            column\r\n        )\r\n\r\n\r\n        if max_dimension_mm is None:\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # COLUMN START\r\n        #\r\n        # Foundation top is used as lower clear limit.\r\n        # ====================================================\r\n\r\n        if foundation_top is not None:\r\n\r\n            column_start = max(\r\n                column_bottom,\r\n                foundation_top\r\n            )\r\n\r\n\r\n        else:\r\n\r\n            column_start = column_bottom\r\n\r\n\r\n        if column_start > column_top:\r\n\r\n            column_start = column_bottom\r\n\r\n\r\n        # ====================================================\r\n        # DETECT/MERGE BEAM JOINTS\r\n        # ====================================================\r\n\r\n        beam_joints = get_beam_joints(\r\n\r\n            beam_package,\r\n\r\n            column_start,\r\n\r\n            column_top\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # CLEAR COLUMN SEGMENTS\r\n        # ====================================================\r\n\r\n        clear_segments = get_clear_segments(\r\n\r\n            column_start,\r\n\r\n            column_top,\r\n\r\n            beam_joints\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # REINFORCEMENT ZONES\r\n        # ====================================================\r\n\r\n        (\r\n            confinement_zones,\r\n            normal_zones,\r\n            confinement_data\r\n\r\n        ) = get_rebar_zones(\r\n\r\n            clear_segments,\r\n\r\n            max_dimension_mm\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # FINAL PACKAGE\r\n        # ====================================================\r\n\r\n        result.append(\r\n            [\r\n                column,                         # [0]\r\n\r\n                column_id,                      # [1]\r\n\r\n                clear_segments,                 # [2]\r\n\r\n                confinement_zones,              # [3]\r\n\r\n                normal_zones,                   # [4]\r\n\r\n                confinement_spacing_mm,         # [5]\r\n\r\n                regular_spacing_mm,             # [6]\r\n\r\n                beam_joints,                    # [7]\r\n\r\n                max_dimension_mm,               # [8]\r\n\r\n                confinement_data,               # [9]\r\n\r\n                tie_diameter_mm,                # [10]\r\n\r\n                cover_mm                        # [11]\r\n            ]\r\n        )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nif len(input_errors) > 0:\r\n\r\n    OUT = [\r\n        [\r\n            \"S04 INPUT ERROR\",\r\n            input_errors\r\n        ]\r\n    ]\r\n\r\n\r\nelse:\r\n\r\n    OUT = result",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "f45436b30e0f474a9c3817a53a7a8bfa",
      "NodeType": "PythonScriptNode",
