        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# M02 — MAIN BAR LAYOUT + VALIDATION\r\n# SIMPLIFIED USER INPUT VERSION\r\n#\r\n# IN[0] = M01 Column Stack Package\r\n# IN[1] = Main Bar Diameter (mm)\r\n# IN[2] = Total Number of Main Bars\r\n#\r\n# Tie Diameter and Concrete Cover are inherited from S04.\r\n#\r\n# S04 PACKAGE EXPECTED:\r\n#\r\n# [0]  Column\r\n# [1]  Column ID\r\n# [2]  Clear Segments\r\n# [3]  Confinement Zones\r\n# [4]  Normal Zones\r\n# [5]  Confinement Spacing\r\n# [6]  Regular Spacing\r\n# [7]  Beam Joints\r\n# [8]  Column Max Dimension\r\n# [9]  Confinement Data\r\n# [10] Tie Diameter\r\n# [11] Concrete Cover\r\n#\r\n#\r\n# M01 STOREY PACKAGE EXPECTED:\r\n#\r\n# [0]  Column\r\n# [1]  Column ID\r\n# [2]  Bottom mm\r\n# [3]  Top mm\r\n# [4]  Width mm\r\n# [5]  Depth mm\r\n# [6]  Center X mm\r\n# [7]  Center Y mm\r\n# [8]  Rotation degrees\r\n# [9]  S03 Package\r\n# [10] S04 Package\r\n#\r\n#\r\n# OUTPUT — EACH STACK\r\n#\r\n# [0]  Stack Index\r\n# [1]  Column IDs\r\n# [2]  Main Bar Diameter\r\n# [3]  Total Main Bars\r\n# [4]  Single Bar Area\r\n# [5]  Total Steel Area\r\n# [6]  Storey Layout Packages\r\n# [7]  Group A Bar Indices\r\n# [8]  Group B Bar Indices\r\n# [9]  Lap Length = 60db\r\n# [10] Validation / Status\r\n# [11] Original M01 Package\r\n#\r\n#\r\n# STOREY LAYOUT PACKAGE\r\n#\r\n# [0]  Column\r\n# [1]  Column ID\r\n# [2]  Width\r\n# [3]  Depth\r\n# [4]  Bottom\r\n# [5]  Top\r\n# [6]  Rotation\r\n# [7]  Tie Diameter\r\n# [8]  Concrete Cover\r\n# [9]  Main Bar Centerline Offset\r\n# [10] Gross Area\r\n# [11] Steel Ratio %\r\n# [12] Bars on Width Face\r\n# [13] Bars on Depth Face\r\n# [14] Bar Layout\r\n# [15] Minimum Clear Spacing\r\n# [16] Validation\r\n#\r\n#\r\n# BAR LAYOUT ITEM\r\n#\r\n# [0] Bar Index\r\n# [1] Splice Group A/B\r\n# [2] Local X\r\n# [3] Local Y\r\n# [4] Global X\r\n# [5] Global Y\r\n# [6] Bottom Z\r\n# [7] Top Z\r\n# [8] Face\r\n#\r\n# ============================================================\r\n\r\n\r\nimport clr\r\nimport math\r\n\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# ============================================================\r\n# REVIT / DYNAMO\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\n\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMIN_STEEL_RATIO = 0.01\r\nMAX_STEEL_RATIO = 0.06\r\n\r\nMIN_CLEAR_SPACING_MM = 40.0\r\n\r\n\r\n# ============================================================\r\n# BASIC FUNCTIONS\r\n# ============================================================\r\n\r\ndef unwrap(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef safe_float(value, default=None):\r\n\r\n    try:\r\n        return float(value)\r\n    except:\r\n        return default\r\n\r\n\r\ndef safe_int(value, default=None):\r\n\r\n    try:\r\n        return int(value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(round(float(value)))\r\n    except:\r\n        return default\r\n\r\n\r\ndef rnd(value, digits=3):\r\n\r\n    try:\r\n        return round(float(value), digits)\r\n    except:\r\n        return value\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\ndef get_input(index):\r\n\r\n    try:\r\n\r\n        if len(IN) > index:\r\n            return IN[index]\r\n\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# M01 PACKAGE DETECTION\r\n# ============================================================\r\n\r\ndef is_m01_package(data):\r\n\r\n    if not isinstance(data, (list, tuple)):\r\n        return False\r\n\r\n    if len(data) < 12:\r\n        return False\r\n\r\n    try:\r\n\r\n        stack_index = int(data[0])\r\n\r\n        columns = data[1]\r\n        ids = data[2]\r\n        storeys = data[9]\r\n\r\n        if not isinstance(\r\n            columns,\r\n            (list, tuple)\r\n        ):\r\n            return False\r\n\r\n        if not isinstance(\r\n            ids,\r\n            (list, tuple)\r\n        ):\r\n            return False\r\n\r\n        if not isinstance(\r\n            storeys,\r\n            (list, tuple)\r\n        ):\r\n            return False\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\ndef collect_m01_packages(data):\r\n\r\n    result = []\r\n\r\n    if data is None:\r\n        return result\r\n\r\n    if is_m01_package(data):\r\n\r\n        result.append(data)\r\n        return result\r\n\r\n    if isinstance(\r\n        data,\r\n        (list, tuple)\r\n    ):\r\n\r\n        for item in data:\r\n\r\n            result.extend(\r\n                collect_m01_packages(item)\r\n            )\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# S04 DATA\r\n# ============================================================\r\n\r\ndef get_s04_values(storey):\r\n\r\n    \"\"\"\r\n    M01 Storey:\r\n        [10] = S04 package\r\n\r\n    S04:\r\n        [10] = Tie Diameter\r\n        [11] = Concrete Cover\r\n    \"\"\"\r\n\r\n    tie_diameter = None\r\n    cover = None\r\n    s04 = None\r\n\r\n    try:\r\n        s04 = storey[10]\r\n    except:\r\n        return (\r\n            None,\r\n            None,\r\n            None\r\n        )\r\n\r\n    if not isinstance(\r\n        s04,\r\n        (list, tuple)\r\n    ):\r\n\r\n        return (\r\n            None,\r\n            None,\r\n            s04\r\n        )\r\n\r\n    try:\r\n        tie_diameter = safe_float(\r\n            s04[10]\r\n        )\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        cover = safe_float(\r\n            s04[11]\r\n        )\r\n    except:\r\n        pass\r\n\r\n    return (\r\n        tie_diameter,\r\n        cover,\r\n        s04\r\n    )\r\n\r\n\r\n# ============================================================\r\n# AUTOMATIC FACE DISTRIBUTION\r\n# ============================================================\r\n\r\ndef determine_face_counts(\r\n    total_bars,\r\n    width,\r\n    depth\r\n):\r\n\r\n    \"\"\"\r\n    Determines a balanced rectangular perimeter arrangement.\r\n\r\n    Total bars:\r\n\r\n        N = 2*Nw + 2*(Nd - 2)\r\n\r\n    Therefore:\r\n\r\n        N = 2*Nw + 2*Nd - 4\r\n\r\n    or:\r\n\r\n        Nw + Nd = (N + 4) / 2\r\n\r\n\r\n    Nw = bars INCLUDING corners on each width face.\r\n    Nd = bars INCLUDING corners on each depth face.\r\n\r\n\r\n    The algorithm searches all valid combinations and chooses\r\n    the arrangement whose physical bar spacing is most uniform.\r\n\r\n    This is better than simply splitting the total equally\r\n    because rectangular columns may have different width/depth.\r\n    \"\"\"\r\n\r\n    if total_bars < 4:\r\n        return None\r\n\r\n    # A symmetric rectangular perimeter arrangement using\r\n    # identical opposite faces requires an even total count.\r\n    if total_bars % 2 != 0:\r\n        return None\r\n\r\n    target_sum = int(\r\n        (total_bars + 4) / 2\r\n    )\r\n\r\n    candidates = []\r\n\r\n    for nw in range(\r\n        2,\r\n        target_sum\r\n    ):\r\n\r\n        nd = target_sum - nw\r\n\r\n        if nd < 2:\r\n            continue\r\n\r\n        calculated_total = (\r\n            2 * nw +\r\n            2 * (nd - 2)\r\n        )\r\n\r\n        if calculated_total != total_bars:\r\n            continue\r\n\r\n        # Approximate center-to-center spacing.\r\n        if nw > 1:\r\n\r\n            spacing_width = (\r\n                width /\r\n                float(nw - 1)\r\n            )\r\n\r\n        else:\r\n\r\n            spacing_width = width\r\n\r\n        if nd > 1:\r\n\r\n            spacing_depth = (\r\n                depth /\r\n                float(nd - 1)\r\n            )\r\n\r\n        else:\r\n\r\n            spacing_depth = depth\r\n\r\n        spacing_difference = abs(\r\n            spacing_width -\r\n            spacing_depth\r\n        )\r\n\r\n        candidates.append(\r\n            [\r\n                spacing_difference,\r\n                nw,\r\n                nd,\r\n                spacing_width,\r\n                spacing_depth\r\n            ]\r\n        )\r\n\r\n    if len(candidates) == 0:\r\n        return None\r\n\r\n    candidates.sort(\r\n        key=lambda x: x[0]\r\n    )\r\n\r\n    best = candidates[0]\r\n\r\n    return [\r\n        best[1],\r\n        best[2]\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# INTERPOLATION\r\n# ============================================================\r\n\r\ndef interpolate(\r\n    start,\r\n    end,\r\n    count\r\n):\r\n\r\n    if count <= 0:\r\n        return []\r\n\r\n    if count == 1:\r\n\r\n        return [\r\n            (\r\n                start +\r\n                end\r\n            ) / 2.0\r\n        ]\r\n\r\n    step = (\r\n        end -\r\n        start\r\n    ) / float(\r\n        count - 1\r\n    )\r\n\r\n    result = []\r\n\r\n    for i in range(count):\r\n\r\n        result.append(\r\n            start +\r\n            step * i\r\n        )\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# LOCAL -> GLOBAL\r\n# ============================================================\r\n\r\ndef local_to_global(\r\n    local_x,\r\n    local_y,\r\n    center_x,\r\n    center_y,\r\n    rotation_degrees\r\n):\r\n\r\n    angle = math.radians(\r\n        rotation_degrees\r\n    )\r\n\r\n    c = math.cos(angle)\r\n    s = math.sin(angle)\r\n\r\n    global_x = (\r\n        center_x +\r\n        local_x * c -\r\n        local_y * s\r\n    )\r\n\r\n    global_y = (\r\n        center_y +\r\n        local_x * s +\r\n        local_y * c\r\n    )\r\n\r\n    return (\r\n        global_x,\r\n        global_y\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CREATE PERIMETER LAYOUT\r\n# ============================================================\r\n\r\ndef create_bar_layout(\r\n    width,\r\n    depth,\r\n    center_x,\r\n    center_y,\r\n    rotation,\r\n    bottom,\r\n    top,\r\n    offset,\r\n    nw,\r\n    nd\r\n):\r\n\r\n    half_x = (\r\n        width / 2.0 -\r\n        offset\r\n    )\r\n\r\n    half_y = (\r\n        depth / 2.0 -\r\n        offset\r\n    )\r\n\r\n    if (\r\n        half_x <= 0 or\r\n        half_y <= 0\r\n    ):\r\n\r\n        return (\r\n            [],\r\n            \"INVALID BAR ENVELOPE\"\r\n        )\r\n\r\n    x_positions = interpolate(\r\n        -half_x,\r\n        half_x,\r\n        nw\r\n    )\r\n\r\n    y_positions = interpolate(\r\n        -half_y,\r\n        half_y,\r\n        nd\r\n    )\r\n\r\n    local_bars = []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TOP WIDTH FACE\r\n    # left -> right\r\n    # --------------------------------------------------------\r\n\r\n    for x in x_positions:\r\n\r\n        local_bars.append(\r\n            [\r\n                x,\r\n                half_y,\r\n                \"TOP\"\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # RIGHT DEPTH FACE\r\n    # top -> bottom\r\n    # corners excluded\r\n    # --------------------------------------------------------\r\n\r\n    if nd > 2:\r\n\r\n        internal_y = list(\r\n            reversed(\r\n                y_positions[1:-1]\r\n            )\r\n        )\r\n\r\n        for y in internal_y:\r\n\r\n            local_bars.append(\r\n                [\r\n                    half_x,\r\n                    y,\r\n                    \"RIGHT\"\r\n                ]\r\n            )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM WIDTH FACE\r\n    # right -> left\r\n    # --------------------------------------------------------\r\n\r\n    for x in reversed(\r\n        x_positions\r\n    ):\r\n\r\n        local_bars.append(\r\n            [\r\n                x,\r\n                -half_y,\r\n                \"BOTTOM\"\r\n            ]\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # LEFT DEPTH FACE\r\n    # bottom -> top\r\n    # corners excluded\r\n    # --------------------------------------------------------\r\n\r\n    if nd > 2:\r\n\r\n        for y in y_positions[1:-1]:\r\n\r\n            local_bars.append(\r\n                [\r\n                    -half_x,\r\n                    y,\r\n                    \"LEFT\"\r\n                ]\r\n            )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FINAL BAR RECORDS\r\n    # --------------------------------------------------------\r\n\r\n    result = []\r\n\r\n    for i, item in enumerate(\r\n        local_bars\r\n    ):\r\n\r\n        local_x = item[0]\r\n        local_y = item[1]\r\n        face = item[2]\r\n\r\n        global_x, global_y = (\r\n            local_to_global(\r\n                local_x,\r\n                local_y,\r\n                center_x,\r\n                center_y,\r\n                rotation\r\n            )\r\n        )\r\n\r\n        bar_index = i + 1\r\n\r\n        # Alternating perimeter splice grouping.\r\n        if i % 2 == 0:\r\n            group = \"A\"\r\n        else:\r\n            group = \"B\"\r\n\r\n        result.append(\r\n            [\r\n                bar_index,          # [0]\r\n                group,              # [1]\r\n\r\n                rnd(local_x),       # [2]\r\n                rnd(local_y),       # [3]\r\n\r\n                rnd(global_x),      # [4]\r\n                rnd(global_y),      # [5]\r\n\r\n                rnd(bottom),        # [6]\r\n                rnd(top),           # [7]\r\n\r\n                face                # [8]\r\n            ]\r\n        )\r\n\r\n    return (\r\n        result,\r\n        \"OK\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CLEAR SPACING\r\n# ============================================================\r\n\r\ndef minimum_clear_spacing(\r\n    width,\r\n    depth,\r\n    offset,\r\n    nw,\r\n    nd,\r\n    db\r\n):\r\n\r\n    values = []\r\n\r\n    available_width = (\r\n        width -\r\n        2.0 * offset\r\n    )\r\n\r\n    available_depth = (\r\n        depth -\r\n        2.0 * offset\r\n    )\r\n\r\n    if nw > 1:\r\n\r\n        center_spacing_width = (\r\n            available_width /\r\n            float(nw - 1)\r\n        )\r\n\r\n        clear_width = (\r\n            center_spacing_width -\r\n            db\r\n        )\r\n\r\n        values.append(\r\n            clear_width\r\n        )\r\n\r\n    if nd > 1:\r\n\r\n        center_spacing_depth = (\r\n            available_depth /\r\n            float(nd - 1)\r\n        )\r\n\r\n        clear_depth = (\r\n            center_spacing_depth -\r\n            db\r\n        )\r\n\r\n        values.append(\r\n            clear_depth\r\n        )\r\n\r\n    if len(values) == 0:\r\n        return None\r\n\r\n    return min(values)\r\n\r\n\r\n# ============================================================\r\n# READ INPUTS\r\n# ============================================================\r\n\r\nm01_input = get_input(0)\r\n\r\nmain_bar_diameter = safe_float(\r\n    get_input(1)\r\n)\r\n\r\ntotal_main_bars = safe_int(\r\n    get_input(2)\r\n)\r\n\r\n\r\n# ============================================================\r\n# INPUT VALIDATION\r\n# ============================================================\r\n\r\ninput_errors = []\r\n\r\nif main_bar_diameter is None:\r\n\r\n    input_errors.append(\r\n        \"MAIN BAR DIAMETER IS MISSING\"\r\n    )\r\n\r\nelif main_bar_diameter <= 0:\r\n\r\n    input_errors.append(\r\n        \"MAIN BAR DIAMETER MUST BE GREATER THAN ZERO\"\r\n    )\r\n\r\n\r\nif total_main_bars is None:\r\n\r\n    input_errors.append(\r\n        \"TOTAL NUMBER OF MAIN BARS IS MISSING\"\r\n    )\r\n\r\nelif total_main_bars < 4:\r\n\r\n    input_errors.append(\r\n        \"TOTAL MAIN BARS MUST BE AT LEAST 4\"\r\n    )\r\n\r\nelif total_main_bars % 2 != 0:\r\n\r\n    input_errors.append(\r\n        \"TOTAL MAIN BARS MUST BE EVEN FOR THIS SYMMETRIC RECTANGULAR LAYOUT\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# ERROR OUTPUT\r\n# ============================================================\r\n\r\nif len(input_errors) > 0:\r\n\r\n    OUT = [\r\n        \"M02 INPUT ERROR\",\r\n        input_errors\r\n    ]\r\n\r\n\r\nelse:\r\n\r\n    # ========================================================\r\n    # COLLECT M01 STACKS\r\n    # ========================================================\r\n\r\n    stacks = collect_m01_packages(\r\n        m01_input\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # BAR PROPERTIES\r\n    # ========================================================\r\n\r\n    single_bar_area = (\r\n        math.pi *\r\n        main_bar_diameter *\r\n        main_bar_diameter /\r\n        4.0\r\n    )\r\n\r\n\r\n    total_steel_area = (\r\n        single_bar_area *\r\n        total_main_bars\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ADOPTED LAP RULE\r\n    # --------------------------------------------------------\r\n\r\n    lap_length = (\r\n        60.0 *\r\n        main_bar_diameter\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # SPLICE GROUPS\r\n    # ========================================================\r\n\r\n    group_a = []\r\n    group_b = []\r\n\r\n    for i in range(\r\n        total_main_bars\r\n    ):\r\n\r\n        bar_number = i + 1\r\n\r\n        if i % 2 == 0:\r\n\r\n            group_a.append(\r\n                bar_number\r\n            )\r\n\r\n        else:\r\n\r\n            group_b.append(\r\n                bar_number\r\n            )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS STACKS\r\n    # ========================================================\r\n\r\n    output = []\r\n\r\n\r\n    for stack in stacks:\r\n\r\n        stack_index = stack[0]\r\n        column_ids = stack[2]\r\n        storeys = stack[9]\r\n\r\n        storey_outputs = []\r\n        stack_status = []\r\n\r\n\r\n        # ====================================================\r\n        # PROCESS EACH COLUMN\r\n        # ====================================================\r\n\r\n        for storey in storeys:\r\n\r\n            column = unwrap(\r\n                storey[0]\r\n            )\r\n\r\n            column_id = storey[1]\r\n\r\n            bottom = safe_float(\r\n                storey[2]\r\n            )\r\n\r\n            top = safe_float(\r\n                storey[3]\r\n            )\r\n\r\n            width = safe_float(\r\n                storey[4]\r\n            )\r\n\r\n            depth = safe_float(\r\n                storey[5]\r\n            )\r\n\r\n            center_x = safe_float(\r\n                storey[6]\r\n            )\r\n\r\n            center_y = safe_float(\r\n                storey[7]\r\n            )\r\n\r\n            rotation = safe_float(\r\n                storey[8],\r\n                0.0\r\n            )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # S04 VALUES\r\n            # ------------------------------------------------\r\n\r\n            (\r\n                tie_diameter,\r\n                cover,\r\n                s04\r\n\r\n            ) = get_s04_values(\r\n                storey\r\n            )\r\n\r\n\r\n            validation = []\r\n\r\n\r\n            # ------------------------------------------------\r\n            # GEOMETRY VALIDATION\r\n            # ------------------------------------------------\r\n\r\n            if width is None or width <= 0:\r\n\r\n                validation.append(\r\n                    \"FAIL: INVALID COLUMN WIDTH\"\r\n                )\r\n\r\n\r\n            if depth is None or depth <= 0:\r\n\r\n                validation.append(\r\n                    \"FAIL: INVALID COLUMN DEPTH\"\r\n                )\r\n\r\n\r\n            if center_x is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: INVALID COLUMN CENTER X\"\r\n                )\r\n\r\n\r\n            if center_y is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: INVALID COLUMN CENTER Y\"\r\n                )\r\n\r\n\r\n            if bottom is None or top is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: INVALID COLUMN HEIGHT\"\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # S04 VALIDATION\r\n            # ------------------------------------------------\r\n\r\n            if tie_diameter is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: TIE DIAMETER NOT FOUND IN S04\"\r\n                )\r\n\r\n\r\n            if cover is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: CONCRETE COVER NOT FOUND IN S04\"\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # STOP THIS STOREY IF REQUIRED DATA MISSING\r\n            # ------------------------------------------------\r\n\r\n            required_ok = (\r\n                width is not None and\r\n                width > 0 and\r\n\r\n                depth is not None and\r\n                depth > 0 and\r\n\r\n                center_x is not None and\r\n                center_y is not None and\r\n\r\n                bottom is not None and\r\n                top is not None and\r\n\r\n                tie_diameter is not None and\r\n                cover is not None\r\n            )\r\n\r\n\r\n            if not required_ok:\r\n\r\n                storey_outputs.append(\r\n                    [\r\n                        column,\r\n                        column_id,\r\n                        width,\r\n                        depth,\r\n                        bottom,\r\n                        top,\r\n                        rotation,\r\n                        tie_diameter,\r\n                        cover,\r\n                        None,\r\n                        None,\r\n                        None,\r\n                        None,\r\n                        None,\r\n                        [],\r\n                        None,\r\n                        validation\r\n                    ]\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # MAIN BAR CENTERLINE OFFSET\r\n            #\r\n            # concrete face\r\n            #      +\r\n            # cover to outside of tie\r\n            #      +\r\n            # tie diameter\r\n            #      +\r\n            # 1/2 main bar diameter\r\n            # ------------------------------------------------\r\n\r\n            offset = (\r\n                cover +\r\n                tie_diameter +\r\n                main_bar_diameter / 2.0\r\n            )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # AUTOMATIC FACE DISTRIBUTION\r\n            # ------------------------------------------------\r\n\r\n            face_counts = (\r\n                determine_face_counts(\r\n                    total_main_bars,\r\n                    width,\r\n                    depth\r\n                )\r\n            )\r\n\r\n\r\n            if face_counts is None:\r\n\r\n                validation.append(\r\n                    \"FAIL: CANNOT CREATE SYMMETRIC PERIMETER LAYOUT\"\r\n                )\r\n\r\n                storey_outputs.append(\r\n                    [\r\n                        column,\r\n                        column_id,\r\n                        width,\r\n                        depth,\r\n                        bottom,\r\n                        top,\r\n                        rotation,\r\n                        tie_diameter,\r\n                        cover,\r\n                        offset,\r\n                        None,\r\n                        None,\r\n                        None,\r\n                        None,\r\n                        [],\r\n                        None,\r\n                        validation\r\n                    ]\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            bars_width = face_counts[0]\r\n            bars_depth = face_counts[1]\r\n\r\n\r\n            # ------------------------------------------------\r\n            # GROSS AREA\r\n            # ------------------------------------------------\r\n\r\n            gross_area = (\r\n                width *\r\n                depth\r\n            )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # STEEL RATIO\r\n            # ------------------------------------------------\r\n\r\n            steel_ratio = (\r\n                total_steel_area /\r\n                gross_area\r\n            )\r\n\r\n\r\n            steel_ratio_percent = (\r\n                steel_ratio *\r\n                100.0\r\n            )\r\n\r\n\r\n            if steel_ratio < MIN_STEEL_RATIO:\r\n\r\n                validation.append(\r\n                    \"FAIL: STEEL RATIO {:.3f}% < 1.0%\".format(\r\n                        steel_ratio_percent\r\n                    )\r\n                )\r\n\r\n            elif steel_ratio > MAX_STEEL_RATIO:\r\n\r\n                validation.append(\r\n                    \"FAIL: STEEL RATIO {:.3f}% > 6.0%\".format(\r\n                        steel_ratio_percent\r\n                    )\r\n                )\r\n\r\n            else:\r\n\r\n                validation.append(\r\n                    \"PASS: STEEL RATIO = {:.3f}%\".format(\r\n                        steel_ratio_percent\r\n                    )\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # BAR ENVELOPE CHECK\r\n            # ------------------------------------------------\r\n\r\n            usable_width = (\r\n                width -\r\n                2.0 * offset\r\n            )\r\n\r\n            usable_depth = (\r\n                depth -\r\n                2.0 * offset\r\n            )\r\n\r\n\r\n            if usable_width <= 0:\r\n\r\n                validation.append(\r\n                    \"FAIL: MAIN BARS DO NOT FIT COLUMN WIDTH\"\r\n                )\r\n\r\n\r\n            if usable_depth <= 0:\r\n\r\n                validation.append(\r\n                    \"FAIL: MAIN BARS DO NOT FIT COLUMN DEPTH\"\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # CLEAR SPACING\r\n            # ------------------------------------------------\r\n\r\n            min_clear = (\r\n                minimum_clear_spacing(\r\n                    width,\r\n                    depth,\r\n                    offset,\r\n                    bars_width,\r\n                    bars_depth,\r\n                    main_bar_diameter\r\n                )\r\n            )\r\n\r\n\r\n            required_clear = max(\r\n                MIN_CLEAR_SPACING_MM,\r\n                1.5 *\r\n                main_bar_diameter\r\n            )\r\n\r\n\r\n            if min_clear is not None:\r\n\r\n                if min_clear < required_clear:\r\n\r\n                    validation.append(\r\n                        \"FAIL: MIN CLEAR SPACING {:.1f} mm < {:.1f} mm\".format(\r\n                            min_clear,\r\n                            required_clear\r\n                        )\r\n                    )\r\n\r\n                else:\r\n\r\n                    validation.append(\r\n                        \"PASS: MIN CLEAR SPACING = {:.1f} mm\".format(\r\n                            min_clear\r\n                        )\r\n                    )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # CREATE BAR POSITIONS\r\n            # ------------------------------------------------\r\n\r\n            (\r\n                bar_layout,\r\n                layout_status\r\n\r\n            ) = create_bar_layout(\r\n\r\n                width,\r\n                depth,\r\n\r\n                center_x,\r\n                center_y,\r\n\r\n                rotation,\r\n\r\n                bottom,\r\n                top,\r\n\r\n                offset,\r\n\r\n                bars_width,\r\n                bars_depth\r\n            )\r\n\r\n\r\n            if layout_status != \"OK\":\r\n\r\n                validation.append(\r\n                    \"FAIL: \" +\r\n                    layout_status\r\n                )\r\n\r\n            else:\r\n\r\n                validation.append(\r\n                    \"PASS: {} MAIN BAR POSITIONS GENERATED\".format(\r\n                        len(bar_layout)\r\n                    )\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # COUNT CHECK\r\n            # ------------------------------------------------\r\n\r\n            if len(bar_layout) != total_main_bars:\r\n\r\n                validation.append(\r\n                    \"FAIL: EXPECTED {} BARS BUT GENERATED {}\".format(\r\n                        total_main_bars,\r\n                        len(bar_layout)\r\n                    )\r\n                )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # DISTRIBUTION MESSAGE\r\n            # ------------------------------------------------\r\n\r\n            validation.append(\r\n                \"AUTO LAYOUT: {} BARS/WIDTH FACE, {} BARS/DEPTH FACE\".format(\r\n                    bars_width,\r\n                    bars_depth\r\n                )\r\n            )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # STOREY OUTPUT\r\n            # ------------------------------------------------\r\n\r\n            storey_output = [\r\n\r\n                column,                         # [0]\r\n\r\n                column_id,                      # [1]\r\n\r\n                rnd(width),                     # [2]\r\n\r\n                rnd(depth),                     # [3]\r\n\r\n                rnd(bottom),                    # [4]\r\n\r\n                rnd(top),                       # [5]\r\n\r\n                rnd(rotation),                  # [6]\r\n\r\n                rnd(tie_diameter),              # [7]\r\n\r\n                rnd(cover),                     # [8]\r\n\r\n                rnd(offset),                    # [9]\r\n\r\n                rnd(gross_area),                # [10]\r\n\r\n                rnd(\r\n                    steel_ratio_percent\r\n                ),                              # [11]\r\n\r\n                bars_width,                     # [12]\r\n\r\n                bars_depth,                     # [13]\r\n\r\n                bar_layout,                     # [14]\r\n\r\n                rnd(min_clear),                 # [15]\r\n\r\n                validation                      # [16]\r\n            ]\r\n\r\n\r\n            storey_outputs.append(\r\n                storey_output\r\n            )\r\n\r\n\r\n        # ====================================================\r\n        # STACK STATUS\r\n        # ====================================================\r\n\r\n        stack_status.append(\r\n            \"MAIN BAR DIAMETER = {:.1f} mm\".format(\r\n                main_bar_diameter\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"TOTAL MAIN BARS = {}\".format(\r\n                total_main_bars\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"BAR AREA = {:.2f} mm2\".format(\r\n                single_bar_area\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"TOTAL STEEL AREA = {:.2f} mm2\".format(\r\n                total_steel_area\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"ADOPTED LAP = 60db = {:.1f} mm\".format(\r\n                lap_length\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"GROUP A = {}\".format(\r\n                group_a\r\n            )\r\n        )\r\n\r\n        stack_status.append(\r\n            \"GROUP B = {}\".format(\r\n                group_b\r\n            )\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # FINAL STACK PACKAGE\r\n        # ====================================================\r\n\r\n        main_package = [\r\n\r\n            stack_index,               # [0]\r\n\r\n            column_ids,                # [1]\r\n\r\n            main_bar_diameter,         # [2]\r\n\r\n            total_main_bars,           # [3]\r\n\r\n            rnd(single_bar_area),      # [4]\r\n\r\n            rnd(total_steel_area),     # [5]\r\n\r\n            storey_outputs,            # [6]\r\n\r\n            group_a,                   # [7]\r\n\r\n            group_b,                   # [8]\r\n\r\n            rnd(lap_length),           # [9]\r\n\r\n            stack_status,              # [10]\r\n\r\n            stack                      # [11]\r\n        ]\r\n\r\n\r\n        output.append(\r\n            main_package\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # OUTPUT\r\n    # ========================================================\r\n\r\n    OUT = output",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "e4d0e742ce9c4b848529859e4653752e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
