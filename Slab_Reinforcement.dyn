    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S02 - SLAB REINFORCEMENT INPUT\r\n# SINGLE BAR DIAMETER\r\n# ============================================================\r\n#\r\n# IN[0] = Bar Diameter (mm)\r\n#\r\n# IN[1] = Bottom Long Spacing (mm)\r\n# IN[2] = Bottom Short Spacing (mm)\r\n#\r\n# IN[3] = Top Long Spacing (mm)\r\n# IN[4] = Top Short Spacing (mm)\r\n#\r\n# IN[5] = Bottom Cover (mm)\r\n# IN[6] = Top Cover (mm)\r\n#\r\n# ============================================================\r\n\r\n\r\ndef get_number(value, name, errors):\r\n\r\n    if value is None:\r\n        errors.append(\"{} is NONE\".format(name))\r\n        return None\r\n\r\n    if isinstance(value, list):\r\n\r\n        if len(value) == 0:\r\n            errors.append(\"{} is an empty list\".format(name))\r\n            return None\r\n\r\n        if len(value) > 1:\r\n            errors.append(\r\n                \"{} received multiple values\".format(name)\r\n            )\r\n            return None\r\n\r\n        value = value[0]\r\n\r\n    try:\r\n        value = float(value)\r\n    except:\r\n        errors.append(\r\n            \"{} is not a valid number\".format(name)\r\n        )\r\n        return None\r\n\r\n    if value <= 0:\r\n        errors.append(\r\n            \"{} must be greater than zero\".format(name)\r\n        )\r\n        return None\r\n\r\n    return value\r\n\r\n\r\n# ------------------------------------------------------------\r\n# ERRORS\r\n# ------------------------------------------------------------\r\n\r\nerrors = []\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT VALUES\r\n# ------------------------------------------------------------\r\n\r\nbar_diameter = get_number(\r\n    IN[0],\r\n    \"Bar Diameter\",\r\n    errors\r\n)\r\n\r\nbottom_long_spacing = get_number(\r\n    IN[1],\r\n    \"Bottom Long Spacing\",\r\n    errors\r\n)\r\n\r\nbottom_short_spacing = get_number(\r\n    IN[2],\r\n    \"Bottom Short Spacing\",\r\n    errors\r\n)\r\n\r\ntop_long_spacing = get_number(\r\n    IN[3],\r\n    \"Top Long Spacing\",\r\n    errors\r\n)\r\n\r\ntop_short_spacing = get_number(\r\n    IN[4],\r\n    \"Top Short Spacing\",\r\n    errors\r\n)\r\n\r\nbottom_cover = get_number(\r\n    IN[5],\r\n    \"Bottom Cover\",\r\n    errors\r\n)\r\n\r\ntop_cover = get_number(\r\n    IN[6],\r\n    \"Top Cover\",\r\n    errors\r\n)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# VALID\r\n# ------------------------------------------------------------\r\n\r\nvalid = len(errors) == 0\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REINFORCEMENT\r\n# ------------------------------------------------------------\r\n\r\nreinforcement = {\r\n\r\n    \"BarDiameter_mm\": bar_diameter,\r\n\r\n    \"BottomLong\": {\r\n        \"Spacing_mm\": bottom_long_spacing\r\n    },\r\n\r\n    \"BottomShort\": {\r\n        \"Spacing_mm\": bottom_short_spacing\r\n    },\r\n\r\n    \"TopLong\": {\r\n        \"Spacing_mm\": top_long_spacing\r\n    },\r\n\r\n    \"TopShort\": {\r\n        \"Spacing_mm\": top_short_spacing\r\n    }\r\n}\r\n\r\n\r\n# ------------------------------------------------------------\r\n# COVERS\r\n# ------------------------------------------------------------\r\n\r\ncovers = {\r\n\r\n    \"Bottom_mm\": bottom_cover,\r\n\r\n    \"Top_mm\": top_cover\r\n}\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REPORT\r\n# ------------------------------------------------------------\r\n\r\nreport = []\r\n\r\nif valid:\r\n\r\n    report.append(\r\n        \"BAR DIAMETER = D{} mm\".format(\r\n            bar_diameter\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Bottom Long = D{} @ {} mm\".format(\r\n            bar_diameter,\r\n            bottom_long_spacing\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Bottom Short = D{} @ {} mm\".format(\r\n            bar_diameter,\r\n            bottom_short_spacing\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Top Long = D{} @ {} mm\".format(\r\n            bar_diameter,\r\n            top_long_spacing\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Top Short = D{} @ {} mm\".format(\r\n            bar_diameter,\r\n            top_short_spacing\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Bottom Cover = {} mm\".format(\r\n            bottom_cover\r\n        )\r\n    )\r\n\r\n    report.append(\r\n        \"Top Cover = {} mm\".format(\r\n            top_cover\r\n        )\r\n    )\r\n\r\nelse:\r\n\r\n    report.append(\r\n        \"INPUT DATA INVALID\"\r\n    )\r\n\r\n    for error in errors:\r\n        report.append(error)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# OUTPUT\r\n# ------------------------------------------------------------\r\n\r\nOUT = {\r\n\r\n    \"Valid\": valid,\r\n\r\n    \"Reinforcement\": reinforcement,\r\n\r\n    \"Covers\": covers,\r\n\r\n    \"Errors\": errors,\r\n\r\n    \"Report\": report\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "1df4a006ee694cb794eef74a8b3d64b8",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "2bfc33e4a70348e68b32eba5fe4949ec",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
