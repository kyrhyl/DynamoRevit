  "Nodes": [
    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementsSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "7a0aeabc-84a3-4230-9987-6b6744c7375a-00000ae3",
        "32b376de-f481-4f6c-9595-4cbb7f1d1f42-0006df84"
      ],
      "Id": "4157faa7214f4fdca3ba98b83abf1b13",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "8d6258f5481c469c9f314d037982937e",
          "Name": "Elements",
          "Description": "The selected elements.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select multiple elements from the Revit document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n        if hasattr(value, \"__iter__\") and not isinstance(value, str):\r\n            return list(value)\r\n    except:\r\n        pass\r\n\r\n    return [value]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# GET ID VALUE\r\n# ------------------------------------------------------------\r\n\r\ndef id_value(obj):\r\n\r\n    if obj is None:\r\n        return None\r\n\r\n    # Element\r\n    try:\r\n        return obj.Id.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.Id.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    # ElementId\r\n    try:\r\n        return obj.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(str(obj))\r\n    except:\r\n        return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# ADD ELEMENT OR ID\r\n# ------------------------------------------------------------\r\n\r\ndef add_delete_item(\r\n    obj,\r\n    category_name,\r\n    floor_id,\r\n    delete_ids,\r\n    seen,\r\n    report\r\n):\r\n\r\n    if obj is None:\r\n        return\r\n\r\n    # --------------------------------------------------------\r\n    # If API returned an Element, use its Id\r\n    # If API returned ElementId, use it directly\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n        eid = obj.Id\r\n    except:\r\n        eid = obj\r\n\r\n    value = id_value(eid)\r\n\r\n    if value is None:\r\n        return\r\n\r\n    if value in seen:\r\n        return\r\n\r\n    seen.add(value)\r\n\r\n    delete_ids.append(eid)\r\n\r\n    report.append(\r\n        \"FOUND | Floor {} | {} | ID {}\".format(\r\n            floor_id,\r\n            category_name,\r\n            value\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\n# IN[0] = Select Model Elements\r\n\r\nselected = as_list(IN[0])\r\n\r\n\r\n# ============================================================\r\n# OUTPUT HOLDERS\r\n# ============================================================\r\n\r\nfloors = []\r\n\r\ndelete_ids = []\r\n\r\nseen_ids = set()\r\n\r\ndeleted_ids = []\r\n\r\nerrors = []\r\n\r\nreport = []\r\n\r\n\r\n# ============================================================\r\n# VALIDATE SELECTED ELEMENTS\r\n# ============================================================\r\n\r\nfor item in selected:\r\n\r\n    if item is None:\r\n        continue\r\n\r\n    try:\r\n        element = UnwrapElement(item)\r\n    except:\r\n        element = item\r\n\r\n    try:\r\n\r\n        if isinstance(element, Floor):\r\n\r\n            floors.append(element)\r\n\r\n            report.append(\r\n                \"SELECTED FLOOR | ID {}\".format(\r\n                    id_value(element)\r\n                )\r\n            )\r\n\r\n        else:\r\n\r\n            report.append(\r\n                \"SKIPPED | ID {} | NOT FLOOR\".format(\r\n                    id_value(element)\r\n                )\r\n            )\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"SELECTION ERROR | {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# NO FLOOR SELECTED\r\n# ============================================================\r\n\r\nif len(floors) == 0:\r\n\r\n    errors.append(\r\n        \"NO VALID FLOOR SELECTED\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GET ALL REINFORCEMENT FROM EACH HOST\r\n# ============================================================\r\n\r\nfor floor in floors:\r\n\r\n    floor_id = id_value(floor)\r\n\r\n    report.append(\r\n        \"================================\"\r\n    )\r\n\r\n    report.append(\r\n        \"CHECKING FLOOR {}\".format(\r\n            floor_id\r\n        )\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # HOST DATA\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        host_data = RebarHostData.GetRebarHostData(\r\n            floor\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        host_data = None\r\n\r\n        errors.append(\r\n            \"Floor {} | Cannot get RebarHostData | {}\".format(\r\n                floor_id,\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    if host_data is None:\r\n\r\n        report.append(\r\n            \"Floor {} | RebarHostData = NONE\".format(\r\n                floor_id\r\n            )\r\n        )\r\n\r\n        continue\r\n\r\n\r\n    # ========================================================\r\n    # STANDARD REBAR\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetRebarsInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"REBAR\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"STANDARD REBAR FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"Floor {} | GetRebarsInHost ERROR | {}\".format(\r\n                floor_id,\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # REBAR CONTAINERS\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetRebarContainersInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"REBAR CONTAINER\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"REBAR CONTAINERS FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        # Some Revit versions may not expose it.\r\n        report.append(\r\n            \"GetRebarContainersInHost unavailable/error | {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # AREA REINFORCEMENT\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetAreaReinforcementsInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"AREA REINFORCEMENT\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"AREA REINFORCEMENT FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"Floor {} | GetAreaReinforcementsInHost ERROR | {}\".format(\r\n                floor_id,\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # PATH REINFORCEMENT\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetPathReinforcementsInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"PATH REINFORCEMENT\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"PATH REINFORCEMENT FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"Floor {} | GetPathReinforcementsInHost ERROR | {}\".format(\r\n                floor_id,\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # FABRIC AREAS\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetFabricAreasInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"FABRIC AREA\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"FABRIC AREAS FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        report.append(\r\n            \"GetFabricAreasInHost unavailable/error | {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # FABRIC SHEETS\r\n    # ========================================================\r\n\r\n    try:\r\n\r\n        items = host_data.GetFabricSheetsInHost()\r\n\r\n        count = 0\r\n\r\n        for item in items:\r\n\r\n            add_delete_item(\r\n                item,\r\n                \"FABRIC SHEET\",\r\n                floor_id,\r\n                delete_ids,\r\n                seen_ids,\r\n                report\r\n            )\r\n\r\n            count += 1\r\n\r\n        report.append(\r\n            \"FABRIC SHEETS FOUND = {}\".format(\r\n                count\r\n            )\r\n        )\r\n\r\n    except Exception as ex:\r\n\r\n        report.append(\r\n            \"GetFabricSheetsInHost unavailable/error | {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# SECONDARY GLOBAL CHECK\r\n#\r\n# This deliberately scans all standard Rebar elements and\r\n# compares their actual host ID against the selected floors.\r\n#\r\n# This is a fallback in case RebarHostData missed something.\r\n# ============================================================\r\n\r\nselected_floor_ids = set()\r\n\r\nfor floor in floors:\r\n\r\n    fid = id_value(floor)\r\n\r\n    if fid is not None:\r\n        selected_floor_ids.add(fid)\r\n\r\n\r\ntry:\r\n\r\n    all_rebars = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(Rebar)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for rebar in all_rebars:\r\n\r\n        try:\r\n\r\n            host_id = rebar.GetHostId()\r\n\r\n            host_value = id_value(\r\n                host_id\r\n            )\r\n\r\n\r\n            if host_value in selected_floor_ids:\r\n\r\n                add_delete_item(\r\n                    rebar,\r\n                    \"REBAR GLOBAL FALLBACK\",\r\n                    host_value,\r\n                    delete_ids,\r\n                    seen_ids,\r\n                    report\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    errors.append(\r\n        \"GLOBAL REBAR SCAN ERROR | {}\".format(\r\n            str(ex)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# AREA REINFORCEMENT FALLBACK\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    all_area = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(AreaReinforcement)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for area in all_area:\r\n\r\n        try:\r\n\r\n            host_value = id_value(\r\n                area.GetHostId()\r\n            )\r\n\r\n\r\n            if host_value in selected_floor_ids:\r\n\r\n                add_delete_item(\r\n                    area,\r\n                    \"AREA GLOBAL FALLBACK\",\r\n                    host_value,\r\n                    delete_ids,\r\n                    seen_ids,\r\n                    report\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    errors.append(\r\n        \"GLOBAL AREA REBAR SCAN ERROR | {}\".format(\r\n            str(ex)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# PATH REINFORCEMENT FALLBACK\r\n# ============================================================\r\n\r\ntry:\r\n\r\n    all_path = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(PathReinforcement)\r\n        .WhereElementIsNotElementType()\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    for path in all_path:\r\n\r\n        try:\r\n\r\n            host_value = id_value(\r\n                path.GetHostId()\r\n            )\r\n\r\n\r\n            if host_value in selected_floor_ids:\r\n\r\n                add_delete_item(\r\n                    path,\r\n                    \"PATH GLOBAL FALLBACK\",\r\n                    host_value,\r\n                    delete_ids,\r\n                    seen_ids,\r\n                    report\r\n                )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\nexcept Exception as ex:\r\n\r\n    errors.append(\r\n        \"GLOBAL PATH REBAR SCAN ERROR | {}\".format(\r\n            str(ex)\r\n        )\r\n    )\r\n\r\n\r\n# ============================================================\r\n# DELETE\r\n# ============================================================\r\n\r\nif len(delete_ids) > 0:\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    for eid in delete_ids:\r\n\r\n        try:\r\n\r\n            original_id = id_value(\r\n                eid\r\n            )\r\n\r\n\r\n            # doc.Delete may also delete dependent elements\r\n            deleted_collection = doc.Delete(\r\n                eid\r\n            )\r\n\r\n\r\n            deleted_ids.append(\r\n                original_id\r\n            )\r\n\r\n\r\n            report.append(\r\n                \"DELETED ROOT ID {}\".format(\r\n                    original_id\r\n                )\r\n            )\r\n\r\n\r\n            try:\r\n\r\n                report.append(\r\n                    \"DEPENDENT ELEMENTS DELETED = {}\".format(\r\n                        len(deleted_collection)\r\n                    )\r\n                )\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n        except Exception as ex:\r\n\r\n            errors.append(\r\n                \"DELETE ERROR | ID {} | {}\".format(\r\n                    id_value(eid),\r\n                    str(ex)\r\n                )\r\n            )\r\n\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\nelse:\r\n\r\n    report.append(\r\n        \"NO REINFORCEMENT FOUND TO DELETE\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# FORCE DOCUMENT REGENERATION\r\n# ============================================================\r\n\r\ntry:\r\n    doc.Regenerate()\r\nexcept:\r\n    pass\r\n\r\n\r\n# ============================================================\r\n# FINAL REPORT\r\n# ============================================================\r\n\r\nreport.append(\r\n    \"================================\"\r\n)\r\n\r\nreport.append(\r\n    \"SELECTED FLOORS = {}\".format(\r\n        len(floors)\r\n    )\r\n)\r\n\r\nreport.append(\r\n    \"UNIQUE REINFORCEMENT OBJECTS FOUND = {}\".format(\r\n        len(delete_ids)\r\n    )\r\n)\r\n\r\nreport.append(\r\n    \"ROOT OBJECTS DELETED = {}\".format(\r\n        len(deleted_ids)\r\n    )\r\n)\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n\r\n    \"Floors\":\r\n        floors,\r\n\r\n    \"FloorCount\":\r\n        len(floors),\r\n\r\n    \"FoundCount\":\r\n        len(delete_ids),\r\n\r\n    \"DeletedCount\":\r\n        len(deleted_ids),\r\n\r\n    \"DeletedIds\":\r\n        deleted_ids,\r\n\r\n    \"Errors\":\r\n        errors,\r\n\r\n    \"Report\":\r\n        report\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "b9aef767b62e43f6b919d27518ac6b13",
