    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n\r\n# ============================================================\r\n# .NET\r\n# ============================================================\r\n\r\nclr.AddReference(\"System\")\r\n\r\nfrom System.Collections.Generic import List\r\n\r\n\r\n# ============================================================\r\n# UNIT HELPERS\r\n# ============================================================\r\n\r\ndef mm_to_ft(value):\r\n    return float(value) / 304.8\r\n\r\n\r\ndef ft_to_mm(value):\r\n    return float(value) * 304.8\r\n\r\n\r\n# ============================================================\r\n# GENERAL HELPERS\r\n# ============================================================\r\n\r\ndef read_key(data, key, default=None):\r\n\r\n    if data is None:\r\n        return default\r\n\r\n    try:\r\n        return data[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return data.get(key, default)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        keys = list(data.Keys)\r\n\r\n        for k in keys:\r\n\r\n            if str(k) == str(key):\r\n\r\n                try:\r\n                    return data[k]\r\n                except:\r\n                    pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return default\r\n\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n\r\n        if (\r\n            hasattr(value, \"__iter__\")\r\n            and not isinstance(value, str)\r\n        ):\r\n            return list(value)\r\n\r\n    except:\r\n        pass\r\n\r\n    return [value]\r\n\r\n\r\ndef unwrap(element):\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef id_value(obj):\r\n\r\n    if obj is None:\r\n        return None\r\n\r\n    try:\r\n        return obj.Id.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.Id.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# BAR TYPE HELPERS\r\n# ============================================================\r\n\r\ndef get_bar_diameter(bar_type):\r\n\r\n    try:\r\n\r\n        value = bar_type.BarModelDiameter\r\n\r\n        if value is not None:\r\n            return value\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        value = bar_type.BarNominalDiameter\r\n\r\n        if value is not None:\r\n            return value\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        p = bar_type.get_Parameter(\r\n            BuiltInParameter.REBAR_BAR_DIAMETER\r\n        )\r\n\r\n        if p is not None:\r\n            return p.AsDouble()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\ndef find_bar_type(diameter_mm):\r\n\r\n    target = mm_to_ft(\r\n        diameter_mm\r\n    )\r\n\r\n    tolerance = mm_to_ft(\r\n        0.5\r\n    )\r\n\r\n\r\n    types = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarBarType)\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    best = None\r\n    best_difference = None\r\n\r\n\r\n    for bar_type in types:\r\n\r\n        try:\r\n\r\n            actual = get_bar_diameter(\r\n                bar_type\r\n            )\r\n\r\n            if actual is None:\r\n                continue\r\n\r\n\r\n            difference = abs(\r\n                actual - target\r\n            )\r\n\r\n\r\n            if (\r\n                best_difference is None\r\n                or difference < best_difference\r\n            ):\r\n\r\n                best = bar_type\r\n                best_difference = difference\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if best is None:\r\n        return None\r\n\r\n\r\n    if best_difference is None:\r\n        return None\r\n\r\n\r\n    if best_difference > tolerance:\r\n        return None\r\n\r\n\r\n    return best\r\n\r\n\r\n# ============================================================\r\n# AREA REINFORCEMENT TYPE\r\n# ============================================================\r\n\r\ndef get_or_create_area_type():\r\n\r\n    # --------------------------------------------------------\r\n    # TRY DEFAULT TYPE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        type_id = doc.GetDefaultElementTypeId(\r\n            ElementTypeGroup.AreaReinforcementType\r\n        )\r\n\r\n        if (\r\n            type_id is not None\r\n            and type_id != ElementId.InvalidElementId\r\n        ):\r\n            return type_id\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TRY EXISTING TYPE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        types = (\r\n            FilteredElementCollector(doc)\r\n            .OfClass(AreaReinforcementType)\r\n            .ToElements()\r\n        )\r\n\r\n        for area_type in types:\r\n            return area_type.Id\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CREATE DEFAULT TYPE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        type_id = (\r\n            AreaReinforcementType\r\n            .CreateDefaultAreaReinforcementType(\r\n                doc\r\n            )\r\n        )\r\n\r\n        if (\r\n            type_id is not None\r\n            and type_id != ElementId.InvalidElementId\r\n        ):\r\n            return type_id\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return ElementId.InvalidElementId\r\n\r\n\r\n# ============================================================\r\n# PARAMETER SETTER\r\n# ============================================================\r\n\r\ndef set_bip(element, bip, value):\r\n\r\n    try:\r\n\r\n        p = element.get_Parameter(\r\n            bip\r\n        )\r\n\r\n        if p is None:\r\n            return False\r\n\r\n        if p.IsReadOnly:\r\n            return False\r\n\r\n        p.Set(\r\n            value\r\n        )\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ============================================================\r\n# CREATE BOTTOM AREA REINFORCEMENT\r\n# ============================================================\r\n\r\ndef create_bottom_area(\r\n    floor,\r\n    area_type_id,\r\n    bar_type,\r\n    major_direction,\r\n    long_spacing,\r\n    short_spacing\r\n):\r\n\r\n    area = AreaReinforcement.Create(\r\n        doc,\r\n        floor,\r\n        major_direction,\r\n        area_type_id,\r\n        bar_type.Id,\r\n        ElementId.InvalidElementId\r\n    )\r\n\r\n    if area is None:\r\n        return None\r\n\r\n\r\n    doc.Regenerate()\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM LONG / MAJOR = ON\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_1,\r\n        1\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM SHORT / MINOR = ON\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_ACTIVE_BOTTOM_DIR_2,\r\n        1\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TOP MAJOR = OFF\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_1,\r\n        0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # TOP MINOR = OFF\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_ACTIVE_TOP_DIR_2,\r\n        0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM LONG SPACING\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_SPACING_BOTTOM_DIR_1,\r\n        long_spacing\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM SHORT SPACING\r\n    # --------------------------------------------------------\r\n\r\n    set_bip(\r\n        area,\r\n        BuiltInParameter.REBAR_SYSTEM_SPACING_BOTTOM_DIR_2,\r\n        short_spacing\r\n    )\r\n\r\n\r\n    doc.Regenerate()\r\n\r\n    return area\r\n\r\n\r\n# ============================================================\r\n# GET GENERATED AREA REINFORCEMENT BARS\r\n# ============================================================\r\n\r\ndef get_area_rebars(area):\r\n\r\n    result = []\r\n\r\n    if area is None:\r\n        return result\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # PRIMARY METHOD\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        ids = area.GetRebarInSystemIds()\r\n\r\n        if ids is not None:\r\n\r\n            for eid in ids:\r\n\r\n                try:\r\n\r\n                    element = doc.GetElement(\r\n                        eid\r\n                    )\r\n\r\n                    if element is not None:\r\n                        result.append(\r\n                            element\r\n                        )\r\n\r\n                except:\r\n                    pass\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FALLBACK METHOD\r\n    # --------------------------------------------------------\r\n\r\n    if len(result) == 0:\r\n\r\n        try:\r\n\r\n            all_system_bars = (\r\n                FilteredElementCollector(doc)\r\n                .OfClass(RebarInSystem)\r\n                .WhereElementIsNotElementType()\r\n                .ToElements()\r\n            )\r\n\r\n            area_id = id_value(\r\n                area\r\n            )\r\n\r\n\r\n            for bar in all_system_bars:\r\n\r\n                try:\r\n\r\n                    system_id = bar.SystemId\r\n\r\n                    if id_value(system_id) == area_id:\r\n\r\n                        result.append(\r\n                            bar\r\n                        )\r\n\r\n                except:\r\n                    pass\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# GET REBAR CENTERLINE CURVES\r\n# ============================================================\r\n\r\ndef get_rebar_curves(bar):\r\n\r\n    curves = []\r\n\r\n    if bar is None:\r\n        return curves\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FIRST OVERLOAD\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        raw_curves = bar.GetCenterlineCurves(\r\n            False,\r\n            False,\r\n            False\r\n        )\r\n\r\n        if raw_curves is not None:\r\n\r\n            for curve in raw_curves:\r\n                curves.append(\r\n                    curve\r\n                )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # SECOND OVERLOAD\r\n    # --------------------------------------------------------\r\n\r\n    if len(curves) == 0:\r\n\r\n        try:\r\n\r\n            raw_curves = bar.GetCenterlineCurves(\r\n                False,\r\n                False,\r\n                False,\r\n                MultiplanarOption.IncludeOnlyPlanarCurves,\r\n                0\r\n            )\r\n\r\n            if raw_curves is not None:\r\n\r\n                for curve in raw_curves:\r\n                    curves.append(\r\n                        curve\r\n                    )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return curves\r\n\r\n\r\n# ============================================================\r\n# GET ACTUAL REBAR Z\r\n# ============================================================\r\n\r\ndef get_bar_actual_z(bar):\r\n\r\n    curves = get_rebar_curves(\r\n        bar\r\n    )\r\n\r\n    z_values = []\r\n\r\n\r\n    for curve in curves:\r\n\r\n        try:\r\n\r\n            p0 = curve.GetEndPoint(0)\r\n            p1 = curve.GetEndPoint(1)\r\n\r\n            z_values.append(\r\n                p0.Z\r\n            )\r\n\r\n            z_values.append(\r\n                p1.Z\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if len(z_values) == 0:\r\n        return None\r\n\r\n\r\n    return (\r\n        sum(z_values)\r\n        /\r\n        float(len(z_values))\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GET BAR PLAN DIRECTION\r\n# ============================================================\r\n\r\ndef get_bar_direction(bar):\r\n\r\n    curves = get_rebar_curves(\r\n        bar\r\n    )\r\n\r\n\r\n    for curve in curves:\r\n\r\n        try:\r\n\r\n            p0 = curve.GetEndPoint(0)\r\n            p1 = curve.GetEndPoint(1)\r\n\r\n            dx = abs(\r\n                p1.X - p0.X\r\n            )\r\n\r\n            dy = abs(\r\n                p1.Y - p0.Y\r\n            )\r\n\r\n\r\n            if dx > dy:\r\n                return \"X\"\r\n\r\n            elif dy > dx:\r\n                return \"Y\"\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# GET ACTUAL AREA REINFORCEMENT LEVELS\r\n# ============================================================\r\n\r\ndef get_actual_area_z(\r\n    area,\r\n    long_axis\r\n):\r\n\r\n    bars = get_area_rebars(\r\n        area\r\n    )\r\n\r\n\r\n    long_values = []\r\n    short_values = []\r\n\r\n\r\n    for bar in bars:\r\n\r\n        try:\r\n\r\n            direction = get_bar_direction(\r\n                bar\r\n            )\r\n\r\n            z = get_bar_actual_z(\r\n                bar\r\n            )\r\n\r\n\r\n            if direction is None:\r\n                continue\r\n\r\n            if z is None:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # LONG AXIS = X\r\n            # ------------------------------------------------\r\n\r\n            if long_axis == \"X\":\r\n\r\n                if direction == \"X\":\r\n\r\n                    long_values.append(\r\n                        z\r\n                    )\r\n\r\n                elif direction == \"Y\":\r\n\r\n                    short_values.append(\r\n                        z\r\n                    )\r\n\r\n\r\n            # ------------------------------------------------\r\n            # LONG AXIS = Y\r\n            # ------------------------------------------------\r\n\r\n            elif long_axis == \"Y\":\r\n\r\n                if direction == \"Y\":\r\n\r\n                    long_values.append(\r\n                        z\r\n                    )\r\n\r\n                elif direction == \"X\":\r\n\r\n                    short_values.append(\r\n                        z\r\n                    )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    actual_long_z = None\r\n    actual_short_z = None\r\n\r\n\r\n    if len(long_values) > 0:\r\n\r\n        actual_long_z = (\r\n            sum(long_values)\r\n            /\r\n            float(len(long_values))\r\n        )\r\n\r\n\r\n    if len(short_values) > 0:\r\n\r\n        actual_short_z = (\r\n            sum(short_values)\r\n            /\r\n            float(len(short_values))\r\n        )\r\n\r\n\r\n    return (\r\n        actual_long_z,\r\n        actual_short_z,\r\n        len(bars)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# FIND S04 SUPPORT DATA FOR FLOOR\r\n# ============================================================\r\n\r\ndef find_support_data(\r\n    beam_output,\r\n    floor_id\r\n):\r\n\r\n    if beam_output is None:\r\n        return None\r\n\r\n\r\n    slabs = as_list(\r\n        read_key(\r\n            beam_output,\r\n            \"Slabs\",\r\n            None\r\n        )\r\n    )\r\n\r\n\r\n    for slab_support in slabs:\r\n\r\n        detected_floor_id = read_key(\r\n            slab_support,\r\n            \"FloorId\",\r\n            None\r\n        )\r\n\r\n\r\n        try:\r\n\r\n            if str(\r\n                detected_floor_id\r\n            ) == str(\r\n                floor_id\r\n            ):\r\n\r\n                return slab_support\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# READ SUPPORT CENTERLINE\r\n# ============================================================\r\n\r\ndef get_support_centerline(\r\n    support_data,\r\n    side,\r\n    fallback\r\n):\r\n\r\n    if support_data is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            None\r\n        )\r\n\r\n\r\n    side_data = read_key(\r\n        support_data,\r\n        side,\r\n        None\r\n    )\r\n\r\n\r\n    if side_data is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            None\r\n        )\r\n\r\n\r\n    found = read_key(\r\n        side_data,\r\n        \"Found\",\r\n        False\r\n    )\r\n\r\n\r\n    if not found:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            read_key(\r\n                side_data,\r\n                \"BeamId\",\r\n                None\r\n            )\r\n        )\r\n\r\n\r\n    centerline = read_key(\r\n        side_data,\r\n        \"BeamCenterline_ft\",\r\n        None\r\n    )\r\n\r\n\r\n    beam_id = read_key(\r\n        side_data,\r\n        \"BeamId\",\r\n        None\r\n    )\r\n\r\n\r\n    if centerline is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            beam_id\r\n        )\r\n\r\n\r\n    return (\r\n        centerline,\r\n        True,\r\n        beam_id\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CREATE ONE CRANKED REBAR\r\n# ============================================================\r\n\r\ndef create_cranked_bar(\r\n    floor,\r\n    bar_type,\r\n    points,\r\n    normal\r\n):\r\n\r\n    curves = List[Curve]()\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 5 SEGMENTS\r\n    #\r\n    # P1-P2 = TOP\r\n    # P2-P3 = CRANK DOWN\r\n    # P3-P4 = BOTTOM\r\n    # P4-P5 = CRANK UP\r\n    # P5-P6 = TOP\r\n    # --------------------------------------------------------\r\n\r\n    for i in range(5):\r\n\r\n        curves.Add(\r\n            Line.CreateBound(\r\n                points[i],\r\n                points[i + 1]\r\n            )\r\n        )\r\n\r\n\r\n    rebar = Rebar.CreateFromCurves(\r\n        doc,\r\n        RebarStyle.Standard,\r\n        bar_type,\r\n        None,\r\n        None,\r\n        floor,\r\n        normal,\r\n        curves,\r\n        RebarHookOrientation.Left,\r\n        RebarHookOrientation.Left,\r\n        True,\r\n        True\r\n    )\r\n\r\n\r\n    return rebar\r\n\r\n\r\n# ============================================================\r\n# APPLY SHAPE-DRIVEN SET LAYOUT\r\n# ============================================================\r\n\r\ndef apply_layout(\r\n    rebar,\r\n    spacing,\r\n    distribution_length\r\n):\r\n\r\n    if rebar is None:\r\n        return False\r\n\r\n\r\n    if distribution_length <= 0:\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        accessor = (\r\n            rebar.GetShapeDrivenAccessor()\r\n        )\r\n\r\n\r\n        accessor.SetLayoutAsMaximumSpacing(\r\n            spacing,\r\n            distribution_length,\r\n            True,\r\n            True,\r\n            True\r\n        )\r\n\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ============================================================\r\n# BUILD X-DIRECTION CRANK\r\n# ============================================================\r\n#\r\n# IMPORTANT:\r\n#\r\n# slab_xmin / slab_xmax\r\n#     = actual slab edges\r\n#\r\n# bar_start / bar_end\r\n#     = detected beam centerlines\r\n#\r\n# L/4 IS BASED ON THE SLAB SPAN.\r\n#\r\n# Therefore beam extension DOES NOT change L/4.\r\n#\r\n# ============================================================\r\n\r\ndef build_x_crank(\r\n    slab_xmin,\r\n    slab_xmax,\r\n    bar_start,\r\n    bar_end,\r\n    y,\r\n    top_z,\r\n    bottom_z\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # SLAB SPAN\r\n    # --------------------------------------------------------\r\n\r\n    L = (\r\n        slab_xmax\r\n        -\r\n        slab_xmin\r\n    )\r\n\r\n\r\n    quarter = (\r\n        L / 4.0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 45 DEGREE CRANK\r\n    #\r\n    # horizontal run = vertical drop\r\n    # --------------------------------------------------------\r\n\r\n    vertical_drop = abs(\r\n        top_z\r\n        -\r\n        bottom_z\r\n    )\r\n\r\n\r\n    crank_run = vertical_drop\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # POINTS\r\n    # --------------------------------------------------------\r\n\r\n    # Start at supporting beam centerline\r\n\r\n    x1 = bar_start\r\n\r\n\r\n    # L/4 measured from slab edge\r\n\r\n    x2 = (\r\n        slab_xmin\r\n        +\r\n        quarter\r\n    )\r\n\r\n\r\n    # End of left crank\r\n\r\n    x3 = (\r\n        x2\r\n        +\r\n        crank_run\r\n    )\r\n\r\n\r\n    # Start of right crank\r\n\r\n    x5 = (\r\n        slab_xmax\r\n        -\r\n        quarter\r\n    )\r\n\r\n\r\n    x4 = (\r\n        x5\r\n        -\r\n        crank_run\r\n    )\r\n\r\n\r\n    # End at supporting beam centerline\r\n\r\n    x6 = bar_end\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # VALIDATE\r\n    # --------------------------------------------------------\r\n\r\n    if x1 >= x2:\r\n        return None\r\n\r\n\r\n    if x3 >= x4:\r\n        return None\r\n\r\n\r\n    if x5 >= x6:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CREATE POINTS\r\n    # --------------------------------------------------------\r\n\r\n    return [\r\n\r\n        XYZ(\r\n            x1,\r\n            y,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x2,\r\n            y,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x3,\r\n            y,\r\n            bottom_z\r\n        ),\r\n\r\n        XYZ(\r\n            x4,\r\n            y,\r\n            bottom_z\r\n        ),\r\n\r\n        XYZ(\r\n            x5,\r\n            y,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x6,\r\n            y,\r\n            top_z\r\n        )\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# BUILD Y-DIRECTION CRANK\r\n# ============================================================\r\n\r\ndef build_y_crank(\r\n    slab_ymin,\r\n    slab_ymax,\r\n    bar_start,\r\n    bar_end,\r\n    x,\r\n    top_z,\r\n    bottom_z\r\n):\r\n\r\n    # --------------------------------------------------------\r\n    # SLAB SPAN\r\n    # --------------------------------------------------------\r\n\r\n    L = (\r\n        slab_ymax\r\n        -\r\n        slab_ymin\r\n    )\r\n\r\n\r\n    quarter = (\r\n        L / 4.0\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # 45 DEGREE CRANK\r\n    # --------------------------------------------------------\r\n\r\n    vertical_drop = abs(\r\n        top_z\r\n        -\r\n        bottom_z\r\n    )\r\n\r\n\r\n    crank_run = vertical_drop\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # POINTS\r\n    # --------------------------------------------------------\r\n\r\n    y1 = bar_start\r\n\r\n\r\n    y2 = (\r\n        slab_ymin\r\n        +\r\n        quarter\r\n    )\r\n\r\n\r\n    y3 = (\r\n        y2\r\n        +\r\n        crank_run\r\n    )\r\n\r\n\r\n    y5 = (\r\n        slab_ymax\r\n        -\r\n        quarter\r\n    )\r\n\r\n\r\n    y4 = (\r\n        y5\r\n        -\r\n        crank_run\r\n    )\r\n\r\n\r\n    y6 = bar_end\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # VALIDATE\r\n    # --------------------------------------------------------\r\n\r\n    if y1 >= y2:\r\n        return None\r\n\r\n\r\n    if y3 >= y4:\r\n        return None\r\n\r\n\r\n    if y5 >= y6:\r\n        return None\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CREATE POINTS\r\n    # --------------------------------------------------------\r\n\r\n    return [\r\n\r\n        XYZ(\r\n            x,\r\n            y1,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x,\r\n            y2,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x,\r\n            y3,\r\n            bottom_z\r\n        ),\r\n\r\n        XYZ(\r\n            x,\r\n            y4,\r\n            bottom_z\r\n        ),\r\n\r\n        XYZ(\r\n            x,\r\n            y5,\r\n            top_z\r\n        ),\r\n\r\n        XYZ(\r\n            x,\r\n            y6,\r\n            top_z\r\n        )\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# INPUTS\r\n# ============================================================\r\n\r\n# IN[0] = S03 MATH OUTPUT\r\n# IN[1] = S04 BEAM DETECTION OUTPUT\r\n\r\nS03 = IN[0]\r\nS04 = IN[1]\r\n\r\n\r\n# ============================================================\r\n# OUTPUT STORAGE\r\n# ============================================================\r\n\r\nareas = []\r\n\r\nlong_cranked_sets = []\r\n\r\nshort_cranked_sets = []\r\n\r\nerrors = []\r\n\r\nwarnings = []\r\n\r\nreport = []\r\n\r\n\r\n# ============================================================\r\n# VALIDATE S03\r\n# ============================================================\r\n\r\nif not read_key(\r\n    S03,\r\n    \"Valid\",\r\n    False\r\n):\r\n\r\n    errors.append(\r\n        \"S03 OUTPUT IS NOT VALID\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# BEAM DETECTION STATUS\r\n# ============================================================\r\n\r\nif S04 is None:\r\n\r\n    warnings.append(\r\n        \"S04 BEAM DETECTION IS NONE. \"\r\n        \"CRANK ENDS WILL USE SLAB EDGES.\"\r\n    )\r\n\r\n\r\nelif not read_key(\r\n    S04,\r\n    \"Valid\",\r\n    False\r\n):\r\n\r\n    warnings.append(\r\n        \"S04 BEAM DETECTION IS NOT VALID. \"\r\n        \"MISSING SUPPORTS WILL USE SLAB EDGES.\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# GET SLABS FROM S03\r\n# ============================================================\r\n\r\nslabs = as_list(\r\n    read_key(\r\n        S03,\r\n        \"Slabs\",\r\n        None\r\n    )\r\n)\r\n\r\n\r\nif len(slabs) == 0:\r\n\r\n    errors.append(\r\n        \"NO SLABS RECEIVED FROM S03\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# START TRANSACTION\r\n# ============================================================\r\n\r\nif len(errors) == 0:\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # AREA REINFORCEMENT TYPE\r\n    # ========================================================\r\n\r\n    area_type_id = get_or_create_area_type()\r\n\r\n\r\n    if (\r\n        area_type_id is None\r\n        or area_type_id == ElementId.InvalidElementId\r\n    ):\r\n\r\n        errors.append(\r\n            \"FAILED TO GET OR CREATE AREA REINFORCEMENT TYPE\"\r\n        )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS EACH SLAB\r\n    # ========================================================\r\n\r\n    if len(errors) == 0:\r\n\r\n        for slab_data in slabs:\r\n\r\n            floor_id = \"UNKNOWN\"\r\n\r\n\r\n            try:\r\n\r\n                # =================================================\r\n                # VALIDATE SLAB DATA\r\n                # =================================================\r\n\r\n                if not read_key(\r\n                    slab_data,\r\n                    \"Valid\",\r\n                    False\r\n                ):\r\n\r\n                    report.append(\r\n                        \"SKIPPED INVALID SLAB\"\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                # =================================================\r\n                # FLOOR\r\n                # =================================================\r\n\r\n                floor = read_key(\r\n                    slab_data,\r\n                    \"Floor\",\r\n                    None\r\n                )\r\n\r\n\r\n                if floor is None:\r\n\r\n                    errors.append(\r\n                        \"FLOOR IS NONE\"\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                floor = unwrap(\r\n                    floor\r\n                )\r\n\r\n\r\n                floor_id = id_value(\r\n                    floor\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # BAR DIAMETER\r\n                # =================================================\r\n\r\n                diameter_mm = read_key(\r\n                    slab_data,\r\n                    \"BarDiameter_mm\",\r\n                    None\r\n                )\r\n\r\n\r\n                if diameter_mm is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | BarDiameter_mm is NONE\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                bar_type = find_bar_type(\r\n                    diameter_mm\r\n                )\r\n\r\n\r\n                if bar_type is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Cannot find D{} mm RebarBarType\".format(\r\n                            floor_id,\r\n                            diameter_mm\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                # =================================================\r\n                # SLAB GEOMETRY\r\n                # =================================================\r\n\r\n                slab = read_key(\r\n                    slab_data,\r\n                    \"Slab\",\r\n                    None\r\n                )\r\n\r\n\r\n                if slab is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Slab geometry is NONE\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                xmin = read_key(\r\n                    slab,\r\n                    \"XMin\",\r\n                    None\r\n                )\r\n\r\n\r\n                xmax = read_key(\r\n                    slab,\r\n                    \"XMax\",\r\n                    None\r\n                )\r\n\r\n\r\n                ymin = read_key(\r\n                    slab,\r\n                    \"YMin\",\r\n                    None\r\n                )\r\n\r\n\r\n                ymax = read_key(\r\n                    slab,\r\n                    \"YMax\",\r\n                    None\r\n                )\r\n\r\n\r\n                long_axis = read_key(\r\n                    slab,\r\n                    \"LongAxis\",\r\n                    None\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # REINFORCEMENT DATA\r\n                # =================================================\r\n\r\n                bottom_long = read_key(\r\n                    slab_data,\r\n                    \"BottomLong\",\r\n                    None\r\n                )\r\n\r\n\r\n                bottom_short = read_key(\r\n                    slab_data,\r\n                    \"BottomShort\",\r\n                    None\r\n                )\r\n\r\n\r\n                top_long = read_key(\r\n                    slab_data,\r\n                    \"TopLong\",\r\n                    None\r\n                )\r\n\r\n\r\n                top_short = read_key(\r\n                    slab_data,\r\n                    \"TopShort\",\r\n                    None\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # SPACING\r\n                # =================================================\r\n\r\n                BL_spacing_mm = read_key(\r\n                    bottom_long,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n\r\n\r\n                BS_spacing_mm = read_key(\r\n                    bottom_short,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # S03 BOTTOM Z\r\n                #\r\n                # USED ONLY AS FALLBACK IF ACTUAL AREA REBAR\r\n                # CENTERLINE CANNOT BE READ.\r\n                # =================================================\r\n\r\n                S03_BL_z = read_key(\r\n                    bottom_long,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n\r\n\r\n                S03_BS_z = read_key(\r\n                    bottom_short,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # TOP LEVELS\r\n                # =================================================\r\n\r\n                TL_top_z = read_key(\r\n                    top_long,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n\r\n\r\n                TS_top_z = read_key(\r\n                    top_short,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # VALIDATE REQUIRED DATA\r\n                # =================================================\r\n\r\n                required = [\r\n\r\n                    (\"XMin\", xmin),\r\n                    (\"XMax\", xmax),\r\n\r\n                    (\"YMin\", ymin),\r\n                    (\"YMax\", ymax),\r\n\r\n                    (\r\n                        \"Bottom Long Spacing\",\r\n                        BL_spacing_mm\r\n                    ),\r\n\r\n                    (\r\n                        \"Bottom Short Spacing\",\r\n                        BS_spacing_mm\r\n                    ),\r\n\r\n                    (\r\n                        \"Top Long Z\",\r\n                        TL_top_z\r\n                    ),\r\n\r\n                    (\r\n                        \"Top Short Z\",\r\n                        TS_top_z\r\n                    )\r\n                ]\r\n\r\n\r\n                missing = False\r\n\r\n\r\n                for name, value in required:\r\n\r\n                    if value is None:\r\n\r\n                        errors.append(\r\n                            \"Floor {} | {} is NONE\".format(\r\n                                floor_id,\r\n                                name\r\n                            )\r\n                        )\r\n\r\n                        missing = True\r\n\r\n\r\n                if missing:\r\n                    continue\r\n\r\n\r\n                # =================================================\r\n                # CONVERT SPACING TO REVIT INTERNAL UNITS\r\n                # =================================================\r\n\r\n                BL_spacing = mm_to_ft(\r\n                    BL_spacing_mm\r\n                )\r\n\r\n\r\n                BS_spacing = mm_to_ft(\r\n                    BS_spacing_mm\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # AREA REINFORCEMENT MAJOR DIRECTION\r\n                # =================================================\r\n\r\n                if long_axis == \"X\":\r\n\r\n                    major_direction = XYZ.BasisX\r\n\r\n\r\n                elif long_axis == \"Y\":\r\n\r\n                    major_direction = XYZ.BasisY\r\n\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Invalid LongAxis = {}\".format(\r\n                            floor_id,\r\n                            long_axis\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                # =================================================\r\n                # STEP 1\r\n                #\r\n                # CREATE BOTTOM AREA REINFORCEMENT\r\n                #\r\n                # THIS CREATES:\r\n                #\r\n                # BOTTOM LONG\r\n                # BOTTOM SHORT\r\n                #\r\n                # AT THEIR FULL INPUT SPACING.\r\n                # =================================================\r\n\r\n                area = create_bottom_area(\r\n                    floor,\r\n                    area_type_id,\r\n                    bar_type,\r\n                    major_direction,\r\n                    BL_spacing,\r\n                    BS_spacing\r\n                )\r\n\r\n\r\n                if area is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Bottom Area Reinforcement creation failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                areas.append(\r\n                    area\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # STEP 2\r\n                #\r\n                # FORCE REVIT TO GENERATE AREA SYSTEM BARS\r\n                # =================================================\r\n\r\n                doc.Regenerate()\r\n\r\n\r\n                # =================================================\r\n                # STEP 3\r\n                #\r\n                # READ ACTUAL BOTTOM AREA REBAR CENTERLINE Z\r\n                # =================================================\r\n\r\n                (\r\n                    actual_long_bottom_z,\r\n                    actual_short_bottom_z,\r\n                    system_bar_count\r\n                ) = get_actual_area_z(\r\n                    area,\r\n                    long_axis\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # FALLBACK TO S03 IF NEEDED\r\n                # =================================================\r\n\r\n                if actual_long_bottom_z is None:\r\n\r\n                    actual_long_bottom_z = S03_BL_z\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | Actual Bottom Long Area Z not found; S03 fallback used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                if actual_short_bottom_z is None:\r\n\r\n                    actual_short_bottom_z = S03_BS_z\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | Actual Bottom Short Area Z not found; S03 fallback used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                if actual_long_bottom_z is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Cannot determine Bottom Long Z\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                if actual_short_bottom_z is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Cannot determine Bottom Short Z\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    continue\r\n\r\n\r\n                # =================================================\r\n                # STEP 4\r\n                #\r\n                # MATCH THIS FLOOR WITH S04 BEAM DETECTION\r\n                # =================================================\r\n\r\n                support_data = find_support_data(\r\n                    S04,\r\n                    floor_id\r\n                )\r\n\r\n\r\n                if support_data is None:\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | No matching S04 support data; slab edges used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # =================================================\r\n                # XMIN SUPPORT\r\n                # =================================================\r\n\r\n                (\r\n                    x_start,\r\n                    xmin_found,\r\n                    xmin_beam_id\r\n                ) = get_support_centerline(\r\n                    support_data,\r\n                    \"XMin\",\r\n                    xmin\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # XMAX SUPPORT\r\n                # =================================================\r\n\r\n                (\r\n                    x_end,\r\n                    xmax_found,\r\n                    xmax_beam_id\r\n                ) = get_support_centerline(\r\n                    support_data,\r\n                    \"XMax\",\r\n                    xmax\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # YMIN SUPPORT\r\n                # =================================================\r\n\r\n                (\r\n                    y_start,\r\n                    ymin_found,\r\n                    ymin_beam_id\r\n                ) = get_support_centerline(\r\n                    support_data,\r\n                    \"YMin\",\r\n                    ymin\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # YMAX SUPPORT\r\n                # =================================================\r\n\r\n                (\r\n                    y_end,\r\n                    ymax_found,\r\n                    ymax_beam_id\r\n                ) = get_support_centerline(\r\n                    support_data,\r\n                    \"YMax\",\r\n                    ymax\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # SUPPORT SAFETY CHECK\r\n                #\r\n                # XMIN beam should be at or outside XMIN.\r\n                # XMAX beam should be at or outside XMAX.\r\n                #\r\n                # YMIN beam should be at or outside YMIN.\r\n                # YMAX beam should be at or outside YMAX.\r\n                #\r\n                # If detector gives a centerline inside the slab,\r\n                # reject it.\r\n                # =================================================\r\n\r\n                if x_start > xmin:\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | XMin beam centerline is inside slab; slab edge used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    x_start = xmin\r\n                    xmin_found = False\r\n\r\n\r\n                if x_end < xmax:\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | XMax beam centerline is inside slab; slab edge used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    x_end = xmax\r\n                    xmax_found = False\r\n\r\n\r\n                if y_start > ymin:\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | YMin beam centerline is inside slab; slab edge used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    y_start = ymin\r\n                    ymin_found = False\r\n\r\n\r\n                if y_end < ymax:\r\n\r\n                    warnings.append(\r\n                        \"Floor {} | YMax beam centerline is inside slab; slab edge used\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n                    y_end = ymax\r\n                    ymax_found = False\r\n\r\n\r\n                # =================================================\r\n                # STEP 5\r\n                #\r\n                # CRANK DISTRIBUTION OFFSET\r\n                #\r\n                # BOTTOM:\r\n                #\r\n                # B   B   B   B\r\n                #\r\n                # CRANK:\r\n                #\r\n                #   C   C   C\r\n                #\r\n                # OFFSET = S/2\r\n                # =================================================\r\n\r\n                long_offset = (\r\n                    BL_spacing / 2.0\r\n                )\r\n\r\n\r\n                short_offset = (\r\n                    BS_spacing / 2.0\r\n                )\r\n\r\n\r\n                # =================================================\r\n                # STEP 6\r\n                #\r\n                # LONG CRANKED SET\r\n                # =================================================\r\n\r\n                if long_axis == \"X\":\r\n\r\n                    # ------------------------------------------------\r\n                    # LONG BARS RUN X\r\n                    #\r\n                    # Distribution runs Y.\r\n                    # ------------------------------------------------\r\n\r\n                    long_y = (\r\n                        ymin\r\n                        +\r\n                        long_offset\r\n                    )\r\n\r\n\r\n                    long_points = build_x_crank(\r\n                        xmin,\r\n                        xmax,\r\n\r\n                        # Beam centerline extensions\r\n                        x_start,\r\n                        x_end,\r\n\r\n                        long_y,\r\n\r\n                        TL_top_z,\r\n\r\n                        # Actual Bottom Long Area Rebar Z\r\n                        actual_long_bottom_z\r\n                    )\r\n\r\n\r\n                    long_normal = XYZ.BasisY\r\n\r\n\r\n                    long_distribution = (\r\n                        ymax\r\n                        -\r\n                        long_y\r\n                    )\r\n\r\n\r\n                else:\r\n\r\n                    # ------------------------------------------------\r\n                    # LONG BARS RUN Y\r\n                    #\r\n                    # Distribution runs X.\r\n                    # ------------------------------------------------\r\n\r\n                    long_x = (\r\n                        xmin\r\n                        +\r\n                        long_offset\r\n                    )\r\n\r\n\r\n                    long_points = build_y_crank(\r\n                        ymin,\r\n                        ymax,\r\n\r\n                        # Beam centerline extensions\r\n                        y_start,\r\n                        y_end,\r\n\r\n                        long_x,\r\n\r\n                        TL_top_z,\r\n\r\n                        # Actual Bottom Long Area Rebar Z\r\n                        actual_long_bottom_z\r\n                    )\r\n\r\n\r\n                    long_normal = XYZ.BasisX\r\n\r\n\r\n                    long_distribution = (\r\n                        xmax\r\n                        -\r\n                        long_x\r\n                    )\r\n\r\n\r\n                # =================================================\r\n                # CREATE LONG CRANKED BAR SET\r\n                # =================================================\r\n\r\n                if long_points is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Invalid LONG crank geometry\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                else:\r\n\r\n                    long_rebar = create_cranked_bar(\r\n                        floor,\r\n                        bar_type,\r\n                        long_points,\r\n                        long_normal\r\n                    )\r\n\r\n\r\n                    if long_rebar is None:\r\n\r\n                        errors.append(\r\n                            \"Floor {} | Long cranked rebar creation failed\".format(\r\n                                floor_id\r\n                            )\r\n                        )\r\n\r\n\r\n                    else:\r\n\r\n                        long_layout_ok = apply_layout(\r\n                            long_rebar,\r\n                            BL_spacing,\r\n                            long_distribution\r\n                        )\r\n\r\n\r\n                        if long_layout_ok:\r\n\r\n                            long_cranked_sets.append(\r\n                                long_rebar\r\n                            )\r\n\r\n\r\n                        else:\r\n\r\n                            errors.append(\r\n                                \"Floor {} | Long cranked rebar layout failed\".format(\r\n                                    floor_id\r\n                                )\r\n                            )\r\n\r\n\r\n                # =================================================\r\n                # STEP 7\r\n                #\r\n                # SHORT CRANKED SET\r\n                # =================================================\r\n\r\n                if long_axis == \"X\":\r\n\r\n                    # ------------------------------------------------\r\n                    # SHORT BARS RUN Y\r\n                    #\r\n                    # Distribution runs X.\r\n                    # ------------------------------------------------\r\n\r\n                    short_x = (\r\n                        xmin\r\n                        +\r\n                        short_offset\r\n                    )\r\n\r\n\r\n                    short_points = build_y_crank(\r\n                        ymin,\r\n                        ymax,\r\n\r\n                        # Beam centerline extensions\r\n                        y_start,\r\n                        y_end,\r\n\r\n                        short_x,\r\n\r\n                        TS_top_z,\r\n\r\n                        # Actual Bottom Short Area Rebar Z\r\n                        actual_short_bottom_z\r\n                    )\r\n\r\n\r\n                    short_normal = XYZ.BasisX\r\n\r\n\r\n                    short_distribution = (\r\n                        xmax\r\n                        -\r\n                        short_x\r\n                    )\r\n\r\n\r\n                else:\r\n\r\n                    # ------------------------------------------------\r\n                    # SHORT BARS RUN X\r\n                    #\r\n                    # Distribution runs Y.\r\n                    # ------------------------------------------------\r\n\r\n                    short_y = (\r\n                        ymin\r\n                        +\r\n                        short_offset\r\n                    )\r\n\r\n\r\n                    short_points = build_x_crank(\r\n                        xmin,\r\n                        xmax,\r\n\r\n                        # Beam centerline extensions\r\n                        x_start,\r\n                        x_end,\r\n\r\n                        short_y,\r\n\r\n                        TS_top_z,\r\n\r\n                        # Actual Bottom Short Area Rebar Z\r\n                        actual_short_bottom_z\r\n                    )\r\n\r\n\r\n                    short_normal = XYZ.BasisY\r\n\r\n\r\n                    short_distribution = (\r\n                        ymax\r\n                        -\r\n                        short_y\r\n                    )\r\n\r\n\r\n                # =================================================\r\n                # CREATE SHORT CRANKED BAR SET\r\n                # =================================================\r\n\r\n                if short_points is None:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Invalid SHORT crank geometry\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                else:\r\n\r\n                    short_rebar = create_cranked_bar(\r\n                        floor,\r\n                        bar_type,\r\n                        short_points,\r\n                        short_normal\r\n                    )\r\n\r\n\r\n                    if short_rebar is None:\r\n\r\n                        errors.append(\r\n                            \"Floor {} | Short cranked rebar creation failed\".format(\r\n                                floor_id\r\n                            )\r\n                        )\r\n\r\n\r\n                    else:\r\n\r\n                        short_layout_ok = apply_layout(\r\n                            short_rebar,\r\n                            BS_spacing,\r\n                            short_distribution\r\n                        )\r\n\r\n\r\n                        if short_layout_ok:\r\n\r\n                            short_cranked_sets.append(\r\n                                short_rebar\r\n                            )\r\n\r\n\r\n                        else:\r\n\r\n                            errors.append(\r\n                                \"Floor {} | Short cranked rebar layout failed\".format(\r\n                                    floor_id\r\n                                )\r\n                            )\r\n\r\n\r\n                # =================================================\r\n                # REPORT\r\n                # =================================================\r\n\r\n                report.append(\r\n                    \"Floor {} | D{} | Area Bars={} | Bottom Long @ {} mm | Bottom Short @ {} mm\".format(\r\n                        floor_id,\r\n                        diameter_mm,\r\n                        system_bar_count,\r\n                        BL_spacing_mm,\r\n                        BS_spacing_mm\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | Bottom Long actual Z = {:.2f} mm\".format(\r\n                        floor_id,\r\n                        ft_to_mm(\r\n                            actual_long_bottom_z\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | Bottom Short actual Z = {:.2f} mm\".format(\r\n                        floor_id,\r\n                        ft_to_mm(\r\n                            actual_short_bottom_z\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | XMin | {} | Beam {} | Extension = {:.1f} mm\".format(\r\n                        floor_id,\r\n                        \"FOUND\" if xmin_found else \"FALLBACK\",\r\n                        xmin_beam_id,\r\n                        ft_to_mm(\r\n                            x_start - xmin\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | XMax | {} | Beam {} | Extension = {:.1f} mm\".format(\r\n                        floor_id,\r\n                        \"FOUND\" if xmax_found else \"FALLBACK\",\r\n                        xmax_beam_id,\r\n                        ft_to_mm(\r\n                            x_end - xmax\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | YMin | {} | Beam {} | Extension = {:.1f} mm\".format(\r\n                        floor_id,\r\n                        \"FOUND\" if ymin_found else \"FALLBACK\",\r\n                        ymin_beam_id,\r\n                        ft_to_mm(\r\n                            y_start - ymin\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n                report.append(\r\n                    \"Floor {} | YMax | {} | Beam {} | Extension = {:.1f} mm\".format(\r\n                        floor_id,\r\n                        \"FOUND\" if ymax_found else \"FALLBACK\",\r\n                        ymax_beam_id,\r\n                        ft_to_mm(\r\n                            y_end - ymax\r\n                        )\r\n                    )\r\n                )\r\n\r\n\r\n            except Exception as ex:\r\n\r\n                errors.append(\r\n                    \"Floor {} | ERROR | {}\".format(\r\n                        floor_id,\r\n                        str(ex)\r\n                    )\r\n                )\r\n\r\n\r\n    # ========================================================\r\n    # FINISH TRANSACTION\r\n    # ========================================================\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# ============================================================\r\n# FINAL OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n\r\n    \"Success\":\r\n        len(errors) == 0,\r\n\r\n    # --------------------------------------------------------\r\n    # BOTTOM REINFORCEMENT\r\n    # --------------------------------------------------------\r\n\r\n    \"BottomAreaCount\":\r\n        len(areas),\r\n\r\n    \"BottomAreas\":\r\n        areas,\r\n\r\n    # --------------------------------------------------------\r\n    # CRANKED REINFORCEMENT\r\n    # --------------------------------------------------------\r\n\r\n    \"LongCrankedSetCount\":\r\n        len(long_cranked_sets),\r\n\r\n    \"LongCrankedSets\":\r\n        long_cranked_sets,\r\n\r\n    \"ShortCrankedSetCount\":\r\n        len(short_cranked_sets),\r\n\r\n    \"ShortCrankedSets\":\r\n        short_cranked_sets,\r\n\r\n    # --------------------------------------------------------\r\n    # DIAGNOSTICS\r\n    # --------------------------------------------------------\r\n\r\n    \"Warnings\":\r\n        warnings,\r\n\r\n    \"Errors\":\r\n        errors,\r\n\r\n    \"Report\":\r\n        report\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "33edb473fdb84da9abee78758ac96f3e",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "bad79e569abf4d85af02b6a9832da0ae",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f5f4ca75c6cd4cb1aa0936a1d605a7fe",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "a030e1297db0418bb94366f80793f17b",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# ============================================================\r\n# SETTINGS\r\n# ============================================================\r\n\r\n# Maximum distance from slab edge to beam centerline\r\nSEARCH_TOLERANCE_MM = 500.0\r\n\r\n# Minimum overlap between beam and slab edge\r\nMIN_OVERLAP_MM = 100.0\r\n\r\n# Direction tolerance.\r\n# 0.90 means beam must be reasonably close to X or Y direction.\r\nDIRECTION_TOLERANCE = 0.90\r\n\r\n\r\n# ============================================================\r\n# UNIT HELPERS\r\n# ============================================================\r\n\r\ndef mm_to_ft(value):\r\n    return float(value) / 304.8\r\n\r\n\r\ndef ft_to_mm(value):\r\n    return float(value) * 304.8\r\n\r\n\r\nSEARCH_TOLERANCE = mm_to_ft(\r\n    SEARCH_TOLERANCE_MM\r\n)\r\n\r\nMIN_OVERLAP = mm_to_ft(\r\n    MIN_OVERLAP_MM\r\n)\r\n\r\n\r\n# ============================================================\r\n# GENERAL HELPERS\r\n# ============================================================\r\n\r\ndef read_key(data, key, default=None):\r\n\r\n    if data is None:\r\n        return default\r\n\r\n    try:\r\n        return data[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return data.get(key, default)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        keys = list(data.Keys)\r\n\r\n        for k in keys:\r\n\r\n            if str(k) == str(key):\r\n\r\n                try:\r\n                    return data[k]\r\n                except:\r\n                    pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return default\r\n\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n\r\n        if (\r\n            hasattr(value, \"__iter__\")\r\n            and not isinstance(value, str)\r\n        ):\r\n\r\n            return list(value)\r\n\r\n    except:\r\n        pass\r\n\r\n    return [value]\r\n\r\n\r\ndef unwrap(element):\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef get_id_value(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return element.Id.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return element.Id.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# GET FLOORS FROM S01\r\n# ============================================================\r\n\r\ndef get_floors_from_s01(data):\r\n\r\n    floors = []\r\n\r\n    # --------------------------------------------------------\r\n    # CASE 1\r\n    # S01 output itself is a list of floors\r\n    # --------------------------------------------------------\r\n\r\n    raw = as_list(data)\r\n\r\n    for item in raw:\r\n\r\n        element = unwrap(item)\r\n\r\n        try:\r\n\r\n            if isinstance(element, Floor):\r\n                floors.append(element)\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if len(floors) > 0:\r\n        return floors\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CASE 2\r\n    # Dictionary output\r\n    # --------------------------------------------------------\r\n\r\n    possible_keys = [\r\n        \"Floors\",\r\n        \"Slabs\",\r\n        \"SelectedFloors\",\r\n        \"SelectedSlabs\",\r\n        \"Elements\",\r\n        \"SelectedElements\"\r\n    ]\r\n\r\n\r\n    for key in possible_keys:\r\n\r\n        values = read_key(\r\n            data,\r\n            key,\r\n            None\r\n        )\r\n\r\n        if values is None:\r\n            continue\r\n\r\n\r\n        for item in as_list(values):\r\n\r\n            # Sometimes item itself is a dictionary\r\n            candidate = read_key(\r\n                item,\r\n                \"Floor\",\r\n                item\r\n            )\r\n\r\n            candidate = unwrap(\r\n                candidate\r\n            )\r\n\r\n\r\n            try:\r\n\r\n                if isinstance(candidate, Floor):\r\n\r\n                    if candidate not in floors:\r\n                        floors.append(candidate)\r\n\r\n            except:\r\n                pass\r\n\r\n\r\n    return floors\r\n\r\n\r\n# ============================================================\r\n# FLOOR BOUNDING BOX\r\n# ============================================================\r\n\r\ndef get_floor_bounds(floor):\r\n\r\n    try:\r\n\r\n        bbox = floor.get_BoundingBox(\r\n            None\r\n        )\r\n\r\n        if bbox is None:\r\n            return None\r\n\r\n\r\n        return {\r\n\r\n            \"XMin\": bbox.Min.X,\r\n            \"XMax\": bbox.Max.X,\r\n\r\n            \"YMin\": bbox.Min.Y,\r\n            \"YMax\": bbox.Max.Y,\r\n\r\n            \"ZMin\": bbox.Min.Z,\r\n            \"ZMax\": bbox.Max.Z\r\n        }\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# GET ALL STRUCTURAL FRAMING\r\n# ============================================================\r\n\r\ndef get_all_beams():\r\n\r\n    result = []\r\n\r\n\r\n    collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(\r\n            BuiltInCategory.OST_StructuralFraming\r\n        )\r\n        .WhereElementIsNotElementType()\r\n    )\r\n\r\n\r\n    for element in collector:\r\n\r\n        try:\r\n\r\n            location = element.Location\r\n\r\n            if not isinstance(\r\n                location,\r\n                LocationCurve\r\n            ):\r\n                continue\r\n\r\n\r\n            curve = location.Curve\r\n\r\n            if curve is None:\r\n                continue\r\n\r\n\r\n            result.append(\r\n                element\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# GET BEAM GEOMETRY\r\n# ============================================================\r\n\r\ndef get_beam_data(beam):\r\n\r\n    try:\r\n\r\n        location = beam.Location\r\n\r\n        if not isinstance(\r\n            location,\r\n            LocationCurve\r\n        ):\r\n            return None\r\n\r\n\r\n        curve = location.Curve\r\n\r\n\r\n        p0 = curve.GetEndPoint(0)\r\n        p1 = curve.GetEndPoint(1)\r\n\r\n\r\n        dx = p1.X - p0.X\r\n        dy = p1.Y - p0.Y\r\n\r\n\r\n        horizontal_length = math.sqrt(\r\n            dx * dx +\r\n            dy * dy\r\n        )\r\n\r\n\r\n        if horizontal_length < 0.000001:\r\n            return None\r\n\r\n\r\n        ux = dx / horizontal_length\r\n        uy = dy / horizontal_length\r\n\r\n\r\n        # ----------------------------------------------------\r\n        # DETERMINE PRIMARY DIRECTION\r\n        # ----------------------------------------------------\r\n\r\n        direction = None\r\n\r\n\r\n        if abs(ux) >= DIRECTION_TOLERANCE:\r\n\r\n            direction = \"X\"\r\n\r\n\r\n        elif abs(uy) >= DIRECTION_TOLERANCE:\r\n\r\n            direction = \"Y\"\r\n\r\n\r\n        else:\r\n\r\n            # Diagonal beam.\r\n            # Ignore for this rectangular slab detector.\r\n            return None\r\n\r\n\r\n        return {\r\n\r\n            \"Beam\": beam,\r\n\r\n            \"BeamId\":\r\n                get_id_value(beam),\r\n\r\n            \"P0\": p0,\r\n            \"P1\": p1,\r\n\r\n            \"Direction\":\r\n                direction,\r\n\r\n            \"CenterX\":\r\n                (p0.X + p1.X) / 2.0,\r\n\r\n            \"CenterY\":\r\n                (p0.Y + p1.Y) / 2.0,\r\n\r\n            \"XMin\":\r\n                min(p0.X, p1.X),\r\n\r\n            \"XMax\":\r\n                max(p0.X, p1.X),\r\n\r\n            \"YMin\":\r\n                min(p0.Y, p1.Y),\r\n\r\n            \"YMax\":\r\n                max(p0.Y, p1.Y),\r\n\r\n            \"Z\":\r\n                (p0.Z + p1.Z) / 2.0\r\n        }\r\n\r\n    except:\r\n\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# RANGE OVERLAP\r\n# ============================================================\r\n\r\ndef range_overlap(\r\n    a_min,\r\n    a_max,\r\n    b_min,\r\n    b_max\r\n):\r\n\r\n    return max(\r\n        0.0,\r\n        min(a_max, b_max)\r\n        -\r\n        max(a_min, b_min)\r\n    )\r\n\r\n\r\n# ============================================================\r\n# EMPTY SUPPORT RESULT\r\n# ============================================================\r\n\r\ndef empty_support(side):\r\n\r\n    return {\r\n\r\n        \"Side\":\r\n            side,\r\n\r\n        \"Found\":\r\n            False,\r\n\r\n        \"Beam\":\r\n            None,\r\n\r\n        \"BeamId\":\r\n            None,\r\n\r\n        \"BeamDirection\":\r\n            None,\r\n\r\n        \"SlabEdge_ft\":\r\n            None,\r\n\r\n        \"BeamCenterline_ft\":\r\n            None,\r\n\r\n        \"Extension_ft\":\r\n            None,\r\n\r\n        \"SlabEdge_mm\":\r\n            None,\r\n\r\n        \"BeamCenterline_mm\":\r\n            None,\r\n\r\n        \"Extension_mm\":\r\n            None,\r\n\r\n        \"Overlap_mm\":\r\n            None,\r\n\r\n        \"Reason\":\r\n            \"No valid supporting beam found\"\r\n    }\r\n\r\n\r\n# ============================================================\r\n# FIND SUPPORT FOR ONE SIDE\r\n# ============================================================\r\n\r\ndef find_support(\r\n    side,\r\n    bounds,\r\n    beam_data_list\r\n):\r\n\r\n    result = empty_support(\r\n        side\r\n    )\r\n\r\n\r\n    xmin = bounds[\"XMin\"]\r\n    xmax = bounds[\"XMax\"]\r\n\r\n    ymin = bounds[\"YMin\"]\r\n    ymax = bounds[\"YMax\"]\r\n\r\n\r\n    best = None\r\n    best_distance = None\r\n    best_overlap = None\r\n\r\n\r\n    # ========================================================\r\n    # XMIN / XMAX\r\n    #\r\n    # Supporting beam should run Y.\r\n    # ========================================================\r\n\r\n    if side == \"XMin\" or side == \"XMax\":\r\n\r\n        if side == \"XMin\":\r\n            slab_edge = xmin\r\n\r\n        else:\r\n            slab_edge = xmax\r\n\r\n\r\n        for data in beam_data_list:\r\n\r\n            if data[\"Direction\"] != \"Y\":\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Beam X centerline\r\n            # ------------------------------------------------\r\n\r\n            beam_center = data[\r\n                \"CenterX\"\r\n            ]\r\n\r\n\r\n            distance = abs(\r\n                beam_center\r\n                -\r\n                slab_edge\r\n            )\r\n\r\n\r\n            if distance > SEARCH_TOLERANCE:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Check beam overlaps slab in Y\r\n            # ------------------------------------------------\r\n\r\n            overlap = range_overlap(\r\n                ymin,\r\n                ymax,\r\n                data[\"YMin\"],\r\n                data[\"YMax\"]\r\n            )\r\n\r\n\r\n            if overlap < MIN_OVERLAP:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Closest valid beam wins\r\n            # ------------------------------------------------\r\n\r\n            if (\r\n                best_distance is None\r\n                or distance < best_distance\r\n            ):\r\n\r\n                best = data\r\n                best_distance = distance\r\n                best_overlap = overlap\r\n\r\n\r\n    # ========================================================\r\n    # YMIN / YMAX\r\n    #\r\n    # Supporting beam should run X.\r\n    # ========================================================\r\n\r\n    elif side == \"YMin\" or side == \"YMax\":\r\n\r\n        if side == \"YMin\":\r\n            slab_edge = ymin\r\n\r\n        else:\r\n            slab_edge = ymax\r\n\r\n\r\n        for data in beam_data_list:\r\n\r\n            if data[\"Direction\"] != \"X\":\r\n                continue\r\n\r\n\r\n            beam_center = data[\r\n                \"CenterY\"\r\n            ]\r\n\r\n\r\n            distance = abs(\r\n                beam_center\r\n                -\r\n                slab_edge\r\n            )\r\n\r\n\r\n            if distance > SEARCH_TOLERANCE:\r\n                continue\r\n\r\n\r\n            # ------------------------------------------------\r\n            # Check beam overlaps slab in X\r\n            # ------------------------------------------------\r\n\r\n            overlap = range_overlap(\r\n                xmin,\r\n                xmax,\r\n                data[\"XMin\"],\r\n                data[\"XMax\"]\r\n            )\r\n\r\n\r\n            if overlap < MIN_OVERLAP:\r\n                continue\r\n\r\n\r\n            if (\r\n                best_distance is None\r\n                or distance < best_distance\r\n            ):\r\n\r\n                best = data\r\n                best_distance = distance\r\n                best_overlap = overlap\r\n\r\n\r\n    else:\r\n\r\n        result[\"Reason\"] = (\r\n            \"Unknown side\"\r\n        )\r\n\r\n        return result\r\n\r\n\r\n    # ========================================================\r\n    # NOTHING FOUND\r\n    # ========================================================\r\n\r\n    if best is None:\r\n\r\n        result[\"SlabEdge_ft\"] = (\r\n            slab_edge\r\n        )\r\n\r\n        result[\"SlabEdge_mm\"] = (\r\n            ft_to_mm(\r\n                slab_edge\r\n            )\r\n        )\r\n\r\n        return result\r\n\r\n\r\n    # ========================================================\r\n    # BEAM CENTERLINE\r\n    # ========================================================\r\n\r\n    if side == \"XMin\" or side == \"XMax\":\r\n\r\n        beam_centerline = best[\r\n            \"CenterX\"\r\n        ]\r\n\r\n    else:\r\n\r\n        beam_centerline = best[\r\n            \"CenterY\"\r\n        ]\r\n\r\n\r\n    # ========================================================\r\n    # SIGNED EXTENSION\r\n    #\r\n    # This is useful later for S05.\r\n    #\r\n    # Example:\r\n    #\r\n    # XMin slab edge = 10.000\r\n    # beam CL        = 9.850\r\n    #\r\n    # extension = -0.150\r\n    #\r\n    # XMax slab edge = 16.000\r\n    # beam CL        = 16.150\r\n    #\r\n    # extension = +0.150\r\n    # ========================================================\r\n\r\n    extension = (\r\n        beam_centerline\r\n        -\r\n        slab_edge\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # RESULT\r\n    # ========================================================\r\n\r\n    result = {\r\n\r\n        \"Side\":\r\n            side,\r\n\r\n        \"Found\":\r\n            True,\r\n\r\n        \"Beam\":\r\n            best[\"Beam\"],\r\n\r\n        \"BeamId\":\r\n            best[\"BeamId\"],\r\n\r\n        \"BeamDirection\":\r\n            best[\"Direction\"],\r\n\r\n        \"SlabEdge_ft\":\r\n            slab_edge,\r\n\r\n        \"BeamCenterline_ft\":\r\n            beam_centerline,\r\n\r\n        \"Extension_ft\":\r\n            extension,\r\n\r\n        \"SlabEdge_mm\":\r\n            ft_to_mm(\r\n                slab_edge\r\n            ),\r\n\r\n        \"BeamCenterline_mm\":\r\n            ft_to_mm(\r\n                beam_centerline\r\n            ),\r\n\r\n        \"Extension_mm\":\r\n            ft_to_mm(\r\n                extension\r\n            ),\r\n\r\n        \"Overlap_mm\":\r\n            ft_to_mm(\r\n                best_overlap\r\n            ),\r\n\r\n        \"Reason\":\r\n            (\r\n                \"Valid perpendicular beam; \"\r\n                \"overlaps slab; \"\r\n                \"centerline distance = \"\r\n                \"{:.1f} mm\"\r\n            ).format(\r\n                abs(\r\n                    ft_to_mm(\r\n                        extension\r\n                    )\r\n                )\r\n            )\r\n    }\r\n\r\n\r\n    return result\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\n# IN[0] = S01 OUTPUT\r\n\r\nS01 = IN[0]\r\n\r\n\r\n# ============================================================\r\n# OUTPUT STORAGE\r\n# ============================================================\r\n\r\nerrors = []\r\n\r\nreport = []\r\n\r\nslab_supports = []\r\n\r\n\r\n# ============================================================\r\n# GET SELECTED FLOORS\r\n# ============================================================\r\n\r\nfloors = get_floors_from_s01(\r\n    S01\r\n)\r\n\r\n\r\nif len(floors) == 0:\r\n\r\n    errors.append(\r\n        \"NO FLOOR ELEMENTS FOUND IN S01 OUTPUT\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# COLLECT BEAMS\r\n# ============================================================\r\n\r\nall_beams = get_all_beams()\r\n\r\n\r\nbeam_data_list = []\r\n\r\n\r\nfor beam in all_beams:\r\n\r\n    data = get_beam_data(\r\n        beam\r\n    )\r\n\r\n    if data is not None:\r\n        beam_data_list.append(\r\n            data\r\n        )\r\n\r\n\r\n# ============================================================\r\n# PROCESS FLOORS\r\n# ============================================================\r\n\r\nfor floor in floors:\r\n\r\n    floor_id = get_id_value(\r\n        floor\r\n    )\r\n\r\n\r\n    try:\r\n\r\n        bounds = get_floor_bounds(\r\n            floor\r\n        )\r\n\r\n\r\n        if bounds is None:\r\n\r\n            errors.append(\r\n                \"Floor {} | Cannot get bounding box\".format(\r\n                    floor_id\r\n                )\r\n            )\r\n\r\n            continue\r\n\r\n\r\n        # ====================================================\r\n        # FIND FOUR SUPPORTS\r\n        # ====================================================\r\n\r\n        support_xmin = find_support(\r\n            \"XMin\",\r\n            bounds,\r\n            beam_data_list\r\n        )\r\n\r\n\r\n        support_xmax = find_support(\r\n            \"XMax\",\r\n            bounds,\r\n            beam_data_list\r\n        )\r\n\r\n\r\n        support_ymin = find_support(\r\n            \"YMin\",\r\n            bounds,\r\n            beam_data_list\r\n        )\r\n\r\n\r\n        support_ymax = find_support(\r\n            \"YMax\",\r\n            bounds,\r\n            beam_data_list\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # COUNT\r\n        # ====================================================\r\n\r\n        supports = [\r\n            support_xmin,\r\n            support_xmax,\r\n            support_ymin,\r\n            support_ymax\r\n        ]\r\n\r\n\r\n        found_count = 0\r\n\r\n\r\n        for support in supports:\r\n\r\n            if support[\"Found\"]:\r\n                found_count += 1\r\n\r\n\r\n        # ====================================================\r\n        # STORE\r\n        # ====================================================\r\n\r\n        slab_result = {\r\n\r\n            \"Floor\":\r\n                floor,\r\n\r\n            \"FloorId\":\r\n                floor_id,\r\n\r\n            \"Bounds\":\r\n                bounds,\r\n\r\n            \"XMin\":\r\n                support_xmin,\r\n\r\n            \"XMax\":\r\n                support_xmax,\r\n\r\n            \"YMin\":\r\n                support_ymin,\r\n\r\n            \"YMax\":\r\n                support_ymax,\r\n\r\n            \"SupportsFound\":\r\n                found_count,\r\n\r\n            \"AllFourFound\":\r\n                found_count == 4\r\n        }\r\n\r\n\r\n        slab_supports.append(\r\n            slab_result\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # HUMAN READABLE REPORT\r\n        # ====================================================\r\n\r\n        report.append(\r\n            \"FLOOR {} | Supports {}/4\".format(\r\n                floor_id,\r\n                found_count\r\n            )\r\n        )\r\n\r\n\r\n        for support in supports:\r\n\r\n            if support[\"Found\"]:\r\n\r\n                report.append(\r\n                    \"{} | Beam {} | Extension = {:.1f} mm | Overlap = {:.1f} mm\".format(\r\n                        support[\"Side\"],\r\n                        support[\"BeamId\"],\r\n                        support[\"Extension_mm\"],\r\n                        support[\"Overlap_mm\"]\r\n                    )\r\n                )\r\n\r\n            else:\r\n\r\n                report.append(\r\n                    \"{} | NOT FOUND\".format(\r\n                        support[\"Side\"]\r\n                    )\r\n                )\r\n\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(\r\n            \"Floor {} | ERROR | {}\".format(\r\n                floor_id,\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n\r\n    \"Valid\":\r\n        (\r\n            len(errors) == 0\r\n            and len(slab_supports) > 0\r\n        ),\r\n\r\n    \"SelectedFloorCount\":\r\n        len(floors),\r\n\r\n    \"StructuralFramingCount\":\r\n        len(all_beams),\r\n\r\n    \"UsableBeamCount\":\r\n        len(beam_data_list),\r\n\r\n    \"Slabs\":\r\n        slab_supports,\r\n\r\n    \"Errors\":\r\n        errors,\r\n\r\n    \"Report\":\r\n        report\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "7e2d9ca42fa2420c8038f7562b94c007",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b5bdb2bda4384c5dbc42f885e758a5e8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "aca22aa86f8042a8aa6da82187b37a8a",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# ============================================================\r\n# REVIT SERVICES\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\n\r\n# ============================================================\r\n# .NET\r\n# ============================================================\r\n\r\nclr.AddReference(\"System\")\r\nfrom System.Collections.Generic import List\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMM_TO_FT = 1.0 / 304.8\r\nFT_TO_MM = 304.8\r\n\r\nTOLERANCE_FT = 1.0 / 304.8\r\n\r\n\r\n# ============================================================\r\n# UNIT HELPERS\r\n# ============================================================\r\n\r\ndef mm_to_ft(value):\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    return float(value) / 304.8\r\n\r\n\r\ndef ft_to_mm(value):\r\n\r\n    if value is None:\r\n        return None\r\n\r\n    return float(value) * 304.8\r\n\r\n\r\n# ============================================================\r\n# SAFE HELPERS\r\n# ============================================================\r\n\r\ndef read_key(data, key, default=None):\r\n\r\n    if data is None:\r\n        return default\r\n\r\n    try:\r\n        return data[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return data.get(key, default)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n\r\n        for k in list(data.Keys):\r\n\r\n            if str(k) == str(key):\r\n\r\n                try:\r\n                    return data[k]\r\n                except:\r\n                    pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return default\r\n\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n\r\n        if (\r\n            hasattr(value, \"__iter__\")\r\n            and not isinstance(value, str)\r\n        ):\r\n\r\n            return list(value)\r\n\r\n    except:\r\n        pass\r\n\r\n    return [value]\r\n\r\n\r\ndef unwrap(element):\r\n\r\n    try:\r\n        return UnwrapElement(element)\r\n    except:\r\n        return element\r\n\r\n\r\ndef safe_float(value, default=None):\r\n\r\n    if value is None:\r\n        return default\r\n\r\n    try:\r\n        return float(value)\r\n    except:\r\n        return default\r\n\r\n\r\ndef id_value(obj):\r\n\r\n    if obj is None:\r\n        return None\r\n\r\n    try:\r\n        return obj.Id.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.Id.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return obj.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return str(obj.Id)\r\n    except:\r\n        return None\r\n\r\n\r\ndef element_id_value(eid):\r\n\r\n    if eid is None:\r\n        return None\r\n\r\n    try:\r\n        return eid.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return eid.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return str(eid)\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# REBAR TYPE\r\n# ============================================================\r\n\r\ndef get_bar_diameter(bar_type):\r\n\r\n    try:\r\n\r\n        d = bar_type.BarModelDiameter\r\n\r\n        if d is not None:\r\n            return d\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        d = bar_type.BarNominalDiameter\r\n\r\n        if d is not None:\r\n            return d\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        p = bar_type.get_Parameter(\r\n            BuiltInParameter.REBAR_BAR_DIAMETER\r\n        )\r\n\r\n        if p is not None:\r\n            return p.AsDouble()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\ndef find_bar_type(diameter_mm):\r\n\r\n    target = mm_to_ft(\r\n        diameter_mm\r\n    )\r\n\r\n    tolerance = mm_to_ft(\r\n        0.5\r\n    )\r\n\r\n\r\n    collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(RebarBarType)\r\n        .ToElements()\r\n    )\r\n\r\n\r\n    best = None\r\n    best_diff = None\r\n\r\n\r\n    for bar_type in collector:\r\n\r\n        try:\r\n\r\n            actual = get_bar_diameter(\r\n                bar_type\r\n            )\r\n\r\n            if actual is None:\r\n                continue\r\n\r\n\r\n            diff = abs(\r\n                actual - target\r\n            )\r\n\r\n\r\n            if (\r\n                best_diff is None\r\n                or diff < best_diff\r\n            ):\r\n\r\n                best = bar_type\r\n                best_diff = diff\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if best is None:\r\n        return None\r\n\r\n\r\n    if best_diff is None:\r\n        return None\r\n\r\n\r\n    if best_diff > tolerance:\r\n        return None\r\n\r\n\r\n    return best\r\n\r\n\r\n# ============================================================\r\n# ORDINARY REBAR CLEANUP\r\n# ============================================================\r\n\r\ndef get_rebar_host_id(rebar):\r\n\r\n    try:\r\n\r\n        return rebar.GetHostId()\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    try:\r\n\r\n        return rebar.HostId\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    return None\r\n\r\n\r\ndef same_id(a, b):\r\n\r\n    if a is None or b is None:\r\n        return False\r\n\r\n    return str(\r\n        element_id_value(a)\r\n    ) == str(\r\n        element_id_value(b)\r\n    )\r\n\r\n\r\ndef clear_floor_rebar(floor):\r\n\r\n    deleted = 0\r\n    messages = []\r\n\r\n    floor_id = floor.Id\r\n\r\n    ids = {}\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # HOST DATA\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        host_data = RebarHostData.GetRebarHostData(\r\n            floor\r\n        )\r\n\r\n\r\n        if host_data is not None:\r\n\r\n            try:\r\n\r\n                host_rebars = host_data.GetRebarsInHost()\r\n\r\n\r\n                for eid in host_rebars:\r\n\r\n                    ids[\r\n                        str(\r\n                            element_id_value(eid)\r\n                        )\r\n                    ] = eid\r\n\r\n            except:\r\n                pass\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # GLOBAL FALLBACK\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n\r\n        all_rebars = (\r\n            FilteredElementCollector(doc)\r\n            .OfClass(Rebar)\r\n            .WhereElementIsNotElementType()\r\n            .ToElements()\r\n        )\r\n\r\n\r\n        for rebar in all_rebars:\r\n\r\n            try:\r\n\r\n                host_id = get_rebar_host_id(\r\n                    rebar\r\n                )\r\n\r\n\r\n                if same_id(\r\n                    host_id,\r\n                    floor_id\r\n                ):\r\n\r\n                    ids[\r\n                        str(id_value(rebar))\r\n                    ] = rebar.Id\r\n\r\n            except:\r\n                pass\r\n\r\n    except Exception as ex:\r\n\r\n        messages.append(\r\n            \"Rebar scan failed: {}\".format(\r\n                str(ex)\r\n            )\r\n        )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DELETE\r\n    # --------------------------------------------------------\r\n\r\n    for key in ids:\r\n\r\n        try:\r\n\r\n            eid = ids[key]\r\n\r\n\r\n            if doc.GetElement(eid) is None:\r\n                continue\r\n\r\n\r\n            doc.Delete(\r\n                eid\r\n            )\r\n\r\n\r\n            deleted += 1\r\n\r\n        except Exception as ex:\r\n\r\n            messages.append(\r\n                \"Delete {} failed: {}\".format(\r\n                    key,\r\n                    str(ex)\r\n                )\r\n            )\r\n\r\n\r\n    doc.Regenerate()\r\n\r\n\r\n    return (\r\n        deleted,\r\n        messages\r\n    )\r\n\r\n\r\n# ============================================================\r\n# S04 SUPPORT SEARCH\r\n# ============================================================\r\n\r\ndef get_s04_items(S04):\r\n\r\n    if S04 is None:\r\n        return []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # S04 MAY ALREADY BE A LIST\r\n    # --------------------------------------------------------\r\n\r\n    if isinstance(S04, list):\r\n        return S04\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # NORMAL DICTIONARY OUTPUT\r\n    # --------------------------------------------------------\r\n\r\n    slabs = read_key(\r\n        S04,\r\n        \"Slabs\",\r\n        None\r\n    )\r\n\r\n\r\n    if slabs is not None:\r\n        return as_list(slabs)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # OTHER POSSIBLE RESULT KEYS\r\n    # --------------------------------------------------------\r\n\r\n    results = read_key(\r\n        S04,\r\n        \"Results\",\r\n        None\r\n    )\r\n\r\n\r\n    if results is not None:\r\n        return as_list(results)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # POSSIBLY A SINGLE FLOOR RESULT\r\n    # --------------------------------------------------------\r\n\r\n    if read_key(\r\n        S04,\r\n        \"FloorId\",\r\n        None\r\n    ) is not None:\r\n\r\n        return [S04]\r\n\r\n\r\n    return []\r\n\r\n\r\ndef find_support_data(\r\n    S04,\r\n    floor_id\r\n):\r\n\r\n    items = get_s04_items(\r\n        S04\r\n    )\r\n\r\n\r\n    for item in items:\r\n\r\n        test_id = read_key(\r\n            item,\r\n            \"FloorId\",\r\n            None\r\n        )\r\n\r\n\r\n        if str(\r\n            test_id\r\n        ) == str(\r\n            floor_id\r\n        ):\r\n\r\n            return item\r\n\r\n\r\n    return None\r\n\r\n\r\n# ============================================================\r\n# SUPPORT CENTERLINE\r\n# ============================================================\r\n\r\ndef get_support_coordinate(\r\n    support_data,\r\n    side,\r\n    fallback\r\n):\r\n\r\n    if support_data is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            None\r\n        )\r\n\r\n\r\n    data = read_key(\r\n        support_data,\r\n        side,\r\n        None\r\n    )\r\n\r\n\r\n    if data is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            None\r\n        )\r\n\r\n\r\n    found = read_key(\r\n        data,\r\n        \"Found\",\r\n        False\r\n    )\r\n\r\n\r\n    beam_id = read_key(\r\n        data,\r\n        \"BeamId\",\r\n        None\r\n    )\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # ONLY TRUST SUPPORT WHEN FOUND = TRUE\r\n    # --------------------------------------------------------\r\n\r\n    if found is not True:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            beam_id\r\n        )\r\n\r\n\r\n    centerline = safe_float(\r\n        read_key(\r\n            data,\r\n            \"BeamCenterline_ft\",\r\n            None\r\n        )\r\n    )\r\n\r\n\r\n    if centerline is None:\r\n\r\n        return (\r\n            fallback,\r\n            False,\r\n            beam_id\r\n        )\r\n\r\n\r\n    return (\r\n        centerline,\r\n        True,\r\n        beam_id\r\n    )\r\n\r\n\r\n# ============================================================\r\n# CREATE STRAIGHT REBAR\r\n# ============================================================\r\n\r\ndef create_straight_rebar(\r\n    host,\r\n    bar_type,\r\n    p1,\r\n    p2,\r\n    normal\r\n):\r\n\r\n    try:\r\n\r\n        if p1.DistanceTo(p2) <= TOLERANCE_FT:\r\n            return None\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n    curves = List[Curve]()\r\n\r\n\r\n    curves.Add(\r\n        Line.CreateBound(\r\n            p1,\r\n            p2\r\n        )\r\n    )\r\n\r\n\r\n    try:\r\n\r\n        return Rebar.CreateFromCurves(\r\n            doc,\r\n            RebarStyle.Standard,\r\n            bar_type,\r\n            None,\r\n            None,\r\n            host,\r\n            normal,\r\n            curves,\r\n            RebarHookOrientation.Left,\r\n            RebarHookOrientation.Left,\r\n            True,\r\n            True\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# CREATE CRANKED REBAR\r\n# ============================================================\r\n\r\ndef create_cranked_rebar(\r\n    host,\r\n    bar_type,\r\n    points,\r\n    normal\r\n):\r\n\r\n    if points is None:\r\n        return None\r\n\r\n\r\n    if len(points) != 6:\r\n        return None\r\n\r\n\r\n    curves = List[Curve]()\r\n\r\n\r\n    for i in range(5):\r\n\r\n        p1 = points[i]\r\n        p2 = points[i + 1]\r\n\r\n\r\n        if p1.DistanceTo(p2) <= TOLERANCE_FT:\r\n            return None\r\n\r\n\r\n        curves.Add(\r\n            Line.CreateBound(\r\n                p1,\r\n                p2\r\n            )\r\n        )\r\n\r\n\r\n    try:\r\n\r\n        return Rebar.CreateFromCurves(\r\n            doc,\r\n            RebarStyle.Standard,\r\n            bar_type,\r\n            None,\r\n            None,\r\n            host,\r\n            normal,\r\n            curves,\r\n            RebarHookOrientation.Left,\r\n            RebarHookOrientation.Left,\r\n            True,\r\n            True\r\n        )\r\n\r\n    except:\r\n        return None\r\n\r\n\r\n# ============================================================\r\n# APPLY REBAR SET\r\n# ============================================================\r\n\r\ndef apply_layout(\r\n    rebar,\r\n    spacing,\r\n    length\r\n):\r\n\r\n    if rebar is None:\r\n        return False\r\n\r\n\r\n    if spacing is None:\r\n        return False\r\n\r\n\r\n    if length is None:\r\n        return False\r\n\r\n\r\n    if spacing <= 0:\r\n        return False\r\n\r\n\r\n    if length <= 0:\r\n        return False\r\n\r\n\r\n    try:\r\n\r\n        accessor = (\r\n            rebar.GetShapeDrivenAccessor()\r\n        )\r\n\r\n\r\n        accessor.SetLayoutAsMaximumSpacing(\r\n            spacing,\r\n            length,\r\n            True,\r\n            True,\r\n            True\r\n        )\r\n\r\n\r\n        return True\r\n\r\n    except:\r\n        return False\r\n\r\n\r\n# ============================================================\r\n# X CRANK\r\n# ============================================================\r\n\r\ndef build_x_crank(\r\n    xmin,\r\n    xmax,\r\n    support_min,\r\n    support_max,\r\n    y,\r\n    top_z,\r\n    bottom_z\r\n):\r\n\r\n    L = xmax - xmin\r\n\r\n\r\n    if L <= 0:\r\n        return None\r\n\r\n\r\n    quarter = L / 4.0\r\n\r\n\r\n    crank_run = abs(\r\n        top_z - bottom_z\r\n    )\r\n\r\n\r\n    x1 = support_min\r\n\r\n    x2 = xmin + quarter\r\n\r\n    x3 = x2 + crank_run\r\n\r\n    x5 = xmax - quarter\r\n\r\n    x4 = x5 - crank_run\r\n\r\n    x6 = support_max\r\n\r\n\r\n    if x1 >= x2:\r\n        return None\r\n\r\n    if x2 >= x3:\r\n        return None\r\n\r\n    if x3 >= x4:\r\n        return None\r\n\r\n    if x4 >= x5:\r\n        return None\r\n\r\n    if x5 >= x6:\r\n        return None\r\n\r\n\r\n    return [\r\n\r\n        XYZ(x1, y, top_z),\r\n\r\n        XYZ(x2, y, top_z),\r\n\r\n        XYZ(x3, y, bottom_z),\r\n\r\n        XYZ(x4, y, bottom_z),\r\n\r\n        XYZ(x5, y, top_z),\r\n\r\n        XYZ(x6, y, top_z)\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# Y CRANK\r\n# ============================================================\r\n\r\ndef build_y_crank(\r\n    ymin,\r\n    ymax,\r\n    support_min,\r\n    support_max,\r\n    x,\r\n    top_z,\r\n    bottom_z\r\n):\r\n\r\n    L = ymax - ymin\r\n\r\n\r\n    if L <= 0:\r\n        return None\r\n\r\n\r\n    quarter = L / 4.0\r\n\r\n\r\n    crank_run = abs(\r\n        top_z - bottom_z\r\n    )\r\n\r\n\r\n    y1 = support_min\r\n\r\n    y2 = ymin + quarter\r\n\r\n    y3 = y2 + crank_run\r\n\r\n    y5 = ymax - quarter\r\n\r\n    y4 = y5 - crank_run\r\n\r\n    y6 = support_max\r\n\r\n\r\n    if y1 >= y2:\r\n        return None\r\n\r\n    if y2 >= y3:\r\n        return None\r\n\r\n    if y3 >= y4:\r\n        return None\r\n\r\n    if y4 >= y5:\r\n        return None\r\n\r\n    if y5 >= y6:\r\n        return None\r\n\r\n\r\n    return [\r\n\r\n        XYZ(x, y1, top_z),\r\n\r\n        XYZ(x, y2, top_z),\r\n\r\n        XYZ(x, y3, bottom_z),\r\n\r\n        XYZ(x, y4, bottom_z),\r\n\r\n        XYZ(x, y5, top_z),\r\n\r\n        XYZ(x, y6, top_z)\r\n    ]\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n\r\nS03 = IN[0]\r\nS04 = IN[1]\r\n\r\n\r\n# ============================================================\r\n# OUTPUT STORAGE\r\n# ============================================================\r\n\r\nbottom_long_sets = []\r\nbottom_short_sets = []\r\n\r\ncrank_long_sets = []\r\ncrank_short_sets = []\r\n\r\nerrors = []\r\nwarnings = []\r\nreport = []\r\n\r\ndeleted_total = 0\r\n\r\n\r\n# ============================================================\r\n# S03 VALIDATION\r\n# ============================================================\r\n\r\nif not read_key(\r\n    S03,\r\n    \"Valid\",\r\n    False\r\n):\r\n\r\n    errors.append(\r\n        \"S03 OUTPUT IS NOT VALID\"\r\n    )\r\n\r\n\r\nslabs = as_list(\r\n    read_key(\r\n        S03,\r\n        \"Slabs\",\r\n        None\r\n    )\r\n)\r\n\r\n\r\nif len(slabs) == 0:\r\n\r\n    errors.append(\r\n        \"NO SLABS FROM S03\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# TRANSACTION\r\n# ============================================================\r\n\r\nif len(errors) == 0:\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(\r\n        doc\r\n    )\r\n\r\n\r\n    for slab_data in slabs:\r\n\r\n        floor_id = \"UNKNOWN\"\r\n\r\n\r\n        try:\r\n\r\n            # =================================================\r\n            # FLOOR\r\n            # =================================================\r\n\r\n            if not read_key(\r\n                slab_data,\r\n                \"Valid\",\r\n                False\r\n            ):\r\n\r\n                continue\r\n\r\n\r\n            floor = unwrap(\r\n                read_key(\r\n                    slab_data,\r\n                    \"Floor\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            if floor is None:\r\n\r\n                errors.append(\r\n                    \"Floor is NONE\"\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            floor_id = id_value(\r\n                floor\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # CLEAR OLD ORDINARY REBAR\r\n            # =================================================\r\n\r\n            deleted, clear_messages = (\r\n                clear_floor_rebar(\r\n                    floor\r\n                )\r\n            )\r\n\r\n\r\n            deleted_total += deleted\r\n\r\n\r\n            for msg in clear_messages:\r\n\r\n                warnings.append(\r\n                    \"Floor {} | {}\".format(\r\n                        floor_id,\r\n                        msg\r\n                    )\r\n                )\r\n\r\n\r\n            # =================================================\r\n            # BAR TYPE\r\n            # =================================================\r\n\r\n            diameter_mm = safe_float(\r\n                read_key(\r\n                    slab_data,\r\n                    \"BarDiameter_mm\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            if diameter_mm is None:\r\n\r\n                errors.append(\r\n                    \"Floor {} | Bar diameter missing\".format(\r\n                        floor_id\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            bar_type = find_bar_type(\r\n                diameter_mm\r\n            )\r\n\r\n\r\n            if bar_type is None:\r\n\r\n                errors.append(\r\n                    \"Floor {} | D{} bar type not found\".format(\r\n                        floor_id,\r\n                        diameter_mm\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            bar_diameter_ft = get_bar_diameter(bar_type)\r\n\r\n            if bar_diameter_ft is None or bar_diameter_ft <= 0:\r\n\r\n                errors.append(\r\n                    \"Floor {} | Could not read actual rebar diameter\".format(\r\n                        floor_id\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            # =================================================\r\n            # SLAB DATA\r\n            # =================================================\r\n\r\n            slab = read_key(\r\n                slab_data,\r\n                \"Slab\",\r\n                None\r\n            )\r\n\r\n\r\n            xmin = safe_float(\r\n                read_key(\r\n                    slab,\r\n                    \"XMin\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            xmax = safe_float(\r\n                read_key(\r\n                    slab,\r\n                    \"XMax\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            ymin = safe_float(\r\n                read_key(\r\n                    slab,\r\n                    \"YMin\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            ymax = safe_float(\r\n                read_key(\r\n                    slab,\r\n                    \"YMax\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            long_axis = read_key(\r\n                slab,\r\n                \"LongAxis\",\r\n                None\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # REBAR DATA\r\n            # =================================================\r\n\r\n            BL = read_key(\r\n                slab_data,\r\n                \"BottomLong\",\r\n                None\r\n            )\r\n\r\n\r\n            BS = read_key(\r\n                slab_data,\r\n                \"BottomShort\",\r\n                None\r\n            )\r\n\r\n\r\n            TL = read_key(\r\n                slab_data,\r\n                \"TopLong\",\r\n                None\r\n            )\r\n\r\n\r\n            TS = read_key(\r\n                slab_data,\r\n                \"TopShort\",\r\n                None\r\n            )\r\n\r\n\r\n            BL_spacing_mm = safe_float(\r\n                read_key(\r\n                    BL,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            BS_spacing_mm = safe_float(\r\n                read_key(\r\n                    BS,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            TL_spacing_mm = safe_float(\r\n                read_key(\r\n                    TL,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            TS_spacing_mm = safe_float(\r\n                read_key(\r\n                    TS,\r\n                    \"Spacing_mm\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            BL_z = safe_float(\r\n                read_key(\r\n                    BL,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            BS_z = safe_float(\r\n                read_key(\r\n                    BS,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            TL_z = safe_float(\r\n                read_key(\r\n                    TL,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            TS_z = safe_float(\r\n                read_key(\r\n                    TS,\r\n                    \"Z\",\r\n                    None\r\n                )\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # VALIDATE\r\n            # =================================================\r\n\r\n            required = [\r\n\r\n                xmin, xmax,\r\n                ymin, ymax,\r\n\r\n                BL_spacing_mm,\r\n                BS_spacing_mm,\r\n\r\n                TL_spacing_mm,\r\n                TS_spacing_mm,\r\n\r\n                BL_z,\r\n                BS_z,\r\n\r\n                TL_z,\r\n                TS_z\r\n            ]\r\n\r\n\r\n            if any(\r\n                x is None\r\n                for x in required\r\n            ):\r\n\r\n                errors.append(\r\n                    \"Floor {} | Required S03 data missing\".format(\r\n                        floor_id\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n\r\n            BL_spacing = mm_to_ft(\r\n                BL_spacing_mm\r\n            )\r\n\r\n\r\n            BS_spacing = mm_to_ft(\r\n                BS_spacing_mm\r\n            )\r\n\r\n\r\n            TL_spacing = mm_to_ft(\r\n                TL_spacing_mm\r\n            )\r\n\r\n\r\n            TS_spacing = mm_to_ft(\r\n                TS_spacing_mm\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # CORRECTED TOP LAYER Z POSITIONS\r\n            # =================================================\r\n            # Top Short is kept as the upper/top-most layer.\r\n            # Top Long is moved down by one ACTUAL bar diameter.\r\n            # This prevents the two orthogonal top mats from occupying\r\n            # the same physical Z elevation at their intersections.\r\n            # No diameter is hardcoded here.\r\n\r\n            top_reference_z = max(TL_z, TS_z)\r\n            top_short_z = top_reference_z\r\n            top_long_z = top_reference_z - bar_diameter_ft\r\n\r\n\r\n            if top_long_z <= BL_z:\r\n\r\n                warnings.append(\r\n                    \"Floor {} | Top Long layer is very close to/below Bottom Long layer after diameter offset\".format(\r\n                        floor_id\r\n                    )\r\n                )\r\n\r\n\r\n            if top_short_z <= BS_z:\r\n\r\n                warnings.append(\r\n                    \"Floor {} | Top Short layer is very close to/below Bottom Short layer\".format(\r\n                        floor_id\r\n                    )\r\n                )\r\n\r\n\r\n            report.append(\r\n                \"Floor {} | Actual bar diameter = {:.1f} mm | TopLong Z = {:.1f} mm | TopShort Z = {:.1f} mm\".format(\r\n                    floor_id,\r\n                    ft_to_mm(bar_diameter_ft),\r\n                    ft_to_mm(top_long_z),\r\n                    ft_to_mm(top_short_z)\r\n                )\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # READ S04 SUPPORTS\r\n            # =================================================\r\n\r\n            support_data = find_support_data(\r\n                S04,\r\n                floor_id\r\n            )\r\n\r\n\r\n            (\r\n                support_xmin,\r\n                xmin_found,\r\n                xmin_beam\r\n            ) = get_support_coordinate(\r\n                support_data,\r\n                \"XMin\",\r\n                xmin\r\n            )\r\n\r\n\r\n            (\r\n                support_xmax,\r\n                xmax_found,\r\n                xmax_beam\r\n            ) = get_support_coordinate(\r\n                support_data,\r\n                \"XMax\",\r\n                xmax\r\n            )\r\n\r\n\r\n            (\r\n                support_ymin,\r\n                ymin_found,\r\n                ymin_beam\r\n            ) = get_support_coordinate(\r\n                support_data,\r\n                \"YMin\",\r\n                ymin\r\n            )\r\n\r\n\r\n            (\r\n                support_ymax,\r\n                ymax_found,\r\n                ymax_beam\r\n            ) = get_support_coordinate(\r\n                support_data,\r\n                \"YMax\",\r\n                ymax\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # IMPORTANT\r\n            #\r\n            # DO NOT CLAMP A FOUND BEAM CENTERLINE TO S03 LIMIT.\r\n            #\r\n            # S03 LIMIT IS COVER-INSET.\r\n            # BEAM CENTERLINE MUST BE ALLOWED OUTSIDE IT.\r\n            # =================================================\r\n\r\n            report.append(\r\n                \"Floor {} | XMin support = {} | Beam = {} | {:.1f} mm from S03 XMin\".format(\r\n                    floor_id,\r\n                    \"BEAM\" if xmin_found else \"FALLBACK\",\r\n                    xmin_beam,\r\n                    ft_to_mm(\r\n                        support_xmin - xmin\r\n                    )\r\n                )\r\n            )\r\n\r\n\r\n            report.append(\r\n                \"Floor {} | XMax support = {} | Beam = {} | {:.1f} mm from S03 XMax\".format(\r\n                    floor_id,\r\n                    \"BEAM\" if xmax_found else \"FALLBACK\",\r\n                    xmax_beam,\r\n                    ft_to_mm(\r\n                        support_xmax - xmax\r\n                    )\r\n                )\r\n            )\r\n\r\n\r\n            report.append(\r\n                \"Floor {} | YMin support = {} | Beam = {} | {:.1f} mm from S03 YMin\".format(\r\n                    floor_id,\r\n                    \"BEAM\" if ymin_found else \"FALLBACK\",\r\n                    ymin_beam,\r\n                    ft_to_mm(\r\n                        support_ymin - ymin\r\n                    )\r\n                )\r\n            )\r\n\r\n\r\n            report.append(\r\n                \"Floor {} | YMax support = {} | Beam = {} | {:.1f} mm from S03 YMax\".format(\r\n                    floor_id,\r\n                    \"BEAM\" if ymax_found else \"FALLBACK\",\r\n                    ymax_beam,\r\n                    ft_to_mm(\r\n                        support_ymax - ymax\r\n                    )\r\n                )\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # DISTRIBUTION WIDTHS\r\n            # =================================================\r\n\r\n            dist_x = xmax - xmin\r\n            dist_y = ymax - ymin\r\n\r\n\r\n            # =================================================\r\n            # LONG AXIS X\r\n            # =================================================\r\n\r\n            if long_axis == \"X\":\r\n\r\n                # ------------------------------------------------\r\n                # BOTTOM LONG\r\n                # EXTENDS X TO BEAM CENTERLINES\r\n                # ------------------------------------------------\r\n\r\n                bottom_long = create_straight_rebar(\r\n                    floor,\r\n                    bar_type,\r\n\r\n                    XYZ(\r\n                        support_xmin,\r\n                        ymin,\r\n                        BL_z\r\n                    ),\r\n\r\n                    XYZ(\r\n                        support_xmax,\r\n                        ymin,\r\n                        BL_z\r\n                    ),\r\n\r\n                    XYZ.BasisY\r\n                )\r\n\r\n\r\n                if (\r\n                    bottom_long is not None\r\n                    and apply_layout(\r\n                        bottom_long,\r\n                        BL_spacing,\r\n                        dist_y\r\n                    )\r\n                ):\r\n\r\n                    bottom_long_sets.append(\r\n                        bottom_long\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Bottom Long failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # BOTTOM SHORT\r\n                # EXTENDS Y TO BEAM CENTERLINES\r\n                # ------------------------------------------------\r\n\r\n                bottom_short = create_straight_rebar(\r\n                    floor,\r\n                    bar_type,\r\n\r\n                    XYZ(\r\n                        xmin,\r\n                        support_ymin,\r\n                        BS_z\r\n                    ),\r\n\r\n                    XYZ(\r\n                        xmin,\r\n                        support_ymax,\r\n                        BS_z\r\n                    ),\r\n\r\n                    XYZ.BasisX\r\n                )\r\n\r\n\r\n                if (\r\n                    bottom_short is not None\r\n                    and apply_layout(\r\n                        bottom_short,\r\n                        BS_spacing,\r\n                        dist_x\r\n                    )\r\n                ):\r\n\r\n                    bottom_short_sets.append(\r\n                        bottom_short\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Bottom Short failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # CRANK LONG\r\n                # ------------------------------------------------\r\n\r\n                crank_long_y = (\r\n                    ymin\r\n                    +\r\n                    TL_spacing / 2.0\r\n                )\r\n\r\n\r\n                long_points = build_x_crank(\r\n                    xmin,\r\n                    xmax,\r\n\r\n                    support_xmin,\r\n                    support_xmax,\r\n\r\n                    crank_long_y,\r\n\r\n                    top_long_z,\r\n                    BL_z\r\n                )\r\n\r\n\r\n                crank_long = create_cranked_rebar(\r\n                    floor,\r\n                    bar_type,\r\n                    long_points,\r\n                    XYZ.BasisY\r\n                )\r\n\r\n\r\n                if (\r\n                    crank_long is not None\r\n                    and apply_layout(\r\n                        crank_long,\r\n                        TL_spacing,\r\n                        dist_y - TL_spacing\r\n                    )\r\n                ):\r\n\r\n                    crank_long_sets.append(\r\n                        crank_long\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Crank Long failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # CRANK SHORT\r\n                # ------------------------------------------------\r\n\r\n                crank_short_x = (\r\n                    xmin\r\n                    +\r\n                    TS_spacing / 2.0\r\n                )\r\n\r\n\r\n                short_points = build_y_crank(\r\n                    ymin,\r\n                    ymax,\r\n\r\n                    support_ymin,\r\n                    support_ymax,\r\n\r\n                    crank_short_x,\r\n\r\n                    top_short_z,\r\n                    BS_z\r\n                )\r\n\r\n\r\n                crank_short = create_cranked_rebar(\r\n                    floor,\r\n                    bar_type,\r\n                    short_points,\r\n                    XYZ.BasisX\r\n                )\r\n\r\n\r\n                if (\r\n                    crank_short is not None\r\n                    and apply_layout(\r\n                        crank_short,\r\n                        TS_spacing,\r\n                        dist_x - TS_spacing\r\n                    )\r\n                ):\r\n\r\n                    crank_short_sets.append(\r\n                        crank_short\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Crank Short failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n            # =================================================\r\n            # LONG AXIS Y\r\n            # =================================================\r\n\r\n            elif long_axis == \"Y\":\r\n\r\n                # ------------------------------------------------\r\n                # BOTTOM LONG\r\n                # EXTENDS Y TO BEAM CENTERLINES\r\n                # ------------------------------------------------\r\n\r\n                bottom_long = create_straight_rebar(\r\n                    floor,\r\n                    bar_type,\r\n\r\n                    XYZ(\r\n                        xmin,\r\n                        support_ymin,\r\n                        BL_z\r\n                    ),\r\n\r\n                    XYZ(\r\n                        xmin,\r\n                        support_ymax,\r\n                        BL_z\r\n                    ),\r\n\r\n                    XYZ.BasisX\r\n                )\r\n\r\n\r\n                if (\r\n                    bottom_long is not None\r\n                    and apply_layout(\r\n                        bottom_long,\r\n                        BL_spacing,\r\n                        dist_x\r\n                    )\r\n                ):\r\n\r\n                    bottom_long_sets.append(\r\n                        bottom_long\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Bottom Long failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # BOTTOM SHORT\r\n                # EXTENDS X TO BEAM CENTERLINES\r\n                # ------------------------------------------------\r\n\r\n                bottom_short = create_straight_rebar(\r\n                    floor,\r\n                    bar_type,\r\n\r\n                    XYZ(\r\n                        support_xmin,\r\n                        ymin,\r\n                        BS_z\r\n                    ),\r\n\r\n                    XYZ(\r\n                        support_xmax,\r\n                        ymin,\r\n                        BS_z\r\n                    ),\r\n\r\n                    XYZ.BasisY\r\n                )\r\n\r\n\r\n                if (\r\n                    bottom_short is not None\r\n                    and apply_layout(\r\n                        bottom_short,\r\n                        BS_spacing,\r\n                        dist_y\r\n                    )\r\n                ):\r\n\r\n                    bottom_short_sets.append(\r\n                        bottom_short\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Bottom Short failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # CRANK LONG\r\n                # ------------------------------------------------\r\n\r\n                crank_long_x = (\r\n                    xmin\r\n                    +\r\n                    TL_spacing / 2.0\r\n                )\r\n\r\n\r\n                long_points = build_y_crank(\r\n                    ymin,\r\n                    ymax,\r\n\r\n                    support_ymin,\r\n                    support_ymax,\r\n\r\n                    crank_long_x,\r\n\r\n                    top_long_z,\r\n                    BL_z\r\n                )\r\n\r\n\r\n                crank_long = create_cranked_rebar(\r\n                    floor,\r\n                    bar_type,\r\n                    long_points,\r\n                    XYZ.BasisX\r\n                )\r\n\r\n\r\n                if (\r\n                    crank_long is not None\r\n                    and apply_layout(\r\n                        crank_long,\r\n                        TL_spacing,\r\n                        dist_x - TL_spacing\r\n                    )\r\n                ):\r\n\r\n                    crank_long_sets.append(\r\n                        crank_long\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Crank Long failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n                # ------------------------------------------------\r\n                # CRANK SHORT\r\n                # ------------------------------------------------\r\n\r\n                crank_short_y = (\r\n                    ymin\r\n                    +\r\n                    TS_spacing / 2.0\r\n                )\r\n\r\n\r\n                short_points = build_x_crank(\r\n                    xmin,\r\n                    xmax,\r\n\r\n                    support_xmin,\r\n                    support_xmax,\r\n\r\n                    crank_short_y,\r\n\r\n                    top_short_z,\r\n                    BS_z\r\n                )\r\n\r\n\r\n                crank_short = create_cranked_rebar(\r\n                    floor,\r\n                    bar_type,\r\n                    short_points,\r\n                    XYZ.BasisY\r\n                )\r\n\r\n\r\n                if (\r\n                    crank_short is not None\r\n                    and apply_layout(\r\n                        crank_short,\r\n                        TS_spacing,\r\n                        dist_y - TS_spacing\r\n                    )\r\n                ):\r\n\r\n                    crank_short_sets.append(\r\n                        crank_short\r\n                    )\r\n\r\n                else:\r\n\r\n                    errors.append(\r\n                        \"Floor {} | Crank Short failed\".format(\r\n                            floor_id\r\n                        )\r\n                    )\r\n\r\n\r\n            else:\r\n\r\n                errors.append(\r\n                    \"Floor {} | Invalid LongAxis {}\".format(\r\n                        floor_id,\r\n                        long_axis\r\n                    )\r\n                )\r\n\r\n\r\n        except Exception as ex:\r\n\r\n            errors.append(\r\n                \"Floor {} | ERROR | {}\".format(\r\n                    floor_id,\r\n                    str(ex)\r\n                )\r\n            )\r\n\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n# ============================================================\r\n# OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n\r\n    \"Success\":\r\n        len(errors) == 0,\r\n\r\n    \"OldOrdinaryRebarDeleted\":\r\n        deleted_total,\r\n\r\n    \"BottomLongSetCount\":\r\n        len(bottom_long_sets),\r\n\r\n    \"BottomLongSets\":\r\n        bottom_long_sets,\r\n\r\n    \"BottomShortSetCount\":\r\n        len(bottom_short_sets),\r\n\r\n    \"BottomShortSets\":\r\n        bottom_short_sets,\r\n\r\n    \"CrankLongSetCount\":\r\n        len(crank_long_sets),\r\n\r\n    \"CrankLongSets\":\r\n        crank_long_sets,\r\n\r\n    \"CrankShortSetCount\":\r\n        len(crank_short_sets),\r\n\r\n    \"CrankShortSets\":\r\n        crank_short_sets,\r\n\r\n    \"Warnings\":\r\n        warnings,\r\n\r\n    \"Errors\":\r\n        errors,\r\n\r\n    \"Report\":\r\n        report\r\n}   \r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "79b63269621247c7ba52d3d1cfc7a994",
