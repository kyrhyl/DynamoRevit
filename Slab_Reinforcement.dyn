      "Outputs": [
        {
          "Id": "9cbf233ba96e4937875f4566e61aa76d",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# ============================================================\r\n# REVIT API\r\n# ============================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ============================================================\r\n# CONSTANTS\r\n# ============================================================\r\n\r\nMM_TO_FT = 1.0 / 304.8\r\nFT_TO_MM = 304.8\r\n\r\n\r\n# ============================================================\r\n# HELPERS\r\n# ============================================================\r\n\r\ndef mm_to_ft(value):\r\n    return float(value) / 304.8\r\n\r\n\r\ndef ft_to_mm(value):\r\n    return float(value) * 304.8\r\n\r\n\r\ndef as_list(value):\r\n\r\n    if value is None:\r\n        return []\r\n\r\n    if isinstance(value, list):\r\n        return value\r\n\r\n    try:\r\n        if hasattr(value, \"__iter__\") and not isinstance(value, str):\r\n            return list(value)\r\n    except:\r\n        pass\r\n\r\n    return [value]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# SAFE DICTIONARY READER\r\n# ------------------------------------------------------------\r\n\r\ndef read_key(data, key, default=None):\r\n\r\n    if data is None:\r\n        return default\r\n\r\n    # Python dict\r\n    try:\r\n        return data[key]\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return data.get(key, default)\r\n    except:\r\n        pass\r\n\r\n    # Dynamo / .NET dictionary\r\n    try:\r\n\r\n        keys = list(data.Keys)\r\n\r\n        for k in keys:\r\n\r\n            if str(k) == str(key):\r\n\r\n                try:\r\n                    return data[k]\r\n                except:\r\n                    pass\r\n\r\n    except:\r\n        pass\r\n\r\n    return default\r\n\r\n\r\n# ------------------------------------------------------------\r\n# SAFE ELEMENT ID\r\n# ------------------------------------------------------------\r\n\r\ndef get_id(element):\r\n\r\n    if element is None:\r\n        return None\r\n\r\n    try:\r\n        return element.Id.Value\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return element.Id.IntegerValue\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return str(element.Id)\r\n    except:\r\n        return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# SAFE NUMBER\r\n# ------------------------------------------------------------\r\n\r\ndef number(value, name, errors):\r\n\r\n    if value is None:\r\n\r\n        errors.append(\r\n            \"{} is NONE\".format(name)\r\n        )\r\n\r\n        return None\r\n\r\n    try:\r\n\r\n        value = float(value)\r\n\r\n    except:\r\n\r\n        errors.append(\r\n            \"{} is not a valid number: {}\".format(\r\n                name,\r\n                value\r\n            )\r\n        )\r\n\r\n        return None\r\n\r\n    if value <= 0:\r\n\r\n        errors.append(\r\n            \"{} must be greater than zero\".format(\r\n                name\r\n            )\r\n        )\r\n\r\n        return None\r\n\r\n    return value\r\n\r\n\r\n# ============================================================\r\n# INPUT\r\n# ============================================================\r\n#\r\n# IN[0] = S01 output\r\n# IN[1] = S02 output\r\n#\r\n# ============================================================\r\n\r\nS01 = IN[0]\r\nS02 = IN[1]\r\n\r\nglobal_errors = []\r\nresults = []\r\n\r\n\r\n# ============================================================\r\n# READ FLOORS FROM S01\r\n# ============================================================\r\n\r\nfloors = read_key(\r\n    S01,\r\n    \"Floors\",\r\n    None\r\n)\r\n\r\nfloors = as_list(\r\n    floors\r\n)\r\n\r\n\r\nif len(floors) == 0:\r\n\r\n    global_errors.append(\r\n        \"NO FLOORS RECEIVED FROM S01\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# VALIDATE S02\r\n# ============================================================\r\n\r\ninput_valid = read_key(\r\n    S02,\r\n    \"Valid\",\r\n    False\r\n)\r\n\r\n\r\nif input_valid is not True:\r\n\r\n    global_errors.append(\r\n        \"S02 INPUT IS NOT VALID\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# READ S02 DATA\r\n# ============================================================\r\n\r\nreinforcement = read_key(\r\n    S02,\r\n    \"Reinforcement\",\r\n    None\r\n)\r\n\r\ncovers = read_key(\r\n    S02,\r\n    \"Covers\",\r\n    None\r\n)\r\n\r\n\r\nif reinforcement is None:\r\n\r\n    global_errors.append(\r\n        \"Cannot read Reinforcement from S02\"\r\n    )\r\n\r\n\r\nif covers is None:\r\n\r\n    global_errors.append(\r\n        \"Cannot read Covers from S02\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# READ SHARED BAR DIAMETER\r\n# ============================================================\r\n\r\nbar_diameter_mm = number(\r\n    read_key(\r\n        reinforcement,\r\n        \"BarDiameter_mm\",\r\n        None\r\n    ),\r\n    \"Bar Diameter\",\r\n    global_errors\r\n)\r\n\r\n\r\n# ============================================================\r\n# READ COVERS\r\n# ============================================================\r\n\r\nbottom_cover_mm = number(\r\n    read_key(\r\n        covers,\r\n        \"Bottom_mm\",\r\n        None\r\n    ),\r\n    \"Bottom Cover\",\r\n    global_errors\r\n)\r\n\r\n\r\ntop_cover_mm = number(\r\n    read_key(\r\n        covers,\r\n        \"Top_mm\",\r\n        None\r\n    ),\r\n    \"Top Cover\",\r\n    global_errors\r\n)\r\n\r\n\r\n# ============================================================\r\n# READ REBAR GROUPS\r\n# ============================================================\r\n\r\nBL = read_key(\r\n    reinforcement,\r\n    \"BottomLong\",\r\n    None\r\n)\r\n\r\nBS = read_key(\r\n    reinforcement,\r\n    \"BottomShort\",\r\n    None\r\n)\r\n\r\nTL = read_key(\r\n    reinforcement,\r\n    \"TopLong\",\r\n    None\r\n)\r\n\r\nTS = read_key(\r\n    reinforcement,\r\n    \"TopShort\",\r\n    None\r\n)\r\n\r\n\r\nif BL is None:\r\n    global_errors.append(\r\n        \"BottomLong data missing\"\r\n    )\r\n\r\nif BS is None:\r\n    global_errors.append(\r\n        \"BottomShort data missing\"\r\n    )\r\n\r\nif TL is None:\r\n    global_errors.append(\r\n        \"TopLong data missing\"\r\n    )\r\n\r\nif TS is None:\r\n    global_errors.append(\r\n        \"TopShort data missing\"\r\n    )\r\n\r\n\r\n# ============================================================\r\n# READ SPACING\r\n# ============================================================\r\n\r\nBL_spacing_mm = number(\r\n    read_key(\r\n        BL,\r\n        \"Spacing_mm\",\r\n        None\r\n    ),\r\n    \"Bottom Long Spacing\",\r\n    global_errors\r\n)\r\n\r\n\r\nBS_spacing_mm = number(\r\n    read_key(\r\n        BS,\r\n        \"Spacing_mm\",\r\n        None\r\n    ),\r\n    \"Bottom Short Spacing\",\r\n    global_errors\r\n)\r\n\r\n\r\nTL_spacing_mm = number(\r\n    read_key(\r\n        TL,\r\n        \"Spacing_mm\",\r\n        None\r\n    ),\r\n    \"Top Long Spacing\",\r\n    global_errors\r\n)\r\n\r\n\r\nTS_spacing_mm = number(\r\n    read_key(\r\n        TS,\r\n        \"Spacing_mm\",\r\n        None\r\n    ),\r\n    \"Top Short Spacing\",\r\n    global_errors\r\n)\r\n\r\n\r\n# ============================================================\r\n# PROCESS IF INPUT VALID\r\n# ============================================================\r\n\r\nif len(global_errors) == 0:\r\n\r\n    # --------------------------------------------------------\r\n    # Convert input units to Revit internal feet\r\n    # --------------------------------------------------------\r\n\r\n    bar_diameter = mm_to_ft(\r\n        bar_diameter_mm\r\n    )\r\n\r\n    bottom_cover = mm_to_ft(\r\n        bottom_cover_mm\r\n    )\r\n\r\n    top_cover = mm_to_ft(\r\n        top_cover_mm\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # PROCESS EACH FLOOR\r\n    # ========================================================\r\n\r\n    for floor_item in floors:\r\n\r\n        slab_errors = []\r\n\r\n        try:\r\n\r\n            # ------------------------------------------------\r\n            # UNWRAP\r\n            # ------------------------------------------------\r\n\r\n            try:\r\n\r\n                floor = UnwrapElement(\r\n                    floor_item\r\n                )\r\n\r\n            except:\r\n\r\n                floor = floor_item\r\n\r\n\r\n            # ------------------------------------------------\r\n            # VERIFY FLOOR\r\n            # ------------------------------------------------\r\n\r\n            if not isinstance(\r\n                floor,\r\n                Floor\r\n            ):\r\n\r\n                results.append({\r\n\r\n                    \"FloorId\":\r\n                        get_id(floor),\r\n\r\n                    \"Valid\":\r\n                        False,\r\n\r\n                    \"Errors\": [\r\n                        \"Selected element is not a Floor\"\r\n                    ]\r\n                })\r\n\r\n                continue\r\n\r\n\r\n            floor_id = get_id(\r\n                floor\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # FLOOR BOUNDING BOX\r\n            # =================================================\r\n\r\n            bbox = floor.get_BoundingBox(\r\n                None\r\n            )\r\n\r\n\r\n            if bbox is None:\r\n\r\n                results.append({\r\n\r\n                    \"Floor\":\r\n                        floor,\r\n\r\n                    \"FloorId\":\r\n                        floor_id,\r\n\r\n                    \"Valid\":\r\n                        False,\r\n\r\n                    \"Errors\": [\r\n                        \"Cannot get Floor bounding box\"\r\n                    ]\r\n                })\r\n\r\n                continue\r\n\r\n\r\n            pmin = bbox.Min\r\n            pmax = bbox.Max\r\n\r\n\r\n            # =================================================\r\n            # DIMENSIONS\r\n            # =================================================\r\n\r\n            dx = pmax.X - pmin.X\r\n            dy = pmax.Y - pmin.Y\r\n            dz = pmax.Z - pmin.Z\r\n\r\n\r\n            dx_mm = ft_to_mm(\r\n                dx\r\n            )\r\n\r\n            dy_mm = ft_to_mm(\r\n                dy\r\n            )\r\n\r\n            thickness_mm = ft_to_mm(\r\n                dz\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # DETERMINE LONG / SHORT AXIS\r\n            # ============================================================\r\n\r\n            if dx >= dy:\r\n\r\n                long_axis = \"X\"\r\n                short_axis = \"Y\"\r\n\r\n                long_direction = XYZ(\r\n                    1,\r\n                    0,\r\n                    0\r\n                )\r\n\r\n                short_direction = XYZ(\r\n                    0,\r\n                    1,\r\n                    0\r\n                )\r\n\r\n                long_length_mm = dx_mm\r\n                short_length_mm = dy_mm\r\n\r\n\r\n            else:\r\n\r\n                long_axis = \"Y\"\r\n                short_axis = \"X\"\r\n\r\n                long_direction = XYZ(\r\n                    0,\r\n                    1,\r\n                    0\r\n                )\r\n\r\n                short_direction = XYZ(\r\n                    1,\r\n                    0,\r\n                    0\r\n                )\r\n\r\n                long_length_mm = dy_mm\r\n                short_length_mm = dx_mm\r\n\r\n\r\n            # =================================================\r\n            # TOP / BOTTOM ELEVATION\r\n            # ============================================================\r\n\r\n            bottom_z = pmin.Z\r\n            top_z = pmax.Z\r\n\r\n\r\n            # =================================================\r\n            # BOTTOM BAR LEVELS\r\n            #\r\n            # Lowest layer:\r\n            # Bottom Short\r\n            #\r\n            # Above it:\r\n            # Bottom Long\r\n            # ============================================================\r\n\r\n            BS_z = (\r\n                bottom_z\r\n                + bottom_cover\r\n                + bar_diameter / 2.0\r\n            )\r\n\r\n\r\n            BL_z = (\r\n                BS_z\r\n                + bar_diameter\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # TOP BAR LEVELS\r\n            #\r\n            # Highest layer:\r\n            # Top Short\r\n            #\r\n            # Below it:\r\n            # Top Long\r\n            # ============================================================\r\n\r\n            TS_z = (\r\n                top_z\r\n                - top_cover\r\n                - bar_diameter / 2.0\r\n            )\r\n\r\n\r\n            TL_z = (\r\n                TS_z\r\n                - bar_diameter\r\n            )\r\n\r\n\r\n            # =================================================\r\n            # CHECK SLAB THICKNESS\r\n            # ============================================================\r\n\r\n            if BL_z >= TL_z:\r\n\r\n                slab_errors.append(\r\n                    \"Slab is too thin for calculated reinforcement layers\"\r\n                )\r\n\r\n\r\n            # =================================================\r\n            # PLAN LIMITS\r\n            # ============================================================\r\n            #\r\n            # This is still mainly useful for direct-rebar drawing.\r\n            # Area Reinforcement can use the floor boundary directly.\r\n            #\r\n            # ============================================================\r\n\r\n            edge_cover = max(\r\n                bottom_cover,\r\n                top_cover\r\n            )\r\n\r\n\r\n            xmin = (\r\n                pmin.X\r\n                + edge_cover\r\n            )\r\n\r\n            xmax = (\r\n                pmax.X\r\n                - edge_cover\r\n            )\r\n\r\n            ymin = (\r\n                pmin.Y\r\n                + edge_cover\r\n            )\r\n\r\n            ymax = (\r\n                pmax.Y\r\n                - edge_cover\r\n            )\r\n\r\n\r\n            if xmax <= xmin:\r\n\r\n                slab_errors.append(\r\n                    \"Invalid X reinforcement limits\"\r\n                )\r\n\r\n\r\n            if ymax <= ymin:\r\n\r\n                slab_errors.append(\r\n                    \"Invalid Y reinforcement limits\"\r\n                )\r\n\r\n\r\n            # =================================================\r\n            # BUILD RESULT\r\n            # ============================================================\r\n\r\n            slab_data = {\r\n\r\n                # --------------------------------------------\r\n                # FLOOR\r\n                # --------------------------------------------\r\n\r\n                \"Floor\":\r\n                    floor,\r\n\r\n                \"FloorId\":\r\n                    floor_id,\r\n\r\n                \"Valid\":\r\n                    len(slab_errors) == 0,\r\n\r\n                \"Errors\":\r\n                    slab_errors,\r\n\r\n\r\n                # ============================================\r\n                # SHARED BAR DIAMETER\r\n                # ============================================\r\n\r\n                \"BarDiameter_mm\":\r\n                    bar_diameter_mm,\r\n\r\n\r\n                # ============================================\r\n                # COVERS\r\n                # ============================================\r\n\r\n                \"Covers\": {\r\n\r\n                    \"Bottom_mm\":\r\n                        bottom_cover_mm,\r\n\r\n                    \"Top_mm\":\r\n                        top_cover_mm\r\n                },\r\n\r\n\r\n                # ============================================\r\n                # SLAB DATA\r\n                # ============================================\r\n\r\n                \"Slab\": {\r\n\r\n                    \"Thickness_mm\":\r\n                        thickness_mm,\r\n\r\n                    \"XLength_mm\":\r\n                        dx_mm,\r\n\r\n                    \"YLength_mm\":\r\n                        dy_mm,\r\n\r\n                    \"LongLength_mm\":\r\n                        long_length_mm,\r\n\r\n                    \"ShortLength_mm\":\r\n                        short_length_mm,\r\n\r\n                    \"LongAxis\":\r\n                        long_axis,\r\n\r\n                    \"ShortAxis\":\r\n                        short_axis,\r\n\r\n                    \"LongDirection\":\r\n                        long_direction,\r\n\r\n                    \"ShortDirection\":\r\n                        short_direction,\r\n\r\n                    \"BottomZ\":\r\n                        bottom_z,\r\n\r\n                    \"TopZ\":\r\n                        top_z,\r\n\r\n                    \"XMin\":\r\n                        xmin,\r\n\r\n                    \"XMax\":\r\n                        xmax,\r\n\r\n                    \"YMin\":\r\n                        ymin,\r\n\r\n                    \"YMax\":\r\n                        ymax\r\n                },\r\n\r\n\r\n                # ============================================\r\n                # BOTTOM LONG\r\n                # ============================================\r\n\r\n                \"BottomLong\": {\r\n\r\n                    \"Diameter_mm\":\r\n                        bar_diameter_mm,\r\n\r\n                    \"Spacing_mm\":\r\n                        BL_spacing_mm,\r\n\r\n                    \"Z\":\r\n                        BL_z,\r\n\r\n                    \"Direction\":\r\n                        long_direction,\r\n\r\n                    \"Axis\":\r\n                        long_axis\r\n                },\r\n\r\n\r\n                # ============================================\r\n                # BOTTOM SHORT\r\n                # ============================================\r\n\r\n                \"BottomShort\": {\r\n\r\n                    \"Diameter_mm\":\r\n                        bar_diameter_mm,\r\n\r\n                    \"Spacing_mm\":\r\n                        BS_spacing_mm,\r\n\r\n                    \"Z\":\r\n                        BS_z,\r\n\r\n                    \"Direction\":\r\n                        short_direction,\r\n\r\n                    \"Axis\":\r\n                        short_axis\r\n                },\r\n\r\n\r\n                # ============================================\r\n                # TOP LONG\r\n                # ============================================\r\n\r\n                \"TopLong\": {\r\n\r\n                    \"Diameter_mm\":\r\n                        bar_diameter_mm,\r\n\r\n                    \"Spacing_mm\":\r\n                        TL_spacing_mm,\r\n\r\n                    \"Z\":\r\n                        TL_z,\r\n\r\n                    \"Direction\":\r\n                        long_direction,\r\n\r\n                    \"Axis\":\r\n                        long_axis\r\n                },\r\n\r\n\r\n                # ============================================\r\n                # TOP SHORT\r\n                # ============================================\r\n\r\n                \"TopShort\": {\r\n\r\n                    \"Diameter_mm\":\r\n                        bar_diameter_mm,\r\n\r\n                    \"Spacing_mm\":\r\n                        TS_spacing_mm,\r\n\r\n                    \"Z\":\r\n                        TS_z,\r\n\r\n                    \"Direction\":\r\n                        short_direction,\r\n\r\n                    \"Axis\":\r\n                        short_axis\r\n                }\r\n            }\r\n\r\n\r\n            results.append(\r\n                slab_data\r\n            )\r\n\r\n\r\n        except Exception as ex:\r\n\r\n            results.append({\r\n\r\n                \"FloorId\":\r\n                    get_id(\r\n                        floor_item\r\n                    ),\r\n\r\n                \"Valid\":\r\n                    False,\r\n\r\n                \"Errors\": [\r\n                    str(ex)\r\n                ]\r\n            })\r\n\r\n\r\n# ============================================================\r\n# COUNT RESULTS\r\n# ============================================================\r\n\r\nvalid_count = 0\r\ninvalid_count = 0\r\n\r\n\r\nfor item in results:\r\n\r\n    if read_key(\r\n        item,\r\n        \"Valid\",\r\n        False\r\n    ):\r\n\r\n        valid_count += 1\r\n\r\n    else:\r\n\r\n        invalid_count += 1\r\n\r\n\r\n# ============================================================\r\n# FINAL OUTPUT\r\n# ============================================================\r\n\r\nOUT = {\r\n\r\n    \"Valid\":\r\n        (\r\n            len(global_errors) == 0\r\n            and valid_count > 0\r\n            and invalid_count == 0\r\n        ),\r\n\r\n    \"Slabs\":\r\n        results,\r\n\r\n    \"ValidSlabs\":\r\n        valid_count,\r\n\r\n    \"InvalidSlabs\":\r\n        invalid_count,\r\n\r\n    \"Errors\":\r\n        global_errors\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "bb22c0247b984dbabe282b68ed2020af",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "f801a24a8257430a96be2a25ea90d9f1",
