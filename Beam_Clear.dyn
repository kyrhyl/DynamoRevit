{
  "Uuid": "b69fb37f-b98a-4c03-89d1-306afbbaaece",
  "IsCustomNode": false,
  "Description": "",
  "Name": "Beam_Clear",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "4ad846d8e05f4308894a1d5d7e990576",
      "Name": "Structural Framing Types",
      "Type": "selection",
      "Type2": "dropdownSelection",
      "Value": "FTB-2",
      "Description": "Select a structural framing type in the active document",
      "SelectedIndex": 4
    }
  ],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# ============================================================\r\n# S01 — CLEAR REBAR BY STRUCTURAL FRAMING TYPE\r\n#\r\n# IN[0] = Structural Framing Type\r\n#         Native Dynamo \"Structural Framing Types\" node\r\n#\r\n# ACTION:\r\n#   1. Finds all Structural Framing instances using\r\n#      the selected type.\r\n#   2. Finds Rebar hosted by those framing elements.\r\n#   3. Deletes those Rebar elements.\r\n#\r\n# OUT:\r\n# [0] Matching Framing Elements\r\n# [1] Matching Framing IDs\r\n# [2] Framing Type Name\r\n# [3] Number of Framing Elements\r\n# [4] Number of Rebars Deleted\r\n# [5] Deleted Rebar IDs\r\n# [6] Status\r\n# ============================================================\r\n\r\nimport clr\r\n\r\n# ------------------------------------------------------------\r\n# REVIT SERVICES\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitServices\")\r\n\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT API\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitAPI\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import Rebar\r\n\r\n\r\n# ------------------------------------------------------------\r\n# REVIT / DYNAMO\r\n# ------------------------------------------------------------\r\n\r\nclr.AddReference(\"RevitNodes\")\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n\r\n# ------------------------------------------------------------\r\n# INPUT\r\n# ------------------------------------------------------------\r\n\r\ninput_type = IN[0]\r\n\r\n\r\n# ------------------------------------------------------------\r\n# SAFE ELEMENT ID\r\n# Supports newer and older Revit versions\r\n# ------------------------------------------------------------\r\n\r\ndef id_value(element_id):\r\n\r\n    if element_id is None:\r\n        return None\r\n\r\n    try:\r\n        return int(element_id.Value)\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        return int(element_id.IntegerValue)\r\n    except:\r\n        pass\r\n\r\n    return None\r\n\r\n\r\n# ------------------------------------------------------------\r\n# DEFAULT OUTPUT\r\n# ------------------------------------------------------------\r\n\r\nmatching_elements = []\r\nmatching_ids = []\r\n\r\ndeleted_rebar_ids = []\r\n\r\ntype_name = None\r\n\r\nframing_count = 0\r\ndeleted_count = 0\r\n\r\nstatus = \"\"\r\n\r\n\r\n# ------------------------------------------------------------\r\n# VALIDATE INPUT\r\n# ------------------------------------------------------------\r\n\r\nif input_type is None:\r\n\r\n    status = \"No Structural Framing Type received.\"\r\n\r\nelse:\r\n\r\n    # --------------------------------------------------------\r\n    # UNWRAP SELECTED TYPE\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n        selected_type = UnwrapElement(input_type)\r\n    except:\r\n        selected_type = input_type\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # GET SELECTED TYPE ID\r\n    # --------------------------------------------------------\r\n\r\n    selected_type_id_value = None\r\n\r\n    try:\r\n\r\n        selected_type_id_value = id_value(\r\n            selected_type.Id\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # GET TYPE NAME\r\n    # --------------------------------------------------------\r\n\r\n    try:\r\n        type_name = selected_type.Name\r\n    except:\r\n        type_name = None\r\n\r\n\r\n    if not type_name:\r\n\r\n        try:\r\n\r\n            p = selected_type.get_Parameter(\r\n                BuiltInParameter.SYMBOL_NAME_PARAM\r\n            )\r\n\r\n            if p:\r\n                type_name = p.AsString()\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    if not type_name:\r\n        type_name = \"Unknown Type\"\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FIND STRUCTURAL FRAMING INSTANCES\r\n    # --------------------------------------------------------\r\n\r\n    framing_collector = (\r\n        FilteredElementCollector(doc)\r\n        .OfCategory(\r\n            BuiltInCategory.OST_StructuralFraming\r\n        )\r\n        .WhereElementIsNotElementType()\r\n    )\r\n\r\n\r\n    for framing in framing_collector:\r\n\r\n        try:\r\n\r\n            framing_type_id = id_value(\r\n                framing.GetTypeId()\r\n            )\r\n\r\n            if framing_type_id == selected_type_id_value:\r\n\r\n                matching_elements.append(framing)\r\n\r\n                fid = id_value(framing.Id)\r\n\r\n                if fid is not None:\r\n                    matching_ids.append(fid)\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    framing_count = len(matching_elements)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CREATE HOST ID SET\r\n    # --------------------------------------------------------\r\n\r\n    host_id_set = set(matching_ids)\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # FIND ALL STANDARD REBAR\r\n    # --------------------------------------------------------\r\n\r\n    all_rebars = (\r\n        FilteredElementCollector(doc)\r\n        .OfClass(Rebar)\r\n        .WhereElementIsNotElementType()\r\n    )\r\n\r\n\r\n    rebars_to_delete = []\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # CHECK REBAR HOST\r\n    # --------------------------------------------------------\r\n\r\n    for rebar in all_rebars:\r\n\r\n        try:\r\n\r\n            host_id = rebar.GetHostId()\r\n\r\n            host_value = id_value(host_id)\r\n\r\n            if host_value in host_id_set:\r\n\r\n                rebars_to_delete.append(rebar)\r\n\r\n                rid = id_value(rebar.Id)\r\n\r\n                if rid is not None:\r\n                    deleted_rebar_ids.append(rid)\r\n\r\n        except:\r\n            pass\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # DELETE REBARS\r\n    # --------------------------------------------------------\r\n\r\n    if len(rebars_to_delete) > 0:\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n        actual_deleted = 0\r\n\r\n        for rebar in rebars_to_delete:\r\n\r\n            try:\r\n\r\n                doc.Delete(rebar.Id)\r\n\r\n                actual_deleted += 1\r\n\r\n            except:\r\n                pass\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        deleted_count = actual_deleted\r\n\r\n\r\n    # --------------------------------------------------------\r\n    # STATUS\r\n    # --------------------------------------------------------\r\n\r\n    if selected_type_id_value is None:\r\n\r\n        status = (\r\n            \"ERROR: Could not determine selected \"\r\n            \"Structural Framing Type ID.\"\r\n        )\r\n\r\n    elif framing_count == 0:\r\n\r\n        status = (\r\n            \"No Structural Framing instances found \"\r\n            \"for type '{}'.\"\r\n        ).format(type_name)\r\n\r\n    elif deleted_count == 0:\r\n\r\n        status = (\r\n            \"Found {} framing element(s) of type '{}', \"\r\n            \"but no hosted standard Rebar elements were found.\"\r\n        ).format(\r\n            framing_count,\r\n            type_name\r\n        )\r\n\r\n    else:\r\n\r\n        status = (\r\n            \"SUCCESS: Found {} framing element(s) of type '{}'. \"\r\n            \"Deleted {} hosted Rebar element(s).\"\r\n        ).format(\r\n            framing_count,\r\n            type_name,\r\n            deleted_count\r\n        )\r\n\r\n\r\n# ------------------------------------------------------------\r\n# OUTPUT\r\n# ------------------------------------------------------------\r\n\r\nOUT = [\r\n    matching_elements,\r\n    matching_ids,\r\n    type_name,\r\n    framing_count,\r\n    deleted_count,\r\n    deleted_rebar_ids,\r\n    status\r\n]",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5a5215f1038d4a10841a1b37fb87a20c",
